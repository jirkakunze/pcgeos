FileHandle StreamGetFile(Stream *str)
{

    if (str->kind == strFile)
    {
        return FStreamGetFile(str);
    }
    if (str->kind == strObjStmCache)
    {
        return NullHandle;
    }

    return StreamGetFile(str->str);
}

/***********************************************************************
 *      StreamGetChar
 ***********************************************************************
 * SYNOPSIS:        Get char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

long StreamGetChar(Stream *str)
{

    switch (str->kind)
    {

        case strFile:
            return FStreamGetChar(str);

        case strSubStream:
            return StreamGetChar(str->str);

        case strLZW:
            return LZWStreamGetChar(str);

        case strFlate:
            return FlateStreamGetChar(str);

        case strObjStmCache:
            return ObjStmCacheStreamGetChar(str);

        case strDCT:
            return DCTStreamGetChar(str);

        case strASCIIHex:
            return ASCIIHexStreamGetChar(str);

        case strASCII85:
            return ASCII85StreamGetChar(str);

        case strRunLength:
            return RunLengthStreamGetChar(str);

        case strCCITTFax:
            return CCITTFaxStreamGetChar(str);

        case strEOF:
            return EOFStreamGetChar(str);

        case strRC4:
            return RC4StreamGetChar(str);

        case strPredictor:
            return PredictorStreamGetChar(str);
    }

    EC_ERROR(-1);
    return EOF;
}

/***********************************************************************
 *      StreamRead
 ***********************************************************************
 * SYNOPSIS:        Read.
 * PARAMETERS:      Stream *str    string
 *                  Guchar *buf    buffer
 *                  word size    size
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

word StreamRead(Stream *str, Guchar *buf, word size)
{
    word n;
    long c;

    if (size == 0)
    {
        return 0;
    }

    if (str->kind == strFlate)
    {
        return FlateStreamRead(str, buf, size);
    }

    if (str->kind == strPredictor)
    {
        return PredictorStreamRead(str, buf, size);
    }

    if (str->kind == strObjStmCache)
    {
        for (n = 0; n < size; ++n)
        {
            c = ObjStmCacheStreamGetChar(str);
            if (c == EOF)
            {
                break;
            }
            buf[n] = (Guchar)c;
        }
        return n;
    }

    if (str->kind == strSubStream)
    {
        return StreamRead(str->str, buf, size);
    }

    for (n = 0; n < size; ++n)
    {
        c = StreamGetChar(str);
        if (c == EOF)
        {
            break;
        }
        buf[n] = (Guchar)c;
    }
    return n;
}

/***********************************************************************
 *      StreamLookChar
 ***********************************************************************
 * SYNOPSIS:        Process stream look char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *

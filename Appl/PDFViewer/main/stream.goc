/*
 * FlateStream: thin wrapper around the zlib library. The z_stream and both
 * buffers live in one heap block (process stack is only 3000 bytes);
 * zlib's own state (32 KB window + tables, fixed malloc memory) is only
 * held while the stream is actually being read: the parser creates a
 * filter chain for every stream object it meets, most of them are never
 * read or only briefly.
 */
#define flateInBufSize 1024     /* compressed bytes per StreamRead */
#define flateReadBufSize 256    /* GetChar/LookChar cache */
#define flateWindowBits 15      /* PDF writers use the full 32 KB window */

typedef struct FlateData
{
    z_stream strm;
    GBool zInit;        /* strm holds zlib state (window allocated) */
    GBool eof;          /* zlib stream ended (or failed) */
    GBool inEof;        /* no more compressed input */
    word readIndex;
    word readCount;
    Guchar inBuf[flateInBufSize];
    Guchar readBuf[flateReadBufSize];
} FlateData;

#define PDF_MAX_CCITT_COLUMNS 32765L
#define PDF_MAX_PREDICTOR_VALUES 32760L

#define headerSearchSize 1024  /* read this many bytes at beginning of */
/* file to look for '%PDF' */


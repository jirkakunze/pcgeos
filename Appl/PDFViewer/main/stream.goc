 ***********************************************************************
 * SYNOPSIS:        Initialize.
 * PARAMETERS:      Stream *str    string
 *                  Stream *str1    str1
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void RunLengthStreamInit(Stream *str, Stream *str1)
{
    StreamInit(str);
    str->str = str1;

    str->kind = strRunLength;
    str->u.runLength = gmalloc(sizeof (RunLengthData));
    if (!str->u.runLength)
    {
        EOFStreamInit(str, str1);
        return;
    }

    str->u.runLength->bufPtr = str->u.runLength->bufEnd = str->u.runLength->buf;
    str->eof = gFalse;
}

/***********************************************************************
 *      RunLengthStreamFree
 ***********************************************************************
 * SYNOPSIS:        Release.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void RunLengthStreamFree(Stream *str)
{
    gfree(str->u.runLength);
}

/***********************************************************************
 *      RunLengthStreamReset
 ***********************************************************************
 * SYNOPSIS:        Reset.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void RunLengthStreamReset(Stream *str)
{
    StreamReset(str->str);

    str->u.runLength->bufPtr = str->u.runLength->bufEnd = str->u.runLength->buf;
    str->eof = gFalse;
}

/***********************************************************************
 *      RunLengthStreamFillBuf
 ***********************************************************************
 * SYNOPSIS:        Fill buffer.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static GBool RunLengthStreamFillBuf(Stream *str)
{
    RunLengthData *pRun = str->u.runLength;
    long c;
    short n, i;

    if (str->eof)
    {
        return gFalse;
    }
    c = StreamGetChar(str->str);
    if (c == 0x80 || c == EOF)
    {
        str->eof = gTrue;
        return gFalse;
    }
    if (c < 0x80)
    {
        n = c + 1;
        for (i = 0; i < n; ++i)
        {
            pRun->buf[i] = (char)StreamGetChar(str->str);
        }
    }
    else
    {
        n = 0x101 - c;
        c = StreamGetChar(str->str);
        for (i = 0; i < n; ++i)
        {
            pRun->buf[i] = (char)c;
        }
    }
    pRun->bufPtr = pRun->buf;
    pRun->bufEnd = pRun->buf + n;
    return gTrue;
}

/***********************************************************************
 *      RunLengthStreamGetChar
 ***********************************************************************
 * SYNOPSIS:        Get char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long RunLengthStreamGetChar(Stream *str)
{
    RunLengthData *pRun = str->u.runLength;

    return(pRun->bufPtr >= pRun->bufEnd && !RunLengthStreamFillBuf(str)) ?
        EOF : (*pRun->bufPtr++ & 0xff);
}

/***********************************************************************
 *      RunLengthStreamLookChar
 ***********************************************************************
 * SYNOPSIS:        Process run length stream look char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long RunLengthStreamLookChar(Stream *str)
{
    RunLengthData *pRun = str->u.runLength;

    return(pRun->bufPtr >= pRun->bufEnd && !RunLengthStreamFillBuf(str)) ?
        EOF : (*pRun->bufPtr & 0xff);
}

/* CCITTFaxStream */

#ifdef __BORLANDC__
#pragma codeseg CCITTFaxStream
#endif
#ifdef __WATCOMC__
#pragma code_seg("CCITTFaxStream")
#endif

/***********************************************************************
 *      CCITTFaxStreamInit
 ***********************************************************************
 * SYNOPSIS:        Initialize.
 * PARAMETERS:      Stream *str    string
 *                  Stream *str1    str1
 *                  long encoding1    encoding1
 *                  GBool byteAlign1    byte align1
 *                  long columns1    columns1
 *                  long rows1    rows1
 *                  GBool black1    black1
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void CCITTFaxStreamInit(Stream *str, Stream *str1, long encoding1,
    GBool byteAlign1, long columns1, long rows1, GBool black1)
{

    CCITTFaxData *pfax;

    StreamInit(str);
    str->str = str1;

    str->kind = strCCITTFax;
    pfax = str->u.fax = gmalloc(sizeof (CCITTFaxData));
    if (!pfax)
    {
        EOFStreamInit(str, str1);
        return;
    }

    pfax->encoding = encoding1;
    pfax->byteAlign = byteAlign1;
    pfax->columns = columns1;
    pfax->rows = rows1;
    pfax->black = black1;
    pfax->refLine = (short *)gmalloc((pfax->columns + 2) * sizeof(short));
    pfax->codingLine = (short *)gmalloc((pfax->columns + 2) * sizeof(short));
    if (!pfax->refLine || !pfax->codingLine)
    {
        gfree(pfax->refLine);
        gfree(pfax->codingLine);
        gfree(pfax);
        str->u.fax = NULL;
        EOFStreamInit(str, str1);
        return;
    }

    str->eof = gFalse;
    pfax->nextLine2D = pfax->encoding < 0;
    pfax->inputBits = 0;
    pfax->codingLine[0] = 0;
    pfax->codingLine[1] = pfax->refLine[2] = columns1;
    pfax->a0 = 1;

    pfax->buf = EOF;
}

/***********************************************************************
 *      CCITTFaxStreamFree
 ***********************************************************************
 * SYNOPSIS:        Release.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void CCITTFaxStreamFree(Stream *str)
{
    gfree(str->u.fax->refLine);
    gfree(str->u.fax->codingLine);
    gfree(str->u.fax);
}

/***********************************************************************
 *      CCITTFaxStreamReset
 ***********************************************************************
 * SYNOPSIS:        Reset.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void CCITTFaxStreamReset(Stream *str)
{
    CCITTFaxData *pfax = str->u.fax;

    StreamReset(str->str);
    str->eof = gFalse;

    pfax->nextLine2D = pfax->encoding < 0;
    pfax->inputBits = 0;
    if ((CCITTFaxStreamLook13Bits(str) >> 1) == 0x001)
    {
        CCITTFaxStreamEatBits(str, 12);
    }
    pfax->codingLine[0] = 0;
    pfax->codingLine[1] = pfax->refLine[2] = pfax->columns;
    pfax->a0 = 1;
    pfax->buf = EOF;
}

/***********************************************************************
 *      CCITTFaxStreamLookChar
 ***********************************************************************
 * SYNOPSIS:        Process ccittfax stream look char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long CCITTFaxStreamLookChar(Stream *str)
{
    CCITTFaxData *pfax = str->u.fax;
    long a0New;
    long ret;
    long bits, i;
    short code1, code2, code3;

    if (str->eof && pfax->codingLine[pfax->a0] >= pfax->columns)
    {
        return EOF;
    }

    if (pfax->codingLine[pfax->a0] >= pfax->columns)
    {

        i = CCITTFaxStreamLook13Bits(str);
        if (i == EOF || (i >> 1) == 0x001)
        {
            str->eof = gTrue;
            pfax->codingLine[pfax->a0 = 0] = pfax->columns;
            return EOF;
        }

        /* 2-D encoding */
        if (pfax->nextLine2D)
        {
            for (i = 0; pfax->codingLine[i] < pfax->columns; ++i)
            {
                pfax->refLine[i] = pfax->codingLine[i];
            }
            pfax->refLine[i] = pfax->refLine[i + 1] = pfax->columns;
            pfax->b1 = 1;
            a0New = pfax->codingLine[pfax->a0 = 0] = 0;
            do
            {
                code1 = CCITTFaxStreamGetTwoDimCode(str);
                switch (code1)
                {
                    case twoDimPass:
                        if (pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            a0New = pfax->refLine[pfax->b1 + 1];
                            pfax->b1 += 2;
                        }
                        break;
                    case twoDimHoriz:
                        if ((pfax->a0 & 1) == 0)
                        {
                            code1 = code2 = 0;
                            do
                            {
                                code1 += code3 =
                                    CCITTFaxStreamGetWhiteCode(str);
                            }
                            while (code3 >= 64);
                            do
                            {
                                code2 += code3 =
                                    CCITTFaxStreamGetBlackCode(str);
                            }
                            while (code3 >= 64);
                        }
                        else
                        {
                            code1 = code2 = 0;
                            do
                            {
                                code1 += code3 =
                                    CCITTFaxStreamGetBlackCode(str);
                            }
                            while (code3 >= 64);
                            do
                            {
                                code2 += code3 =
                                    CCITTFaxStreamGetWhiteCode(str);
                            }
                            while (code3 >= 64);
                        }
                        pfax->codingLine[pfax->a0 + 1] = a0New + code1;
                        ++pfax->a0;
                        a0New = pfax->codingLine[pfax->a0 + 1] =
                            pfax->codingLine[pfax->a0] + code2;
                        ++pfax->a0;
                        while (
                            pfax->refLine[pfax->b1] <=
                            pfax->codingLine[pfax->a0] &&
                            pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            pfax->b1 += 2;
                        }
                        break;
                    case twoDimVert0:
                        a0New = pfax->codingLine[++pfax->a0] =
                            pfax->refLine[pfax->b1];
                        if (pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            ++pfax->b1;
                            while (
                                pfax->refLine[pfax->b1] <=
                                pfax->codingLine[pfax->a0] &&
                                pfax->refLine[pfax->b1] < pfax->columns)
                            {
                                pfax->b1 += 2;
                            }
                        }
                        break;
                    case twoDimVertR1:
                        a0New = pfax->codingLine[++pfax->a0] =
                            pfax->refLine[pfax->b1] + 1;
                        if (pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            ++pfax->b1;
                            while (
                                pfax->refLine[pfax->b1] <=
                                pfax->codingLine[pfax->a0] &&
                                pfax->refLine[pfax->b1] < pfax->columns)
                            {
                                pfax->b1 += 2;
                            }
                        }
                        break;
                    case twoDimVertL1:
                        a0New = pfax->codingLine[++pfax->a0] =
                            pfax->refLine[pfax->b1] - 1;
                        --pfax->b1;
                        while (
                            pfax->refLine[pfax->b1] <=
                            pfax->codingLine[pfax->a0] &&
                            pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            pfax->b1 += 2;
                        }
                        break;
                    case twoDimVertR2:
                        a0New = pfax->codingLine[++pfax->a0] =
                            pfax->refLine[pfax->b1] + 2;
                        if (pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            ++pfax->b1;
                            while (
                                pfax->refLine[pfax->b1] <=
                                pfax->codingLine[pfax->a0] &&
                                pfax->refLine[pfax->b1] < pfax->columns)
                            {
                                pfax->b1 += 2;
                            }
                        }
                        break;
                    case twoDimVertL2:
                        a0New = pfax->codingLine[++pfax->a0] =
                            pfax->refLine[pfax->b1] - 2;
                        --pfax->b1;
                        while (
                            pfax->refLine[pfax->b1] <=
                            pfax->codingLine[pfax->a0] &&
                            pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            pfax->b1 += 2;
                        }
                        break;
                    case twoDimVertR3:
                        a0New = pfax->codingLine[++pfax->a0] =
                            pfax->refLine[pfax->b1] + 3;
                        if (pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            ++pfax->b1;
                            while (
                                pfax->refLine[pfax->b1] <=
                                pfax->codingLine[pfax->a0] &&
                                pfax->refLine[pfax->b1] < pfax->columns)
                            {
                                pfax->b1 += 2;
                            }
                        }
                        break;
                    case twoDimVertL3:
                        a0New = pfax->codingLine[++pfax->a0] =
                            pfax->refLine[pfax->b1] - 3;
                        --pfax->b1;
                        while (
                            pfax->refLine[pfax->b1] <=
                            pfax->codingLine[pfax->a0] &&
                            pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            pfax->b1 += 2;
                        }
                        break;
                    case EOF:
                        str->eof = gTrue;
                        pfax->codingLine[pfax->a0 = 0] = pfax->columns;
                        return EOF;
                    default:
                        EC_WARNING(-1);

                        return EOF;
                }
            }
            while (pfax->codingLine[pfax->a0] < pfax->columns);

            /* 1-D encoding */
        }
        else
        {
            pfax->codingLine[pfax->a0 = 0] = 0;
            while (1)
            {
                code1 = 0;
                do
                {
                    code1 += code3 = CCITTFaxStreamGetWhiteCode(str);
                }
                while (code3 >= 64);
                pfax->codingLine[pfax->a0 + 1] =
                    pfax->codingLine[pfax->a0] + code1;
                ++pfax->a0;
                if (pfax->codingLine[pfax->a0] >= pfax->columns)
                {
                    break;
                }
                code2 = 0;
                do
                {
                    code2 += code3 = CCITTFaxStreamGetBlackCode(str);
                }
                while (code3 >= 64);
                pfax->codingLine[pfax->a0 + 1] =
                    pfax->codingLine[pfax->a0] + code2;
                ++pfax->a0;
                if (pfax->codingLine[pfax->a0] >= pfax->columns)
                {
                    break;
                }
            }
        }

        if (pfax->codingLine[pfax->a0] != pfax->columns)
        {
            EC_WARNING(-1);
        }

        code1 = CCITTFaxStreamLook13Bits(str);
        if ((code1 >> 1) == 0x001)
        {
            CCITTFaxStreamEatBits(str, 12);
            if (pfax->encoding > 0)
            {
                CCITTFaxStreamEatBits(str, 1);
                pfax->nextLine2D = !(code1 & 1);
            }
        }

        pfax->a0 = 0;
        pfax->outputBits = pfax->codingLine[1] - pfax->codingLine[0];
    }

    if (pfax->outputBits >= 8)
    {
        ret = ((pfax->a0 & 1) == 0) ? 0xff : 0x00;
        if ((pfax->outputBits -= 8) == 0)
        {
            ++pfax->a0;
            if (pfax->codingLine[pfax->a0] < pfax->columns)
            {
                pfax->outputBits =
                    pfax->codingLine[pfax->a0 + 1] - pfax->codingLine[pfax->a0];
            }
        }
    }
    else
    {
        bits = 8;
        ret = 0;
        do
        {
            if (pfax->outputBits > bits)
            {
                i = bits;
                bits = 0;
                if ((pfax->a0 & 1) == 0)
                {
                    ret |= 0xff >> (8 - i);
                }
                pfax->outputBits -= i;
            }
            else
            {
                i = pfax->outputBits;
                bits -= pfax->outputBits;
                if ((pfax->a0 & 1) == 0)
                {
                    ret |= (0xff >> (8 - i)) << bits;
                }
                pfax->outputBits = 0;
                ++pfax->a0;
                if (pfax->codingLine[pfax->a0] < pfax->columns)
                {
                    pfax->outputBits =
                        pfax->codingLine[pfax->a0 + 1] -
                        pfax->codingLine[pfax->a0];
                }
            }
        }
        while (bits > 0 && pfax->codingLine[pfax->a0] < pfax->columns);
    }
    pfax->buf = pfax->black ? (ret ^ 0xff) : ret;
    return pfax->buf;
}

/***********************************************************************
 *      CCITTFaxStreamGetChar
 ***********************************************************************
 * SYNOPSIS:        Get char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long CCITTFaxStreamGetChar(Stream *str)
{
    long c = CCITTFaxStreamLookChar(str);
    str->u.fax->buf = EOF;
    return c;
}

/***********************************************************************
 *      CCITTFaxStreamEatBits
 ***********************************************************************
 * SYNOPSIS:        Process ccittfax stream eat bits.
 * PARAMETERS:      Stream *str    string
 *                  short bits    bits
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void CCITTFaxStreamEatBits(Stream *str, short bits)
{
    str->u.fax->inputBits -= bits;
}

/* Cache these locked pointers in CCITTFaxData during initialization. */

/***********************************************************************
 *      CCITTFaxStreamGetTwoDimCode
 ***********************************************************************
 * SYNOPSIS:        Get two dim code.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static short CCITTFaxStreamGetTwoDimCode(Stream *str)
{
    short code, code0;
    CCITTCode *twoDimTab1;
    CCITTCode *p;
    short retval;

    code0 = CCITTFaxStreamLook13Bits(str);
    code = code0 >> 6;
    if (code == 0x0002)
    {
        CCITTFaxStreamEatBits(str, 7);
        return twoDimVertL3;
    }
    if (code == 0x0003)
    {
        CCITTFaxStreamEatBits(str, 7);
        return twoDimVertR3;
    }
    code >>= 1;
    if (code == 0x0002)
    {
        CCITTFaxStreamEatBits(str, 6);
        return twoDimVertL2;
    }
    if (code == 0x0003)
    {
        CCITTFaxStreamEatBits(str, 6);
        return twoDimVertR2;
    }

    MemLock(OptrToHandle(@twoDimTab1xx));
    twoDimTab1 = LMemDeref(@twoDimTab1xx);

    code >>= 2;
    p = &twoDimTab1[code];
    if (p->bits > 0)
    {
        CCITTFaxStreamEatBits(str, p->bits);
        retval = p->n;
        MemUnlock(OptrToHandle(@twoDimTab1xx));
        return retval;
    }
    MemUnlock(OptrToHandle(@twoDimTab1xx));

    EC_WARNING(-1);

    return EOF;
}

/***********************************************************************
 *      CCITTFaxStreamGetWhiteCode
 ***********************************************************************
 * SYNOPSIS:        Get white code.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static short CCITTFaxStreamGetWhiteCode(Stream *str)
{
    short code, retval;
    CCITTCode *p;
    CCITTCode *whiteTab1, *whiteTab2;

    MemLock(OptrToHandle(@whiteTab1xx));

    code = CCITTFaxStreamLook13Bits(str);
    if ((code >> 6) == 0)
    {
        whiteTab1 = LMemDeref(@whiteTab1xx);
        p = &whiteTab1[code >> 1];
    }
    else
    {
        whiteTab2 = LMemDeref(@whiteTab2xx);
        p = &whiteTab2[code >> 4];
    }
    if (p->bits > 0)
    {
        CCITTFaxStreamEatBits(str, p->bits);
        retval = p->n;
        MemUnlock(OptrToHandle(@whiteTab1xx));
        return retval;
    }

    MemUnlock(OptrToHandle(@whiteTab1xx));
    EC_WARNING(-1);

    return EOF;
}

/***********************************************************************
 *      CCITTFaxStreamGetBlackCode
 ***********************************************************************
 * SYNOPSIS:        Get black code.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static short CCITTFaxStreamGetBlackCode(Stream *str)
{
    short code, retval;
    CCITTCode *p;
    CCITTCode *blackTab1, *blackTab2, *blackTab3;

    MemLock(OptrToHandle(@blackTab1xx));

    code = CCITTFaxStreamLook13Bits(str);
    if ((code >> 7) == 0)
    {
        blackTab1 = LMemDeref(@blackTab1xx);
        p = &blackTab1[code];
    }
    else if ((code >> 9) == 0)
    {
        blackTab2 = LMemDeref(@blackTab2xx);
        p = &blackTab2[(code >> 1) - 64];
    }
    else
    {
        blackTab3 = LMemDeref(@blackTab3xx);
        p = &blackTab3[code >> 7];
    }
    if (p->bits > 0)
    {
        CCITTFaxStreamEatBits(str, p->bits);
        retval = p->n;
        MemUnlock(OptrToHandle(@blackTab1xx));
        return retval;
    }

    MemUnlock(OptrToHandle(@blackTab1xx));
    EC_WARNING(-1);

    return EOF;
}

/***********************************************************************
 *      CCITTFaxStreamLook13Bits
 ***********************************************************************
 * SYNOPSIS:        Process ccittfax stream look13 bits.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static short CCITTFaxStreamLook13Bits(Stream *str)
{
    long c;
    CCITTFaxData *pfax = str->u.fax;

    while (pfax->inputBits < 13)
    {
        if ((c = StreamGetChar(str->str)) == EOF)
        {
            if (pfax->inputBits == 0)
            {
                return EOF;
            }
            c = 0;
        }
        pfax->inputBuf = (pfax->inputBuf << 8) + c;
        pfax->inputBits += 8;
    }
    return(pfax->inputBuf >> (pfax->inputBits - 13)) & 0x1fff;
}

/* DCTStream */

#ifdef __BORLANDC__
#pragma codeseg DCTStream
#endif
#ifdef __WATCOMC__
#pragma code_seg("DCTStream")
#endif

/* IDCT constants (20.12 fixed point format) */
#ifndef FP_IDCT
#define dctCos1    4017
#define dctSin1     799
#define dctCos3    3406
#define dctSin3    2276
#define dctCos6    1567
#define dctSin6    3784
#define dctSqrt2   5793
#define dctSqrt1d2 2896
#endif

/* IDCT constants */
#ifdef FP_IDCT
#define dctCos1    0.98078528
#define dctSin1    0.19509032
#define dctCos3    0.83146961
#define dctSin3    0.55557023
#define dctCos6    0.38268343
#define dctSin6    0.92387953
#define dctSqrt2   1.41421356
#define dctSqrt1d2 0.70710678
#endif

/* color conversion parameters (16.16 fixed point format) */
#define dctCrToR   91881  /* 1.4020 */
#define dctCbToG  -22553  /* -0.3441363 */
#define dctCrToG  -46802  /* -0.71413636 */
#define dctCbToB  116130  /* 1.772 */

#define dctClipOffset 256

static Handle dctClipHandle = 0;

/* zig zag decode map */
static const Guchar dctZigZag[64] = {
    0,
        1, 8,
        16, 9, 2,
        3, 10, 17, 24,
        32, 25, 18, 11, 4,
        5, 12, 19, 26, 33, 40,
        48, 41, 34, 27, 20, 13, 6,
        7, 14, 21, 28, 35, 42, 49, 56,
        57, 50, 43, 36, 29, 22, 15,
        23, 30, 37, 44, 51, 58,
        59, 52, 45, 38, 31,
        39, 46, 53, 60,
        61, 54, 47,
        55, 62,
        63
};

/***********************************************************************
 *      DCTStreamInit
 ***********************************************************************
 * SYNOPSIS:        Initialize.
 * PARAMETERS:      Stream *str    string
 *                  Stream *str1    str1
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void DCTStreamInit(Stream *str, Stream *str1)
{
    DCTData *pdct;
    Guchar *dctClip;
    short i, j;

    StreamInit(str);
    str->str = str1;

    str->kind = strDCT;
    pdct = str->u.dct = gmalloc(sizeof (DCTData));
    if (!pdct)
    {
        EOFStreamInit(str, str1);
        return;
    }

    pdct->width = pdct->height = 0;
    pdct->mcuWidth = pdct->mcuHeight = 0;
    pdct->numComps = 0;
    pdct->comp = 0;
    pdct->x = pdct->y = pdct->dy = 0;
    pdct->lockedRow = -1;
    pdct->idctWorkspaceHandle = NullHandle;
    for (i = 0; i < 4; ++i)
    {
        for (j = 0; j < 32; ++j)
        {
            pdct->rowBufHandle[i][j] = NullHandle;
            pdct->rowBuf[i][j] = NULL;
        }
    }

    pdct->idctWorkspaceHandle = MemAlloc(64 * sizeof(long), HF_SWAPABLE,
        HAF_NO_ERR);
    if (pdct->idctWorkspaceHandle == NullHandle)
    {
        GMemSetError();
        gfree(pdct);
        str->u.dct = NULL;
        EOFStreamInit(str, str1);
        return;
    }

    if (!dctClipHandle)
    {
        /* Allocate & initialize memory. */
        dctClipHandle = MemAlloc(768, HF_SWAPABLE, HAF_NO_ERR);
        if (dctClipHandle == NullHandle)
        {
            GMemSetError();
            MemFree(pdct->idctWorkspaceHandle);
            pdct->idctWorkspaceHandle = NullHandle;
            gfree(pdct);
            str->u.dct = NULL;
            EOFStreamInit(str, str1);
            return;
        }
        EC(ECCheckMemHandle(dctClipHandle));
        dctClip = MemLock(dctClipHandle);

        for (i = -256; i < 0; ++i)
        {
            dctClip[dctClipOffset + i] = 0;
        }
        for (i = 0; i < 256; ++i)
        {
            dctClip[dctClipOffset + i] = i;
        }
        for (i = 256; i < 512; ++i)
        {
            dctClip[dctClipOffset + i] = 255;
        }

        MemUnlock(dctClipHandle);
    }
}

/***********************************************************************
 *      DCTStreamUnlockRows
 ***********************************************************************
 * SYNOPSIS:        Unlock rows.
 * PARAMETERS:      DCTData *pdct    pdct
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void DCTStreamUnlockRows(DCTData *pdct)
{
    short i, j;

    for (i = 0; i < 4; ++i)
    {
        for (j = 0; j < 32; ++j)
        {
            if (pdct->rowBuf[i][j] != NULL)
            {
                MemUnlock(pdct->rowBufHandle[i][j]);
                pdct->rowBuf[i][j] = NULL;
            }
        }
    }
    pdct->lockedRow = -1;
}

/***********************************************************************
 *      DCTStreamLockAllRows
 ***********************************************************************
 * SYNOPSIS:        Lock all rows.
 * PARAMETERS:      DCTData *pdct    pdct
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static GBool DCTStreamLockAllRows(DCTData *pdct)
{
    short i, j;

    DCTStreamUnlockRows(pdct);
    for (i = 0; i < pdct->numComps; ++i)
    {
        for (j = 0; j < pdct->mcuHeight; ++j)
        {
            EC(ECCheckMemHandle(pdct->rowBufHandle[i][j]));
            pdct->rowBuf[i][j] = (Guchar *)MemLock(pdct->rowBufHandle[i][j]);
            if (pdct->rowBuf[i][j] == NULL)
            {
                DCTStreamUnlockRows(pdct);
                return gFalse;
            }
        }
    }
    return gTrue;
}

/***********************************************************************
 *      DCTStreamLockOutputRow
 ***********************************************************************
 * SYNOPSIS:        Lock output row.
 * PARAMETERS:      DCTData *pdct    pdct
 *                  short row    row
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static GBool DCTStreamLockOutputRow(DCTData *pdct, short row)
{
    short i;

    if (pdct->lockedRow == row)
    {
        return gTrue;
    }

    DCTStreamUnlockRows(pdct);
    for (i = 0; i < pdct->numComps; ++i)
    {
        EC(ECCheckMemHandle(pdct->rowBufHandle[i][row]));
        pdct->rowBuf[i][row] = (Guchar *)MemLock(pdct->rowBufHandle[i][row]);
        if (pdct->rowBuf[i][row] == NULL)
        {
            DCTStreamUnlockRows(pdct);
            return gFalse;
        }
    }
    pdct->lockedRow = row;
    return gTrue;
}

/***********************************************************************
 *      DCTStreamFreeRowBuffers
 ***********************************************************************
 * SYNOPSIS:        Release row buffers.
 * PARAMETERS:      DCTData *pdct    pdct
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void DCTStreamFreeRowBuffers(DCTData *pdct)
{
    short i, j;

    DCTStreamUnlockRows(pdct);
    for (i = 0; i < 4; ++i)
    {
        for (j = 0; j < 32; ++j)
        {
            if (pdct->rowBufHandle[i][j] != NullHandle)
            {
                MemFree(pdct->rowBufHandle[i][j]);
                pdct->rowBufHandle[i][j] = NullHandle;
            }
        }
    }
}

/***********************************************************************
 *      DCTStreamFree
 ***********************************************************************
 * SYNOPSIS:        Release.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void DCTStreamFree(Stream *str)
{
    DCTData *pdct = str->u.dct;

    DCTStreamFreeRowBuffers(pdct);
    if (pdct->idctWorkspaceHandle != NullHandle)
    {
        MemFree(pdct->idctWorkspaceHandle);
        pdct->idctWorkspaceHandle = NullHandle;
    }
    gfree(pdct);
}

/***********************************************************************
 *      DCTStreamReset
 ***********************************************************************
 * SYNOPSIS:        Reset.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void DCTStreamReset(Stream *str)
{
    DCTData *pdct = str->u.dct;

    DCTStreamFreeRowBuffers(pdct);
    StreamReset(str->str);
    if (!DCTStreamReadHeader(str))
    {
        pdct->y = pdct->height;
        return;
    }
    pdct->restartMarker = 0xd0;
    DCTStreamRestart(str);
}

/***********************************************************************
 *      DCTStreamLookChar
 ***********************************************************************
 * SYNOPSIS:        Process dctstream look char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long DCTStreamLookChar(Stream *str)
{
    DCTData *pdct = str->u.dct;

    if (pdct->y >= pdct->height)
    {
        return EOF;
    }
    if (pdct->dy >= pdct->mcuHeight)
    {
        DCTStreamUnlockRows(pdct);
        if (!DCTStreamReadMCURow(str))
        {
            pdct->y = pdct->height;
            return EOF;
        }
        pdct->comp = 0;
        pdct->x = 0;
        pdct->dy = 0;
    }
    if (!DCTStreamLockOutputRow(pdct, (short)pdct->dy))
    {
        pdct->y = pdct->height;
        return EOF;
    }
    return pdct->rowBuf[pdct->comp][pdct->dy][pdct->x];
}

/***********************************************************************
 *      DCTStreamGetChar
 ***********************************************************************
 * SYNOPSIS:        Get char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long DCTStreamGetChar(Stream *str)
{
    DCTData *pdct = str->u.dct;
    long c;

    c = DCTStreamLookChar(str);
    if (c == EOF)
    {
        return EOF;
    }
    if (++pdct->comp == pdct->numComps)
    {
        pdct->comp = 0;
        if (++pdct->x == pdct->width)
        {
            pdct->x = 0;
            ++pdct->y;
            ++pdct->dy;
            DCTStreamUnlockRows(pdct);
        }
    }
    if (pdct->y == pdct->height)
    {
        DCTStreamReadTrailer(str);
    }
    return c;
}

/***********************************************************************
 *      DCTStreamRestart
 ***********************************************************************
 * SYNOPSIS:        Process dctstream restart.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void DCTStreamRestart(Stream *str)
{
    DCTData *pdct = str->u.dct;
    short i;

    pdct->inputBits = 0;
    pdct->restartCtr = pdct->restartInterval;
    for (i = 0; i < pdct->numComps; ++i)
    {
        pdct->compInfo[i].prevDC = 0;
    }
}

/***********************************************************************
 *      DCTStreamReadMCURow
 ***********************************************************************
 * SYNOPSIS:        Read mcurow.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static GBool DCTStreamReadMCURow(Stream *str)
{
    DCTData *pdct = str->u.dct;
    Guchar *dctClip;
    Guchar data[64];
    Guchar *p1, *p2;
    long pY, pCb, pCr, pR, pG, pB;
    word h, v, horiz, vert, hSub, vSub;
    long x1, x2, y2, x3, y3, x4, y4, x5, y5, i;
    word cc;
    long c;

    if (!DCTStreamLockAllRows(pdct))
    {
        return gFalse;
    }

    EC(ECCheckMemHandle(dctClipHandle));
    dctClip = MemLock(dctClipHandle);
    if (dctClip == NULL)
    {
        DCTStreamUnlockRows(pdct);
        return gFalse;
    }

    for (x1 = 0; x1 < pdct->width; x1 += pdct->mcuWidth)
    {

        /* deal with restart marker */
        if (pdct->restartInterval > 0 && pdct->restartCtr == 0)
        {
            c = DCTStreamReadMarker(str);
            if (c != pdct->restartMarker)
            {
                EC_WARNING(-1);

                MemUnlock(dctClipHandle);
                DCTStreamUnlockRows(pdct);
                return gFalse;
            }
            if (++pdct->restartMarker == 0xd8)
            {
                pdct->restartMarker = 0xd0;
            }
            DCTStreamRestart(str);
        }

        for (cc = 0; cc < pdct->numComps; ++cc)
        {
            h = pdct->compInfo[cc].hSample;
            v = pdct->compInfo[cc].vSample;
            horiz = pdct->mcuWidth / h;
            vert = pdct->mcuHeight / v;
            hSub = horiz >> 3;
            vSub = vert >> 3;
            for (y2 = 0; y2 < pdct->mcuHeight; y2 += vert)
            {
                for (x2 = 0; x2 < pdct->mcuWidth; x2 += horiz)
                {
                    if (!DCTStreamReadDataUnit(str,
                        &pdct->dcHuffTables[pdct->compInfo[cc].dcHuffTable],
                        &pdct->acHuffTables[pdct->compInfo[cc].acHuffTable],
                        &pdct->quantTables[pdct->compInfo[cc].quantTable],
                        &pdct->compInfo[cc].prevDC,
                        &data))
                    {
                        MemUnlock(dctClipHandle);
                        DCTStreamUnlockRows(pdct);
                        return gFalse;
                    }
                    if (hSub == 1 && vSub == 1)
                    {
                        for (y3 = 0, i = 0; y3 < 8; ++y3, i += 8)
                        {
                            p1 = &pdct->rowBuf[cc][y2 + y3][x1 + x2];
                            p1[0] = data[i];
                            p1[1] = data[i + 1];
                            p1[2] = data[i + 2];
                            p1[3] = data[i + 3];
                            p1[4] = data[i + 4];
                            p1[5] = data[i + 5];
                            p1[6] = data[i + 6];
                            p1[7] = data[i + 7];
                        }
                    }
                    else if (hSub == 2 && vSub == 2)
                    {
                        for (y3 = 0, i = 0; y3 < 16; y3 += 2, i += 8)
                        {
                            p1 = &pdct->rowBuf[cc][y2 + y3][x1 + x2];
                            p2 = &pdct->rowBuf[cc][y2 + y3 + 1][x1 + x2];
                            p1[0] = p1[1] = p2[0] = p2[1] = data[i];
                            p1[2] = p1[3] = p2[2] = p2[3] = data[i + 1];
                            p1[4] = p1[5] = p2[4] = p2[5] = data[i + 2];
                            p1[6] = p1[7] = p2[6] = p2[7] = data[i + 3];
                            p1[8] = p1[9] = p2[8] = p2[9] = data[i + 4];
                            p1[10] = p1[11] = p2[10] = p2[11] = data[i + 5];
                            p1[12] = p1[13] = p2[12] = p2[13] = data[i + 6];
                            p1[14] = p1[15] = p2[14] = p2[15] = data[i + 7];
                        }
                    }
                    else
                    {
                        i = 0;
                        for (y3 = 0, y4 = 0; y3 < 8; ++y3, y4 += vSub)
                        {
                            for (x3 = 0, x4 = 0; x3 < 8; ++x3, x4 += hSub)
                            {
                                for (y5 = 0; y5 < vSub; ++y5)
                                {
                                    for (x5 = 0; x5 < hSub; ++x5)
                                    {
                                        pdct->rowBuf[cc][y2 + y4 + y5]
                                        [x1 + x2 + x4 + x5] =
                                            data[i];
                                    }
                                }
                                ++i;
                            }
                        }
                    }
                }
            }
        }
        --pdct->restartCtr;

        /* color space conversion */
        if (pdct->colorXform)
        {
            /* convert YCbCr to RGB */
            if (pdct->numComps == 3)
            {
                for (y2 = 0; y2 < pdct->mcuHeight; ++y2)
                {
                    for (x2 = 0; x2 < pdct->mcuWidth; ++x2)
                    {
                        pY = pdct->rowBuf[0][y2][x1 + x2];
                        pCb = pdct->rowBuf[1][y2][x1 + x2] - 128;
                        pCr = pdct->rowBuf[2][y2][x1 + x2] - 128;
                        pR = ((pY << 16) + dctCrToR *pCr + 32768) >> 16;
                        pdct->rowBuf[0][y2][x1 + x2] =
                            dctClip[dctClipOffset + pR];
                        pG =
                            ((pY << 16) + dctCbToG *pCb +
                            dctCrToG *pCr + 32678) >> 16;
                        pdct->rowBuf[1][y2][x1 + x2] =
                            dctClip[dctClipOffset + pG];
                        pB = ((pY << 16) + dctCbToB *pCb + 32768) >> 16;
                        pdct->rowBuf[2][y2][x1 + x2] =
                            dctClip[dctClipOffset + pB];
                    }
                }
                /* convert YCbCrK to CMYK (K is passed through unchanged) */
            }
            else if (pdct->numComps == 4)
            {
                for (y2 = 0; y2 < pdct->mcuHeight; ++y2)
                {
                    for (x2 = 0; x2 < pdct->mcuWidth; ++x2)
                    {
                        pY = pdct->rowBuf[0][y2][x1 + x2];
                        pCb = pdct->rowBuf[1][y2][x1 + x2] - 128;
                        pCr = pdct->rowBuf[2][y2][x1 + x2] - 128;
                        pR = ((pY << 16) + dctCrToR *pCr + 32768) >> 16;
                        pdct->rowBuf[0][y2][x1 + x2] =
                            255 - dctClip[dctClipOffset + pR];
                        pG =
                            ((pY << 16) + dctCbToG *pCb +
                            dctCrToG *pCr + 32678) >> 16;
                        pdct->rowBuf[1][y2][x1 + x2] =
                            255 - dctClip[dctClipOffset + pG];
                        pB = ((pY << 16) + dctCbToB *pCb + 32768) >> 16;
                        pdct->rowBuf[2][y2][x1 + x2] =
                            255 - dctClip[dctClipOffset + pB];
                    }
                }
            }
        }
    }
    MemUnlock(dctClipHandle);
    DCTStreamUnlockRows(pdct);
    return gTrue;
}

/* This IDCT algorithm is taken from: */
/* Christoph Loeffler, Adriaan Ligtenberg, George S. */
/* "Practical Fast 1-D DCT Algorithms with 11 Multiplications", */
/* IEEE Intl. */
/* 988-991. */
/* The stage numbers mentioned in the comments refer to Figure 1 in this */
/* paper. */
#ifndef FP_IDCT
/***********************************************************************
 *      DCTStreamReadDataUnit
 ***********************************************************************
 * SYNOPSIS:        Read data unit.
 * PARAMETERS:      Stream *str    string
 *                  DCTHuffTable *dcHuffTable    dc huff table
 *                  DCTHuffTable *acHuffTable    ac huff table
 *                  Guchar *quantTable    quant table
 *                  long *prevDC    prev dc
 *                  Guchar *data    data
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

GBool DCTStreamReadDataUnit(Stream *str, DCTHuffTable *dcHuffTable,
    DCTHuffTable *acHuffTable,
    Guchar *quantTable, long *prevDC,
    Guchar *data)
{
    DCTData *pdct = str->u.dct;
    Guchar *dctClip;
    long *tmp1;
    GBool result = gFalse;
    long v0, v1, v2, v3, v4, v5, v6, v7, t;
    long run, size, amp;
    long c;
    short i, j;

    EC(ECCheckMemHandle(pdct->idctWorkspaceHandle));
    tmp1 = (long *)MemLock(pdct->idctWorkspaceHandle);
    if (tmp1 == NULL)
    {
        return gFalse;
    }

    /* Huffman decode and dequantize */
    size = DCTStreamReadHuffSym(str, dcHuffTable);
    if (size == 9999)
    {
        goto done;
    }
    /*
     * size is a raw byte straight out of the JPEG file's own Huffman table
     * definition (DHT marker).
     */
    if (size < 0 || size > 16)
    {
        EC_WARNING(-1);
        goto done;
    }
    if (size > 0)
    {
        amp = DCTStreamReadAmp(str, size);
        if (amp == 9999)
        {
            goto done;
        }
    }
    else
    {
        amp = 0;
    }
    tmp1[0] = (*prevDC += amp) * quantTable[0];
    for (i = 1; i < 64; ++i)
    {
        tmp1[i] = 0;
    }
    i = 1;
    while (i < 64)
    {
        run = 0;
        while ((c = DCTStreamReadHuffSym(str, acHuffTable)) == 0xf0
            && run < 0x30)
        {
            run += 0x10;
        }
        if (c == 9999)
        {
            goto done;
        }
        if (c == 0x00)
        {
            break;
        }
        else
        {
            run += (c >> 4) & 0x0f;
            size = c & 0x0f;
            amp = DCTStreamReadAmp(str, size);
            if (amp == 9999)
            {
                goto done;
            }
            if (run > 63 - i)
            {
                EC_WARNING(-1);
                goto done;
            }
            i += run;
            j = dctZigZag[i++];
            tmp1[j] = amp *quantTable[j];
        }
    }

    /* inverse DCT on rows */
    for (i = 0; i < 64; i += 8)
    {

        /* stage 4 */
        v0 = (dctSqrt2 * tmp1[i + 0] + 128) >> 8;
        v1 = (dctSqrt2 * tmp1[i + 4] + 128) >> 8;
        v2 = tmp1[i + 2];
        v3 = tmp1[i + 6];
        v4 = (dctSqrt1d2 * (tmp1[i + 1] - tmp1[i + 7]) + 128) >> 8;
        v7 = (dctSqrt1d2 * (tmp1[i + 1] + tmp1[i + 7]) + 128) >> 8;
        v5 = tmp1[i + 3] << 4;
        v6 = tmp1[i + 5] << 4;

        /* stage 3 */
        t = (v0 - v1 + 1) >> 1;
        v0 = (v0 + v1 + 1) >> 1;
        v1 = t;
        t = (v2 * dctSin6 + v3 * dctCos6 + 128) >> 8;
        v2 = (v2 * dctCos6 - v3 * dctSin6 + 128) >> 8;
        v3 = t;
        t = (v4 - v6 + 1) >> 1;
        v4 = (v4 + v6 + 1) >> 1;
        v6 = t;
        t = (v7 + v5 + 1) >> 1;
        v5 = (v7 - v5 + 1) >> 1;
        v7 = t;

        /* stage 2 */
        t = (v0 - v3 + 1) >> 1;
        v0 = (v0 + v3 + 1) >> 1;
        v3 = t;
        t = (v1 - v2 + 1) >> 1;
        v1 = (v1 + v2 + 1) >> 1;
        v2 = t;
        t = (v4 * dctSin3 + v7 * dctCos3 + 2048) >> 12;
        v4 = (v4 * dctCos3 - v7 * dctSin3 + 2048) >> 12;
        v7 = t;
        t = (v5 * dctSin1 + v6 * dctCos1 + 2048) >> 12;
        v5 = (v5 * dctCos1 - v6 * dctSin1 + 2048) >> 12;
        v6 = t;

        /* stage 1 */
        tmp1[i + 0] = v0 + v7;
        tmp1[i + 7] = v0 - v7;
        tmp1[i + 1] = v1 + v6;
        tmp1[i + 6] = v1 - v6;
        tmp1[i + 2] = v2 + v5;
        tmp1[i + 5] = v2 - v5;
        tmp1[i + 3] = v3 + v4;
        tmp1[i + 4] = v3 - v4;
    }

    /* inverse DCT on columns */
    for (i = 0; i < 8; ++i)
    {

        /* stage 4 */
        v0 = (dctSqrt2 * tmp1[0 * 8 + i] + 2048) >> 12;
        v1 = (dctSqrt2 * tmp1[4 * 8 + i] + 2048) >> 12;
        v2 = tmp1[2 * 8 + i];
        v3 = tmp1[6 * 8 + i];
        v4 = (dctSqrt1d2 * (tmp1[1 * 8 + i] - tmp1[7 * 8 + i]) + 2048) >> 12;
        v7 = (dctSqrt1d2 * (tmp1[1 * 8 + i] + tmp1[7 * 8 + i]) + 2048) >> 12;
        v5 = tmp1[3 * 8 + i];
        v6 = tmp1[5 * 8 + i];

        /* stage 3 */
        t = (v0 - v1 + 1) >> 1;
        v0 = (v0 + v1 + 1) >> 1;
        v1 = t;
        t = (v2 * dctSin6 + v3 * dctCos6 + 2048) >> 12;
        v2 = (v2 * dctCos6 - v3 * dctSin6 + 2048) >> 12;
        v3 = t;
        t = (v4 - v6 + 1) >> 1;
        v4 = (v4 + v6 + 1) >> 1;
        v6 = t;
        t = (v7 + v5 + 1) >> 1;
        v5 = (v7 - v5 + 1) >> 1;
        v7 = t;

        /* stage 2 */
        t = (v0 - v3 + 1) >> 1;
        v0 = (v0 + v3 + 1) >> 1;
        v3 = t;
        t = (v1 - v2 + 1) >> 1;
        v1 = (v1 + v2 + 1) >> 1;
        v2 = t;
        t = (v4 * dctSin3 + v7 * dctCos3 + 2048) >> 12;
        v4 = (v4 * dctCos3 - v7 * dctSin3 + 2048) >> 12;
        v7 = t;
        t = (v5 * dctSin1 + v6 * dctCos1 + 2048) >> 12;
        v5 = (v5 * dctCos1 - v6 * dctSin1 + 2048) >> 12;
        v6 = t;

        /* stage 1 */
        tmp1[0 * 8 + i] = v0 + v7;
        tmp1[7 * 8 + i] = v0 - v7;
        tmp1[1 * 8 + i] = v1 + v6;
        tmp1[6 * 8 + i] = v1 - v6;
        tmp1[2 * 8 + i] = v2 + v5;
        tmp1[5 * 8 + i] = v2 - v5;
        tmp1[3 * 8 + i] = v3 + v4;
        tmp1[4 * 8 + i] = v3 - v4;
    }

    /* convert to 8-bit integers */
    EC(ECCheckMemHandle(dctClipHandle));
    dctClip = MemLock(dctClipHandle);

    for (i = 0; i < 64; ++i)
    {
        data[i] = dctClip[dctClipOffset + 128 + ((tmp1[i] + 8) >> 4)];
    }

    MemUnlock(dctClipHandle);
    result = gTrue;

    done:
    MemUnlock(pdct->idctWorkspaceHandle);
    return result;
}
#endif

#ifdef FP_IDCT
/***********************************************************************
 *      readDataUnit
 ***********************************************************************
 * SYNOPSIS:        Read data unit.
 * PARAMETERS:      DCTHuffTable *dcHuffTable    dc huff table
 *                  DCTHuffTable *acHuffTable    ac huff table
 *                  Guchar quantTable[64]    quant table
 *                  int *prevDC    prev dc
 *                  Guchar data[64]    data
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

GBool DCTStream::readDataUnit(DCTHuffTable *dcHuffTable,
    DCTHuffTable *acHuffTable, Guchar quantTable[64], int *prevDC, Guchar data[64])
{
    double tmp1[64];
    double v0, v1, v2, v3, v4, v5, v6, v7, t;
    int run, size, amp;
    int c;
    int i, j;

    /* Huffman decode and dequantize */
    size = readHuffSym(dcHuffTable);
    if (size == 9999)
    {
        return gFalse;
    }
    if (size > 0)
    {
        amp = readAmp(size);
        if (amp == 9999)
        {
            return gFalse;
        }
    }
    else
    {
        amp = 0;
    }
    tmp1[0] = (*prevDC += amp) * quantTable[0];
    for (i = 1; i < 64; ++i)
    {
        tmp1[i] = 0;
    }
    i = 1;
    while (i < 64)
    {
        run = 0;
        while ((c = readHuffSym(acHuffTable)) == 0xf0 && run < 0x30)
        {
            run += 0x10;
        }
        if (c == 9999)
        {
            return gFalse;
        }
        if (c == 0x00)
        {
            break;
        }
        else
        {
            run += (c >> 4) & 0x0f;
            size = c & 0x0f;
            amp = readAmp(size);
            if (amp == 9999)
            {
                return gFalse;
            }
            if (run > 63 - i)
            {
                return gFalse;
            }
            i += run;
            j = dctZigZag[i++];
            tmp1[j] = amp *quantTable[j];
        }
    }

    /* inverse DCT on rows */
    for (i = 0; i < 64; i += 8)
    {

        /* stage 4 */
        v0 = dctSqrt2 * tmp1[i + 0];
        v1 = dctSqrt2 * tmp1[i + 4];
        v2 = tmp1[i + 2];
        v3 = tmp1[i + 6];
        v4 = dctSqrt1d2 * (tmp1[i + 1] - tmp1[i + 7]);
        v7 = dctSqrt1d2 * (tmp1[i + 1] + tmp1[i + 7]);
        v5 = tmp1[i + 3];
        v6 = tmp1[i + 5];

        /* stage 3 */
        t = 0.5 * (v0 - v1);
        v0 = 0.5 * (v0 + v1);
        v1 = t;
        t = v2 * dctSin6 + v3 * dctCos6;
        v2 = v2 * dctCos6 - v3 * dctSin6;
        v3 = t;
        t = 0.5 * (v4 - v6);
        v4 = 0.5 * (v4 + v6);
        v6 = t;
        t = 0.5 * (v7 + v5);
        v5 = 0.5 * (v7 - v5);
        v7 = t;

        /* stage 2 */
        t = 0.5 * (v0 - v3);
        v0 = 0.5 * (v0 + v3);
        v3 = t;
        t = 0.5 * (v1 - v2);
        v1 = 0.5 * (v1 + v2);
        v2 = t;
        t = v4 * dctSin3 + v7 * dctCos3;
        v4 = v4 * dctCos3 - v7 * dctSin3;
        v7 = t;
        t = v5 * dctSin1 + v6 * dctCos1;
        v5 = v5 * dctCos1 - v6 * dctSin1;
        v6 = t;

        /* stage 1 */
        tmp1[i + 0] = v0 + v7;
        tmp1[i + 7] = v0 - v7;
        tmp1[i + 1] = v1 + v6;
        tmp1[i + 6] = v1 - v6;
        tmp1[i + 2] = v2 + v5;
        tmp1[i + 5] = v2 - v5;
        tmp1[i + 3] = v3 + v4;
        tmp1[i + 4] = v3 - v4;
    }

    /* inverse DCT on columns */
    for (i = 0; i < 8; ++i)
    {

        /* stage 4 */
        v0 = dctSqrt2 * tmp1[0 * 8 + i];
        v1 = dctSqrt2 * tmp1[4 * 8 + i];
        v2 = tmp1[2 * 8 + i];
        v3 = tmp1[6 * 8 + i];
        v4 = dctSqrt1d2 * (tmp1[1 * 8 + i] - tmp1[7 * 8 + i]);
        v7 = dctSqrt1d2 * (tmp1[1 * 8 + i] + tmp1[7 * 8 + i]);
        v5 = tmp1[3 * 8 + i];
        v6 = tmp1[5 * 8 + i];

        /* stage 3 */
        t = 0.5 * (v0 - v1);
        v0 = 0.5 * (v0 + v1);
        v1 = t;
        t = v2 * dctSin6 + v3 * dctCos6;
        v2 = v2 * dctCos6 - v3 * dctSin6;
        v3 = t;
        t = 0.5 * (v4 - v6);
        v4 = 0.5 * (v4 + v6);
        v6 = t;
        t = 0.5 * (v7 + v5);
        v5 = 0.5 * (v7 - v5);
        v7 = t;

        /* stage 2 */
        t = 0.5 * (v0 - v3);
        v0 = 0.5 * (v0 + v3);
        v3 = t;
        t = 0.5 * (v1 - v2);
        v1 = 0.5 * (v1 + v2);
        v2 = t;
        t = v4 * dctSin3 + v7 * dctCos3;
        v4 = v4 * dctCos3 - v7 * dctSin3;
        v7 = t;
        t = v5 * dctSin1 + v6 * dctCos1;
        v5 = v5 * dctCos1 - v6 * dctSin1;
        v6 = t;

        /* stage 1 */
        tmp1[0 * 8 + i] = v0 + v7;
        tmp1[7 * 8 + i] = v0 - v7;
        tmp1[1 * 8 + i] = v1 + v6;
        tmp1[6 * 8 + i] = v1 - v6;
        tmp1[2 * 8 + i] = v2 + v5;
        tmp1[5 * 8 + i] = v2 - v5;
        tmp1[3 * 8 + i] = v3 + v4;
        tmp1[4 * 8 + i] = v3 - v4;
    }

    /* convert to 8-bit integers */
    for (i = 0; i < 64; ++i)
    {
        data[i] = dctClip[dctClipOffset + (int)(tmp1[i] + 128.5)];
    }

    return gTrue;
}
#endif

/***********************************************************************
 *      DCTStreamReadHuffSym
 ***********************************************************************
 * SYNOPSIS:        Read huff sym.
 * PARAMETERS:      Stream *str    string
 *                  DCTHuffTable *table    table
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long DCTStreamReadHuffSym(Stream *str, DCTHuffTable *table)
{
    Gushort code;
    long bit;
    word codeBits;

    code = 0;
    codeBits = 0;
    do
    {
        /* add a bit to the code */
        if ((bit = DCTStreamReadBit(str)) == EOF)
        {
            return 9999;
        }
        code = (code << 1) + bit;
        ++codeBits;

        /* look up code */
        if (code - table->firstCode[codeBits] < table->numCodes[codeBits])
        {
            code -= table->firstCode[codeBits];
            return table->sym[table->firstSym[codeBits] + code];
        }
    }
    while (codeBits < 16);

    EC_WARNING(-1);

    return 9999;
}

/***********************************************************************
 *      DCTStreamReadAmp
 ***********************************************************************
 * SYNOPSIS:        Read amp.
 * PARAMETERS:      Stream *str    string
 *                  long size    size
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long DCTStreamReadAmp(Stream *str, long size)
{
    long amp, bit;
    word bits;

    amp = 0;
    for (bits = 0; bits < size; ++bits)
    {
        if ((bit = DCTStreamReadBit(str)) == EOF)
        {
            return 9999;
        }
        amp = (amp << 1) + bit;
    }
    if (amp < (1 << (size - 1)))
    {
        amp -= (1 << size) - 1;
    }
    return amp;
}

/***********************************************************************
 *      DCTStreamReadByte
 ***********************************************************************
 * SYNOPSIS:        Read byte.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long DCTStreamReadByte(Stream *str)
{
    return StreamGetChar(str->str);
}

/***********************************************************************
 *      DCTStreamReadBit
 ***********************************************************************
 * SYNOPSIS:        Read bit.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long DCTStreamReadBit(Stream *str)
{
    DCTData *pdct = str->u.dct;
    long bit;
    long c, c2;

    if (pdct->inputBits == 0)
    {
        if ((c = DCTStreamReadByte(str)) == EOF)
        {
            return EOF;
        }
        if (c == 0xff)
        {
            do
            {
                c2 = DCTStreamReadByte(str);
            }
            while (c2 == 0xff);
            if (c2 != 0x00)
            {
                EC_WARNING(-1);

                return EOF;
            }
        }
        pdct->inputBuf = c;
        pdct->inputBits = 8;
    }
    bit = (pdct->inputBuf >> (pdct->inputBits - 1)) & 1;
    --pdct->inputBits;
    return bit;
}

/***********************************************************************
 *      DCTStreamReadHeader
 ***********************************************************************
 * SYNOPSIS:        Read header.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static GBool DCTStreamReadHeader(Stream *str)
{
    DCTData *pdct = str->u.dct;
    word minHSample, minVSample;
    long bufWidth;
    long n;
    long c = 0;
    short i, j;
    GBool doScan;

    pdct->width = pdct->height = 0;
    pdct->numComps = 0;
    pdct->numQuantTables = 0;
    pdct->numDCHuffTables = 0;
    pdct->numACHuffTables = 0;
    pdct->colorXform = 0;
    pdct->sawAdobeMarker = gFalse;
    pdct->restartInterval = 0;

    doScan = gFalse;
    while (!doScan)
    {
        c = DCTStreamReadMarker(str);
        switch (c)
        {
            case 0xc0: /* SOF0 */
                if (!DCTStreamReadFrameInfo(str))
                {
                    return gFalse;
                }
                break;
            case 0xc4: /* DHT */
                if (!DCTStreamReadHuffmanTables(str))
                {
                    return gFalse;
                }
                break;
            case 0xd8: /* SOI */
                break;
            case 0xda: /* SOS */
                if (!DCTStreamReadScanInfo(str))
                {
                    return gFalse;
                }
                doScan = gTrue;
                break;
            case 0xdb: /* DQT */
                if (!DCTStreamReadQuantTables(str))
                {
                    return gFalse;
                }
                break;
            case 0xdd: /* DRI */
                if (!DCTStreamReadRestartInterval(str))
                {
                    return gFalse;
                }
                break;
            case 0xee: /* APP14 */
                if (!DCTStreamReadAdobeMarker(str))
                {
                    return gFalse;
                }
                break;
            case EOF:
                EC_WARNING(-1);

                return gFalse;
            default:
                if (c >= 0xe0)
                {
                    n = DCTStreamRead16(str) - 2;
                    for (i = 0; i < n; ++i)
                    {
                        DCTStreamReadByte(str);
                    }
                }
                else
                {
                    EC_WARNING(-1);

                    return gFalse;
                }
                break;
        }
    }

    /*
     * Apply the same fallback here: default to YCbCr for 3-component data
     * unless the component IDs are literally 'R'/'G'/'B' (0x52/0x47/0x42).
     */
    if (!pdct->sawAdobeMarker && pdct->numComps == 3)
    {
        if (!(pdct->compInfo[0].id == 'R' &&
            pdct->compInfo[1].id == 'G' &&
            pdct->compInfo[2].id == 'B'))
        {
            pdct->colorXform = 1;
        }
    }

    /* compute MCU size */
    pdct->mcuWidth = minHSample = pdct->compInfo[0].hSample;
    pdct->mcuHeight = minVSample = pdct->compInfo[0].vSample;
    for (i = 1; i < pdct->numComps; ++i)
    {
        if (pdct->compInfo[i].hSample < minHSample)
        {
            minHSample = pdct->compInfo[i].hSample;
        }
        if (pdct->compInfo[i].vSample < minVSample)
        {
            minVSample = pdct->compInfo[i].vSample;
        }
        if (pdct->compInfo[i].hSample > pdct->mcuWidth)
        {
            pdct->mcuWidth = pdct->compInfo[i].hSample;
        }
        if (pdct->compInfo[i].vSample > pdct->mcuHeight)
        {
            pdct->mcuHeight = pdct->compInfo[i].vSample;
        }
    }
    for (i = 0; i < pdct->numComps; ++i)
    {
        pdct->compInfo[i].hSample /= minHSample;
        pdct->compInfo[i].vSample /= minVSample;
    }
    pdct->mcuWidth = (pdct->mcuWidth / minHSample) * 8;
    pdct->mcuHeight = (pdct->mcuHeight / minVSample) * 8;
    if (pdct->mcuWidth < 8 || pdct->mcuWidth > 32 ||
        pdct->mcuHeight < 8 || pdct->mcuHeight > 32)
    {
        EC_WARNING(-1);
        return gFalse;
    }

    /* allocate buffers */
    {
        long roundedWidth, mcuCount;
        if (!PdfCheckedAdd(pdct->width, pdct->mcuWidth - 1, &roundedWidth))
        {
            EC_WARNING(-1);
            return gFalse;
        }
        mcuCount = roundedWidth / pdct->mcuWidth;
        if (!PdfCheckedMul(mcuCount, pdct->mcuWidth, &bufWidth) ||
            bufWidth > 65535L)
        {
            EC_WARNING(-1);
            return gFalse;
        }
    }
    for (i = 0; i < pdct->numComps; ++i)
    {
        for (j = 0; j < pdct->mcuHeight; ++j)
        {
            pdct->rowBufHandle[i][j] = MemAlloc((word)bufWidth, HF_SWAPABLE,
                HAF_NO_ERR);
            if (pdct->rowBufHandle[i][j] == NullHandle)
            {
                GMemSetError();
                DCTStreamFreeRowBuffers(pdct);
                return gFalse;
            }
        }
    }

    pdct->comp = 0;
    pdct->x = 0;
    pdct->y = 0;
    pdct->dy = pdct->mcuHeight;
    pdct->lockedRow = -1;

    return gTrue;
}

/***********************************************************************
 *      DCTStreamReadFrameInfo
 ***********************************************************************
 * SYNOPSIS:        Read frame info.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static GBool DCTStreamReadFrameInfo(Stream *str)
{
    DCTData *pdct = str->u.dct;
    long length;
    long prec;
    long c;
    short i;

    length = DCTStreamRead16(str) - 2;
    prec = DCTStreamReadByte(str);
    pdct->height = DCTStreamRead16(str);
    pdct->width = DCTStreamRead16(str);
    pdct->numComps = DCTStreamReadByte(str);
    length -= 6;
    if (pdct->numComps < 1 || pdct->numComps > 4)
    {
        EC_WARNING(-1);
        return gFalse;
    }
    if (prec != 8)
    {
        EC_WARNING(-1);

        return gFalse;
    }
    for (i = 0; i < pdct->numComps; ++i)
    {
        c = DCTStreamReadByte(str);
        if (c == EOF)
        {
            EC_WARNING(-1);
            return gFalse;
        }
        pdct->compInfo[i].id = (Guchar)c;
        pdct->compInfo[i].inScan = gFalse;
        c = DCTStreamReadByte(str);
        if (c == EOF || ((c >> 4) & 0x0f) < 1 || ((c >> 4) & 0x0f) > 4 ||
            (c & 0x0f) < 1 || (c & 0x0f) > 4)
        {
            EC_WARNING(-1);
            return gFalse;
        }
        pdct->compInfo[i].hSample = (Guchar)((c >> 4) & 0x0f);
        pdct->compInfo[i].vSample = (Guchar)(c & 0x0f);
        c = DCTStreamReadByte(str);
        if (c < 0 || c >= 4)
        {
            EC_WARNING(-1);
            return gFalse;
        }
        pdct->compInfo[i].quantTable = (Guchar)c;
        pdct->compInfo[i].dcHuffTable = 0;
        pdct->compInfo[i].acHuffTable = 0;
    }
    return gTrue;
}

/***********************************************************************
 *      DCTStreamReadScanInfo
 ***********************************************************************
 * SYNOPSIS:        Read scan info.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static GBool DCTStreamReadScanInfo(Stream *str)
{
    DCTData *pdct = str->u.dct;
    long length;
    long scanComps, id, c;
    short i, j;

    length = DCTStreamRead16(str) - 2;
    scanComps = DCTStreamReadByte(str);
    --length;
    if (scanComps < 1 || scanComps > pdct->numComps || scanComps > 4)
    {
        EC_WARNING(-1);
        return gFalse;
    }
    if (length != 2 * scanComps + 3)
    {
        EC_WARNING(-1);

        return gFalse;
    }
    for (i = 0; i < scanComps; ++i)
    {
        id = DCTStreamReadByte(str);
        for (j = 0; j < pdct->numComps; ++j)
        {
            if (id == pdct->compInfo[j].id)
            {
                break;
            }
        }
        if (j == pdct->numComps)
        {
            EC_WARNING(-1);

            return gFalse;
        }
        pdct->compInfo[j].inScan = gTrue;
        c = DCTStreamReadByte(str);
        if (c == EOF || ((c >> 4) & 0x0f) >= 4 || (c & 0x0f) >= 4)
        {
            EC_WARNING(-1);
            return gFalse;
        }
        pdct->compInfo[j].dcHuffTable = (Guchar)((c >> 4) & 0x0f);
        pdct->compInfo[j].acHuffTable = (Guchar)(c & 0x0f);
    }
    DCTStreamReadByte(str);
    DCTStreamReadByte(str);
    DCTStreamReadByte(str);
    return gTrue;
}

/***********************************************************************
 *      DCTStreamReadQuantTables
 ***********************************************************************
 * SYNOPSIS:        Read quant tables.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static GBool DCTStreamReadQuantTables(Stream *str)
{
    DCTData *pdct = str->u.dct;
    long length;
    long index;
    short i;

    length = DCTStreamRead16(str) - 2;
    while (length > 0)
    {
        index = DCTStreamReadByte(str);
        if ((index & 0xf0) || index >= 4)
        {
            EC_WARNING(-1);

            return gFalse;
        }
        if (index == pdct->numQuantTables)
        {
            pdct->numQuantTables = index + 1;
        }
        for (i = 0; i < 64; ++i)
        {
            pdct->quantTables[index][dctZigZag[i]] = DCTStreamReadByte(str);
        }
        length -= 65;
    }
    return gTrue;
}

/***********************************************************************
 *      DCTStreamReadHuffmanTables
 ***********************************************************************
 * SYNOPSIS:        Read huffman tables.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static GBool DCTStreamReadHuffmanTables(Stream *str)
{
    DCTData *pdct = str->u.dct;
    DCTHuffTable *tbl;
    long length;
    long index;
    long c;
    short i;
    Gushort code;
    Guchar sym;

    length = DCTStreamRead16(str) - 2;
    while (length > 0)
    {
        index = DCTStreamReadByte(str);
        --length;
        if ((index & 0x0f) >= 4)
        {
            EC_WARNING(-1);

            return gFalse;
        }
        if (index & 0x10)
        {
            index &= 0x0f;
            if (index >= pdct->numACHuffTables)
            {
                pdct->numACHuffTables = index + 1;
            }
            tbl = &pdct->acHuffTables[index];
        }
        else
        {
            if (index >= pdct->numDCHuffTables)
            {
                pdct->numDCHuffTables = index + 1;
            }
            tbl = &pdct->dcHuffTables[index];
        }
        sym = 0;
        code = 0;
        for (i = 1; i <= 16; ++i)
        {
            c = DCTStreamReadByte(str);
            tbl->firstSym[i] = sym;
            tbl->firstCode[i] = code;
            tbl->numCodes[i] = c;
            sym += c;
            code = (code + c) << 1;
        }
        length -= 16;
        for (i = 0; i < sym; ++i)
        {
            tbl->sym[i] = DCTStreamReadByte(str);
        }
        length -= sym;
    }
    return gTrue;
}

/***********************************************************************
 *      DCTStreamReadRestartInterval
 ***********************************************************************
 * SYNOPSIS:        Read restart interval.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static GBool DCTStreamReadRestartInterval(Stream *str)
{
    DCTData *pdct = str->u.dct;
    long length;

    length = DCTStreamRead16(str);
    if (length != 4)
    {
        EC_WARNING(-1);

        return gFalse;
    }
    pdct->restartInterval = DCTStreamRead16(str);
    return gTrue;
}

/***********************************************************************
 *      DCTStreamReadAdobeMarker
 ***********************************************************************
 * SYNOPSIS:        Read adobe marker.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static GBool DCTStreamReadAdobeMarker(Stream *str)
{
    DCTData *pdct = str->u.dct;
    long length, i;
    char buf[12];
    long c;

    length = DCTStreamRead16(str);
    if (length != 14)
    {
        goto err;
    }
    for (i = 0; i < 12; ++i)
    {
        if ((c = DCTStreamReadByte(str)) == EOF)
        {
            goto err;
        }
        buf[i] = c;
    }
    if (strncmp(buf, "Adobe", 5))
    {
        goto err;
    }
    pdct->colorXform = buf[11];
    pdct->sawAdobeMarker = gTrue;
    return gTrue;

    err:
    EC_WARNING(-1);

    return gFalse;
}

/***********************************************************************
 *      DCTStreamReadTrailer
 ***********************************************************************
 * SYNOPSIS:        Read trailer.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static GBool DCTStreamReadTrailer(Stream *str)
{
    long c;

    c = DCTStreamReadMarker(str);
    if (c != 0xd9) { /* EOI */
        EC_WARNING(-1);

        return gFalse;
    }
    return gTrue;
}

/***********************************************************************
 *      DCTStreamReadMarker
 ***********************************************************************
 * SYNOPSIS:        Read marker.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long DCTStreamReadMarker(Stream *str)
{
    long c;

    do
    {
        do
        {
            c = DCTStreamReadByte(str);
        }
        while (c != 0xff);
        do
        {
            c = DCTStreamReadByte(str);
        }
        while (c == 0xff);
    }
    while (c == 0x00);
    return c;
}

/***********************************************************************
 *      DCTStreamRead16
 ***********************************************************************
 * SYNOPSIS:        Process dctstream read16.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long DCTStreamRead16(Stream *str)
{
    long c1, c2;

    if ((c1 = DCTStreamReadByte(str)) == EOF)
    {
        return EOF;
    }
    if ((c2 = DCTStreamReadByte(str)) == EOF)
    {
        return EOF;
    }
    return(c1 << 8) + c2;
}

#ifdef __BORLANDC__
#pragma codeseg stream
#endif
#ifdef __WATCOMC__
#pragma code_seg("stream")
#endif

/* RC4Stream -- decrypts an encrypted PDF's raw stream bytes on the fly, */
/* before any other filter (Flate/DCT/...) sees them. */

/***********************************************************************
 *      RC4StreamInit
 ***********************************************************************
 * SYNOPSIS:        Initialize.
 * PARAMETERS:      Stream *str    string
 *                  Stream *str1    str1
 *                  Guchar *key    key
 *                  short keyLen    key len
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void RC4StreamInit(Stream *str, Stream *str1, Guchar *key, short keyLen)
{
    RC4Data *prc4;

    StreamInit(str);
    str->kind = strRC4;
    str->str = str1;
    prc4 = str->u.rc4 = gmalloc(sizeof(RC4Data));
    if (!prc4)
    {
        EOFStreamInit(str, str1);
        return;
    }
    memcpy(prc4->keyBuf, key, keyLen);
    prc4->keyLen = keyLen;
    RC4KeySchedule(prc4->keyBuf, prc4->keyLen, prc4->sBox);
    prc4->rc4i = prc4->rc4j = 0;
    prc4->peeked = gFalse;
}

/***********************************************************************
 *      RC4StreamFree
 ***********************************************************************
 * SYNOPSIS:        Release.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void RC4StreamFree(Stream *str)
{
    gfree(str->u.rc4);
}

/***********************************************************************
 *      RC4StreamReset
 ***********************************************************************
 * SYNOPSIS:        Reset.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void RC4StreamReset(Stream *str)
{
    RC4Data *prc4 = str->u.rc4;

    StreamReset(str->str);
    /* Reset the PRGA state whenever the wrapped stream resets. */
    RC4KeySchedule(prc4->keyBuf, prc4->keyLen, prc4->sBox);
    prc4->rc4i = prc4->rc4j = 0;
    prc4->peeked = gFalse;
}

/***********************************************************************
 *      RC4StreamAdvance
 ***********************************************************************
 * SYNOPSIS:        Advance.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long RC4StreamAdvance(Stream *str)
{
    RC4Data *prc4 = str->u.rc4;
    long c;

    c = StreamGetChar(str->str);
    if (c == EOF)
    {
        return EOF;
    }
    return(long)((Guchar)c ^ RC4NextByte(prc4->sBox, &prc4->rc4i,
        &prc4->rc4j));
}

/***********************************************************************
 *      RC4StreamGetChar
 ***********************************************************************
 * SYNOPSIS:        Get char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long RC4StreamGetChar(Stream *str)
{
    RC4Data *prc4 = str->u.rc4;

    if (prc4->peeked)
    {
        prc4->peeked = gFalse;
        return prc4->peekedChar;
    }
    return RC4StreamAdvance(str);
}

/***********************************************************************
 *      RC4StreamLookChar
 ***********************************************************************
 * SYNOPSIS:        Process rc4 stream look char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long RC4StreamLookChar(Stream *str)
{
    RC4Data *prc4 = str->u.rc4;

    if (!prc4->peeked)
    {
        prc4->peekedChar = RC4StreamAdvance(str);
        prc4->peeked = gTrue;
    }
    return prc4->peekedChar;
}

/* FlateStream */

#ifdef __BORLANDC__
#pragma codeseg FlateStream
#endif
#ifdef __WATCOMC__
#pragma code_seg("FlateStream")
#endif

/***********************************************************************
 *      FlateStreamEndZlib
 ***********************************************************************
 * SYNOPSIS:        Free zlib's state (window), if it is allocated.
 ***********************************************************************/

static void FlateStreamEndZlib(FlateData *fd)
{
    if (fd->zInit)
    {
        inflateEnd(&fd->strm);
        fd->zInit = gFalse;
    }
}

/***********************************************************************
 *      FlateStreamInit
 ***********************************************************************
 * SYNOPSIS:        Initialize a zlib based Flate decoder.
 * PARAMETERS:      Stream *str     stream to set up
 *                  Stream *str1    compressed data
 *
 * RETURNS:         void
 *
 * STRATEGY:
 *      Only the wrapper data is allocated here; zlib itself is set up by
 *      FlateStreamReset when the stream is really read.
 *      No StreamReset here: the parser builds the filter chain before it
 *      has read "endstream" (see PredictorStreamWrap).
 ***********************************************************************/

void FlateStreamInit(Stream *str, Stream *str1)
{
    FlateData *fd;

    StreamInit(str);
    str->str = str1;

    fd = gmalloc(sizeof(FlateData));
    if (!fd)
    {
        EOFStreamInit(str, str1);
        return;
    }
    memset(fd, 0, sizeof(FlateData));   /* zalloc/zfree/opaque = Z_NULL */

    fd->eof = gTrue;    /* nothing to read until the first reset */
    str->kind = strFlate;
    str->u.flate = fd;
}

/***********************************************************************
 *      FlateStreamFree
 ***********************************************************************
 * SYNOPSIS:        Release the zlib state and the wrapper data.
 ***********************************************************************/

void FlateStreamFree(Stream *str)
{
    if (str->u.flate)
    {
        FlateStreamEndZlib(str->u.flate);
        gfree(str->u.flate);
        str->u.flate = NULL;
    }
}

/***********************************************************************
 *      FlateStreamReset
 ***********************************************************************
 * SYNOPSIS:        Restart decoding at the beginning of the data.
 ***********************************************************************/

void FlateStreamReset(Stream *str)
{
    FlateData *fd = str->u.flate;

    int ret;

    StreamReset(str->str);

    /*
     * Fresh zlib state for every pass (inflateReset would keep the old
     * window around between passes). 15 window bits: the zlib library is
     * built with MAX_WBITS=14 (that only limits its own compressor), but
     * almost all PDF writers use the full 32 KB window, which plain
     * inflateInit() would reject as "invalid window size".
     */
    FlateStreamEndZlib(fd);
    fd->eof = gTrue;
    fd->readIndex = 0;
    fd->readCount = 0;
    memset(&fd->strm, 0, sizeof(z_stream));
    fd->strm.next_in = fd->inBuf;
    ret = inflateInit2(&fd->strm, flateWindowBits);
    if (ret != Z_OK)
    {
        if (ret == Z_MEM_ERROR)
        {
            GMemSetError();
        }
        return;
    }
    fd->zInit = gTrue;

    fd->strm.next_in = fd->inBuf;   /* zlib 1.1.4 rejects next_in == NULL */
    fd->strm.avail_in = 0;
    fd->eof = gFalse;
    fd->inEof = gFalse;
    fd->readIndex = 0;
    fd->readCount = 0;
}

/* FlateStreamGetChar moved above into StreamGetChar's code segment. */

/***********************************************************************
 *      FlateStreamLookChar
 ***********************************************************************
 * SYNOPSIS:        Peek at the next decoded byte.
 * RETURNS:         byte value or EOF
 ***********************************************************************/

long FlateStreamLookChar(Stream *str)
{
    FlateData *fd = str->u.flate;

    if (fd->readIndex >= fd->readCount)
    {
        fd->readCount = FlateStreamReadRaw(str, fd->readBuf,
            flateReadBufSize);
        fd->readIndex = 0;
        if (fd->readCount == 0)
        {
            return EOF;
        }
    }

    return fd->readBuf[fd->readIndex];
}

/***********************************************************************
 *      FlateStreamReadRaw
 ***********************************************************************
 * SYNOPSIS:        Inflate up to size bytes straight into out.
 * PARAMETERS:      Stream *str     Flate stream
 *                  Guchar *out     destination
 *                  word size       bytes wanted
 *
 * RETURNS:         bytes delivered; less than size only at the end
 *
 * STRATEGY:
 *      Refill the input buffer from the underlying stream whenever zlib
 *      has used it up. Stop at Z_STREAM_END, on any zlib error (what was
 *      decoded so far is still returned, like xpdf does with damaged
 *      data), or when the input is exhausted and zlib makes no progress
 *      (truncated stream).
 ***********************************************************************/

static word FlateStreamReadRaw(Stream *str, Guchar *out, word size)
{
    FlateData *fd = str->u.flate;
    z_stream *zs;
    uInt outBefore, inBefore;
    int ret;

    if (fd->eof || size == 0)
    {
        return 0;
    }

    zs = &fd->strm;
    zs->next_out = out;
    zs->avail_out = size;

    while (zs->avail_out > 0)
    {
        if (zs->avail_in == 0 && !fd->inEof)
        {
            zs->next_in = fd->inBuf;
            zs->avail_in = StreamRead(str->str, fd->inBuf, flateInBufSize);
            if (zs->avail_in == 0)
            {
                fd->inEof = gTrue;
            }
        }

        outBefore = zs->avail_out;
        inBefore = zs->avail_in;
        ret = inflate(zs, Z_NO_FLUSH);

        if (ret == Z_STREAM_END)
        {
            fd->eof = gTrue;
            break;
        }
        if (ret != Z_OK && ret != Z_BUF_ERROR)
        {
            /* Z_DATA_ERROR, Z_NEED_DICT, Z_MEM_ERROR, Z_STREAM_ERROR */
            if (ret == Z_MEM_ERROR)
            {
                GMemSetError();
            }
            EC_WARNING(-1);
            fd->eof = gTrue;
            break;
        }
        if (zs->avail_out == outBefore && zs->avail_in == inBefore &&
            (fd->inEof || zs->avail_in > 0))
        {
            /* no progress possible: truncated or stuck stream */
            fd->eof = gTrue;
            break;
        }
    }

    size -= (word)zs->avail_out;
    if (fd->eof)
    {
        /* done with this pass: give the window back right away */
        FlateStreamEndZlib(fd);
    }
    return size;
}

 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void ASCIIHexStreamReset(Stream *str)
{
    StreamReset(str->str);
    str->buf = EOF;
    str->eof = gFalse;
}

/***********************************************************************
 *      ASCIIHexStreamLookChar
 ***********************************************************************
 * SYNOPSIS:        Process asciihex stream look char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long ASCIIHexStreamLookChar(Stream *str)
{
    long c1, c2, x;

    if (str->buf != EOF)
    {
        return str->buf;
    }
    if (str->eof)
    {
        str->buf = EOF;
        return EOF;
    }
    do
    {
        c1 = StreamGetChar(str->str);
    }
    while (isspace(c1));
    if (c1 == '>')
    {
        str->eof = gTrue;
        str->buf = EOF;
        return str->buf;
    }
    do
    {
        c2 = StreamGetChar(str->str);
    }
    while (isspace(c2));
    if (c2 == '>')
    {
        str->eof = gTrue;
        c2 = '0';
    }
    if (c1 >= '0' && c1 <= '9')
    {
        x = (c1 - '0') << 4;
    }
    else if (c1 >= 'A' && c1 <= 'F')
    {
        x = (c1 - 'A' + 10) << 4;
    }
    else if (c1 >= 'a' && c1 <= 'f')
    {
        x = (c1 - 'a' + 10) << 4;
    }
    else if (c1 == EOF)
    {
        str->eof = gTrue;
        x = 0;
    }
    else
    {
        EC_WARNING(-1);

        x = 0;
    }
    if (c2 >= '0' && c2 <= '9')
    {
        x += c2 - '0';
    }
    else if (c2 >= 'A' && c2 <= 'F')
    {
        x += c2 - 'A' + 10;
    }
    else if (c2 >= 'a' && c2 <= 'f')
    {
        x += c2 - 'a' + 10;
    }
    else if (c2 == EOF)
    {
        str->eof = gTrue;
        x = 0;
    }
    else
    {
        EC_WARNING(-1);

    }
    str->buf = x & 0xff;
    return str->buf;
}

/***********************************************************************
 *      ASCIIHexStreamGetChar
 ***********************************************************************
 * SYNOPSIS:        Get char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long ASCIIHexStreamGetChar(Stream *str)
{
    long c = ASCIIHexStreamLookChar(str);
    str->buf = EOF;
    return c;
}

/* ASCII85Stream */

/***********************************************************************
 *      ASCII85StreamInit
 ***********************************************************************
 * SYNOPSIS:        Initialize.
 * PARAMETERS:      Stream *str    string
 *                  Stream *str1    str1
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void ASCII85StreamInit(Stream *str, Stream *str1)
{
    StreamInit(str);
    str->str = str1;

    str->kind = strASCII85;
    str->u.a85 = gmalloc(sizeof(ASCII85Data));
    if (!str->u.a85)
    {
        EOFStreamInit(str, str1);
        return;
    }

    str->u.a85->index = str->u.a85->n = 0;
    str->eof = gFalse;
}


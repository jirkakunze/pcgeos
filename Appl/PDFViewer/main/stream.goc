    str->u.a85->index = str->u.a85->n = 0;
    str->eof = gFalse;
}

/***********************************************************************
 *      ASCII85StreamLookChar
 ***********************************************************************
 * SYNOPSIS:        Process ascii85 stream look char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long ASCII85StreamLookChar(Stream *str)
{
    short k;
    Gulong t;
    ASCII85Data *p85 = str->u.a85;

    if (p85->index >= p85->n)
    {
        if (str->eof)
        {
            return EOF;
        }
        p85->index = 0;
        do
        {
            p85->c[0] = StreamGetChar(str->str);
        }
        while (p85->c[0] == '\n' || p85->c[0] == '\r');
        if (p85->c[0] == '~' || p85->c[0] == EOF)
        {
            str->eof = gTrue;
            p85->n = 0;
            return EOF;
        }
        else if (p85->c[0] == 'z')
        {
            p85->b[0] = p85->b[1] = p85->b[2] = p85->b[3] = 0;
            p85->n = 4;
        }
        else
        {
            for (k = 1; k < 5; ++k)
            {
                do
                {
                    p85->c[k] = StreamGetChar(str->str);
                }
                while (p85->c[k] == '\n' || p85->c[k] == '\r');
                if (p85->c[k] == '~' || p85->c[k] == EOF)
                {
                    break;
                }
            }
            p85->n = k - 1;
            if (k < 5 && (p85->c[k] == '~' || p85->c[k] == EOF))
            {
                for (++k; k < 5; ++k)
                {
                    p85->c[k] = 0x21 + 84;
                }
                str->eof = gTrue;
            }
            t = 0;
            for (k = 0; k < 5; ++k)
            {
                t = t * 85 + (p85->c[k] - 0x21);
            }
            for (k = 3; k >= 0; --k)
            {
                p85->b[k] = (long)(t & 0xff);
                t >>= 8;
            }
        }
    }
    return p85->b[p85->index];
}

/***********************************************************************
 *      ASCII85StreamGetChar
 ***********************************************************************
 * SYNOPSIS:        Get char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long ASCII85StreamGetChar(Stream *str)
{
    long ch = ASCII85StreamLookChar(str);
    ++str->u.a85->index;
    return ch;
}

/* LZWStream */

#ifdef __BORLANDC__
#pragma codeseg LZWStream
#endif
#ifdef __WATCOMC__
#pragma code_seg("LZWStream")
#endif

/* code copied from Acorn port of xpdf */

static long LZWStreamGetCode(Stream *str);

/* Code */

/***********************************************************************
 *      LZWStreamInit
 ***********************************************************************
 * SYNOPSIS:        Initialize.
 * PARAMETERS:      Stream *str    string
 *                  Stream *str2    str2
 *                  long early1    early1
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void LZWStreamInit(Stream *str, Stream *str2, long early1)
{

    StreamInit(str);
    str->str = str2;

    str->kind = strLZW;
    str->u.lzw = gmalloc(sizeof (LZWData));
    if (!str->u.lzw)
    {
        EOFStreamInit(str, str2);
        return;
    }

    str->u.lzw->early = early1;
    str->u.lzw->bufPtr = str->u.lzw->bufEnd = str->u.lzw->buf;
}

/***********************************************************************
 *      LZWStreamFree
 ***********************************************************************
 * SYNOPSIS:        Release.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void LZWStreamFree(Stream *str)
{

    gfree(str->u.lzw);
}

/***********************************************************************
 *      LZWStreamReset
 ***********************************************************************
 * SYNOPSIS:        Reset.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void LZWStreamReset(Stream *str)
{
    long code;
    LZWData *plzw = str->u.lzw;

    StreamReset(str->str);

    plzw->inCodeBits = 9;
    plzw->inputBuf = 0;
    plzw->inputBits = 0;

    for (code = 0; code < 256; ++code)
    {
        plzw->codetab[code] = 0;
        plzw->htab[code] = (Guchar)code;
    }
    plzw->free_ent = 258;

    while ((code = LZWStreamGetCode(str)) == 256);

    if (code == EOF || code == 257)
    {
        /* EOF code */
        plzw->bufPtr = plzw->bufEnd = plzw->buf;
        return;
    }

    plzw->buf[0] = plzw->oldcode = plzw->finchar = code;
    plzw->bufPtr = plzw->buf;
    plzw->bufEnd = &plzw->buf[1];
}

/***********************************************************************
 *      LZWStreamGetCode
 ***********************************************************************
 * SYNOPSIS:        Get code.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long LZWStreamGetCode(Stream *str)
{
    long c;
    long code;
    LZWData *plzw = str->u.lzw;

    while (plzw->inputBits < plzw->inCodeBits)
    {
        if ((c = StreamGetChar(str->str)) == EOF)
        {
            return EOF;
        }

        plzw->inputBuf = (plzw->inputBuf << 8) | c;
        plzw->inputBits += 8;
    }
    code =
        (plzw->inputBuf >> (plzw->inputBits - plzw->inCodeBits)) &
    ((1 << plzw->inCodeBits) - 1);

    plzw->inputBits -= plzw->inCodeBits;
    return code;
}

/***********************************************************************
 *      LZWStreamFillBuf
 ***********************************************************************
 * SYNOPSIS:        Fill buffer.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

GBool LZWStreamFillBuf(Stream *str)
{
    long code, incode, count;
    LZWData *plzw = str->u.lzw;

    code = LZWStreamGetCode(str);
    if (code == 256)
    {
        /* Clear code */
#if 1==0
        for (code = 0; code < 256; ++code)
        {
            codetab[code] = 0;
        }
#else
        memset(&plzw->codetab[0], 0, 256 * sizeof(short));
#endif
        plzw->free_ent = 258;
        plzw->inCodeBits = 9;
        while ((code = LZWStreamGetCode(str)) == 256);
    }

    if (code == EOF || code == 257)
    {
        /* EOF code */
        plzw->bufPtr = plzw->bufEnd = plzw->buf;
        return gFalse;
    }
    incode = code;

    count = sizeof(plzw->buf);

    /* Special case for KwKwK string. */
    if (code >= plzw->free_ent)
    {
        plzw->buf[--count] = plzw->finchar;
        code = plzw->oldcode;
    }

    /* Generate output characters */
    /* traverse tables in reverse order. */

    while (code >= 256)
    {
        plzw->buf[--count] = plzw->htab[code];
        code = plzw->codetab[code];
        if (count == 0)
        {
            EC_WARNING(-1);
            /* error(getPos(), "LZW buffer overflow"); */
            plzw->bufPtr = plzw->buf;
            plzw->bufEnd = &plzw->buf[sizeof(plzw->buf) - 1];
            return gTrue;
        }
    }
    plzw->buf[--count] = plzw->finchar = plzw->htab[code];

    /* Generate the new entry. */
    if ((code = plzw->free_ent) < 4096)
    {
        plzw->codetab[code] = (short)plzw->oldcode;
        plzw->htab[code] = (Guchar)plzw->finchar;
        plzw->free_ent = code + 1;
        if (plzw->free_ent + plzw->early == 0x200)
        {
            plzw->inCodeBits = 10;
        }
        else if (plzw->free_ent + plzw->early == 0x400)
        {
            plzw->inCodeBits = 11;
        }
        else if (plzw->free_ent + plzw->early == 0x800)
        {
            plzw->inCodeBits = 12;
        }
    }

    /* Remember previous code. */
    plzw->oldcode = incode;

    plzw->bufPtr = &plzw->buf[count];
    plzw->bufEnd = &plzw->buf[sizeof(plzw->buf)];
    return gTrue;
}

/***********************************************************************
 *      LZWStreamGetChar
 ***********************************************************************
 * SYNOPSIS:        Get char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

long LZWStreamGetChar(Stream *str)
{
    LZWData *plzw = str->u.lzw;

    return(plzw->bufPtr >= plzw->bufEnd && !LZWStreamFillBuf(str)) ?
        EOF : (*plzw->bufPtr++ & 0xff);
}

/***********************************************************************
 *      LZWStreamLookChar
 ***********************************************************************
 * SYNOPSIS:        Process lzwstream look char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

long LZWStreamLookChar(Stream *str)
{
    LZWData *plzw = str->u.lzw;

    return(plzw->bufPtr >= plzw->bufEnd && !LZWStreamFillBuf(str)) ?
        EOF : (*plzw->bufPtr & 0xff);
}


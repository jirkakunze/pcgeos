/* Flate: zlib wrapper; the zlib state exists only while it is read */
#define flateInBufSize 1024     /* compressed bytes per StreamRead */
#define flateReadBufSize 256    /* GetChar/LookChar cache */
#define flateWindowBits 15      /* PDF writers use the full 32 KB window */

typedef struct FlateData
{
    z_stream strm;
    GBool zInit;        /* strm holds zlib state (window allocated) */
    GBool eof;          /* zlib stream ended (or failed) */
    GBool inEof;        /* no more compressed input */
    word readIndex;
    word readCount;
    Guchar inBuf[flateInBufSize];
    Guchar readBuf[flateReadBufSize];
} FlateData;

#define PDF_MAX_CCITT_COLUMNS 32765L
#define PDF_MAX_PREDICTOR_VALUES 32760L

#define headerSearchSize 1024  /* bytes searched for "%PDF" */


 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

long StreamLookChar(Stream *str)
{

    switch (str->kind)
    {

        case strFile:
            return FStreamLookChar(str);

        case strSubStream:
            return StreamLookChar(str->str);

        case strLZW:
            return LZWStreamLookChar(str);

        case strFlate:
            return FlateStreamLookChar(str);

        case strObjStmCache:
            return ObjStmCacheStreamLookChar(str);

        case strDCT:
            return DCTStreamLookChar(str);

        case strASCIIHex:
            return ASCIIHexStreamLookChar(str);

        case strASCII85:
            return ASCII85StreamLookChar(str);

        case strRunLength:
            return RunLengthStreamLookChar(str);

        case strCCITTFax:
            return CCITTFaxStreamLookChar(str);

        case strEOF:
            return EOFStreamLookChar(str);

        case strRC4:
            return RC4StreamLookChar(str);

        case strPredictor:
            return PredictorStreamLookChar(str);
    }

    EC_ERROR(-1);
    return EOF;
}

/***********************************************************************
 *      FlateStreamGetChar
 ***********************************************************************
 * SYNOPSIS:        Get char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

long FlateStreamGetChar(Stream *str)
{
    FlateData *pflate = str->u.flate;

    if (pflate->readIndex >= pflate->readCount)
    {
        pflate->readCount = FlateStreamReadRaw(str, pflate->readBuf,
            flateReadBufSize);
        pflate->readIndex = 0;
        if (pflate->readCount == 0)
        {
            return EOF;
        }
    }

    return pflate->readBuf[pflate->readIndex++];
}

/***********************************************************************
 *      FlateStreamRead
 ***********************************************************************
 * SYNOPSIS:        Read.
 * PARAMETERS:      Stream *str    string
 *                  Guchar *buf    buffer
 *                  word size    size
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

word FlateStreamRead(Stream *str, Guchar *buf, word size)
{
    FlateData *pflate = str->u.flate;
    word total = 0;
    word n;

    /* Consume bytes already prefetched for GetChar/LookChar first. */
    while (total < size && pflate->readIndex < pflate->readCount)
    {
        buf[total++] = pflate->readBuf[pflate->readIndex++];
    }

    if (total < size)
    {
        n = FlateStreamReadRaw(str, buf + total, size - total);
        total += n;
    }

    return total;
}


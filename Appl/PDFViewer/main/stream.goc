/***********************************************************************
 *      StreamGetLine
 ***********************************************************************
 * SYNOPSIS:        Get line.
 * PARAMETERS:      Stream *str    string
 *                  char *buf    buffer
 *                  long size    size
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void StreamGetLine(Stream *str, char *buf, long size)
{
    long i;
    long c;

    if (StreamLookChar(str) == EOF)
    {
        buf[0] = '\0';
        return;
    }
    for (i = 0; i < size - 1; ++i)
    {
        c = StreamGetChar(str);
        if (c == EOF || c == '\n')
        {
            break;
        }
        if (c == '\r')
        {
            if ((c = StreamLookChar(str)) == '\n')
            {
                StreamGetChar(str);
            }
            break;
        }
        buf[i] = c;
    }
    buf[i] = '\0';
}

/***********************************************************************
 *      StreamResetImage
 ***********************************************************************
 * SYNOPSIS:        Reset image.
 * PARAMETERS:      Stream *stream    stream
 *                  long width1    width1
 *                  short nComps1    n comps1
 *                  short nBits1    n bits1
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

GBool StreamResetImage(Stream *stream, long width1, short nComps1, short nBits1)
{
    long rowBytes;

    StreamReset(stream);

    stream->width = width1;
    stream->nComps = nComps1;
    stream->nBits = nBits1;
    stream->nVals = (long)(stream->width) * stream->nComps;
    rowBytes = (stream->nVals * stream->nBits + 7) >> 3;
    if (rowBytes < 1 || rowBytes > 65535L ||
        stream->nVals + 7 > 65535L)
    {
        return gFalse;
    }
    stream->rowBytes = rowBytes;
    {
        Guchar *newRawLine;
        Guchar *newPixLine;

        newRawLine = (Guchar *)grealloc(stream->rawLine, stream->rowBytes);
        if (!newRawLine)
        {
            return gFalse;
        }
        stream->rawLine = newRawLine;

        newPixLine = (Guchar *)grealloc(stream->pixLine,
            ((stream->nVals + 7) & ~7) * sizeof(Guchar));
        if (!newPixLine)
        {
            return gFalse;
        }
        stream->pixLine = newPixLine;
    }
    stream->pixIdx = stream->nVals;
    return gTrue;
}

/***********************************************************************
 *      StreamGetImagePixel
 ***********************************************************************
 * SYNOPSIS:        Get the next pixel of an image stream.
 * PARAMETERS:      Stream *this    stream set up by StreamResetImage
 *                  Guchar *pix     receives nComps component values
 *
 * RETURNS:         gTrue, or EOF at the end of the data
 *
 * STRATEGY:
 *      Read one row of packed samples and unpack it into one byte per
 *      component. Predictors are already undone by the PredictorStream
 *      in the filter chain. 16-bit samples are reduced to their high
 *      byte, so callers always get values of at most 8 bits.
 *
 ***********************************************************************/

GBool StreamGetImagePixel(Stream *this, Guchar *pix)
{
    Gulong buf, bitMask;
    long c;
    short bits;
    word n;
    long i, j;

    if (this->pixIdx >= this->nVals)
    {
        n = StreamRead(this, this->rawLine, (word)this->rowBytes);
        if (n == 0)
        {
            return EOF;
        }
        if (n < (word)this->rowBytes)
        {
            /* truncated image data -- fill the rest of the row */
            memset(this->rawLine + n, 0, (word)this->rowBytes - n);
        }

        if (this->nBits == 1)
        {
            for (i = 0, j = 0; i < this->nVals; i += 8, ++j)
            {
                c = this->rawLine[j];
                this->pixLine[i + 0] = (Guchar)((c >> 7) & 1);
                this->pixLine[i + 1] = (Guchar)((c >> 6) & 1);
                this->pixLine[i + 2] = (Guchar)((c >> 5) & 1);
                this->pixLine[i + 3] = (Guchar)((c >> 4) & 1);
                this->pixLine[i + 4] = (Guchar)((c >> 3) & 1);
                this->pixLine[i + 5] = (Guchar)((c >> 2) & 1);
                this->pixLine[i + 6] = (Guchar)((c >> 1) & 1);
                this->pixLine[i + 7] = (Guchar)(c & 1);
            }
        }
        else if (this->nBits == 8)
        {
            memcpy(this->pixLine, this->rawLine, (word)this->nVals);
        }
        else if (this->nBits == 16)
        {
            /* big-endian samples: keep the high byte */
            for (i = 0, j = 0; i < this->nVals; ++i, j += 2)
            {
                this->pixLine[i] = this->rawLine[j];
            }
        }
        else
        {
            bitMask = (1 << this->nBits) - 1;
            buf = 0;
            bits = 0;
            j = 0;
            for (i = 0; i < this->nVals; ++i)
            {
                if (bits < this->nBits)
                {
                    buf = (buf << 8) | (this->rawLine[j++] & 0xff);
                    bits += 8;
                }
                this->pixLine[i] =
                    (Guchar)((buf >> (bits - this->nBits)) & bitMask);
                bits -= this->nBits;
            }
        }

        this->pixIdx = 0;
    }

    for (i = 0; i < this->nComps; ++i)
    {
        pix[i] = this->pixLine[this->pixIdx++];
    }
    return gTrue;
}

/***********************************************************************
 *      StreamAddFilters
 ***********************************************************************
 * SYNOPSIS:        Add filters.
 * PARAMETERS:      Stream *str1    str1
 *                  Obj *dict    dictionary
 *                  XRef *xref    cross-reference table
 *
 * RETURNS:         result pointer
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

Stream *StreamAddFilters(Stream *str1, Obj *dict, XRef *xref)
{
    Obj obj, obj2;
    Obj params, params2;
    Stream *str;
    Stream *oldStr;
    word i;

    str = str1;
    ObjDictLookup(dict, "Filter", &obj, xref);
    if (isNull(&obj))
    {
        ObjFree(&obj);
        ObjDictLookup(dict, "F", &obj, xref);
    }
    ObjDictLookup(dict, "DecodeParms", &params, xref);
    if (isNull(&params))
    {
        ObjFree(&params);
        ObjDictLookup(dict, "DP", &params, xref);
    }
    if (isName(&obj))
    {
        str = StreamMakeFilter(str, getName(&obj), &params, xref);
    }
    else if (isArray(&obj))
    {

        for (i = 0; i < ObjArrayGetLength(&obj); ++i)
        {
            ObjArrayGet(&obj, i, &obj2, xref);
            if (isArray(&params))
            {
                ObjArrayGet(&params, i, &params2, xref);
            }
            else
            {
                initNull(&params2);
            }
            if (isName(&obj2))
            {
                str = StreamMakeFilter(str, getName(&obj2), &params2, xref);
            }
            else
            {
                EC_WARNING(-1);

                oldStr = str;
                str = gmalloc(sizeof(Stream));
                if (!str)
                {
                    str = oldStr;
                    ObjFree(&obj2);
                    ObjFree(&params2);
                    break;
                }
                EOFStreamInit(str, oldStr);
            }
            ObjFree(&obj2);
            ObjFree(&params2);
        }
    }
    else if (!isNull(&obj))
    {
        EC_WARNING(-1);

    }
    ObjFree(&obj);
    ObjFree(&params);

    return str;
}

/***********************************************************************
 *      StreamValidPredictorParams
 ***********************************************************************
 * SYNOPSIS:        Process stream valid predictor params.
 * PARAMETERS:      long pred    pred
 *                  long columns    columns
 *                  long colors    colors
 *                  long bits    bits
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static GBool StreamValidPredictorParams(long pred, long columns, long colors,
    long bits)
{
    long nVals, rowBits, rowBytes, pixBits, pixBytes, rawSize;

    if (pred == 1)
    {
        return gTrue;
    }
    if (!(pred == 2 || (pred >= 10 && pred <= 15)))
    {
        return gFalse;
    }
    if (columns < 1 || colors < 1 || colors > 32)
    {
        return gFalse;
    }
    if (!(bits == 1 || bits == 2 || bits == 4 || bits == 8 || bits == 16))
    {
        return gFalse;
    }

    /*
     * Validate every size expression used later by StreamResetImage before any
     * multiplication/addition can wrap a signed 32-bit long.
     */
    if (!PdfCheckedMul(columns, colors, &nVals) ||
        nVals > PDF_MAX_PREDICTOR_VALUES ||
        !PdfCheckedMul(nVals, bits, &rowBits) ||
        !PdfCheckedAdd(rowBits, 7, &rowBits) ||
        !PdfCheckedMul(colors, bits, &pixBits) ||
        !PdfCheckedAdd(pixBits, 7, &pixBits))
    {
        return gFalse;
    }

    rowBytes = rowBits >> 3;
    pixBytes = pixBits >> 3;
    /* PredictorStream keeps the previous and the current row */
    if (!PdfCheckedAdd(rowBytes, rowBytes, &rawSize) || rawSize > 65535L ||
        pixBytes > rowBytes)
    {
        return gFalse;
    }

    return gTrue;
}

/***********************************************************************
 *      StreamMakeFilter
 ***********************************************************************
 * SYNOPSIS:        Create filter.
 * PARAMETERS:      Stream *str1    str1
 *                  char *name    name
 *                  Obj *params    params
 *                  XRef *xref    cross-reference table
 *
 * RETURNS:         result pointer
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static Stream *StreamMakeFilter(Stream *str1, char *name, Obj *params,
    XRef *xref)
{
    long pred; /* parameters */
    long colors;
    long bits;
    long early;
    long encoding;
    GBool byteAlign;
    GBool black;
    long columns, rows;
    Obj obj;

    Stream *str;

    str = gmalloc(sizeof(Stream));
    if (!str)
    {
        return str1;
    }

    if (!strcmp(name, "ASCIIHexDecode") || !strcmp(name, "AHx"))
    {
        ASCIIHexStreamInit(str, str1);
    }
    else if (!strcmp(name, "ASCII85Decode") || !strcmp(name, "A85"))
    {
        ASCII85StreamInit(str, str1);
    }
    else if (!strcmp(name, "LZWDecode") || !strcmp(name, "LZW"))
    {
        pred = 1;
        columns = 1;
        colors = 1;
        bits = 8;
        early = 1;
        if (isDict(params))
        {
            ObjDictLookup(params, "Predictor", &obj, xref);
            if (isInt(&obj))
            {
                pred = getInt(&obj);
            }
            ObjFree(&obj);
            ObjDictLookup(params, "Columns", &obj, xref);
            if (isInt(&obj))
            {
                columns = getInt(&obj);
            }
            ObjFree(&obj);
            ObjDictLookup(params, "Colors", &obj, xref);
            if (isInt(&obj))
            {
                colors = getInt(&obj);
            }
            ObjFree(&obj);
            ObjDictLookup(params, "BitsPerComponent", &obj, xref);
            if (isInt(&obj))
            {
                bits = getInt(&obj);
            }
            ObjFree(&obj);
            ObjDictLookup(params, "EarlyChange", &obj, xref);
            if (isInt(&obj))
            {
                early = getInt(&obj);
            }
            ObjFree(&obj);
        }
        if (!StreamValidPredictorParams(pred, columns, colors, bits) ||
            (early != 0 && early != 1))
        {
            EC_WARNING(-1);
            EOFStreamInit(str, str1);
        }
        else
        {
            LZWStreamInit(str, str1, early);
            str = PredictorStreamWrap(str, pred, columns, colors, bits);
        }
    }
    else if (!strcmp(name, "RunLengthDecode") || !strcmp(name, "RL"))
    {
        RunLengthStreamInit(str, str1);
    }
    else if (!strcmp(name, "CCITTFaxDecode") || !strcmp(name, "CCF"))
    {
        encoding = 0;
        byteAlign = gFalse;
        columns = 1728;
        rows = 0;
        black = gFalse;
        if (isDict(params))
        {
            ObjDictLookup(params, "K", &obj, xref);
            if (isInt(&obj))
            {
                encoding = getInt(&obj);
            }
            ObjFree(&obj);
            ObjDictLookup(params, "EncodedByteAlign", &obj, xref);
            if (isBool(&obj))
            {
                byteAlign = getBool(&obj);
            }
            ObjFree(&obj);
            ObjDictLookup(params, "Columns", &obj, xref);
            if (isInt(&obj))
            {
                columns = getInt(&obj);
            }
            ObjFree(&obj);
            ObjDictLookup(params, "Rows", &obj, xref);
            if (isInt(&obj))
            {
                rows = getInt(&obj);
            }
            ObjFree(&obj);
            ObjDictLookup(params, "BlackIs1", &obj, xref);
            if (isBool(&obj))
            {
                black = getBool(&obj);
            }
            ObjFree(&obj);
        }
        if (columns < 1 || columns > PDF_MAX_CCITT_COLUMNS || rows < 0)
        {
            EC_WARNING(-1);
            EOFStreamInit(str, str1);
        }
        else
        {
            CCITTFaxStreamInit(str, str1, encoding, byteAlign, columns, rows,
                black);
        }
    }
    else if (!strcmp(name, "DCTDecode") || !strcmp(name, "DCT"))
    {
        DCTStreamInit(str, str1);
    }
    else if (!strcmp(name, "FlateDecode") || !strcmp(name, "Fl"))
    {
        pred = 1;
        columns = 1;
        colors = 1;
        bits = 8;
        if (isDict(params))
        {
            ObjDictLookup(params, "Predictor", &obj, xref);
            if (isInt(&obj))
            {
                pred = getInt(&obj);
            }
            ObjFree(&obj);
            ObjDictLookup(params, "Columns", &obj, xref);
            if (isInt(&obj))
            {
                columns = getInt(&obj);
            }
            ObjFree(&obj);
            ObjDictLookup(params, "Colors", &obj, xref);
            if (isInt(&obj))
            {
                colors = getInt(&obj);
            }
            ObjFree(&obj);
            ObjDictLookup(params, "BitsPerComponent", &obj, xref);
            if (isInt(&obj))
            {
                bits = getInt(&obj);
            }
            ObjFree(&obj);
        }
        if (!StreamValidPredictorParams(pred, columns, colors, bits))
        {
            EC_WARNING(-1);
            EOFStreamInit(str, str1);
        }
        else
        {
            FlateStreamInit(str, str1);
            str = PredictorStreamWrap(str, pred, columns, colors, bits);
        }
    }
    else
    {
        EC_WARNING(-1);

        EOFStreamInit(str, str1);
    }

    return str;
}

/* PredictorStream */

/***********************************************************************
 *      PredictorStreamWrap
 ***********************************************************************
 * SYNOPSIS:        Put a PredictorStream on top of a decoded stream.
 * PARAMETERS:      Stream *str1    Flate/LZW stream to wrap
 *                  long pred, columns, colors, bits    /DecodeParms
 *                                  (already checked by
 *                                  StreamValidPredictorParams)
 *
 * RETURNS:         the new stream, or str1 itself for predictor 1
 *
 * STRATEGY:
 *      Out of memory: return an EOF stream instead of handing out the
 *      still-predicted bytes as if they were plain data.
 *
 ***********************************************************************/

static Stream *PredictorStreamWrap(Stream *str1, long pred, long columns,
    long colors, long bits)
{
    Stream *str;
    PredictorData *pd;
    long rowBytes, pixBytes;

    if (pred <= 1)
    {
        return str1;
    }

    str = gmalloc(sizeof(Stream));
    if (!str)
    {
        /* nothing better possible than the undecoded data */
        return str1;
    }
    StreamInit(str);
    str->str = str1;
    str->kind = strPredictor;

    rowBytes = (columns * colors * bits + 7) >> 3;
    pixBytes = (colors * bits + 7) >> 3;

    pd = str->u.pred = gmalloc(sizeof(PredictorData));
    if (pd)
    {
        pd->lines = gmalloc(2 * rowBytes);
    }
    if (!pd || !pd->lines)
    {
        gfree(pd);
        str->u.pred = NULL;
        EOFStreamInit(str, str1);
        return str;
    }

    pd->predictor = (short)pred;
    pd->nComps = (short)colors;
    pd->nBits = (short)bits;
    pd->pixBytes = (short)pixBytes;
    pd->width = columns;
    pd->rowBytes = (word)rowBytes;
    /*
     * Do not reset str1 here: the filter is built while the parser is
     * still reading the stream object, and resetting would move the
     * shared file position. The caller resets the chain before reading.
     */
    PredictorStreamResetLines(pd);
    return str;
}

/***********************************************************************
 *      PredictorStreamFree
 ***********************************************************************/

static void PredictorStreamFree(Stream *str)
{
    if (str->u.pred)
    {
        gfree(str->u.pred->lines);
        gfree(str->u.pred);
        str->u.pred = NULL;
    }
}

/***********************************************************************
 *      PredictorStreamReset
 ***********************************************************************
 * SYNOPSIS:        Restart at the first row; the row above the first
 *                  one counts as all zero.
 ***********************************************************************/

static void PredictorStreamResetLines(PredictorData *pd)
{
    memset(pd->lines, 0, 2 * pd->rowBytes);
    pd->prevLine = pd->lines;
    pd->curLine = pd->lines + pd->rowBytes;
    pd->lineIdx = pd->rowBytes;
    pd->eof = gFalse;
}

static void PredictorStreamReset(Stream *str)
{
    StreamReset(str->str);
    PredictorStreamResetLines(str->u.pred);
}

/***********************************************************************
 *      PredictorStreamFillLine
 ***********************************************************************
 * SYNOPSIS:        Read and un-predict the next row.
 * RETURNS:         gFalse at the end of the data
 *
 * STRATEGY:
 *      PNG (10-15): every row starts with its own filter type byte --
 *      the /Predictor value only says "PNG", it does not pick the
 *      filter. a = byte one pixel to the left, b = byte above,
 *      c = byte above-left (0 outside the image).
 *      TIFF (2): each component is the difference to the same
 *      component of the previous pixel; for 1/2/4 bits the samples are
 *      unpacked, summed per component and packed again in place.
 *      Same algorithm as xpdf's StreamPredictor::getNextLine.
 ***********************************************************************/

static GBool PredictorStreamFillLine(Stream *str)
{
    PredictorData *pd = str->u.pred;
    Guchar *cur, *prev, *tmp;
    word i, n, rowBytes = pd->rowBytes, pb = pd->pixBytes;
    short curPred;
    long c;
    int a, b, cc, p, pa, pbb, pc;

    if (pd->eof)
    {
        return gFalse;
    }

    /* the old current row becomes the row above */
    tmp = pd->prevLine;
    pd->prevLine = pd->curLine;
    pd->curLine = tmp;
    cur = pd->curLine;
    prev = pd->prevLine;

    if (pd->predictor >= 10)
    {
        if ((c = StreamGetChar(str->str)) == EOF)
        {
            pd->eof = gTrue;
            return gFalse;
        }
        curPred = (short)c + 10;
    }
    else
    {
        curPred = pd->predictor;
    }

    n = StreamRead(str->str, cur, rowBytes);
    if (n == 0)
    {
        pd->eof = gTrue;
        return gFalse;
    }
    if (n < rowBytes)
    {
        /* short last row: decode what is there, then stop */
        memset(cur + n, 0, rowBytes - n);
        pd->eof = gTrue;
    }

    switch (curPred)
    {
        case 11: /* PNG sub */
            for (i = pb; i < rowBytes; ++i)
            {
                cur[i] += cur[i - pb];
            }
            break;
        case 12: /* PNG up */
            for (i = 0; i < rowBytes; ++i)
            {
                cur[i] += prev[i];
            }
            break;
        case 13: /* PNG average */
            for (i = 0; i < rowBytes; ++i)
            {
                a = (i >= pb) ? cur[i - pb] : 0;
                cur[i] += (Guchar)((a + prev[i]) >> 1);
            }
            break;
        case 14: /* PNG Paeth */
            for (i = 0; i < rowBytes; ++i)
            {
                a = (i >= pb) ? cur[i - pb] : 0;
                b = prev[i];
                cc = (i >= pb) ? prev[i - pb] : 0;
                p = a + b - cc;
                pa = (p > a) ? p - a : a - p;
                pbb = (p > b) ? p - b : b - p;
                pc = (p > cc) ? p - cc : cc - p;
                if (pa <= pbb && pa <= pc)
                {
                    cur[i] += (Guchar)a;
                }
                else if (pbb <= pc)
                {
                    cur[i] += (Guchar)b;
                }
                else
                {
                    cur[i] += (Guchar)cc;
                }
            }
            break;
        case 2: /* TIFF */
            if (pd->nBits == 8)
            {
                for (i = pb; i < rowBytes; ++i)
                {
                    cur[i] += cur[i - pb];
                }
            }
            else if (pd->nBits == 16)
            {
                word sum;

                for (i = pb; i + 1 < rowBytes; i += 2)
                {
                    sum = (((word)cur[i] << 8) | cur[i + 1]) +
                        (((word)cur[i - pb] << 8) | cur[i + 1 - pb]);
                    cur[i] = (Guchar)(sum >> 8);
                    cur[i + 1] = (Guchar)sum;
                }
            }
            else
            {
                Gulong inBuf = 0, outBuf = 0;
                short inBits = 0, outBits = 0, k;
                word bitMask = (1 << pd->nBits) - 1;
                word in = 0, out = 0;
                long x;

                memset(pd->compBuf, 0, pd->nComps);
                for (x = 0; x < pd->width; ++x)
                {
                    for (k = 0; k < pd->nComps; ++k)
                    {
                        if (inBits < pd->nBits)
                        {
                            inBuf = (inBuf << 8) | cur[in++];
                            inBits += 8;
                        }
                        pd->compBuf[k] = (Guchar)((pd->compBuf[k] +
                            (inBuf >> (inBits - pd->nBits))) & bitMask);
                        inBits -= pd->nBits;
                        outBuf = (outBuf << pd->nBits) | pd->compBuf[k];
                        outBits += pd->nBits;
                        if (outBits >= 8)
                        {
                            cur[out++] = (Guchar)(outBuf >> (outBits - 8));
                            outBits -= 8;
                        }
                    }
                }
                if (outBits > 0)
                {
                    /* keep the padding bits of the last byte */
                    cur[out] = (Guchar)((outBuf << (8 - outBits)) +
                        (inBuf & ((1 << (8 - outBits)) - 1)));
                }
            }
            break;
        case 10: /* PNG none */
        default: /* unknown PNG filter type: pass the bytes through */
            break;
    }

    pd->lineIdx = 0;
    return gTrue;
}

/***********************************************************************
 *      PredictorStreamGetChar / PredictorStreamLookChar
 ***********************************************************************/

static long PredictorStreamGetChar(Stream *str)
{
    PredictorData *pd = str->u.pred;

    if (pd->lineIdx >= pd->rowBytes && !PredictorStreamFillLine(str))
    {
        return EOF;
    }
    return pd->curLine[pd->lineIdx++];
}

static long PredictorStreamLookChar(Stream *str)
{
    PredictorData *pd = str->u.pred;

    if (pd->lineIdx >= pd->rowBytes && !PredictorStreamFillLine(str))
    {
        return EOF;
    }
    return pd->curLine[pd->lineIdx];
}

/***********************************************************************
 *      PredictorStreamRead
 ***********************************************************************
 * SYNOPSIS:        Bulk read; copies whole row pieces at once.
 ***********************************************************************/

static word PredictorStreamRead(Stream *str, Guchar *buf, word size)
{
    PredictorData *pd = str->u.pred;
    word done = 0, chunk;

    while (done < size)
    {
        if (pd->lineIdx >= pd->rowBytes && !PredictorStreamFillLine(str))
        {
            break;
        }
        chunk = pd->rowBytes - pd->lineIdx;
        if (chunk > size - done)
        {
            chunk = size - done;
        }
        memcpy(buf + done, pd->curLine + pd->lineIdx, chunk);
        pd->lineIdx += chunk;
        done += chunk;
    }
    return done;
}

/* ObjStmCacheStream */

/***********************************************************************
 *      ObjStmCacheStreamFill
 ***********************************************************************
 * SYNOPSIS:        Fill.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static GBool ObjStmCacheStreamFill(Stream *str)
{
    ObjStmCacheStreamData *d = str->u.objStmCache;
    Guchar *src;
    word avail, n;

    if (!d || d->pos >= d->length)
    {
        return gFalse;
    }

    HugeArrayLock(d->vmFile, d->data, d->pos, (void **) & src, &avail);
    if (!src || avail == 0)
    {
        return gFalse;
    }

    n = avail;
    if (n > objStmCacheReadBufSize)
    {
        n = objStmCacheReadBufSize;
    }
    if ((long)n > d->length - d->pos)
    {
        n = (word)(d->length - d->pos);
    }
    memcpy(d->buf, src, n);
    HugeArrayUnlock(src);
    d->bufIndex = 0;
    d->bufCount = n;
    return n != 0;
}

/***********************************************************************
 *      ObjStmCacheStreamInit
 ***********************************************************************
 * SYNOPSIS:        Initialize.
 * PARAMETERS:      Stream *str    string
 *                  VMFileHandle vmFile    vm file
 *                  VMBlockHandle data    data
 *                  long start    start
 *                  long length    length
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

GBool ObjStmCacheStreamInit(Stream *str, VMFileHandle vmFile,
    VMBlockHandle data, long start, long length)
{
    ObjStmCacheStreamData *d;

    StreamInit(str);
    if (!data || start < 0 || length < 0 || start > length)
    {
        return gFalse;
    }

    d = (ObjStmCacheStreamData *)gmalloc(sizeof(ObjStmCacheStreamData));
    if (!d)
    {
        return gFalse;
    }

    str->kind = strObjStmCache;
    str->u.objStmCache = d;
    d->vmFile = vmFile;
    d->data = data;
    d->start = start;
    d->pos = start;
    d->length = length;
    d->bufIndex = d->bufCount = 0;
    return gTrue;
}

/***********************************************************************
 *      ObjStmCacheStreamFree
 ***********************************************************************
 * SYNOPSIS:        Release.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void ObjStmCacheStreamFree(Stream *str)
{
    gfree(str->u.objStmCache);
    str->u.objStmCache = NULL;
}

/***********************************************************************
 *      ObjStmCacheStreamReset
 ***********************************************************************
 * SYNOPSIS:        Reset.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void ObjStmCacheStreamReset(Stream *str)
{
    ObjStmCacheStreamData *d = str->u.objStmCache;
    d->pos = d->start;
    d->bufIndex = d->bufCount = 0;
}

/***********************************************************************
 *      ObjStmCacheStreamGetChar
 ***********************************************************************
 * SYNOPSIS:        Get char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

long ObjStmCacheStreamGetChar(Stream *str)
{
    ObjStmCacheStreamData *d = str->u.objStmCache;
    long c;

    if (d->bufIndex >= d->bufCount && !ObjStmCacheStreamFill(str))
    {
        return EOF;
    }
    c = d->buf[d->bufIndex++];
    ++d->pos;
    return c;
}

/***********************************************************************
 *      ObjStmCacheStreamLookChar
 ***********************************************************************
 * SYNOPSIS:        Process object stm cache stream look char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

long ObjStmCacheStreamLookChar(Stream *str)
{
    ObjStmCacheStreamData *d = str->u.objStmCache;

    if (d->bufIndex >= d->bufCount && !ObjStmCacheStreamFill(str))
    {
        return EOF;
    }
    return d->buf[d->bufIndex];
}

/***********************************************************************
 *      ObjStmCacheStreamGetLength
 ***********************************************************************
 * SYNOPSIS:        Get length.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:

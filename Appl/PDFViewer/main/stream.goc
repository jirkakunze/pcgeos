/********************************************************************
 *                      StreamSetPos
 ********************************************************************
 * SYNOPSIS:      Set the file position of the base file stream.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *                pos1                  New position; negative: from the end of
 *                                      the file.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
void StreamSetPos(Stream *str, long pos1)
{

    EC(ECCheckBounds(str));

    if (str->kind == strFile)
    {
        FStreamSetPos(str, pos1);
    }
    else
    {
        StreamSetPos(str->str, pos1);
    }
}

/********************************************************************
 *                      StreamGetLine
 ********************************************************************
 * SYNOPSIS:      Read one line (LF, CR or CR LF).
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *                *buf                  Ptr to the destination buffer.
 *                size                  Size of buf, with the NUL.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
void StreamGetLine(Stream *str, char *buf, word size)
{
    word i;
    short c;

    if (StreamLookChar(str) == EOF)
    {
        buf[0] = '\0';
        return;
    }
    for (i = 0; i < size - 1; ++i)
    {
        c = StreamGetChar(str);
        if (c == EOF || c == '\n')
        {
            break;
        }
        if (c == '\r')
        {
            if ((c = StreamLookChar(str)) == '\n')
            {
                StreamGetChar(str);
            }
            break;
        }
        buf[i] = c;
    }
    buf[i] = '\0';
}

/********************************************************************
 *                      StreamResetImage
 ********************************************************************
 * SYNOPSIS:      Reset a stream for reading image pixels.
 *
 * PARAMETERS:    *stream               Ptr to the stream.
 *                width1                Image width in pixels.
 *                nComps1               Components per pixel.
 *                nBits1                Bits per component.
 *
 * RETURNS:       GBool                 gFalse if the row is too large or there
 *                                      is no memory.
 *
 * STRATEGY:      The raw and the unpacked row buffers are allocated with the
 *                row size. 8-bit images get no unpacked row buffer.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
GBool StreamResetImage(Stream *stream, word width1, short nComps1, short nBits1)
{
    long nVals, rowBytes;

    StreamReset(stream);

    /* check the sizes in 32 bits, then keep them as words */
    nVals = (long)width1 * nComps1;
    rowBytes = (nVals * nBits1 + 7) >> 3;
    if (rowBytes < 1 || rowBytes > 65535L || nVals + 7 > 65535L)
    {
        return gFalse;
    }
    stream->width = width1;
    stream->nComps = nComps1;
    stream->nBits = nBits1;
    stream->nVals = (word)nVals;
    stream->rowBytes = (word)rowBytes;
    {
        Guchar *newRawLine;
        Guchar *newPixLine;

        newRawLine = (Guchar *)grealloc(stream->rawLine, stream->rowBytes);
        if (!newRawLine)
        {
            return gFalse;
        }
        stream->rawLine = newRawLine;

        /*
         * 8-bit samples need no unpacking: StreamGetImagePixel reads them
         * from rawLine. Release a buffer of an earlier reset.
         */
        if (nBits1 == 8)
        {
            gfree(stream->pixLine);
            stream->pixLine = NULL;
        }
        else
        {
            newPixLine = (Guchar *)grealloc(stream->pixLine,
                ((stream->nVals + 7) & ~7) * sizeof(Guchar));
            if (!newPixLine)
            {
                return gFalse;
            }
            stream->pixLine = newPixLine;
        }
    }
    stream->pixIdx = stream->nVals;
    return gTrue;
}

/********************************************************************
 *                      StreamGetImagePixel
 ********************************************************************
 * SYNOPSIS:      Return the components of the next pixel.
 *
 * PARAMETERS:    *this                 Ptr to the stream.
 *                *pix                  Ptr to the components (out), one byte
 *                                      each.
 *
 * RETURNS:       GBool                 gTrue, EOF at the end of the data.
 *
 * STRATEGY:      Read and unpack one row at a time. 16-bit samples keep the
 *                high byte; truncated rows are filled with 0. 8-bit samples
 *                are read from the raw row (no copy).
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
GBool StreamGetImagePixel(Stream *this, Guchar *pix)
{
    Gulong buf, bitMask;
    word c;
    short bits;
    word n;
    word i, j;
    Guchar *line;

    if (this->pixIdx >= this->nVals)
    {
        n = StreamRead(this, this->rawLine, (word)this->rowBytes);
        if (n == 0)
        {
            return EOF;
        }
        if (n < (word)this->rowBytes)
        {
            /* truncated image data -- fill the rest of the row */
            memset(this->rawLine + n, 0, (word)this->rowBytes - n);
        }

        /* Only 8-bit images may be without the unpacked row buffer */
        EC_ERROR_IF(this->nBits != 8 && this->pixLine == NULL, -1);

        if (this->nBits == 8)
        {
            /*
             * Nothing to unpack: the pixels are read from rawLine below.
             * This branch is necessary: 8-bit images have no pixLine.
             */
        }
        else if (this->nBits == 1)
        {
            for (i = 0, j = 0; i < this->nVals; i += 8, ++j)
            {
                c = this->rawLine[j];
                this->pixLine[i + 0] = (Guchar)((c >> 7) & 1);
                this->pixLine[i + 1] = (Guchar)((c >> 6) & 1);
                this->pixLine[i + 2] = (Guchar)((c >> 5) & 1);
                this->pixLine[i + 3] = (Guchar)((c >> 4) & 1);
                this->pixLine[i + 4] = (Guchar)((c >> 3) & 1);
                this->pixLine[i + 5] = (Guchar)((c >> 2) & 1);
                this->pixLine[i + 6] = (Guchar)((c >> 1) & 1);
                this->pixLine[i + 7] = (Guchar)(c & 1);
            }
        }
        else if (this->nBits == 16)
        {
            /* big-endian samples: keep the high byte */
            for (i = 0, j = 0; i < this->nVals; ++i, j += 2)
            {
                this->pixLine[i] = this->rawLine[j];
            }
        }
        else
        {
            /* Other bit depths: unpack from a bit buffer */
            bitMask = (1 << this->nBits) - 1;
            buf = 0;
            bits = 0;
            j = 0;
            for (i = 0; i < this->nVals; ++i)
            {
                if (bits < this->nBits)
                {
                    buf = (buf << 8) | (this->rawLine[j++] & 0xff);
                    bits += 8;
                }
                this->pixLine[i] =
                    (Guchar)((buf >> (bits - this->nBits)) & bitMask);
                bits -= this->nBits;
            }
        }

        this->pixIdx = 0;
    }

    /* 8-bit samples: rawLine is the pixel row (rowBytes == nVals) */
    line = (this->nBits == 8) ? this->rawLine : this->pixLine;
    EC_ERROR_IF(line == NULL, -1);
    for (i = 0; i < this->nComps; ++i)
    {
        pix[i] = line[this->pixIdx++];
    }
    return gTrue;
}

/********************************************************************
 *                      StreamAddFilters
 ********************************************************************
 * SYNOPSIS:      Add the filters of a stream dictionary to a stream.
 *
 * PARAMETERS:    *str1                 Ptr to the base stream.
 *                *dict                 Ptr to the stream dictionary.
 *                *xref                 Ptr to the cross-reference table.
 *
 * RETURNS:       Stream *              Ptr to the last filter (str1 if there
 *                                      are none).
 *
 * STRATEGY:      /Filter and /DecodeParms (also /F and /DP), one name or an
 *                array. An unknown filter gives an EOF stream. The filters are
 *                not reset here.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
Stream *StreamAddFilters(Stream *str1, Obj *dict, XRef *xref)
{
    Obj obj, obj2;
    Obj params, params2;
    Stream *str;
    Stream *oldStr;
    word i;

    str = str1;
    ObjDictLookup(dict, "Filter", &obj, xref);
    if (isNull(&obj))
    {
        ObjFree(&obj);
        ObjDictLookup(dict, "F", &obj, xref);
    }
    ObjDictLookup(dict, "DecodeParms", &params, xref);
    if (isNull(&params))
    {
        ObjFree(&params);
        ObjDictLookup(dict, "DP", &params, xref);
    }
    if (isName(&obj))
    {
        str = StreamMakeFilter(str, getName(&obj), &params, xref);
    }
    else if (isArray(&obj))
    {

        for (i = 0; i < ObjArrayGetLength(&obj); ++i)
        {
            ObjArrayGet(&obj, i, &obj2, xref);
            if (isArray(&params))
            {
                ObjArrayGet(&params, i, &params2, xref);
            }
            else
            {
                initNull(&params2);
            }
            if (isName(&obj2))
            {
                str = StreamMakeFilter(str, getName(&obj2), &params2, xref);
            }
            else
            {
                EC_WARNING(-1);

                oldStr = str;
                str = gmalloc(sizeof(Stream));
                if (!str)
                {
                    str = oldStr;
                    ObjFree(&obj2);
                    ObjFree(&params2);
                    break;
                }
                EOFStreamInit(str, oldStr);
            }
            ObjFree(&obj2);
            ObjFree(&params2);
        }
    }
    else if (!isNull(&obj))
    {
        EC_WARNING(-1);

    }
    ObjFree(&obj);
    ObjFree(&params);

    return str;
}

/********************************************************************
 *                      StreamValidPredictorParams
 ********************************************************************
 * SYNOPSIS:      Check predictor parameters.
 *
 * PARAMETERS:    pred                  /Predictor.
 *                columns               /Columns.
 *                colors                /Colors.
 *                bits                  /BitsPerComponent.
 *
 * RETURNS:       GBool                 gTrue if the values are valid and the
 *                                      two rows fit into one block.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static GBool StreamValidPredictorParams(long pred, long columns, long colors,
    long bits)
{
    long nVals, rowBits, rowBytes, pixBits, pixBytes, rawSize;

    if (pred == 1)
    {
        return gTrue;
    }
    if (!(pred == 2 || (pred >= 10 && pred <= 15)))
    {
        return gFalse;
    }
    if (columns < 1 || colors < 1 || colors > 32)
    {
        return gFalse;
    }
    if (!(bits == 1 || bits == 2 || bits == 4 || bits == 8 || bits == 16))
    {
        return gFalse;
    }

    /* Check all sizes before a product can overflow a long */
    if (!PdfCheckedMul(columns, colors, &nVals) ||
        nVals > PDF_MAX_PREDICTOR_VALUES ||
        !PdfCheckedMul(nVals, bits, &rowBits) ||
        !PdfCheckedAdd(rowBits, 7, &rowBits) ||
        !PdfCheckedMul(colors, bits, &pixBits) ||
        !PdfCheckedAdd(pixBits, 7, &pixBits))
    {
        return gFalse;
    }

    rowBytes = rowBits >> 3;
    pixBytes = pixBits >> 3;
    /* PredictorStream keeps the previous and the current row */
    if (!PdfCheckedAdd(rowBytes, rowBytes, &rawSize) || rawSize > 65535L ||
        pixBytes > rowBytes)
    {
        return gFalse;
    }

    return gTrue;
}

/********************************************************************
 *                      StreamMakeFilter
 ********************************************************************
 * SYNOPSIS:      Make one filter stream.
 *
 * PARAMETERS:    *str1                 Ptr to the stream to decode.
 *                *name                 Ptr to the filter name (also the short
 *                                      names).
 *                *params               Ptr to the /DecodeParms object.
 *                *xref                 Ptr to the cross-reference table.
 *
 * RETURNS:       Stream *              Ptr to the new stream, str1 if there is
 *                                      no memory.
 *
 * STRATEGY:      Bad parameters or an unknown filter give an EOF stream. Flate
 *                and LZW get a predictor stream if /Predictor > 1.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static Stream *StreamMakeFilter(Stream *str1, char *name, Obj *params,
    XRef *xref)
{
    long pred;
    long colors;
    long bits;
    long early;
    long encoding;
    GBool byteAlign;
    GBool black;
    long columns, rows;
    Obj obj;

    Stream *str;

    str = gmalloc(sizeof(Stream));
    if (!str)
    {
        return str1;
    }

    if (!strcmp(name, "ASCIIHexDecode") || !strcmp(name, "AHx"))
    {
        ASCIIHexStreamInit(str, str1);
    }
    else if (!strcmp(name, "ASCII85Decode") || !strcmp(name, "A85"))
    {
        ASCII85StreamInit(str, str1);
    }
    else if (!strcmp(name, "LZWDecode") || !strcmp(name, "LZW"))
    {
        pred = 1;
        columns = 1;
        colors = 1;
        bits = 8;
        early = 1;
        if (isDict(params))
        {
            ObjDictLookup(params, "Predictor", &obj, xref);
            if (isInt(&obj))
            {
                pred = getInt(&obj);
            }
            ObjFree(&obj);
            ObjDictLookup(params, "Columns", &obj, xref);
            if (isInt(&obj))
            {
                columns = getInt(&obj);
            }
            ObjFree(&obj);
            ObjDictLookup(params, "Colors", &obj, xref);
            if (isInt(&obj))
            {
                colors = getInt(&obj);
            }
            ObjFree(&obj);
            ObjDictLookup(params, "BitsPerComponent", &obj, xref);
            if (isInt(&obj))
            {
                bits = getInt(&obj);
            }
            ObjFree(&obj);
            ObjDictLookup(params, "EarlyChange", &obj, xref);
            if (isInt(&obj))
            {
                early = getInt(&obj);
            }
            ObjFree(&obj);
        }
        if (!StreamValidPredictorParams(pred, columns, colors, bits) ||
            (early != 0 && early != 1))
        {
            EC_WARNING(-1);
            EOFStreamInit(str, str1);
        }
        else
        {
            LZWStreamInit(str, str1, (short)early);
            str = PredictorStreamWrap(str, pred, columns, colors, bits);
        }
    }
    else if (!strcmp(name, "RunLengthDecode") || !strcmp(name, "RL"))
    {
        RunLengthStreamInit(str, str1);
    }
    else if (!strcmp(name, "CCITTFaxDecode") || !strcmp(name, "CCF"))
    {
        encoding = 0;
        byteAlign = gFalse;
        columns = 1728;
        rows = 0;
        black = gFalse;
        if (isDict(params))
        {
            ObjDictLookup(params, "K", &obj, xref);
            if (isInt(&obj))
            {
                encoding = getInt(&obj);
            }
            ObjFree(&obj);
            ObjDictLookup(params, "EncodedByteAlign", &obj, xref);
            if (isBool(&obj))
            {
                byteAlign = getBool(&obj);
            }
            ObjFree(&obj);
            ObjDictLookup(params, "Columns", &obj, xref);
            if (isInt(&obj))
            {
                columns = getInt(&obj);
            }
            ObjFree(&obj);
            ObjDictLookup(params, "Rows", &obj, xref);
            if (isInt(&obj))
            {
                rows = getInt(&obj);
            }
            ObjFree(&obj);
            ObjDictLookup(params, "BlackIs1", &obj, xref);
            if (isBool(&obj))
            {
                black = getBool(&obj);
            }
            ObjFree(&obj);
        }
        if (columns < 1 || columns > PDF_MAX_CCITT_COLUMNS || rows < 0)
        {
            EC_WARNING(-1);
            EOFStreamInit(str, str1);
        }
        else
        {
            CCITTFaxStreamInit(str, str1, encoding, byteAlign, columns, rows,
                black);
        }
    }
    else if (!strcmp(name, "DCTDecode") || !strcmp(name, "DCT"))
    {
        DCTStreamInit(str, str1);
    }
    else if (!strcmp(name, "FlateDecode") || !strcmp(name, "Fl"))
    {
        pred = 1;
        columns = 1;
        colors = 1;
        bits = 8;
        if (isDict(params))
        {
            ObjDictLookup(params, "Predictor", &obj, xref);
            if (isInt(&obj))
            {
                pred = getInt(&obj);
            }
            ObjFree(&obj);
            ObjDictLookup(params, "Columns", &obj, xref);
            if (isInt(&obj))
            {
                columns = getInt(&obj);
            }
            ObjFree(&obj);
            ObjDictLookup(params, "Colors", &obj, xref);
            if (isInt(&obj))
            {
                colors = getInt(&obj);
            }
            ObjFree(&obj);
            ObjDictLookup(params, "BitsPerComponent", &obj, xref);
            if (isInt(&obj))
            {
                bits = getInt(&obj);
            }
            ObjFree(&obj);
        }
        if (!StreamValidPredictorParams(pred, columns, colors, bits))
        {
            EC_WARNING(-1);
            EOFStreamInit(str, str1);
        }
        else
        {
            FlateStreamInit(str, str1);
            str = PredictorStreamWrap(str, pred, columns, colors, bits);
        }
    }
    else
    {
        EC_WARNING(-1);

        EOFStreamInit(str, str1);
    }

    return str;
}

/********************************************************************
 *                      PredictorStreamWrap
 ********************************************************************
 * SYNOPSIS:      Put a predictor stream on top of a Flate or LZW stream.
 *
 * PARAMETERS:    *str1                 Ptr to the decoded stream.
 *                pred                  /Predictor.
 *                columns               /Columns.
 *                colors                /Colors.
 *                bits                  /BitsPerComponent.
 *
 * RETURNS:       Stream *              Ptr to the predictor stream, str1 for
 *                                      predictor 1 or if there is no memory.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static Stream *PredictorStreamWrap(Stream *str1, long pred, long columns,
    long colors, long bits)
{
    Stream *str;
    PredictorData *pd;
    long rowBytes, pixBytes;

    if (pred <= 1)
    {
        return str1;
    }

    str = gmalloc(sizeof(Stream));
    if (!str)
    {
        /* nothing better possible than the undecoded data */
        return str1;
    }
    StreamInit(str);
    str->str = str1;
    str->kind = strPredictor;

    rowBytes = (columns * colors * bits + 7) >> 3;
    pixBytes = (colors * bits + 7) >> 3;

    /* Row buffers come with the first reset: most streams are not read */
    pd = str->u.pred = gmalloc(sizeof(PredictorData));
    if (!pd)
    {
        EOFStreamInit(str, str1);
        return str;
    }
    pd->lines = NULL;

    pd->predictor = (short)pred;
    pd->nComps = (short)colors;
    pd->nBits = (short)bits;
    pd->pixBytes = (short)pixBytes;
    pd->width = columns;
    pd->rowBytes = (word)rowBytes;
    /* No reset here: the parser still reads the stream object */
    pd->lineIdx = pd->rowBytes;
    pd->eof = gTrue;            /* nothing to read until the first reset */
    return str;
}

/********************************************************************
 *                      PredictorStreamFree
 ********************************************************************
 * SYNOPSIS:      Free the predictor data and its rows.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void PredictorStreamFree(Stream *str)
{
    if (str->u.pred)
    {
        gfree(str->u.pred->lines);
        gfree(str->u.pred);
        str->u.pred = NULL;
    }
}

/********************************************************************
 *                      PredictorStreamResetLines
 ********************************************************************
 * SYNOPSIS:      Allocate and clear the two row buffers.
 *
 * PARAMETERS:    *pd                   Ptr to the predictor data.
 *
 * RETURNS:       GBool                 gFalse if there is no memory (the stream
 *                                      is at EOF).
 *
 * STRATEGY:      The row above the first row counts as all 0.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static GBool PredictorStreamResetLines(PredictorData *pd)
{
    if (!pd->lines)
    {
        pd->lines = gmalloc(2L * pd->rowBytes);
        if (!pd->lines)
        {
            pd->eof = gTrue;
            return gFalse;
        }
    }
    memset(pd->lines, 0, 2 * pd->rowBytes);
    pd->prevLine = pd->lines;
    pd->curLine = pd->lines + pd->rowBytes;
    pd->lineIdx = pd->rowBytes;
    pd->eof = gFalse;
    return gTrue;
}

/********************************************************************
 *                      PredictorStreamReset
 ********************************************************************
 * SYNOPSIS:      Start the predictor stream from the beginning.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void PredictorStreamReset(Stream *str)
{
    StreamReset(str->str);
    (void)PredictorStreamResetLines(str->u.pred);
}

/********************************************************************
 *                      PredictorStreamFillLine
 ********************************************************************
 * SYNOPSIS:      Read and decode the next row.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       GBool                 gFalse at the end of the data.
 *
 * STRATEGY:      PNG predictors (10-15): each row starts with its own filter
 *                type. TIFF predictor 2: each component adds the same component
 *                of the pixel on the left; 1, 2 and 4 bits are unpacked, added
 *                and packed again.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static GBool PredictorStreamFillLine(Stream *str)
{
    PredictorData *pd = str->u.pred;
    Guchar *cur, *prev, *tmp;
    word i, n, rowBytes = pd->rowBytes, pb = pd->pixBytes;
    short curPred;
    short c;
    int a, b, cc, p, pa, pbb, pc;

    if (pd->eof)
    {
        return gFalse;
    }

    /* the old current row becomes the row above */
    tmp = pd->prevLine;
    pd->prevLine = pd->curLine;
    pd->curLine = tmp;
    cur = pd->curLine;
    prev = pd->prevLine;

    if (pd->predictor >= 10)
    {
        if ((c = StreamGetChar(str->str)) == EOF)
        {
            pd->eof = gTrue;
            return gFalse;
        }
        curPred = (short)c + 10;
    }
    else
    {
        curPred = pd->predictor;
    }

    n = StreamRead(str->str, cur, rowBytes);
    if (n == 0)
    {
        pd->eof = gTrue;
        return gFalse;
    }
    if (n < rowBytes)
    {
        /* short last row: decode what is there, then stop */
        memset(cur + n, 0, rowBytes - n);
        pd->eof = gTrue;
    }

    switch (curPred)
    {
        case 11: /* PNG sub */
            for (i = pb; i < rowBytes; ++i)
            {
                cur[i] += cur[i - pb];
            }
            break;
        case 12: /* PNG up */
            for (i = 0; i < rowBytes; ++i)
            {
                cur[i] += prev[i];
            }
            break;
        case 13: /* PNG average */
            for (i = 0; i < rowBytes; ++i)
            {
                a = (i >= pb) ? cur[i - pb] : 0;
                cur[i] += (Guchar)((a + prev[i]) >> 1);
            }
            break;
        case 14: /* PNG Paeth */
            for (i = 0; i < rowBytes; ++i)
            {
                a = (i >= pb) ? cur[i - pb] : 0;
                b = prev[i];
                cc = (i >= pb) ? prev[i - pb] : 0;
                p = a + b - cc;
                pa = (p > a) ? p - a : a - p;
                pbb = (p > b) ? p - b : b - p;
                pc = (p > cc) ? p - cc : cc - p;
                if (pa <= pbb && pa <= pc)
                {
                    cur[i] += (Guchar)a;
                }
                else if (pbb <= pc)
                {
                    cur[i] += (Guchar)b;
                }
                else
                {
                    cur[i] += (Guchar)cc;
                }
            }
            break;
        case 2: /* TIFF */
            if (pd->nBits == 8)
            {
                for (i = pb; i < rowBytes; ++i)
                {
                    cur[i] += cur[i - pb];
                }
            }
            else if (pd->nBits == 16)
            {
                word sum;

                for (i = pb; i + 1 < rowBytes; i += 2)
                {
                    sum = (((word)cur[i] << 8) | cur[i + 1]) +
                        (((word)cur[i - pb] << 8) | cur[i + 1 - pb]);
                    cur[i] = (Guchar)(sum >> 8);
                    cur[i + 1] = (Guchar)sum;
                }
            }
            else
            {
                Gulong inBuf = 0, outBuf = 0;
                short inBits = 0, outBits = 0, k;
                word bitMask = (1 << pd->nBits) - 1;
                word in = 0, out = 0;
                word x;

                memset(pd->compBuf, 0, pd->nComps);
                for (x = 0; x < pd->width; ++x)
                {
                    for (k = 0; k < pd->nComps; ++k)
                    {
                        if (inBits < pd->nBits)
                        {
                            inBuf = (inBuf << 8) | cur[in++];
                            inBits += 8;
                        }
                        pd->compBuf[k] = (Guchar)((pd->compBuf[k] +
                            (inBuf >> (inBits - pd->nBits))) & bitMask);
                        inBits -= pd->nBits;
                        outBuf = (outBuf << pd->nBits) | pd->compBuf[k];
                        outBits += pd->nBits;
                        if (outBits >= 8)
                        {
                            cur[out++] = (Guchar)(outBuf >> (outBits - 8));
                            outBits -= 8;
                        }
                    }
                }
                if (outBits > 0)
                {
                    /* keep the padding bits of the last byte */
                    cur[out] = (Guchar)((outBuf << (8 - outBits)) +
                        (inBuf & ((1 << (8 - outBits)) - 1)));
                }
            }
            break;
        case 10: /* PNG none */
        default: /* unknown PNG filter type: pass the bytes through */
            break;
    }

    pd->lineIdx = 0;
    return gTrue;
}

/********************************************************************
 *                      PredictorStreamGetChar
 ********************************************************************
 * SYNOPSIS:      Read the next decoded byte.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Byte, EOF at the end of the data.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short PredictorStreamGetChar(Stream *str)
{
    PredictorData *pd = str->u.pred;

    if (pd->lineIdx >= pd->rowBytes && !PredictorStreamFillLine(str))
    {
        return EOF;
    }
    return pd->curLine[pd->lineIdx++];
}

/********************************************************************
 *                      PredictorStreamLookChar
 ********************************************************************
 * SYNOPSIS:      Return the next decoded byte but do not read it.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Byte, EOF at the end of the data.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short PredictorStreamLookChar(Stream *str)
{
    PredictorData *pd = str->u.pred;

    if (pd->lineIdx >= pd->rowBytes && !PredictorStreamFillLine(str))
    {
        return EOF;
    }
    return pd->curLine[pd->lineIdx];
}

/********************************************************************
 *                      PredictorStreamRead
 ********************************************************************
 * SYNOPSIS:      Read a block of decoded bytes.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *                *buf                  Ptr to the destination buffer.
 *                size                  Number of bytes.
 *
 * RETURNS:       word                  Number of bytes read, less at the end of
 *                                      the data.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static word PredictorStreamRead(Stream *str, Guchar *buf, word size)
{
    PredictorData *pd = str->u.pred;
    word done = 0, chunk;

    while (done < size)
    {
        if (pd->lineIdx >= pd->rowBytes && !PredictorStreamFillLine(str))
        {
            break;
        }
        chunk = pd->rowBytes - pd->lineIdx;
        if (chunk > size - done)
        {
            chunk = size - done;
        }
        memcpy(buf + done, pd->curLine + pd->lineIdx, chunk);
        pd->lineIdx += chunk;
        done += chunk;
    }
    return done;
}

/*
 * Keyed by FileHandle. GEOS reuses file handles, so XRefInit() and XRefFree()
 * invalidate the cache for their file. The buffer is a movable block that is
 * allocated on the first miss, locked only while copying and freed on
 * invalidation (no 2 KB in dgroup).
 */
#define fStreamSharedCacheSize 2048

typedef struct FStreamSharedCache {
    FileHandle file;
    long pos;
    word count;
    MemHandle buf;
} FStreamSharedCache;

static FStreamSharedCache fStreamSharedCache = { 0, 0, 0, NullHandle };

/********************************************************************
 *                      FStreamInvalidateReadCache
 ********************************************************************
 * SYNOPSIS:      Clear the shared file read cache and free its buffer.
 *
 * PARAMETERS:    file                  File handle, 0 for any file.
 *
 * RETURNS:       void
 *
 * STRATEGY:      GEOS reuses file handles: XRefInit and XRefFree call this for
 *                their file.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
void FStreamInvalidateReadCache(FileHandle file)
{
    if (file == 0 || fStreamSharedCache.file == file)
    {
        fStreamSharedCache.file = 0;
        fStreamSharedCache.pos = 0;
        fStreamSharedCache.count = 0;
        if (fStreamSharedCache.buf)
        {
            MemFree(fStreamSharedCache.buf);
            fStreamSharedCache.buf = NullHandle;
        }
    }
}

/********************************************************************
 *                      FStreamReadCached
 ********************************************************************
 * SYNOPSIS:      Read file bytes through the shared read cache.
 *
 * PARAMETERS:    file                  File handle.
 *                pos                   File position.
 *                *dst                  Ptr to the destination.
 *                n                     Number of bytes.
 *
 * RETURNS:       word                  Number of bytes read.
 *
 * STRATEGY:      The cache holds one 2 KB block of one file in a movable block,
 *                locked only while copying. Without memory read directly.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static word FStreamReadCached(FileHandle file, long pos, Guchar *dst, word n)
{
    long cacheEnd;
    word offset;
    word avail;
    word readCount;
    Guchar *buf;

    if (!n)
    {
        return 0;
    }

    cacheEnd = fStreamSharedCache.pos + (long)fStreamSharedCache.count;
    /* Hit: all n bytes are in the cache */
    if (fStreamSharedCache.buf && fStreamSharedCache.file == file &&
        pos >= fStreamSharedCache.pos && pos < cacheEnd)
    {
        offset = (word)(pos - fStreamSharedCache.pos);
        avail = fStreamSharedCache.count - offset;
        if (avail >= n)
        {
            buf = MemLock(fStreamSharedCache.buf);
            memcpy(dst, buf + offset, n);
            MemUnlock(fStreamSharedCache.buf);
            return n;
        }
    }

    FilePos(file, pos, FILE_POS_START);
    if (!fStreamSharedCache.buf)
    {
        fStreamSharedCache.buf = MemAlloc(fStreamSharedCacheSize,
            HF_SWAPABLE, 0);
    }
    if (!fStreamSharedCache.buf)
    {
        /* no memory for the cache: read directly */
        fStreamSharedCache.file = 0;
        fStreamSharedCache.count = 0;
        return FileRead(file, dst, n, FALSE);
    }
    buf = MemLock(fStreamSharedCache.buf);
    readCount = FileRead(file, buf, fStreamSharedCacheSize, FALSE);
    fStreamSharedCache.file = file;
    fStreamSharedCache.pos = pos;
    fStreamSharedCache.count = readCount;

    if (readCount > n)
    {
        readCount = n;
    }
    if (readCount)
    {
        memcpy(dst, buf, readCount);
    }
    MemUnlock(fStreamSharedCache.buf);
    return readCount;
}

/********************************************************************
 *                      FStreamInitWithStorage
 ********************************************************************
 * SYNOPSIS:      Initialize a file stream with given storage.
 *
 * PARAMETERS:    *this                 Ptr to the stream.
 *                *storage              Ptr to the FStream data.
 *                f1                    File handle; the caller owns it.
 *                start1                Start position.
 *                length1               Length, -1 up to the end of the file.
 *                *dict1                Ptr to the stream dictionary; it is
 *                                      moved into the stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void FStreamInitWithStorage(Stream *this, FStream *storage, FileHandle f1,
    long start1, long length1, Obj *dict1)
{
    FStream *myfs;

    StreamInit(this);
    this->kind = strFile;
    myfs = this->u.fs = storage;

    /* The caller owns the file handle */
    myfs->f = f1;
    myfs->start = myfs->bufPos = start1;
    myfs->length = length1;
    myfs->bufPtr = myfs->bufEnd = myfs->buf;
    myfs->savePos = -1;
    ObjMove(&myfs->dict, dict1);

    /* Physical seeking is deferred to FStreamReadCached() on a miss. */
}

/********************************************************************
 *                      FStreamInit
 ********************************************************************
 * SYNOPSIS:      Initialize a stream on a part of a file.
 *
 * PARAMETERS:    *this                 Ptr to the stream.
 *                f1                    File handle; the caller owns it.
 *                start1                Start position.
 *                length1               Length, -1 up to the end of the file.
 *                *dict1                Ptr to the stream dictionary; it is
 *                                      moved into the stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:      No memory: an EOF stream.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
void FStreamInit(Stream *this, FileHandle f1, long start1, long length1,
    Obj *dict1)
{
    FStream *myfs;

    myfs = gmalloc(sizeof(FStream));
    if (!myfs)
    {
        StreamInit(this);
        this->kind = strEOF;
        return;
    }
    FStreamInitWithStorage(this, myfs, f1, start1, length1, dict1);
}

/********************************************************************
 *                      FStreamFree
 ********************************************************************
 * SYNOPSIS:      Free a file stream (not the file).
 *
 * PARAMETERS:    *this                 Ptr to the stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void FStreamFree(Stream *this)
{
    FStream *fs = this->u.fs;

    /* FStream wraps no other stream */

    ObjFree(&fs->dict);
    /* The caller owns fs->f */
    gfree(fs);

}

/********************************************************************
 *                      FStreamReset
 ********************************************************************
 * SYNOPSIS:      Go back to the start of the file stream.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void FStreamReset(Stream *str)
{
    FStream *this = str->u.fs;

    this->savePos = -1;
    this->bufPtr = this->bufEnd = this->buf;
    this->bufPos = this->start;
}

/********************************************************************
 *                      FStreamFillBuf
 ********************************************************************
 * SYNOPSIS:      Read the next block of the file stream.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       GBool                 gFalse at the end of the stream.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static GBool FStreamFillBuf(Stream *str)
{
    FStream *this = str->u.fs;
    word n;

    this->bufPos += this->bufEnd - this->buf;
    /* FStreamReadCached() performs FilePos() only on a shared-cache miss. */
    this->bufPtr = this->bufEnd = this->buf;

    if (this->length >= 0 && this->bufPos >= this->start + this->length)
    {
        return gFalse;
    }
    if (this->length >= 0
        && this->bufPos + sizeof(this->buf) > this->start + this->length)
    {
        n = this->start + this->length - this->bufPos;
    }
    else
    {
        n = sizeof (this->buf);
    }
    n = FStreamReadCached(this->f, this->bufPos, (Guchar *)this->buf, n);
    this->bufEnd = this->buf + n;
    if (this->bufPtr >= this->bufEnd)
    {
        return gFalse;
    }
    return gTrue;
}

/********************************************************************
 *                      FStreamSetPos
 ********************************************************************
 * SYNOPSIS:      Set the position of a file stream.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *                pos1                  New position; negative: from the end of
 *                                      the file.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Only the position is stored; the file is read on the next
 *                cache miss.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void FStreamSetPos(Stream *str, long pos1)
{
    FStream *this = str->u.fs;
    long size;

    if (pos1 >= 0)
    {
        /* Logical seek only; physical seek happens on the next cache miss. */
        this->bufPos = pos1;
    }
    else
    {
        size = FilePos(this->f, 0, FILE_POS_END);
        if (pos1 < -size)
        {
            pos1 = (-size);
        }
        this->bufPos = FilePos(this->f, pos1, FILE_POS_END);
    }
    this->bufPtr = this->bufEnd = this->buf;
}

/********************************************************************
 *                      FStreamGetChar
 ********************************************************************
 * SYNOPSIS:      Read the next byte of a file stream.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Byte, EOF at the end of the data.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
short FStreamGetChar(Stream *str)
{
    FStream *this = str->u.fs;

    return(this->bufPtr >= this->bufEnd &&
        !FStreamFillBuf(str)) ? EOF : (*this->bufPtr++ & 0xff);
}

/********************************************************************
 *                      FStreamLookChar
 ********************************************************************
 * SYNOPSIS:      Return the next byte of a file stream but do not read it.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Byte, EOF at the end of the data.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short FStreamLookChar(Stream *str)
{
    FStream *this = str->u.fs;

    return(this->bufPtr >= this->bufEnd &&
        !FStreamFillBuf(str)) ? EOF : (*this->bufPtr & 0xff);
}

static long FStreamGetLength(Stream *str)
{
    return str->u.fs->length;
}

/********************************************************************
 *                      FStreamGetPos
 ********************************************************************
 * SYNOPSIS:      Return the file position of a file stream.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       long                  File position.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
long FStreamGetPos(Stream *str)
{
    FStream *this = str->u.fs;

    return this->bufPos + (this->bufPtr - this->buf);
}

static FileHandle FStreamGetFile(Stream *str)
{
    return str->u.fs->f;
}

static Dict *FStreamGetDict(Stream *str)
{
    return getDict(&str->u.fs->dict);
}

/********************************************************************
 *                      SubStreamInit
 ********************************************************************
 * SYNOPSIS:      Initialize a substream with its own dictionary.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *                *str1                 Ptr to the base stream (not owned).
 *                *dict1                Ptr to the dictionary to copy.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
void SubStreamInit(Stream *str, Stream *str1, Obj *dict1)
{
    StreamInit(str);
    str->str = str1;

    str->kind = strSubStream;

    ObjCopy(&str->dict, dict1);
    str->eof = gFalse;
}

static void SubStreamFree(Stream *str)
{
    ObjFree(&str->dict);
}

static void SubStreamReset(Stream *str)
{
    str->eof = gFalse;
}

static Dict *SubStreamGetDict(Stream *str)
{
    return getDict(&str->dict);
}

/********************************************************************
 *                      EOFStreamInit
 ********************************************************************
 * SYNOPSIS:      Make a stream that is always at its end.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *                *str2                 Ptr to the wrapped stream; it is freed
 *                                      with this stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Used for unknown filters, bad parameters and no memory.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
void EOFStreamInit(Stream *str, Stream *str2)
{
    StreamInit(str);
    str->str = str2;
    str->kind = strEOF;
}

static void EOFStreamFree(Stream *str)
{
    (void)str;
}

static void EOFStreamReset(Stream *str)
{
    (void)str;
}

static short EOFStreamGetChar(Stream *str)
{
    (void)str;
    return EOF;
}

static short EOFStreamLookChar(Stream *str)
{
    (void)str;
    return EOF;
}

#ifdef __BORLANDC__
#pragma codeseg ASCIIHexStream
#endif
#ifdef __WATCOMC__
#pragma code_seg("ASCIIHexStream")
#endif

/********************************************************************
 *                      ASCIIHexStreamInit
 ********************************************************************
 * SYNOPSIS:      Initialize an ASCIIHex filter stream.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *                *str1                 Ptr to the encoded stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void ASCIIHexStreamInit(Stream *str, Stream *str1)
{
    StreamInit(str);
    str->str = str1;

    str->kind = strASCIIHex;

    str->buf = EOF;
    str->eof = gFalse;
}

static void ASCIIHexStreamFree(Stream *str)
{
    (void)str;
}

/********************************************************************
 *                      ASCIIHexStreamReset
 ********************************************************************
 * SYNOPSIS:      Start the ASCIIHex stream from the beginning.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void ASCIIHexStreamReset(Stream *str)
{
    StreamReset(str->str);
    str->buf = EOF;
    str->eof = gFalse;
}

/********************************************************************
 *                      ASCIIHexStreamLookChar
 ********************************************************************
 * SYNOPSIS:      Decode the next byte but do not read it.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Byte, EOF at the end of the data.
 *
 * STRATEGY:      White space is skipped; ">" ends the data. An odd last digit
 *                is followed by 0.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short ASCIIHexStreamLookChar(Stream *str)
{
    short c1, c2, x;

    if (str->buf != EOF)
    {
        return str->buf;
    }
    if (str->eof)
    {
        str->buf = EOF;
        return EOF;
    }
    do
    {
        c1 = StreamGetChar(str->str);
    }
    while (isspace(c1));
    if (c1 == '>')
    {
        str->eof = gTrue;
        str->buf = EOF;
        return str->buf;
    }
    do
    {
        c2 = StreamGetChar(str->str);
    }
    while (isspace(c2));
    if (c2 == '>')
    {
        str->eof = gTrue;
        c2 = '0';
    }
    if (c1 >= '0' && c1 <= '9')
    {
        x = (c1 - '0') << 4;
    }
    else if (c1 >= 'A' && c1 <= 'F')
    {
        x = (c1 - 'A' + 10) << 4;
    }
    else if (c1 >= 'a' && c1 <= 'f')
    {
        x = (c1 - 'a' + 10) << 4;
    }
    else if (c1 == EOF)
    {
        str->eof = gTrue;
        x = 0;
    }
    else
    {
        EC_WARNING(-1);

        x = 0;
    }
    if (c2 >= '0' && c2 <= '9')
    {
        x += c2 - '0';
    }
    else if (c2 >= 'A' && c2 <= 'F')
    {
        x += c2 - 'A' + 10;
    }
    else if (c2 >= 'a' && c2 <= 'f')
    {
        x += c2 - 'a' + 10;
    }
    else if (c2 == EOF)
    {
        str->eof = gTrue;
        x = 0;
    }
    else
    {
        EC_WARNING(-1);

    }
    str->buf = x & 0xff;
    return str->buf;
}

/********************************************************************
 *                      ASCIIHexStreamGetChar
 ********************************************************************
 * SYNOPSIS:      Read the next decoded byte.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Byte, EOF at the end of the data.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short ASCIIHexStreamGetChar(Stream *str)
{
    short c = ASCIIHexStreamLookChar(str);
    str->buf = EOF;
    return c;
}

/********************************************************************
 *                      ASCII85StreamInit
 ********************************************************************
 * SYNOPSIS:      Initialize an ASCII85 filter stream.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *                *str1                 Ptr to the encoded stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void ASCII85StreamInit(Stream *str, Stream *str1)
{
    StreamInit(str);
    str->str = str1;

    str->kind = strASCII85;
    str->u.a85 = gmalloc(sizeof(ASCII85Data));
    if (!str->u.a85)
    {
        EOFStreamInit(str, str1);
        return;
    }

    str->u.a85->index = str->u.a85->n = 0;
    str->eof = gFalse;
}

static void ASCII85StreamFree(Stream *str)
{
    gfree(str->u.a85);
}

/********************************************************************
 *                      ASCII85StreamReset
 ********************************************************************
 * SYNOPSIS:      Start the ASCII85 stream from the beginning.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void ASCII85StreamReset(Stream *str)
{
    StreamReset(str->str);
    str->u.a85->index = str->u.a85->n = 0;
    str->eof = gFalse;
}

/********************************************************************
 *                      ASCII85StreamLookChar
 ********************************************************************
 * SYNOPSIS:      Decode the next byte but do not read it.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Byte, EOF at the end of the data.
 *
 * STRATEGY:      Decode one group of five chars into four bytes; "z" is four 0
 *                bytes, "~" ends the data.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short ASCII85StreamLookChar(Stream *str)
{
    short k;
    Gulong t;
    ASCII85Data *p85 = str->u.a85;

    if (p85->index >= p85->n)
    {
        if (str->eof)
        {
            return EOF;
        }
        p85->index = 0;
        do
        {
            p85->c[0] = StreamGetChar(str->str);
        }
        while (p85->c[0] == '\n' || p85->c[0] == '\r');
        if (p85->c[0] == '~' || p85->c[0] == EOF)
        {
            str->eof = gTrue;
            p85->n = 0;
            return EOF;
        }
        else if (p85->c[0] == 'z')
        {
            p85->b[0] = p85->b[1] = p85->b[2] = p85->b[3] = 0;
            p85->n = 4;
        }
        else
        {
            for (k = 1; k < 5; ++k)
            {
                do
                {
                    p85->c[k] = StreamGetChar(str->str);
                }
                while (p85->c[k] == '\n' || p85->c[k] == '\r');
                if (p85->c[k] == '~' || p85->c[k] == EOF)
                {
                    break;
                }
            }
            p85->n = k - 1;
            /* Short last group: pad with "u" */
            if (k < 5 && (p85->c[k] == '~' || p85->c[k] == EOF))
            {
                for (++k; k < 5; ++k)
                {
                    p85->c[k] = 0x21 + 84;
                }
                str->eof = gTrue;
            }
            /* Five base-85 digits make four bytes */
            t = 0;
            for (k = 0; k < 5; ++k)
            {
                t = t * 85 + (p85->c[k] - 0x21);
            }
            for (k = 3; k >= 0; --k)
            {
                p85->b[k] = (Guchar)(t & 0xff);
                t >>= 8;
            }
        }
    }
    return p85->b[p85->index];
}

/********************************************************************
 *                      ASCII85StreamGetChar
 ********************************************************************
 * SYNOPSIS:      Read the next decoded byte.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Byte, EOF at the end of the data.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short ASCII85StreamGetChar(Stream *str)
{
    short ch = ASCII85StreamLookChar(str);
    ++str->u.a85->index;
    return ch;
}

#ifdef __BORLANDC__
#pragma codeseg LZWStream
#endif
#ifdef __WATCOMC__
#pragma code_seg("LZWStream")
#endif

/* code copied from Acorn port of xpdf */

static short LZWStreamGetCode(Stream *str);
static GBool LZWStreamDecode(Stream *str, LZWTables *tab);

/********************************************************************
 *                      LZWStreamInit
 ********************************************************************
 * SYNOPSIS:      Initialize an LZW filter stream.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *                *str2                 Ptr to the encoded stream.
 *                early1                /EarlyChange (0 or 1).
 *
 * RETURNS:       void
 *
 * STRATEGY:      The string table is allocated in the first reset.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void LZWStreamInit(Stream *str, Stream *str2, short early1)
{

    StreamInit(str);
    str->str = str2;

    str->kind = strLZW;
    str->u.lzw = gmalloc(sizeof (LZWData));
    if (!str->u.lzw)
    {
        EOFStreamInit(str, str2);
        return;
    }

    str->u.lzw->early = early1;
    str->u.lzw->bufPtr = str->u.lzw->bufEnd = str->u.lzw->buf;
    str->u.lzw->tabH = NullHandle; /* allocated by LZWStreamReset */
}

/********************************************************************
 *                      LZWStreamFree
 ********************************************************************
 * SYNOPSIS:      Free the LZW data and its string table.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void LZWStreamFree(Stream *str)
{

    if (str->u.lzw->tabH)
    {
        MemFree(str->u.lzw->tabH);
    }
    gfree(str->u.lzw);
}

/********************************************************************
 *                      LZWStreamReset
 ********************************************************************
 * SYNOPSIS:      Start the LZW stream from the beginning.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:      The string table (12 KB) is a swapable block; it is allocated
 *                here and locked only while it is used.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void LZWStreamReset(Stream *str)
{
    short code;
    LZWData *plzw = str->u.lzw;
    LZWTables *tab;

    StreamReset(str->str);

    /* Empty buffer: GetChar calls LZWStreamFillBuf, which needs tabH. */
    plzw->bufPtr = plzw->bufEnd = plzw->buf;
    if (!plzw->tabH)
    {
        plzw->tabH = MemAlloc(sizeof(LZWTables), HF_SWAPABLE, HAF_ZERO_INIT);
        if (!plzw->tabH)
        {
            GMemSetError();
            return;             /* LZWStreamFillBuf returns EOF */
        }
    }

    plzw->inCodeBits = 9;
    plzw->inputBuf = 0;
    plzw->inputBits = 0;

    tab = MemLock(plzw->tabH);
    EC_ERROR_IF(tab == NULL, -1);
    for (code = 0; code < 256; ++code)
    {
        tab->codetab[code] = 0;
        tab->htab[code] = (Guchar)code;
    }
    MemUnlock(plzw->tabH);
    plzw->free_ent = 258;

    while ((code = LZWStreamGetCode(str)) == 256);

    if (code == EOF || code == 257)
    {
        /* EOF code */
        plzw->bufPtr = plzw->bufEnd = plzw->buf;
        return;
    }

    plzw->buf[0] = plzw->oldcode = plzw->finchar = code;
    plzw->bufPtr = plzw->buf;
    plzw->bufEnd = &plzw->buf[1];
}

/********************************************************************
 *                      LZWStreamGetCode
 ********************************************************************
 * SYNOPSIS:      Read the next LZW code.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Code (9 to 12 bits), EOF at the end of
 *                                      the data.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short LZWStreamGetCode(Stream *str)
{
    short c;
    short code;
    LZWData *plzw = str->u.lzw;

    while (plzw->inputBits < plzw->inCodeBits)
    {
        if ((c = StreamGetChar(str->str)) == EOF)
        {
            return EOF;
        }

        plzw->inputBuf = (plzw->inputBuf << 8) | c;
        plzw->inputBits += 8;
    }
    code =
        (plzw->inputBuf >> (plzw->inputBits - plzw->inCodeBits)) &
    ((1 << plzw->inCodeBits) - 1);

    plzw->inputBits -= plzw->inCodeBits;
    return code;
}

/********************************************************************
 *                      LZWStreamFillBuf
 ********************************************************************
 * SYNOPSIS:      Decode the next code into the buffer.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       GBool                 gFalse at the end of the data.
 *
 * STRATEGY:      Lock the string table only for one code; between calls it can
 *                move or be swapped out.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static GBool LZWStreamFillBuf(Stream *str)
{
    LZWData *plzw = str->u.lzw;
    LZWTables *tab;
    GBool ret;

    if (!plzw->tabH)
    {
        return gFalse;          /* no reset yet, or no memory */
    }

    tab = MemLock(plzw->tabH);
    EC_ERROR_IF(tab == NULL, -1);
    ret = LZWStreamDecode(str, tab);
    MemUnlock(plzw->tabH);
    return ret;
}

/********************************************************************
 *                      LZWStreamDecode
 ********************************************************************
 * SYNOPSIS:      Decode the next code with the locked string table.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *                *tab                  Ptr to the locked string table.
 *
 * RETURNS:       GBool                 gFalse at the end of the data.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static GBool LZWStreamDecode(Stream *str, LZWTables *tab)
{
    short code, incode, count;
    LZWData *plzw = str->u.lzw;

    code = LZWStreamGetCode(str);
    if (code == 256)
    {
        /* Clear code */
        memset(&tab->codetab[0], 0, 256 * sizeof(short));
        plzw->free_ent = 258;
        plzw->inCodeBits = 9;
        while ((code = LZWStreamGetCode(str)) == 256);

        /* The first code after a clear code makes no table entry */
        if (code != EOF && code != 257)
        {
            plzw->buf[0] = (char)code;
            plzw->oldcode = plzw->finchar = code;
            plzw->bufPtr = plzw->buf;
            plzw->bufEnd = &plzw->buf[1];
            return gTrue;
        }
    }

    if (code == EOF || code == 257)
    {
        /* EOF code */
        plzw->bufPtr = plzw->bufEnd = plzw->buf;
        return gFalse;
    }
    incode = code;

    count = sizeof(plzw->buf);

    /* Special case for KwKwK string. */
    if (code >= plzw->free_ent)
    {
        plzw->buf[--count] = plzw->finchar;
        code = plzw->oldcode;
    }

    /* Write the string backwards from the end of buf */

    while (code >= 256)
    {
        plzw->buf[--count] = tab->htab[code];
        code = tab->codetab[code];
        if (count == 0)
        {
            EC_WARNING(-1);
            plzw->bufPtr = plzw->buf;
            plzw->bufEnd = &plzw->buf[sizeof(plzw->buf) - 1];
            return gTrue;
        }
    }
    plzw->buf[--count] = plzw->finchar = tab->htab[code];

    /* Generate the new entry. */
    if ((code = plzw->free_ent) < 4096)
    {
        tab->codetab[code] = plzw->oldcode;
        tab->htab[code] = (Guchar)plzw->finchar;
        plzw->free_ent = code + 1;
        if (plzw->free_ent + plzw->early == 0x200)
        {
            plzw->inCodeBits = 10;
        }
        else if (plzw->free_ent + plzw->early == 0x400)
        {
            plzw->inCodeBits = 11;
        }
        else if (plzw->free_ent + plzw->early == 0x800)
        {
            plzw->inCodeBits = 12;
        }
    }

    /* Remember previous code. */
    plzw->oldcode = incode;

    plzw->bufPtr = &plzw->buf[count];
    plzw->bufEnd = &plzw->buf[sizeof(plzw->buf)];
    return gTrue;
}

/********************************************************************
 *                      LZWStreamGetChar
 ********************************************************************
 * SYNOPSIS:      Read the next decoded byte.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Byte, EOF at the end of the data.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short LZWStreamGetChar(Stream *str)
{
    LZWData *plzw = str->u.lzw;

    return(plzw->bufPtr >= plzw->bufEnd && !LZWStreamFillBuf(str)) ?
        EOF : (*plzw->bufPtr++ & 0xff);
}

/********************************************************************
 *                      LZWStreamLookChar
 ********************************************************************
 * SYNOPSIS:      Return the next decoded byte but do not read it.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Byte, EOF at the end of the data.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short LZWStreamLookChar(Stream *str)
{
    LZWData *plzw = str->u.lzw;

    return(plzw->bufPtr >= plzw->bufEnd && !LZWStreamFillBuf(str)) ?
        EOF : (*plzw->bufPtr & 0xff);
}

#ifdef __BORLANDC__
#pragma codeseg RunLengthStream
#endif
#ifdef __WATCOMC__
#pragma code_seg("RunLengthStream")
#endif

/********************************************************************
 *                      RunLengthStreamInit
 ********************************************************************
 * SYNOPSIS:      Initialize a RunLength filter stream.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *                *str1                 Ptr to the encoded stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void RunLengthStreamInit(Stream *str, Stream *str1)
{
    StreamInit(str);
    str->str = str1;

    str->kind = strRunLength;
    str->u.runLength = gmalloc(sizeof (RunLengthData));
    if (!str->u.runLength)
    {
        EOFStreamInit(str, str1);
        return;
    }

    str->u.runLength->bufPtr = str->u.runLength->bufEnd = str->u.runLength->buf;
    str->eof = gFalse;
}

static void RunLengthStreamFree(Stream *str)
{
    gfree(str->u.runLength);
}

/********************************************************************
 *                      RunLengthStreamReset
 ********************************************************************
 * SYNOPSIS:      Start the RunLength stream from the beginning.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void RunLengthStreamReset(Stream *str)
{
    StreamReset(str->str);

    str->u.runLength->bufPtr = str->u.runLength->bufEnd = str->u.runLength->buf;
    str->eof = gFalse;
}

/********************************************************************
 *                      RunLengthStreamFillBuf
 ********************************************************************
 * SYNOPSIS:      Decode the next run into the buffer.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       GBool                 gFalse at the end of the data (code
 *                                      128).
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static GBool RunLengthStreamFillBuf(Stream *str)
{
    RunLengthData *pRun = str->u.runLength;
    short c;
    short n, i;

    if (str->eof)
    {
        return gFalse;
    }
    c = StreamGetChar(str->str);
    if (c == 0x80 || c == EOF)
    {
        str->eof = gTrue;
        return gFalse;
    }
    /* Literal run of c + 1 bytes */
    if (c < 0x80)
    {
        n = c + 1;
        for (i = 0; i < n; ++i)
        {
            pRun->buf[i] = (char)StreamGetChar(str->str);
        }
    }
    else
    {
        /* Repeat run: 257 - c copies of the next byte */
        n = 0x101 - c;
        c = StreamGetChar(str->str);
        for (i = 0; i < n; ++i)
        {
            pRun->buf[i] = (char)c;
        }
    }
    pRun->bufPtr = pRun->buf;
    pRun->bufEnd = pRun->buf + n;
    return gTrue;
}

/********************************************************************
 *                      RunLengthStreamGetChar
 ********************************************************************
 * SYNOPSIS:      Read the next decoded byte.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Byte, EOF at the end of the data.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short RunLengthStreamGetChar(Stream *str)
{
    RunLengthData *pRun = str->u.runLength;

    return(pRun->bufPtr >= pRun->bufEnd && !RunLengthStreamFillBuf(str)) ?
        EOF : (*pRun->bufPtr++ & 0xff);
}

/********************************************************************
 *                      RunLengthStreamLookChar
 ********************************************************************
 * SYNOPSIS:      Return the next decoded byte but do not read it.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Byte, EOF at the end of the data.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short RunLengthStreamLookChar(Stream *str)
{
    RunLengthData *pRun = str->u.runLength;

    return(pRun->bufPtr >= pRun->bufEnd && !RunLengthStreamFillBuf(str)) ?
        EOF : (*pRun->bufPtr & 0xff);
}

#ifdef __BORLANDC__
#pragma codeseg CCITTFaxStream
#endif
#ifdef __WATCOMC__
#pragma code_seg("CCITTFaxStream")
#endif

/********************************************************************
 *                      CCITTFaxStreamInit
 ********************************************************************
 * SYNOPSIS:      Initialize a CCITT fax filter stream.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *                *str1                 Ptr to the encoded stream.
 *                encoding1             /K: < 0 G4, 0 G3 1-D, > 0 G3 2-D.
 *                byteAlign1            /EncodedByteAlign.
 *                columns1              /Columns.
 *                rows1                 /Rows.
 *                black1                /BlackIs1.
 *
 * RETURNS:       void
 *
 * STRATEGY:      The line buffers are allocated in the first reset.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void CCITTFaxStreamInit(Stream *str, Stream *str1, long encoding1,
    GBool byteAlign1, long columns1, long rows1, GBool black1)
{

    CCITTFaxData *pfax;

    StreamInit(str);
    str->str = str1;

    str->kind = strCCITTFax;
    pfax = str->u.fax = gmalloc(sizeof (CCITTFaxData));
    if (!pfax)
    {
        EOFStreamInit(str, str1);
        return;
    }

    pfax->encoding = encoding1;
    pfax->byteAlign = byteAlign1;
    pfax->columns = (short)columns1; /* checked by StreamMakeFilter */
    pfax->rows = rows1;
    pfax->black = black1;

    /* Line buffers (up to 2 x 64 KB) come with the first reset */
    pfax->refLine = NULL;
    pfax->codingLine = NULL;
    str->eof = gTrue;           /* nothing to read until the first reset */
    pfax->nextLine2D = pfax->encoding < 0;
    pfax->inputBits = 0;
    pfax->a0 = 1;

    pfax->buf = EOF;
}

/********************************************************************
 *                      CCITTFaxStreamFree
 ********************************************************************
 * SYNOPSIS:      Free the CCITT data and its line buffers.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void CCITTFaxStreamFree(Stream *str)
{
    gfree(str->u.fax->refLine);
    gfree(str->u.fax->codingLine);
    gfree(str->u.fax);
}

/********************************************************************
 *                      CCITTFaxStreamReset
 ********************************************************************
 * SYNOPSIS:      Start the CCITT stream from the beginning.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Allocate the two line buffers (up to 2 x 64 KB) on the first
 *                reset. No memory: the stream is at EOF.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void CCITTFaxStreamReset(Stream *str)
{
    CCITTFaxData *pfax = str->u.fax;

    StreamReset(str->str);
    pfax->buf = EOF;
    if (!pfax->refLine)
    {
        pfax->refLine = (short *)gmalloc((pfax->columns + 2L) *
            sizeof(short));
        pfax->codingLine = (short *)gmalloc((pfax->columns + 2L) *
            sizeof(short));
        if (!pfax->refLine || !pfax->codingLine)
        {
            gfree(pfax->refLine);
            gfree(pfax->codingLine);
            pfax->refLine = NULL;
            pfax->codingLine = NULL;
            str->eof = gTrue;   /* CCITTFaxStreamLookChar returns EOF */
            return;
        }
    }
    str->eof = gFalse;

    pfax->nextLine2D = pfax->encoding < 0;
    pfax->inputBits = 0;
    if ((CCITTFaxStreamLook13Bits(str) >> 1) == 0x001)
    {
        CCITTFaxStreamEatBits(str, 12);
    }
    pfax->codingLine[0] = 0;
    pfax->codingLine[1] = pfax->refLine[2] = pfax->columns;
    pfax->a0 = 1;
    pfax->buf = EOF;
}

/********************************************************************
 *                      CCITTFaxStreamLookChar
 ********************************************************************
 * SYNOPSIS:      Decode the next byte but do not read it.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Byte, EOF at the end of the data.
 *
 * STRATEGY:      A line is decoded into codingLine (positions where the color
 *                changes), with 2-D modes relative to refLine or with white and
 *                black runs. Output bytes are made from these runs.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short CCITTFaxStreamLookChar(Stream *str)
{
    CCITTFaxData *pfax = str->u.fax;
    short a0New;
    short ret;
    short bits, i;
    short code1, code2, code3;

    if (!pfax->codingLine)
    {
        return EOF;             /* no reset yet, or no memory */
    }
    if (str->eof && pfax->codingLine[pfax->a0] >= pfax->columns)
    {
        return EOF;
    }

    /* Line done: decode the next line into codingLine */
    if (pfax->codingLine[pfax->a0] >= pfax->columns)
    {

        i = CCITTFaxStreamLook13Bits(str);
        if (i == EOF || (i >> 1) == 0x001)
        {
            str->eof = gTrue;
            pfax->codingLine[pfax->a0 = 0] = pfax->columns;
            return EOF;
        }

        /* Two-dimensional line: modes relative to refLine */
        if (pfax->nextLine2D)
        {
            for (i = 0; pfax->codingLine[i] < pfax->columns; ++i)
            {
                pfax->refLine[i] = pfax->codingLine[i];
            }
            pfax->refLine[i] = pfax->refLine[i + 1] = pfax->columns;
            pfax->b1 = 1;
            a0New = pfax->codingLine[pfax->a0 = 0] = 0;
            do
            {
                code1 = CCITTFaxStreamGetTwoDimCode(str);
                switch (code1)
                {
                    case twoDimPass:
                        if (pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            a0New = pfax->refLine[pfax->b1 + 1];
                            pfax->b1 += 2;
                        }
                        break;
                    case twoDimHoriz:
                        if ((pfax->a0 & 1) == 0)
                        {
                            code1 = code2 = 0;
                            do
                            {
                                code1 += code3 =
                                    CCITTFaxStreamGetWhiteCode(str);
                            }
                            while (code3 >= 64);
                            do
                            {
                                code2 += code3 =
                                    CCITTFaxStreamGetBlackCode(str);
                            }
                            while (code3 >= 64);
                        }
                        else
                        {
                            code1 = code2 = 0;
                            do
                            {
                                code1 += code3 =
                                    CCITTFaxStreamGetBlackCode(str);
                            }
                            while (code3 >= 64);
                            do
                            {
                                code2 += code3 =
                                    CCITTFaxStreamGetWhiteCode(str);
                            }
                            while (code3 >= 64);
                        }
                        pfax->codingLine[pfax->a0 + 1] = a0New + code1;
                        ++pfax->a0;
                        a0New = pfax->codingLine[pfax->a0 + 1] =
                            pfax->codingLine[pfax->a0] + code2;
                        ++pfax->a0;
                        while (
                            pfax->refLine[pfax->b1] <=
                            pfax->codingLine[pfax->a0] &&
                            pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            pfax->b1 += 2;
                        }
                        break;
                    case twoDimVert0:
                        a0New = pfax->codingLine[++pfax->a0] =
                            pfax->refLine[pfax->b1];
                        if (pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            ++pfax->b1;
                            while (
                                pfax->refLine[pfax->b1] <=
                                pfax->codingLine[pfax->a0] &&
                                pfax->refLine[pfax->b1] < pfax->columns)
                            {
                                pfax->b1 += 2;
                            }
                        }
                        break;
                    case twoDimVertR1:
                        a0New = pfax->codingLine[++pfax->a0] =
                            pfax->refLine[pfax->b1] + 1;
                        if (pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            ++pfax->b1;
                            while (
                                pfax->refLine[pfax->b1] <=
                                pfax->codingLine[pfax->a0] &&
                                pfax->refLine[pfax->b1] < pfax->columns)
                            {
                                pfax->b1 += 2;
                            }
                        }
                        break;
                    case twoDimVertL1:
                        a0New = pfax->codingLine[++pfax->a0] =
                            pfax->refLine[pfax->b1] - 1;
                        --pfax->b1;
                        while (
                            pfax->refLine[pfax->b1] <=
                            pfax->codingLine[pfax->a0] &&
                            pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            pfax->b1 += 2;
                        }
                        break;
                    case twoDimVertR2:
                        a0New = pfax->codingLine[++pfax->a0] =
                            pfax->refLine[pfax->b1] + 2;
                        if (pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            ++pfax->b1;
                            while (
                                pfax->refLine[pfax->b1] <=
                                pfax->codingLine[pfax->a0] &&
                                pfax->refLine[pfax->b1] < pfax->columns)
                            {
                                pfax->b1 += 2;
                            }
                        }
                        break;
                    case twoDimVertL2:
                        a0New = pfax->codingLine[++pfax->a0] =
                            pfax->refLine[pfax->b1] - 2;
                        --pfax->b1;
                        while (
                            pfax->refLine[pfax->b1] <=
                            pfax->codingLine[pfax->a0] &&
                            pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            pfax->b1 += 2;
                        }
                        break;
                    case twoDimVertR3:
                        a0New = pfax->codingLine[++pfax->a0] =
                            pfax->refLine[pfax->b1] + 3;
                        if (pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            ++pfax->b1;
                            while (
                                pfax->refLine[pfax->b1] <=
                                pfax->codingLine[pfax->a0] &&
                                pfax->refLine[pfax->b1] < pfax->columns)
                            {
                                pfax->b1 += 2;
                            }
                        }
                        break;
                    case twoDimVertL3:
                        a0New = pfax->codingLine[++pfax->a0] =
                            pfax->refLine[pfax->b1] - 3;
                        --pfax->b1;
                        while (
                            pfax->refLine[pfax->b1] <=
                            pfax->codingLine[pfax->a0] &&
                            pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            pfax->b1 += 2;
                        }
                        break;
                    case EOF:
                        str->eof = gTrue;
                        pfax->codingLine[pfax->a0 = 0] = pfax->columns;
                        return EOF;
                    default:
                        EC_WARNING(-1);

                        return EOF;
                }
            }
            while (pfax->codingLine[pfax->a0] < pfax->columns);

            /* One-dimensional line: white and black runs */
        }
        else
        {
            pfax->codingLine[pfax->a0 = 0] = 0;
            while (1)
            {
                code1 = 0;
                do
                {
                    code1 += code3 = CCITTFaxStreamGetWhiteCode(str);
                }
                while (code3 >= 64);
                pfax->codingLine[pfax->a0 + 1] =
                    pfax->codingLine[pfax->a0] + code1;
                ++pfax->a0;
                if (pfax->codingLine[pfax->a0] >= pfax->columns)
                {
                    break;
                }
                code2 = 0;
                do
                {
                    code2 += code3 = CCITTFaxStreamGetBlackCode(str);
                }
                while (code3 >= 64);
                pfax->codingLine[pfax->a0 + 1] =
                    pfax->codingLine[pfax->a0] + code2;
                ++pfax->a0;
                if (pfax->codingLine[pfax->a0] >= pfax->columns)
                {
                    break;
                }
            }
        }

        if (pfax->codingLine[pfax->a0] != pfax->columns)
        {
            EC_WARNING(-1);
        }

        /* EOL code; with K > 0 a tag bit selects 1-D or 2-D */
        code1 = CCITTFaxStreamLook13Bits(str);
        if ((code1 >> 1) == 0x001)
        {
            CCITTFaxStreamEatBits(str, 12);
            if (pfax->encoding > 0)
            {
                CCITTFaxStreamEatBits(str, 1);
                pfax->nextLine2D = !(code1 & 1);
            }
        }

        pfax->a0 = 0;
        pfax->outputBits = pfax->codingLine[1] - pfax->codingLine[0];
    }

    /* Make the next output byte from the runs */
    if (pfax->outputBits >= 8)
    {
        ret = ((pfax->a0 & 1) == 0) ? 0xff : 0x00;
        if ((pfax->outputBits -= 8) == 0)
        {
            ++pfax->a0;
            if (pfax->codingLine[pfax->a0] < pfax->columns)
            {
                pfax->outputBits =
                    pfax->codingLine[pfax->a0 + 1] - pfax->codingLine[pfax->a0];
            }
        }
    }
    else
    {
        bits = 8;
        ret = 0;
        do
        {
            if (pfax->outputBits > bits)
            {
                i = bits;
                bits = 0;
                if ((pfax->a0 & 1) == 0)
                {
                    ret |= 0xff >> (8 - i);
                }
                pfax->outputBits -= i;
            }
            else
            {
                i = pfax->outputBits;
                bits -= pfax->outputBits;
                if ((pfax->a0 & 1) == 0)
                {
                    ret |= (0xff >> (8 - i)) << bits;
                }
                pfax->outputBits = 0;
                ++pfax->a0;
                if (pfax->codingLine[pfax->a0] < pfax->columns)
                {
                    pfax->outputBits =
                        pfax->codingLine[pfax->a0 + 1] -
                        pfax->codingLine[pfax->a0];
                }
            }
        }
        while (bits > 0 && pfax->codingLine[pfax->a0] < pfax->columns);
    }
    pfax->buf = pfax->black ? (ret ^ 0xff) : ret;
    return pfax->buf;
}

/********************************************************************
 *                      CCITTFaxStreamGetChar
 ********************************************************************
 * SYNOPSIS:      Read the next decoded byte.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Byte, EOF at the end of the data.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short CCITTFaxStreamGetChar(Stream *str)
{
    short c = CCITTFaxStreamLookChar(str);
    str->u.fax->buf = EOF;
    return c;
}

static void CCITTFaxStreamEatBits(Stream *str, short bits)
{
    str->u.fax->inputBits -= bits;
}

/********************************************************************
 *                      CCITTFaxStreamGetTwoDimCode
 ********************************************************************
 * SYNOPSIS:      Read the next 2-D mode code.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 twoDim mode, EOF on a bad code.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short CCITTFaxStreamGetTwoDimCode(Stream *str)
{
    short code, code0;
    CCITTCode *twoDimTab1;
    CCITTCode *p;
    short retval;

    code0 = CCITTFaxStreamLook13Bits(str);
    code = code0 >> 6;
    if (code == 0x0002)
    {
        CCITTFaxStreamEatBits(str, 7);
        return twoDimVertL3;
    }
    if (code == 0x0003)
    {
        CCITTFaxStreamEatBits(str, 7);
        return twoDimVertR3;
    }
    code >>= 1;
    if (code == 0x0002)
    {
        CCITTFaxStreamEatBits(str, 6);
        return twoDimVertL2;
    }
    if (code == 0x0003)
    {
        CCITTFaxStreamEatBits(str, 6);
        return twoDimVertR2;
    }

    MemLock(OptrToHandle(@twoDimTab1xx));
    twoDimTab1 = LMemDeref(@twoDimTab1xx);

    code >>= 2;
    p = &twoDimTab1[code];
    if (p->bits > 0)
    {
        CCITTFaxStreamEatBits(str, p->bits);
        retval = p->n;
        MemUnlock(OptrToHandle(@twoDimTab1xx));
        return retval;
    }
    MemUnlock(OptrToHandle(@twoDimTab1xx));

    EC_WARNING(-1);

    return EOF;
}

/********************************************************************
 *                      CCITTFaxStreamGetWhiteCode
 ********************************************************************
 * SYNOPSIS:      Read the next white run length.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Run length (>= 64: a make-up code
 *                                      follows), 1 on a bad code.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short CCITTFaxStreamGetWhiteCode(Stream *str)
{
    short code, retval;
    CCITTCode *p;
    CCITTCode *whiteTab1, *whiteTab2;

    MemLock(OptrToHandle(@whiteTab1xx));

    code = CCITTFaxStreamLook13Bits(str);
    if ((code >> 6) == 0)
    {
        whiteTab1 = LMemDeref(@whiteTab1xx);
        p = &whiteTab1[code >> 1];
    }
    else
    {
        whiteTab2 = LMemDeref(@whiteTab2xx);
        p = &whiteTab2[code >> 4];
    }
    if (p->bits > 0)
    {
        CCITTFaxStreamEatBits(str, p->bits);
        retval = p->n;
        MemUnlock(OptrToHandle(@whiteTab1xx));
        return retval;
    }

    MemUnlock(OptrToHandle(@whiteTab1xx));
    EC_WARNING(-1);

    return EOF;
}

/********************************************************************
 *                      CCITTFaxStreamGetBlackCode
 ********************************************************************
 * SYNOPSIS:      Read the next black run length.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Run length (>= 64: a make-up code
 *                                      follows), 1 on a bad code.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short CCITTFaxStreamGetBlackCode(Stream *str)
{
    short code, retval;
    CCITTCode *p;
    CCITTCode *blackTab1, *blackTab2, *blackTab3;

    MemLock(OptrToHandle(@blackTab1xx));

    code = CCITTFaxStreamLook13Bits(str);
    if ((code >> 7) == 0)
    {
        blackTab1 = LMemDeref(@blackTab1xx);
        p = &blackTab1[code];
    }
    else if ((code >> 9) == 0)
    {
        blackTab2 = LMemDeref(@blackTab2xx);
        p = &blackTab2[(code >> 1) - 64];
    }
    else
    {
        blackTab3 = LMemDeref(@blackTab3xx);
        p = &blackTab3[code >> 7];
    }
    if (p->bits > 0)
    {
        CCITTFaxStreamEatBits(str, p->bits);
        retval = p->n;
        MemUnlock(OptrToHandle(@blackTab1xx));
        return retval;
    }

    MemUnlock(OptrToHandle(@blackTab1xx));
    EC_WARNING(-1);

    return EOF;
}

/********************************************************************
 *                      CCITTFaxStreamLook13Bits
 ********************************************************************
 * SYNOPSIS:      Return the next 13 bits but do not read them.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 13 bits (0 bits after the end), EOF if
 *                                      no bits are left.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short CCITTFaxStreamLook13Bits(Stream *str)
{
    short c;
    CCITTFaxData *pfax = str->u.fax;

    while (pfax->inputBits < 13)
    {
        if ((c = StreamGetChar(str->str)) == EOF)
        {
            if (pfax->inputBits == 0)
            {
                return EOF;
            }
            c = 0;
        }
        pfax->inputBuf = (pfax->inputBuf << 8) + c;
        pfax->inputBits += 8;
    }
    return(pfax->inputBuf >> (pfax->inputBits - 13)) & 0x1fff;
}

#ifdef __BORLANDC__
#pragma codeseg stream
#endif
#ifdef __WATCOMC__
#pragma code_seg("stream")
#endif

/* RC4Stream: decrypt raw stream bytes before any other filter */

/********************************************************************
 *                      RC4StreamInit
 ********************************************************************
 * SYNOPSIS:      Initialize an RC4 decryption stream.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *                *str1                 Ptr to the encrypted stream.
 *                *key                  Ptr to the object key.
 *                keyLen                Key length in bytes.
 *
 * RETURNS:       void
 *
 * STRATEGY:      RC4 is the first filter: it decrypts the raw stream bytes
 *                before any other filter.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
void RC4StreamInit(Stream *str, Stream *str1, Guchar *key, short keyLen)
{
    RC4Data *prc4;

    StreamInit(str);
    str->kind = strRC4;
    str->str = str1;
    prc4 = str->u.rc4 = gmalloc(sizeof(RC4Data));
    if (!prc4)
    {
        EOFStreamInit(str, str1);
        return;
    }
    memcpy(prc4->keyBuf, key, keyLen);
    prc4->keyLen = keyLen;
    RC4KeySchedule(prc4->keyBuf, prc4->keyLen, prc4->sBox);
    prc4->rc4i = prc4->rc4j = 0;
    prc4->peeked = gFalse;
}

static void RC4StreamFree(Stream *str)
{
    gfree(str->u.rc4);
}

/********************************************************************
 *                      RC4StreamReset
 ********************************************************************
 * SYNOPSIS:      Start the RC4 stream from the beginning.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void RC4StreamReset(Stream *str)
{
    RC4Data *prc4 = str->u.rc4;

    StreamReset(str->str);
    /* Reset the PRGA state whenever the wrapped stream resets. */
    RC4KeySchedule(prc4->keyBuf, prc4->keyLen, prc4->sBox);
    prc4->rc4i = prc4->rc4j = 0;
    prc4->peeked = gFalse;
}

/********************************************************************
 *                      RC4StreamAdvance
 ********************************************************************
 * SYNOPSIS:      Read and decrypt the next byte.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Byte, EOF at the end of the data.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short RC4StreamAdvance(Stream *str)
{
    RC4Data *prc4 = str->u.rc4;
    short c;

    c = StreamGetChar(str->str);
    if (c == EOF)
    {
        return EOF;
    }
    return(short)((Guchar)c ^ RC4NextByte(prc4->sBox, &prc4->rc4i,
        &prc4->rc4j));
}

/********************************************************************
 *                      RC4StreamRead
 ********************************************************************
 * SYNOPSIS:      Read and decrypt a block of bytes.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *                *buf                  Ptr to the destination buffer.
 *                size                  Number of bytes.
 *
 * RETURNS:       word                  Number of bytes read, less at the end of
 *                                      the data.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      11/25/26  JK        Initial version
 *******************************************************************/
static word RC4StreamRead(Stream *str, Guchar *buf, word size)
{
    RC4Data *prc4 = str->u.rc4;
    word n = 0, i;

    if (prc4->peeked)
    {
        prc4->peeked = gFalse;
        if (prc4->peekedChar == EOF)
        {
            return 0;
        }
        buf[n++] = (Guchar)prc4->peekedChar;
    }
    i = n;
    n += StreamRead(str->str, buf + n, size - n);
    for (; i < n; ++i)
    {
        buf[i] ^= RC4NextByte(prc4->sBox, &prc4->rc4i, &prc4->rc4j);
    }
    return n;
}

/********************************************************************
 *                      RC4StreamGetChar
 ********************************************************************
 * SYNOPSIS:      Read the next decrypted byte.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Byte, EOF at the end of the data.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short RC4StreamGetChar(Stream *str)
{
    RC4Data *prc4 = str->u.rc4;

    if (prc4->peeked)
    {
        prc4->peeked = gFalse;
        return prc4->peekedChar;
    }
    return RC4StreamAdvance(str);
}

/********************************************************************
 *                      RC4StreamLookChar
 ********************************************************************
 * SYNOPSIS:      Return the next decrypted byte but do not read it.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Byte, EOF at the end of the data.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short RC4StreamLookChar(Stream *str)
{
    RC4Data *prc4 = str->u.rc4;

    if (!prc4->peeked)
    {
        prc4->peekedChar = RC4StreamAdvance(str);
        prc4->peeked = gTrue;
    }
    return prc4->peekedChar;
}

#ifdef __BORLANDC__
#pragma codeseg FlateStream
#endif
#ifdef __WATCOMC__
#pragma code_seg("FlateStream")
#endif

/********************************************************************
 *                      FlateStreamEndZlib
 ********************************************************************
 * SYNOPSIS:      Free the zlib state of a Flate stream.
 *
 * PARAMETERS:    *fd                   Ptr to the Flate data.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void FlateStreamEndZlib(FlateData *fd)
{
    if (fd->zInit)
    {
        inflateEnd(&fd->strm);
        fd->zInit = gFalse;
    }
}

/********************************************************************
 *                      FlateStreamInit
 ********************************************************************
 * SYNOPSIS:      Initialize a Flate filter stream.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *                *str1                 Ptr to the compressed stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:      The zlib state is made in the first reset: most streams of a
 *                file are never read.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void FlateStreamInit(Stream *str, Stream *str1)
{
    FlateData *fd;

    StreamInit(str);
    str->str = str1;

    fd = gmalloc(sizeof(FlateData));
    if (!fd)
    {
        EOFStreamInit(str, str1);
        return;
    }
    memset(fd, 0, sizeof(FlateData));   /* zalloc/zfree/opaque = Z_NULL */

    fd->eof = gTrue;    /* nothing to read until the first reset */
    str->kind = strFlate;
    str->u.flate = fd;
}

/********************************************************************
 *                      FlateStreamFree
 ********************************************************************
 * SYNOPSIS:      Free the Flate data and the zlib state.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void FlateStreamFree(Stream *str)
{
    if (str->u.flate)
    {
        FlateStreamEndZlib(str->u.flate);
        gfree(str->u.flate);
        str->u.flate = NULL;
    }
}

/********************************************************************
 *                      FlateStreamReset
 ********************************************************************
 * SYNOPSIS:      Start the Flate stream from the beginning.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:      New zlib state for every pass. 15 window bits: PDF writers use
 *                the full 32 KB window.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void FlateStreamReset(Stream *str)
{
    FlateData *fd = str->u.flate;

    int ret;

    StreamReset(str->str);

    /* New zlib state per pass (inflateReset keeps the old window) */
    FlateStreamEndZlib(fd);
    fd->eof = gTrue;
    fd->readIndex = 0;
    fd->readCount = 0;
    memset(&fd->strm, 0, sizeof(z_stream));
    fd->strm.next_in = fd->inBuf;
    ret = inflateInit2(&fd->strm, flateWindowBits);
    if (ret != Z_OK)
    {
        if (ret == Z_MEM_ERROR)
        {
            GMemSetError();
        }
        EC_WARNING(-1);
        return;
    }
    fd->zInit = gTrue;

    fd->strm.next_in = fd->inBuf;   /* zlib 1.1.4 rejects next_in == NULL */
    fd->strm.avail_in = 0;
    fd->eof = gFalse;
    fd->inEof = gFalse;
    fd->readIndex = 0;
    fd->readCount = 0;
}

/* FlateStreamGetChar moved above into StreamGetChar's code segment. */

/********************************************************************
 *                      FlateStreamLookChar
 ********************************************************************
 * SYNOPSIS:      Return the next decoded byte but do not read it.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Byte, EOF at the end of the data.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short FlateStreamLookChar(Stream *str)
{
    FlateData *fd = str->u.flate;

    if (fd->readIndex >= fd->readCount)
    {
        fd->readCount = FlateStreamReadRaw(str, fd->readBuf,
            flateReadBufSize);
        fd->readIndex = 0;
        if (fd->readCount == 0)
        {
            return EOF;
        }
    }

    return fd->readBuf[fd->readIndex];
}

/********************************************************************
 *                      FlateStreamReadRaw
 ********************************************************************
 * SYNOPSIS:      Decompress a block with zlib.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *                *out                  Ptr to the destination buffer.
 *                size                  Number of bytes.
 *
 * RETURNS:       word                  Number of bytes read, less at the end of
 *                                      the data.
 *
 * STRATEGY:      Read compressed input in flateInBufSize blocks. At the end of
 *                the data (or on an error) the zlib state is freed at once.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static word FlateStreamReadRaw(Stream *str, Guchar *out, word size)
{
    FlateData *fd = str->u.flate;
    z_stream *zs;
    uInt outBefore, inBefore;
    int ret;

    if (fd->eof || size == 0)
    {
        return 0;
    }

    zs = &fd->strm;
    zs->next_out = out;
    zs->avail_out = size;

    while (zs->avail_out > 0)
    {
        if (zs->avail_in == 0 && !fd->inEof)
        {
            zs->next_in = fd->inBuf;
            zs->avail_in = StreamRead(str->str, fd->inBuf, flateInBufSize);
            if (zs->avail_in == 0)
            {
                fd->inEof = gTrue;
            }
        }

        outBefore = zs->avail_out;
        inBefore = zs->avail_in;
        ret = inflate(zs, Z_NO_FLUSH);

        if (ret == Z_STREAM_END)
        {
            fd->eof = gTrue;
            break;
        }
        if (ret != Z_OK && ret != Z_BUF_ERROR)
        {
            /* Z_DATA_ERROR, Z_NEED_DICT, Z_MEM_ERROR, Z_STREAM_ERROR */
            if (ret == Z_MEM_ERROR)
            {
                GMemSetError();
            }
            EC_WARNING(-1);
            fd->eof = gTrue;
            break;
        }
        if (zs->avail_out == outBefore && zs->avail_in == inBefore &&
            (fd->inEof || zs->avail_in > 0))
        {
            /* no progress possible: truncated or stuck stream */
            fd->eof = gTrue;
            break;
        }
    }

    size -= (word)zs->avail_out;
    if (fd->eof)
    {
        /* done with this pass: give the window back right away */
        FlateStreamEndZlib(fd);
    }
    return size;
}

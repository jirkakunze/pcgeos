        case strFile:
            FStreamReset(str);
            break;

        case strSubStream:
            SubStreamReset(str);
            break;

        case strLZW:
            LZWStreamReset(str);
            break;

        case strFlate:
            FlateStreamReset(str);
            break;

        case strObjStmCache:
            ObjStmCacheStreamReset(str);
            break;

        case strDCT:
            DCTStreamReset(str);
            break;

        case strASCIIHex:
            ASCIIHexStreamReset(str);
            break;

        case strASCII85:
            ASCII85StreamReset(str);
            break;

        case strRunLength:
            RunLengthStreamReset(str);
            break;

        case strCCITTFax:
            CCITTFaxStreamReset(str);
            break;

        case strEOF:
            EOFStreamReset(str);
            break;

        case strRC4:
            RC4StreamReset(str);
            break;

        case strPredictor:
            PredictorStreamReset(str);
            break;

        default:
            EC_ERROR(-1);
            break;
    }
}


{

    switch (str->kind)
    {
        case strFile:
            return FStreamGetDict(str);

        case strSubStream:
            return SubStreamGetDict(str);
    }

    return StreamGetDict(str->str);
}

/********************************************************************
 *                      StreamReset
 ********************************************************************
 * SYNOPSIS:      Start reading the stream from the beginning.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Each filter resets the stream it wraps first. Readers must
 *                reset a chain before they read it.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
void StreamReset(Stream *str)
{

    EC(ECCheckBounds(str));

    switch (str->kind)
    {

        case strFile:
            FStreamReset(str);
            break;

        case strSubStream:
            SubStreamReset(str);
            break;

        case strLZW:
            LZWStreamReset(str);
            break;

        case strFlate:
            FlateStreamReset(str);
            break;

        case strDCT:
            DCTStreamReset(str);
            break;

        case strASCIIHex:
            ASCIIHexStreamReset(str);
            break;

        case strASCII85:
            ASCII85StreamReset(str);
            break;

        case strRunLength:
            RunLengthStreamReset(str);
            break;

        case strCCITTFax:
            CCITTFaxStreamReset(str);
            break;

        case strEOF:
            EOFStreamReset(str);
            break;

        case strRC4:
            RC4StreamReset(str);
            break;

        case strPredictor:
            PredictorStreamReset(str);
            break;

        default:
            EC_ERROR(-1);
            break;
    }
}


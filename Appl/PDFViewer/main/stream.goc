#pragma code_seg("ASCIIHexStream")
#endif

/***********************************************************************
 *      ASCIIHexStreamInit
 ***********************************************************************
 * SYNOPSIS:        Initialize.
 * PARAMETERS:      Stream *str    string
 *                  Stream *str1    str1
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void ASCIIHexStreamInit(Stream *str, Stream *str1)
{
    StreamInit(str);
    str->str = str1;

    str->kind = strASCIIHex;

    str->buf = EOF;
    str->eof = gFalse;
}


 ***********************************************************************
 * SYNOPSIS:        Initialize.
 * PARAMETERS:      Stream *str    string
 *                  Stream *str1    str1
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void RunLengthStreamInit(Stream *str, Stream *str1)
{
    StreamInit(str);
    str->str = str1;

    str->kind = strRunLength;
    str->u.runLength = gmalloc(sizeof (RunLengthData));
    if (!str->u.runLength)
    {
        EOFStreamInit(str, str1);
        return;
    }

    str->u.runLength->bufPtr = str->u.runLength->bufEnd = str->u.runLength->buf;
    str->eof = gFalse;
}

/***********************************************************************
 *      RunLengthStreamFree
 ***********************************************************************
 * SYNOPSIS:        Release.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void RunLengthStreamFree(Stream *str)
{
    gfree(str->u.runLength);
}

/***********************************************************************
 *      RunLengthStreamReset
 ***********************************************************************
 * SYNOPSIS:        Reset.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void RunLengthStreamReset(Stream *str)
{
    StreamReset(str->str);

    str->u.runLength->bufPtr = str->u.runLength->bufEnd = str->u.runLength->buf;
    str->eof = gFalse;
}

/***********************************************************************
 *      RunLengthStreamFillBuf
 ***********************************************************************
 * SYNOPSIS:        Fill buffer.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static GBool RunLengthStreamFillBuf(Stream *str)
{
    RunLengthData *pRun = str->u.runLength;
    long c;
    short n, i;

    if (str->eof)
    {
        return gFalse;
    }
    c = StreamGetChar(str->str);
    if (c == 0x80 || c == EOF)
    {
        str->eof = gTrue;
        return gFalse;
    }
    if (c < 0x80)
    {
        n = c + 1;
        for (i = 0; i < n; ++i)
        {
            pRun->buf[i] = (char)StreamGetChar(str->str);
        }
    }
    else
    {
        n = 0x101 - c;
        c = StreamGetChar(str->str);
        for (i = 0; i < n; ++i)
        {
            pRun->buf[i] = (char)c;
        }
    }
    pRun->bufPtr = pRun->buf;
    pRun->bufEnd = pRun->buf + n;
    return gTrue;
}

/***********************************************************************
 *      RunLengthStreamGetChar
 ***********************************************************************
 * SYNOPSIS:        Get char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long RunLengthStreamGetChar(Stream *str)
{
    RunLengthData *pRun = str->u.runLength;

    return(pRun->bufPtr >= pRun->bufEnd && !RunLengthStreamFillBuf(str)) ?
        EOF : (*pRun->bufPtr++ & 0xff);
}

/***********************************************************************
 *      RunLengthStreamLookChar
 ***********************************************************************
 * SYNOPSIS:        Process run length stream look char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long RunLengthStreamLookChar(Stream *str)
{
    RunLengthData *pRun = str->u.runLength;

    return(pRun->bufPtr >= pRun->bufEnd && !RunLengthStreamFillBuf(str)) ?
        EOF : (*pRun->bufPtr & 0xff);
}

/* CCITTFaxStream */

#ifdef __BORLANDC__
#pragma codeseg CCITTFaxStream
#endif
#ifdef __WATCOMC__
#pragma code_seg("CCITTFaxStream")
#endif

/***********************************************************************
 *      CCITTFaxStreamInit
 ***********************************************************************
 * SYNOPSIS:        Initialize.
 * PARAMETERS:      Stream *str    string
 *                  Stream *str1    str1
 *                  long encoding1    encoding1
 *                  GBool byteAlign1    byte align1
 *                  long columns1    columns1
 *                  long rows1    rows1
 *                  GBool black1    black1
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void CCITTFaxStreamInit(Stream *str, Stream *str1, long encoding1,
    GBool byteAlign1, long columns1, long rows1, GBool black1)
{

    CCITTFaxData *pfax;

    StreamInit(str);
    str->str = str1;

    str->kind = strCCITTFax;
    pfax = str->u.fax = gmalloc(sizeof (CCITTFaxData));
    if (!pfax)
    {
        EOFStreamInit(str, str1);
        return;
    }

    pfax->encoding = encoding1;
    pfax->byteAlign = byteAlign1;
    pfax->columns = columns1;
    pfax->rows = rows1;
    pfax->black = black1;
    pfax->refLine = (short *)gmalloc((pfax->columns + 2) * sizeof(short));
    pfax->codingLine = (short *)gmalloc((pfax->columns + 2) * sizeof(short));
    if (!pfax->refLine || !pfax->codingLine)
    {
        gfree(pfax->refLine);
        gfree(pfax->codingLine);
        gfree(pfax);
        str->u.fax = NULL;
        EOFStreamInit(str, str1);
        return;
    }

    str->eof = gFalse;
    pfax->nextLine2D = pfax->encoding < 0;
    pfax->inputBits = 0;
    pfax->codingLine[0] = 0;
    pfax->codingLine[1] = pfax->refLine[2] = columns1;
    pfax->a0 = 1;

    pfax->buf = EOF;
}

/***********************************************************************
 *      CCITTFaxStreamFree
 ***********************************************************************
 * SYNOPSIS:        Release.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void CCITTFaxStreamFree(Stream *str)
{
    gfree(str->u.fax->refLine);
    gfree(str->u.fax->codingLine);
    gfree(str->u.fax);
}

/***********************************************************************
 *      CCITTFaxStreamReset
 ***********************************************************************
 * SYNOPSIS:        Reset.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void CCITTFaxStreamReset(Stream *str)
{
    CCITTFaxData *pfax = str->u.fax;

    StreamReset(str->str);
    str->eof = gFalse;

    pfax->nextLine2D = pfax->encoding < 0;
    pfax->inputBits = 0;
    if ((CCITTFaxStreamLook13Bits(str) >> 1) == 0x001)
    {
        CCITTFaxStreamEatBits(str, 12);
    }
    pfax->codingLine[0] = 0;
    pfax->codingLine[1] = pfax->refLine[2] = pfax->columns;
    pfax->a0 = 1;
    pfax->buf = EOF;
}

/***********************************************************************
 *      CCITTFaxStreamLookChar
 ***********************************************************************
 * SYNOPSIS:        Process ccittfax stream look char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long CCITTFaxStreamLookChar(Stream *str)
{
    CCITTFaxData *pfax = str->u.fax;
    long a0New;
    long ret;
    long bits, i;
    short code1, code2, code3;

    if (str->eof && pfax->codingLine[pfax->a0] >= pfax->columns)
    {
        return EOF;
    }

    if (pfax->codingLine[pfax->a0] >= pfax->columns)
    {

        i = CCITTFaxStreamLook13Bits(str);
        if (i == EOF || (i >> 1) == 0x001)
        {
            str->eof = gTrue;
            pfax->codingLine[pfax->a0 = 0] = pfax->columns;
            return EOF;
        }

        /* 2-D encoding */
        if (pfax->nextLine2D)
        {
            for (i = 0; pfax->codingLine[i] < pfax->columns; ++i)
            {
                pfax->refLine[i] = pfax->codingLine[i];
            }
            pfax->refLine[i] = pfax->refLine[i + 1] = pfax->columns;
            pfax->b1 = 1;
            a0New = pfax->codingLine[pfax->a0 = 0] = 0;
            do
            {
                code1 = CCITTFaxStreamGetTwoDimCode(str);
                switch (code1)
                {
                    case twoDimPass:
                        if (pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            a0New = pfax->refLine[pfax->b1 + 1];
                            pfax->b1 += 2;
                        }
                        break;
                    case twoDimHoriz:
                        if ((pfax->a0 & 1) == 0)
                        {
                            code1 = code2 = 0;
                            do
                            {
                                code1 += code3 =
                                    CCITTFaxStreamGetWhiteCode(str);
                            }
                            while (code3 >= 64);
                            do
                            {
                                code2 += code3 =
                                    CCITTFaxStreamGetBlackCode(str);
                            }
                            while (code3 >= 64);
                        }
                        else
                        {
                            code1 = code2 = 0;
                            do
                            {
                                code1 += code3 =
                                    CCITTFaxStreamGetBlackCode(str);
                            }
                            while (code3 >= 64);
                            do
                            {
                                code2 += code3 =
                                    CCITTFaxStreamGetWhiteCode(str);
                            }
                            while (code3 >= 64);
                        }
                        pfax->codingLine[pfax->a0 + 1] = a0New + code1;
                        ++pfax->a0;
                        a0New = pfax->codingLine[pfax->a0 + 1] =
                            pfax->codingLine[pfax->a0] + code2;
                        ++pfax->a0;
                        while (
                            pfax->refLine[pfax->b1] <=
                            pfax->codingLine[pfax->a0] &&
                            pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            pfax->b1 += 2;
                        }
                        break;
                    case twoDimVert0:
                        a0New = pfax->codingLine[++pfax->a0] =
                            pfax->refLine[pfax->b1];
                        if (pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            ++pfax->b1;
                            while (
                                pfax->refLine[pfax->b1] <=
                                pfax->codingLine[pfax->a0] &&
                                pfax->refLine[pfax->b1] < pfax->columns)
                            {
                                pfax->b1 += 2;
                            }
                        }
                        break;
                    case twoDimVertR1:
                        a0New = pfax->codingLine[++pfax->a0] =
                            pfax->refLine[pfax->b1] + 1;
                        if (pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            ++pfax->b1;
                            while (
                                pfax->refLine[pfax->b1] <=
                                pfax->codingLine[pfax->a0] &&
                                pfax->refLine[pfax->b1] < pfax->columns)
                            {
                                pfax->b1 += 2;
                            }
                        }
                        break;
                    case twoDimVertL1:
                        a0New = pfax->codingLine[++pfax->a0] =
                            pfax->refLine[pfax->b1] - 1;
                        --pfax->b1;
                        while (
                            pfax->refLine[pfax->b1] <=
                            pfax->codingLine[pfax->a0] &&
                            pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            pfax->b1 += 2;
                        }
                        break;
                    case twoDimVertR2:
                        a0New = pfax->codingLine[++pfax->a0] =
                            pfax->refLine[pfax->b1] + 2;
                        if (pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            ++pfax->b1;
                            while (
                                pfax->refLine[pfax->b1] <=
                                pfax->codingLine[pfax->a0] &&
                                pfax->refLine[pfax->b1] < pfax->columns)
                            {
                                pfax->b1 += 2;
                            }
                        }
                        break;
                    case twoDimVertL2:
                        a0New = pfax->codingLine[++pfax->a0] =
                            pfax->refLine[pfax->b1] - 2;
                        --pfax->b1;
                        while (
                            pfax->refLine[pfax->b1] <=
                            pfax->codingLine[pfax->a0] &&
                            pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            pfax->b1 += 2;
                        }
                        break;
                    case twoDimVertR3:
                        a0New = pfax->codingLine[++pfax->a0] =
                            pfax->refLine[pfax->b1] + 3;
                        if (pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            ++pfax->b1;
                            while (
                                pfax->refLine[pfax->b1] <=
                                pfax->codingLine[pfax->a0] &&
                                pfax->refLine[pfax->b1] < pfax->columns)
                            {
                                pfax->b1 += 2;
                            }
                        }
                        break;
                    case twoDimVertL3:
                        a0New = pfax->codingLine[++pfax->a0] =
                            pfax->refLine[pfax->b1] - 3;
                        --pfax->b1;
                        while (
                            pfax->refLine[pfax->b1] <=
                            pfax->codingLine[pfax->a0] &&
                            pfax->refLine[pfax->b1] < pfax->columns)
                        {
                            pfax->b1 += 2;
                        }
                        break;
                    case EOF:
                        str->eof = gTrue;
                        pfax->codingLine[pfax->a0 = 0] = pfax->columns;
                        return EOF;
                    default:
                        EC_WARNING(-1);

                        return EOF;
                }
            }
            while (pfax->codingLine[pfax->a0] < pfax->columns);

            /* 1-D encoding */
        }
        else
        {
            pfax->codingLine[pfax->a0 = 0] = 0;
            while (1)
            {
                code1 = 0;
                do
                {
                    code1 += code3 = CCITTFaxStreamGetWhiteCode(str);
                }
                while (code3 >= 64);
                pfax->codingLine[pfax->a0 + 1] =
                    pfax->codingLine[pfax->a0] + code1;
                ++pfax->a0;
                if (pfax->codingLine[pfax->a0] >= pfax->columns)
                {
                    break;
                }
                code2 = 0;
                do
                {
                    code2 += code3 = CCITTFaxStreamGetBlackCode(str);
                }
                while (code3 >= 64);
                pfax->codingLine[pfax->a0 + 1] =
                    pfax->codingLine[pfax->a0] + code2;
                ++pfax->a0;
                if (pfax->codingLine[pfax->a0] >= pfax->columns)
                {
                    break;
                }
            }
        }

        if (pfax->codingLine[pfax->a0] != pfax->columns)
        {
            EC_WARNING(-1);
        }

        code1 = CCITTFaxStreamLook13Bits(str);
        if ((code1 >> 1) == 0x001)
        {
            CCITTFaxStreamEatBits(str, 12);
            if (pfax->encoding > 0)
            {
                CCITTFaxStreamEatBits(str, 1);
                pfax->nextLine2D = !(code1 & 1);
            }
        }

        pfax->a0 = 0;
        pfax->outputBits = pfax->codingLine[1] - pfax->codingLine[0];
    }

    if (pfax->outputBits >= 8)
    {
        ret = ((pfax->a0 & 1) == 0) ? 0xff : 0x00;
        if ((pfax->outputBits -= 8) == 0)
        {
            ++pfax->a0;
            if (pfax->codingLine[pfax->a0] < pfax->columns)
            {
                pfax->outputBits =
                    pfax->codingLine[pfax->a0 + 1] - pfax->codingLine[pfax->a0];
            }
        }
    }
    else
    {
        bits = 8;
        ret = 0;
        do
        {
            if (pfax->outputBits > bits)
            {
                i = bits;
                bits = 0;
                if ((pfax->a0 & 1) == 0)
                {
                    ret |= 0xff >> (8 - i);
                }
                pfax->outputBits -= i;
            }
            else
            {
                i = pfax->outputBits;
                bits -= pfax->outputBits;
                if ((pfax->a0 & 1) == 0)
                {
                    ret |= (0xff >> (8 - i)) << bits;
                }
                pfax->outputBits = 0;
                ++pfax->a0;
                if (pfax->codingLine[pfax->a0] < pfax->columns)
                {
                    pfax->outputBits =
                        pfax->codingLine[pfax->a0 + 1] -
                        pfax->codingLine[pfax->a0];
                }
            }
        }
        while (bits > 0 && pfax->codingLine[pfax->a0] < pfax->columns);
    }
    pfax->buf = pfax->black ? (ret ^ 0xff) : ret;
    return pfax->buf;
}

/***********************************************************************
 *      CCITTFaxStreamGetChar
 ***********************************************************************
 * SYNOPSIS:        Get char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long CCITTFaxStreamGetChar(Stream *str)
{
    long c = CCITTFaxStreamLookChar(str);
    str->u.fax->buf = EOF;
    return c;
}

/***********************************************************************
 *      CCITTFaxStreamEatBits
 ***********************************************************************
 * SYNOPSIS:        Process ccittfax stream eat bits.
 * PARAMETERS:      Stream *str    string
 *                  short bits    bits
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void CCITTFaxStreamEatBits(Stream *str, short bits)
{
    str->u.fax->inputBits -= bits;
}

/* Cache these locked pointers in CCITTFaxData during initialization. */

/***********************************************************************
 *      CCITTFaxStreamGetTwoDimCode
 ***********************************************************************
 * SYNOPSIS:        Get two dim code.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static short CCITTFaxStreamGetTwoDimCode(Stream *str)
{
    short code, code0;
    CCITTCode *twoDimTab1;
    CCITTCode *p;
    short retval;

    code0 = CCITTFaxStreamLook13Bits(str);
    code = code0 >> 6;
    if (code == 0x0002)
    {
        CCITTFaxStreamEatBits(str, 7);
        return twoDimVertL3;
    }
    if (code == 0x0003)
    {
        CCITTFaxStreamEatBits(str, 7);
        return twoDimVertR3;
    }
    code >>= 1;
    if (code == 0x0002)
    {
        CCITTFaxStreamEatBits(str, 6);
        return twoDimVertL2;
    }
    if (code == 0x0003)
    {
        CCITTFaxStreamEatBits(str, 6);
        return twoDimVertR2;
    }

    MemLock(OptrToHandle(@twoDimTab1xx));
    twoDimTab1 = LMemDeref(@twoDimTab1xx);

    code >>= 2;
    p = &twoDimTab1[code];
    if (p->bits > 0)
    {
        CCITTFaxStreamEatBits(str, p->bits);
        retval = p->n;
        MemUnlock(OptrToHandle(@twoDimTab1xx));
        return retval;
    }
    MemUnlock(OptrToHandle(@twoDimTab1xx));

    EC_WARNING(-1);

    return EOF;
}

/***********************************************************************
 *      CCITTFaxStreamGetWhiteCode
 ***********************************************************************
 * SYNOPSIS:        Get white code.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static short CCITTFaxStreamGetWhiteCode(Stream *str)
{
    short code, retval;
    CCITTCode *p;
    CCITTCode *whiteTab1, *whiteTab2;

    MemLock(OptrToHandle(@whiteTab1xx));

    code = CCITTFaxStreamLook13Bits(str);
    if ((code >> 6) == 0)
    {
        whiteTab1 = LMemDeref(@whiteTab1xx);
        p = &whiteTab1[code >> 1];
    }
    else
    {
        whiteTab2 = LMemDeref(@whiteTab2xx);
        p = &whiteTab2[code >> 4];
    }
    if (p->bits > 0)
    {
        CCITTFaxStreamEatBits(str, p->bits);
        retval = p->n;
        MemUnlock(OptrToHandle(@whiteTab1xx));
        return retval;
    }

    MemUnlock(OptrToHandle(@whiteTab1xx));
    EC_WARNING(-1);

    return EOF;
}

/***********************************************************************
 *      CCITTFaxStreamGetBlackCode
 ***********************************************************************
 * SYNOPSIS:        Get black code.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static short CCITTFaxStreamGetBlackCode(Stream *str)
{
    short code, retval;
    CCITTCode *p;
    CCITTCode *blackTab1, *blackTab2, *blackTab3;

    MemLock(OptrToHandle(@blackTab1xx));

    code = CCITTFaxStreamLook13Bits(str);
    if ((code >> 7) == 0)
    {
        blackTab1 = LMemDeref(@blackTab1xx);
        p = &blackTab1[code];
    }
    else if ((code >> 9) == 0)
    {
        blackTab2 = LMemDeref(@blackTab2xx);
        p = &blackTab2[(code >> 1) - 64];
    }
    else
    {
        blackTab3 = LMemDeref(@blackTab3xx);
        p = &blackTab3[code >> 7];
    }
    if (p->bits > 0)
    {
        CCITTFaxStreamEatBits(str, p->bits);
        retval = p->n;
        MemUnlock(OptrToHandle(@blackTab1xx));
        return retval;
    }

    MemUnlock(OptrToHandle(@blackTab1xx));
    EC_WARNING(-1);

    return EOF;
}

/***********************************************************************
 *      CCITTFaxStreamLook13Bits
 ***********************************************************************
 * SYNOPSIS:        Process ccittfax stream look13 bits.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static short CCITTFaxStreamLook13Bits(Stream *str)
{
    long c;
    CCITTFaxData *pfax = str->u.fax;

    while (pfax->inputBits < 13)
    {
        if ((c = StreamGetChar(str->str)) == EOF)
        {
            if (pfax->inputBits == 0)
            {
                return EOF;
            }
            c = 0;
        }
        pfax->inputBuf = (pfax->inputBuf << 8) + c;
        pfax->inputBits += 8;
    }
    return(pfax->inputBuf >> (pfax->inputBits - 13)) & 0x1fff;
}

#ifdef __BORLANDC__
#pragma codeseg stream
#endif
#ifdef __WATCOMC__
#pragma code_seg("stream")
#endif

/* RC4Stream -- decrypts an encrypted PDF's raw stream bytes on the fly, */
/* before any other filter (Flate/DCT/...) sees them. */

/***********************************************************************
 *      RC4StreamInit
 ***********************************************************************
 * SYNOPSIS:        Initialize.
 * PARAMETERS:      Stream *str    string
 *                  Stream *str1    str1
 *                  Guchar *key    key
 *                  short keyLen    key len
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void RC4StreamInit(Stream *str, Stream *str1, Guchar *key, short keyLen)
{
    RC4Data *prc4;

    StreamInit(str);
    str->kind = strRC4;
    str->str = str1;
    prc4 = str->u.rc4 = gmalloc(sizeof(RC4Data));
    if (!prc4)
    {
        EOFStreamInit(str, str1);
        return;
    }
    memcpy(prc4->keyBuf, key, keyLen);
    prc4->keyLen = keyLen;
    RC4KeySchedule(prc4->keyBuf, prc4->keyLen, prc4->sBox);
    prc4->rc4i = prc4->rc4j = 0;
    prc4->peeked = gFalse;
}

/***********************************************************************
 *      RC4StreamFree
 ***********************************************************************
 * SYNOPSIS:        Release.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void RC4StreamFree(Stream *str)
{
    gfree(str->u.rc4);
}

/***********************************************************************
 *      RC4StreamReset
 ***********************************************************************
 * SYNOPSIS:        Reset.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void RC4StreamReset(Stream *str)
{
    RC4Data *prc4 = str->u.rc4;

    StreamReset(str->str);
    /* Reset the PRGA state whenever the wrapped stream resets. */
    RC4KeySchedule(prc4->keyBuf, prc4->keyLen, prc4->sBox);
    prc4->rc4i = prc4->rc4j = 0;
    prc4->peeked = gFalse;
}

/***********************************************************************
 *      RC4StreamAdvance
 ***********************************************************************
 * SYNOPSIS:        Advance.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long RC4StreamAdvance(Stream *str)
{
    RC4Data *prc4 = str->u.rc4;
    long c;

    c = StreamGetChar(str->str);
    if (c == EOF)
    {
        return EOF;
    }
    return(long)((Guchar)c ^ RC4NextByte(prc4->sBox, &prc4->rc4i,
        &prc4->rc4j));
}

/***********************************************************************
 *      RC4StreamGetChar
 ***********************************************************************
 * SYNOPSIS:        Get char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long RC4StreamGetChar(Stream *str)
{
    RC4Data *prc4 = str->u.rc4;

    if (prc4->peeked)
    {
        prc4->peeked = gFalse;
        return prc4->peekedChar;
    }
    return RC4StreamAdvance(str);
}

/***********************************************************************
 *      RC4StreamLookChar
 ***********************************************************************
 * SYNOPSIS:        Process rc4 stream look char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static long RC4StreamLookChar(Stream *str)
{
    RC4Data *prc4 = str->u.rc4;

    if (!prc4->peeked)
    {
        prc4->peekedChar = RC4StreamAdvance(str);
        prc4->peeked = gTrue;
    }
    return prc4->peekedChar;
}

/* FlateStream */

#ifdef __BORLANDC__
#pragma codeseg FlateStream
#endif
#ifdef __WATCOMC__
#pragma code_seg("FlateStream")
#endif

/***********************************************************************
 *      FlateStreamEndZlib
 ***********************************************************************
 * SYNOPSIS:        Free zlib's state (window), if it is allocated.
 ***********************************************************************/

static void FlateStreamEndZlib(FlateData *fd)
{
    if (fd->zInit)
    {
        inflateEnd(&fd->strm);
        fd->zInit = gFalse;
    }
}

/***********************************************************************
 *      FlateStreamInit
 ***********************************************************************
 * SYNOPSIS:        Initialize a zlib based Flate decoder.
 * PARAMETERS:      Stream *str     stream to set up
 *                  Stream *str1    compressed data
 *
 * RETURNS:         void
 *
 * STRATEGY:
 *      Only the wrapper data is allocated here; zlib itself is set up by
 *      FlateStreamReset when the stream is really read.
 *      No StreamReset here: the parser builds the filter chain before it
 *      has read "endstream" (see PredictorStreamWrap).
 ***********************************************************************/

void FlateStreamInit(Stream *str, Stream *str1)
{
    FlateData *fd;

    StreamInit(str);
    str->str = str1;

    fd = gmalloc(sizeof(FlateData));
    if (!fd)
    {
        EOFStreamInit(str, str1);
        return;
    }
    memset(fd, 0, sizeof(FlateData));   /* zalloc/zfree/opaque = Z_NULL */

    fd->eof = gTrue;    /* nothing to read until the first reset */
    str->kind = strFlate;
    str->u.flate = fd;
}

/***********************************************************************
 *      FlateStreamFree
 ***********************************************************************
 * SYNOPSIS:        Release the zlib state and the wrapper data.
 ***********************************************************************/

void FlateStreamFree(Stream *str)
{
    if (str->u.flate)
    {
        FlateStreamEndZlib(str->u.flate);
        gfree(str->u.flate);
        str->u.flate = NULL;
    }
}

/***********************************************************************
 *      FlateStreamReset
 ***********************************************************************
 * SYNOPSIS:        Restart decoding at the beginning of the data.
 ***********************************************************************/

void FlateStreamReset(Stream *str)
{
    FlateData *fd = str->u.flate;

    int ret;

    StreamReset(str->str);

    /*
     * Fresh zlib state for every pass (inflateReset would keep the old
     * window around between passes). 15 window bits: the zlib library is
     * built with MAX_WBITS=14 (that only limits its own compressor), but
     * almost all PDF writers use the full 32 KB window, which plain
     * inflateInit() would reject as "invalid window size".
     */
    FlateStreamEndZlib(fd);
    fd->eof = gTrue;
    fd->readIndex = 0;
    fd->readCount = 0;
    memset(&fd->strm, 0, sizeof(z_stream));
    fd->strm.next_in = fd->inBuf;
    ret = inflateInit2(&fd->strm, flateWindowBits);
    if (ret != Z_OK)
    {
        if (ret == Z_MEM_ERROR)
        {
            GMemSetError();
        }
        EC_WARNING(-1);
        return;
    }
    fd->zInit = gTrue;

    fd->strm.next_in = fd->inBuf;   /* zlib 1.1.4 rejects next_in == NULL */
    fd->strm.avail_in = 0;
    fd->eof = gFalse;
    fd->inEof = gFalse;
    fd->readIndex = 0;
    fd->readCount = 0;
}

/* FlateStreamGetChar moved above into StreamGetChar's code segment. */

/***********************************************************************
 *      FlateStreamLookChar
 ***********************************************************************
 * SYNOPSIS:        Peek at the next decoded byte.
 * RETURNS:         byte value or EOF
 ***********************************************************************/

long FlateStreamLookChar(Stream *str)
{
    FlateData *fd = str->u.flate;

    if (fd->readIndex >= fd->readCount)
    {
        fd->readCount = FlateStreamReadRaw(str, fd->readBuf,
            flateReadBufSize);
        fd->readIndex = 0;
        if (fd->readCount == 0)
        {
            return EOF;
        }
    }

    return fd->readBuf[fd->readIndex];
}

/***********************************************************************
 *      FlateStreamReadRaw
 ***********************************************************************
 * SYNOPSIS:        Inflate up to size bytes straight into out.
 * PARAMETERS:      Stream *str     Flate stream
 *                  Guchar *out     destination
 *                  word size       bytes wanted
 *
 * RETURNS:         bytes delivered; less than size only at the end
 *
 * STRATEGY:
 *      Refill the input buffer from the underlying stream whenever zlib
 *      has used it up. Stop at Z_STREAM_END, on any zlib error (what was
 *      decoded so far is still returned, like xpdf does with damaged
 *      data), or when the input is exhausted and zlib makes no progress
 *      (truncated stream).
 ***********************************************************************/

static word FlateStreamReadRaw(Stream *str, Guchar *out, word size)
{
    FlateData *fd = str->u.flate;
    z_stream *zs;
    uInt outBefore, inBefore;
    int ret;

    if (fd->eof || size == 0)
    {
        return 0;
    }

    zs = &fd->strm;
    zs->next_out = out;
    zs->avail_out = size;

    while (zs->avail_out > 0)
    {
        if (zs->avail_in == 0 && !fd->inEof)
        {
            zs->next_in = fd->inBuf;
            zs->avail_in = StreamRead(str->str, fd->inBuf, flateInBufSize);
            if (zs->avail_in == 0)
            {
                fd->inEof = gTrue;
            }
        }

        outBefore = zs->avail_out;
        inBefore = zs->avail_in;
        ret = inflate(zs, Z_NO_FLUSH);

        if (ret == Z_STREAM_END)
        {
            fd->eof = gTrue;
            break;
        }
        if (ret != Z_OK && ret != Z_BUF_ERROR)
        {
            /* Z_DATA_ERROR, Z_NEED_DICT, Z_MEM_ERROR, Z_STREAM_ERROR */
            if (ret == Z_MEM_ERROR)
            {
                GMemSetError();
            }
            EC_WARNING(-1);
            fd->eof = gTrue;
            break;
        }
        if (zs->avail_out == outBefore && zs->avail_in == inBefore &&
            (fd->inEof || zs->avail_in > 0))
        {
            /* no progress possible: truncated or stuck stream */
            fd->eof = gTrue;
            break;
        }
    }

    size -= (word)zs->avail_out;
    if (fd->eof)
    {
        /* done with this pass: give the window back right away */
        FlateStreamEndZlib(fd);
    }
    return size;
}

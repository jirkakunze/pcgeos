}

/***********************************************************************
 *      ObjStmCacheStreamSetPos
 ***********************************************************************
 * SYNOPSIS:        Set position.
 * PARAMETERS:      Stream *str    string
 *                  long pos    file position
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void ObjStmCacheStreamSetPos(Stream *str, long pos)
{
    ObjStmCacheStreamData *d = str->u.objStmCache;
    if (pos < d->start)
    {
        pos = d->start;
    }
    if (pos > d->length)
    {
        pos = d->length;
    }
    d->pos = pos;
    d->bufIndex = d->bufCount = 0;
}

/* Shared file read cache (OPT-17) */

/*
 * No cache data is locked and the working set is constant. The cache is
 * nevertheless keyed by FileHandle and is explicitly invalidated by XRefFree().
 */
#define fStreamSharedCacheSize 2048

typedef struct FStreamSharedCache {
    FileHandle file;
    long pos;
    word count;
    Guchar buf[fStreamSharedCacheSize];
} FStreamSharedCache;

static FStreamSharedCache fStreamSharedCache = { 0, 0, 0 };

/***********************************************************************
 *      FStreamInvalidateReadCache
 ***********************************************************************
 * SYNOPSIS:        Read cache.
 * PARAMETERS:      FileHandle file    file
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void FStreamInvalidateReadCache(FileHandle file)
{
    if (file == 0 || fStreamSharedCache.file == file)
    {
        fStreamSharedCache.file = 0;
        fStreamSharedCache.pos = 0;
        fStreamSharedCache.count = 0;
    }
}

/***********************************************************************
 *      FStreamReadCached
 ***********************************************************************
 * SYNOPSIS:        Read cached.
 * PARAMETERS:      FileHandle file    file
 *                  long pos    file position
 *                  Guchar *dst    dst
 *                  word n    count
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static word FStreamReadCached(FileHandle file, long pos, Guchar *dst, word n)
{
    long cacheEnd;
    word offset;
    word avail;
    word readCount;

    if (!n)
    {
        return 0;
    }

    cacheEnd = fStreamSharedCache.pos + (long)fStreamSharedCache.count;
    if (fStreamSharedCache.file == file &&
        pos >= fStreamSharedCache.pos && pos < cacheEnd)
    {
        offset = (word)(pos - fStreamSharedCache.pos);
        avail = fStreamSharedCache.count - offset;
        if (avail >= n)
        {
            memcpy(dst, fStreamSharedCache.buf + offset, n);
            return n;
        }
    }

    /* Cache miss. */
    FilePos(file, pos, FILE_POS_START);
    readCount = FileRead(file, fStreamSharedCache.buf,
        sizeof(fStreamSharedCache.buf), FALSE);
    fStreamSharedCache.file = file;
    fStreamSharedCache.pos = pos;
    fStreamSharedCache.count = readCount;

    if (readCount > n)
    {
        readCount = n;
    }
    if (readCount)
    {
        memcpy(dst, fStreamSharedCache.buf, readCount);
    }
    return readCount;
}

/* FileStream */

/***********************************************************************
 *      FStreamInitWithStorage
 ***********************************************************************
 * SYNOPSIS:        Initialize with storage.
 * PARAMETERS:      Stream *this    this
 *                  FStream *storage    storage
 *                  FileHandle f1    f1
 *                  long start1    start1
 *                  long length1    length1
 *                  Obj *dict1    dict1
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void FStreamInitWithStorage(Stream *this, FStream *storage, FileHandle f1,
    long start1, long length1, Obj *dict1)
{
    FStream *myfs;

    StreamInit(this);
    this->kind = strFile;
    myfs = this->u.fs = storage;

    /* Keep the caller-owned source handle. */
    myfs->f = f1;
    myfs->start = myfs->bufPos = start1;
    myfs->length = length1;
    myfs->bufPtr = myfs->bufEnd = myfs->buf;
    myfs->savePos = -1;
    ObjMove(&myfs->dict, dict1);

    /* Physical seeking is deferred to FStreamReadCached() on a miss. */
}

/***********************************************************************
 *      FStreamInit
 ***********************************************************************
 * SYNOPSIS:        Initialize.
 * PARAMETERS:      Stream *this    this
 *                  FileHandle f1    f1
 *                  long start1    start1
 *                  long length1    length1
 *                  Obj *dict1    dict1
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void FStreamInit(Stream *this, FileHandle f1, long start1, long length1,
    Obj *dict1)
{
    FStream *myfs;

    myfs = gmalloc(sizeof(FStream));
    if (!myfs)
    {
        StreamInit(this);
        this->kind = strEOF;
        return;
    }
    FStreamInitWithStorage(this, myfs, f1, start1, length1, dict1);
}

/***********************************************************************
 *      FStreamFree
 ***********************************************************************
 * SYNOPSIS:        Release.
 * PARAMETERS:      Stream *this    this
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void FStreamFree(Stream *this)
{
    FStream *fs = this->u.fs;

    /*
     * Note: FStream shouldn't wrap another stream, so no need to free
     * this->str.
     */

    ObjFree(&fs->dict);
    /* fs->f is caller-owned; FStream no longer duplicates the handle. */
    gfree(fs);

}

/***********************************************************************
 *      FStreamReset
 ***********************************************************************
 * SYNOPSIS:        Reset.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void FStreamReset(Stream *str)
{
    FStream *this = str->u.fs;

    this->savePos = -1;
    this->bufPtr = this->bufEnd = this->buf;
    this->bufPos = this->start;
}

/***********************************************************************
 *      FStreamFillBuf
 ***********************************************************************
 * SYNOPSIS:        Fill buffer.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static GBool FStreamFillBuf(Stream *str)
{
    FStream *this = str->u.fs;
    word n;

    this->bufPos += this->bufEnd - this->buf;
    /*
     * I originally implemented streams using 'FileDuplicateHandle' because I
     * thought each handle would maintain its own independent file position as
     * reads were made.
     */
    /* FStreamReadCached() performs FilePos() only on a shared-cache miss. */
    this->bufPtr = this->bufEnd = this->buf;

    if (this->length >= 0 && this->bufPos >= this->start + this->length)
    {
        return gFalse;
    }
    if (this->length >= 0
        && this->bufPos + sizeof(this->buf) > this->start + this->length)
    {
        n = this->start + this->length - this->bufPos;
    }
    else
    {
        n = sizeof (this->buf);
    }
    n = FStreamReadCached(this->f, this->bufPos, (Guchar *)this->buf, n);
    this->bufEnd = this->buf + n;
    if (this->bufPtr >= this->bufEnd)
    {
        return gFalse;
    }
    return gTrue;
}

/***********************************************************************
 *      FStreamSetPos
 ***********************************************************************
 * SYNOPSIS:        Set position.
 * PARAMETERS:      Stream *str    string
 *                  long pos1    pos1
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void FStreamSetPos(Stream *str, long pos1)
{
    FStream *this = str->u.fs;
    long size;

    if (pos1 >= 0)
    {
        /* Logical seek only; physical seek happens on the next cache miss. */
        this->bufPos = pos1;
    }
    else
    {
        size = FilePos(this->f, 0, FILE_POS_END);
        if (pos1 < -size)
        {
            pos1 = (-size);
        }
        this->bufPos = FilePos(this->f, pos1, FILE_POS_END);
    }
    this->bufPtr = this->bufEnd = this->buf;
}

/***********************************************************************
 *      FStreamGetChar
 ***********************************************************************
 * SYNOPSIS:        Get char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

long FStreamGetChar(Stream *str)
{
    FStream *this = str->u.fs;

    return(this->bufPtr >= this->bufEnd &&
        !FStreamFillBuf(str)) ? EOF : (*this->bufPtr++ & 0xff);
}

/***********************************************************************
 *      FStreamLookChar
 ***********************************************************************
 * SYNOPSIS:        Process fstream look char.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         result value

 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

long ObjStmCacheStreamGetLength(Stream *str)
{
    return str->u.objStmCache->length - str->u.objStmCache->start;
}

/***********************************************************************
 *      ObjStmCacheStreamGetPos
 ***********************************************************************
 * SYNOPSIS:        Get position.

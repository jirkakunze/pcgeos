/***********************************************************************
 *      ASCII85StreamReset
 ***********************************************************************
 * SYNOPSIS:        Reset.
 * PARAMETERS:      Stream *str    string
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void ASCII85StreamReset(Stream *str)
{

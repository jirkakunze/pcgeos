/********************************************************************
 *                      StreamInit
 ********************************************************************
 * SYNOPSIS:      Initialize the common fields of a stream.
 *
 * PARAMETERS:    *stream               Ptr to the stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
void StreamInit(Stream *stream)
{

    EC(ECCheckBounds(stream));

    stream->kind = strWeird;
    stream->str = NULL;

    stream->ref = 1;
    stream->rawLine = NULL;
    stream->pixLine = NULL;
}

/********************************************************************
 *                      StreamFree
 ********************************************************************
 * SYNOPSIS:      Free a stream and the streams it wraps.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:      File streams and substreams end the chain; all other kinds
 *                also free the stream in str->str.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
void StreamFree(Stream *str)
{

    EC(ECCheckBounds(str));

    gfree(str->rawLine);
    gfree(str->pixLine);

    switch (str->kind)
    {
        /* File streams wrap no other stream */
        case strFile:
            FStreamFree(str);
            return;
            /* Substreams do not own their base stream */
        case strSubStream:
            SubStreamFree(str);
            return;

            /* All other streams free the stream they wrap */
        case strLZW:
            LZWStreamFree(str);
            break;

        case strFlate:
            FlateStreamFree(str);
            break;

        case strDCT:
            DCTStreamFree(str);
            break;

        case strASCIIHex:
            ASCIIHexStreamFree(str);
            break;

        case strASCII85:
            ASCII85StreamFree(str);
            break;

        case strRunLength:
            RunLengthStreamFree(str);
            break;

        case strCCITTFax:
            CCITTFaxStreamFree(str);
            break;

        case strEOF:
            EOFStreamFree(str);
            break;

        case strRC4:
            RC4StreamFree(str);
            break;

        case strPredictor:
            PredictorStreamFree(str);
            break;
    }

    StreamFree(str->str);
    gfree(str->str);
}

/********************************************************************
 *                      StreamGetFile
 ********************************************************************
 * SYNOPSIS:      Return the file handle of the base file stream.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       FileHandle            File handle.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
FileHandle StreamGetFile(Stream *str)
{

    if (str->kind == strFile)
    {
        return FStreamGetFile(str);
    }

    return StreamGetFile(str->str);
}

/********************************************************************
 *                      StreamGetChar
 ********************************************************************
 * SYNOPSIS:      Read the next byte of a stream.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Byte, EOF at the end of the data.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
short StreamGetChar(Stream *str)
{

    switch (str->kind)
    {

        case strFile:
            return FStreamGetChar(str);

        case strSubStream:
            return StreamGetChar(str->str);

        case strLZW:
            return LZWStreamGetChar(str);

        case strFlate:
            return FlateStreamGetChar(str);

        case strDCT:
            return DCTStreamGetChar(str);

        case strASCIIHex:
            return ASCIIHexStreamGetChar(str);

        case strASCII85:
            return ASCII85StreamGetChar(str);

        case strRunLength:
            return RunLengthStreamGetChar(str);

        case strCCITTFax:
            return CCITTFaxStreamGetChar(str);

        case strEOF:
            return EOFStreamGetChar(str);

        case strRC4:
            return RC4StreamGetChar(str);

        case strPredictor:
            return PredictorStreamGetChar(str);
    }

    EC_ERROR(-1);
    return EOF;
}

/********************************************************************
 *                      StreamRead
 ********************************************************************
 * SYNOPSIS:      Read a block of bytes.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *                *buf                  Ptr to the destination buffer.
 *                size                  Number of bytes.
 *
 * RETURNS:       word                  Number of bytes read, less at the end of
 *                                      the data.
 *
 * STRATEGY:      Flate, predictor, DCT, file, LZW, RunLength and RC4 streams
 *                copy blocks; the other kinds read byte by byte.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
word StreamRead(Stream *str, Guchar *buf, word size)
{
    word n;
    short c;

    if (size == 0)
    {
        return 0;
    }

    if (str->kind == strFlate)
    {
        return FlateStreamRead(str, buf, size);
    }

    if (str->kind == strPredictor)
    {
        return PredictorStreamRead(str, buf, size);
    }

    if (str->kind == strDCT)
    {
        return DCTStreamRead(str, buf, size);
    }

    /* Buffered streams: copy blocks, not one byte at a time */
    if (str->kind == strFile)
    {
        return StreamReadFromBuf(str, buf, size, &str->u.fs->bufPtr,
            &str->u.fs->bufEnd);
    }

    if (str->kind == strLZW)
    {
        return StreamReadFromBuf(str, buf, size, &str->u.lzw->bufPtr,
            &str->u.lzw->bufEnd);
    }

    if (str->kind == strRunLength)
    {
        return StreamReadFromBuf(str, buf, size, &str->u.runLength->bufPtr,
            &str->u.runLength->bufEnd);
    }

    if (str->kind == strRC4)
    {
        return RC4StreamRead(str, buf, size);
    }

    if (str->kind == strSubStream)
    {
        return StreamRead(str->str, buf, size);
    }

    for (n = 0; n < size; ++n)
    {
        c = StreamGetChar(str);
        if (c == EOF)
        {
            break;
        }
        buf[n] = (Guchar)c;
    }
    return n;
}

/********************************************************************
 *                      StreamReadFromBuf
 ********************************************************************
 * SYNOPSIS:      Read a block from the buffer of a buffered stream.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *                *buf                  Ptr to the destination buffer.
 *                size                  Number of bytes.
 *                *bufPtr               Ptr to the read pointer of the stream
 *                                      buffer.
 *                *bufEnd               Ptr to the end pointer of the stream
 *                                      buffer.
 *
 * RETURNS:       word                  Number of bytes read, less at the end of
 *                                      the data.
 *
 * STRATEGY:      Refill through a switch on the stream kind (the fill functions
 *                are in other segments: no function pointer).
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      11/25/26  JK        Initial version
 *******************************************************************/
static word StreamReadFromBuf(Stream *str, Guchar *buf, word size,
    char **bufPtr, char **bufEnd)
{
    word n = 0, avail;
    GBool more;

    EC(ECCheckBounds(buf));

    while (n < size)
    {
        if (*bufPtr >= *bufEnd)
        {
            switch (str->kind)
            {
                case strFile:
                    more = FStreamFillBuf(str);
                    break;
                case strLZW:
                    more = LZWStreamFillBuf(str);
                    break;
                case strRunLength:
                    more = RunLengthStreamFillBuf(str);
                    break;
                default:
                    EC_ERROR(-1);
                    more = gFalse;
                    break;
            }
            if (!more)
            {
                break;
            }
        }
        avail = (word)(*bufEnd - *bufPtr);
        if (avail > size - n)
        {
            avail = size - n;
        }
        memcpy(buf + n, *bufPtr, avail);
        *bufPtr += avail;
        n += avail;
    }
    return n;
}

/********************************************************************
 *                      StreamSkipLookedChar
 ********************************************************************
 * SYNOPSIS:      Read the byte that StreamLookChar returned last.
 *
 * PARAMETERS:    *str                  Ptr to the stream. The last call for
 *                                      it must be a StreamLookChar that did
 *                                      not return EOF.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Same result as StreamGetChar, but faster for the lexer
 *                (look at a char, then take it): Flate and file streams
 *                have the byte in their buffer after the look, thus only
 *                move the read position. Other streams use StreamGetChar.
 *                Sub-streams pass the call to their base stream, as
 *                StreamGetChar does.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      11/28/26  Claude/jkunze  Initial version
 *******************************************************************/
void StreamSkipLookedChar(Stream *str)
{
    EC(ECCheckBounds(str));

    while (str->kind == strSubStream)
    {
        str = str->str;
    }
    if (str->kind == strFlate)
    {
        /* FlateStreamLookChar filled the buffer */
        EC_ERROR_IF(str->u.flate->readIndex >= str->u.flate->readCount, -1);
        ++str->u.flate->readIndex;
        return;
    }
    if (str->kind == strFile)
    {
        /* FStreamLookChar filled the buffer */
        EC_ERROR_IF(str->u.fs->bufPtr >= str->u.fs->bufEnd, -1);
        ++str->u.fs->bufPtr;
        return;
    }
    (void)StreamGetChar(str);
}

/********************************************************************
 *                      StreamLookChar
 ********************************************************************
 * SYNOPSIS:      Return the next byte but do not read it.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Byte, EOF at the end of the data.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
short StreamLookChar(Stream *str)
{

    switch (str->kind)
    {

        case strFile:
            return FStreamLookChar(str);

        case strSubStream:
            return StreamLookChar(str->str);

        case strLZW:
            return LZWStreamLookChar(str);

        case strFlate:
            return FlateStreamLookChar(str);

        case strDCT:
            return DCTStreamLookChar(str);

        case strASCIIHex:
            return ASCIIHexStreamLookChar(str);

        case strASCII85:
            return ASCII85StreamLookChar(str);

        case strRunLength:
            return RunLengthStreamLookChar(str);

        case strCCITTFax:
            return CCITTFaxStreamLookChar(str);

        case strEOF:
            return EOFStreamLookChar(str);

        case strRC4:
            return RC4StreamLookChar(str);

        case strPredictor:
            return PredictorStreamLookChar(str);
    }

    EC_ERROR(-1);
    return EOF;
}

/********************************************************************
 *                      FlateStreamGetChar
 ********************************************************************
 * SYNOPSIS:      Read the next byte of a Flate stream.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       short                 Byte, EOF at the end of the data.
 *
 * STRATEGY:      Bytes come from a small read-ahead buffer. In this segment, so
 *                that StreamGetChar calls it directly.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short FlateStreamGetChar(Stream *str)
{
    FlateData *pflate = str->u.flate;

    if (pflate->readIndex >= pflate->readCount)
    {
        pflate->readCount = FlateStreamReadRaw(str, pflate->readBuf,
            flateReadBufSize);
        pflate->readIndex = 0;
        if (pflate->readCount == 0)
        {
            return EOF;
        }
    }

    return pflate->readBuf[pflate->readIndex++];
}

/********************************************************************
 *                      FlateStreamRead
 ********************************************************************
 * SYNOPSIS:      Read a block from a Flate stream.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *                *buf                  Ptr to the destination buffer.
 *                size                  Number of bytes.
 *
 * RETURNS:       word                  Number of bytes read, less at the end of
 *                                      the data.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static word FlateStreamRead(Stream *str, Guchar *buf, word size)
{
    FlateData *pflate = str->u.flate;
    word total = 0;
    word n;

    /* Consume bytes already prefetched for GetChar/LookChar first. */
    while (total < size && pflate->readIndex < pflate->readCount)
    {
        buf[total++] = pflate->readBuf[pflate->readIndex++];
    }

    if (total < size)
    {
        n = FlateStreamReadRaw(str, buf + total, size - total);
        total += n;
    }

    return total;
}

/********************************************************************
 *                      StreamGetDict
 ********************************************************************
 * SYNOPSIS:      Return the stream dictionary of the base stream.
 *
 * PARAMETERS:    *str                  Ptr to the stream.
 *
 * RETURNS:       Dict *                Ptr to the dictionary.

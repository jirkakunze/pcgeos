static void CopyNamedEncoding(GfxFont *this, Obj *pObj, GBool hasWidthsArray);
static void GfxFontMakeWidths(GfxFont *this, Dict *fontDict, XRef *xref);
static short GfxFontLookupStandardWidth(GfxFont *this, const char *name,
    word len);
static optr GfxFontWidthTable(GfxFont *this);
static sword GfxNameListFind(const char *list, const char *name, word len);
static word GfxNameListEntryLen(const char *entry);
static void GfxFontMakeEncoding(GfxFont *this, Dict *fontDict, XRef *xref,
    GBool hasWidthsArray);

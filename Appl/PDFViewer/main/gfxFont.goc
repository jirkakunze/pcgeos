/* GfxFont */

/***********************************************************************
 *      GfxFontNameRule
 ***********************************************************************
 * SYNOPSIS:        Generic name rules for fonts not in fontNameMap.
 * RETURNS:         class letter (see fontNameMap), 0 = no rule applies
 ***********************************************************************/
static char GfxFontNameRule(const char *name)
{
    const char *p;

    /* "Mono" as a word: not "Monotype", "Monoline" */
    for (p = strstr(name, "Mono"); p; p = strstr(p + 1, "Mono"))
    {
        if (!islower(p[4]) || !strncmp(p + 4, "space", 5))
        {
            return 'M';
        }
    }
    if (strstr(name, "Code") || strstr(name, "Console") ||
        strstr(name, "Typewriter"))
    {
        return 'M';
    }
    if (strstr(name, "Serif") && !strstr(name, "Sans"))
    {
        return 'S';
    }
    if (strstr(name, "Sans") || strstr(name, "Gothic") ||
        strstr(name, "Grotesk"))
    {
        return 'N';
    }
    if (strstr(name, "Roman") || strstr(name, "Antiqua"))
    {
        return 'S';
    }
    return 0;
}

/***********************************************************************
 *      GfxFontMapName
 ***********************************************************************
 * SYNOPSIS:        Pick the GEOS substitute font class from the name.
 * PARAMETERS:      GfxFont *this       font, flags already set from
 *                                      /Flags (or the default)
 *                  const char *name    PDF font name (BaseFont)
 * STRATEGY:        Font names are far more reliable than /Flags (many
 *                  producers write 32 = "nonsymbolic" for every font).
 *                  The name is normalized (subset tag "AAAAAA+", spaces
 *                  and '_' dropped), then looked up as a prefix in
 *                  fontNameMap, then the generic rules. If either knows
 *                  the font, its class replaces the serif / fixed /
 *                  symbolic flags; otherwise the flags stay.
 ***********************************************************************/
void GfxFontMapName(GfxFont *this, const char *name)
{
    char buf[48];
    char *map, *entry, *end;
    char cls = 0;
    word len, n = 0;

    /* Ignore any unique tag (name starts with "AAAAAA+"). */
    if (strlen(name) > 8 && isalpha(name[0]) && isalpha(name[1])
        && isalpha(name[2]) && isalpha(name[3]) && isalpha(name[4])
        && isalpha(name[5]) && name[6] == '+')
    {
        name = &name[7];
    }
    for (; *name && n < sizeof(buf) - 1; ++name)
    {
        if (*name != ' ' && *name != '_')
        {
            buf[n++] = *name;
        }
    }
    buf[n] = '\0';
    if (n == 0)
    {
        return;
    }

    MemLock(OptrToHandle(@fontNameMap));
    map = LMemDeref(@fontNameMap);
    for (entry = map; *entry; entry = (*end) ? end + 1 : end)
    {
        for (end = entry + 1; *end && *end != '|'; ++end)
        {
        }
        len = end - entry - 1;
        if (len && !strncmp(buf, entry + 1, len))
        {
            cls = entry[0];
            break;
        }
    }
    MemUnlock(OptrToHandle(@fontNameMap));

    if (cls == 0)
    {
        cls = GfxFontNameRule(buf);
    }
    if (cls == 0)
    {
        return;
    }
    this->flags &= ~(fontSymbolic | fontSerif | fontFixedWidth);
    switch (cls)
    {
        case 'M':
            this->flags |= fontFixedWidth;
            break;
        case 'S':
            this->flags |= fontSerif;
            break;
        case 'Y':
            this->flags |= fontSymbolic;
            break;
    }
}

/***********************************************************************
 *      GfxFontNameStyle
 ***********************************************************************
 * SYNOPSIS:        Derive bold/italic from the font name.
 * STRATEGY:        The font code uses the fontBold and fontItalic flags
 *                  to set the bold and italic text styles.
 ***********************************************************************/
static void GfxFontNameStyle(GfxFont *this)
{
    if (strstr(GStrGetCString(&this->name), "Bold")
        || strstr(GStrGetCString(&this->name), "Black")
        || strstr(GStrGetCString(&this->name), "CMBX"))
    {
        this->flags |= fontBold;
    }
    if (strstr(GStrGetCString(&this->name), "Italic")
        || strstr(GStrGetCString(&this->name), "Oblique")
        || strstr(GStrGetCString(&this->name), "CMTI")
        || strstr(GStrGetCString(&this->name), "CMSL")
        || strstr(GStrGetCString(&this->name), "CMMI"))
    {
        this->flags |= fontItalic;
    }
}

/***********************************************************************
 *      GfxFontInit
 ***********************************************************************
 * SYNOPSIS:        Initialize.
 * PARAMETERS:      GfxFont *this    this
 *                  char *tag1    tag1
 *                  Ref id1    id1
 *                  Dict *fontDict    font dict
 *                  XRef *xref    cross-reference table
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void GfxFontInit(GfxFont *this, char *tag1, Ref id1, Dict *fontDict, XRef *xref)
{

    Obj obj1, obj2;
    char *pPdfToGeosMap;
    char **pNameMap;
    int code;
    word toUniAppliedCount;
    GBool hasWidthsArray;

    /* make cleanup safe even if a string allocation below fails */
    this->cidMap = this->cidRanges = NullHandle;
    this->cidCount = this->cidRangeCount = 0;
    this->cidDefaultWidth = 1000;
    this->charRise = 0;
    this->tag.s = this->name.s = NULL;
    this->tag.length = this->name.length = 0;

    GStrInitString(&this->tag, tag1);
    if (GMemHadError())
    {
        return;
    }
    this->id.num = id1.num;
    this->id.gen = id1.gen;

    GStrInit(&this->name);
    if (GMemHadError())
    {
        return;
    }
    DictLookup(fontDict, "BaseFont", &obj1, xref);
    if (isName(&obj1))
    {
        GStrAppendString(&this->name, getName(&obj1));
    }
    ObjFree(&obj1);

    /* is it a built-in font? */

    /*
     * TeX extension font (big operators, delimiters): its glyphs hang
     * below the baseline (cmex10.afm: summationtext 0 .. -1000), the
     * GEOS substitutes stand on it -- move them down.
     */
    if (strstr(GStrGetCString(&this->name), "CMEX"))
    {
        this->charRise = -800;
    }

    this->type = fontUnknownType;
    DictLookup(fontDict, "Subtype", &obj1, xref);
    if (isNameSame(&obj1, "Type1"))
    {
        this->type = fontType1;
    }
    else if (isNameSame(&obj1, "Type3"))
    {
        this->type = fontType3;
    }
    else if (isNameSame(&obj1, "TrueType"))
    {
        this->type = fontTrueType;
    }
    else if (isNameSame(&obj1, "Type0"))
    {
        this->type = fontType0;
    }
    ObjFree(&obj1);
    this->is16 = gFalse;

    /*
     * Substitute font class: Times-Roman by default, the font name
     * (GfxFontMapName) overrides it -- also over the /Flags read below.
     */
    this->flags = fontSerif;
    GfxFontMapName(this, GStrGetCString(&this->name));

    this->embFontID.num = -1;
    this->embFontID.gen = -1;
    this->hasCharSet = gFalse;
    this->fontWidthFactor = 0;

    DictLookup(fontDict, "FontDescriptor", &obj1, xref);
    if (isDict(&obj1))
    {

        /* Is CharSet entry present? */

        ObjDictLookup(&obj1, "CharSet", &obj2, xref);
        if (!isNull(&obj2))
        {
            this->hasCharSet = gTrue;
        }
        ObjFree(&obj2);

        /* flags */
        ObjDictLookup(&obj1, "Flags", &obj2, xref);
        if (isInt(&obj2))
        {
            this->flags = getInt(&obj2);
        }
        ObjFree(&obj2);
        /*
         * The name decides over the flags (often just 32, or 'symbolic'
         * set for ordinary text fonts).
         */
        GfxFontMapName(this, GStrGetCString(&this->name));
        /*
         * Maybe this is too tailored to a specific problem, but I've had a
         * case of the 'symbol' flag getting set for non-symbol fonts:
         */
        if (this->flags & (fontSerif | fontFixedWidth))
        {
            this->flags &= ~fontSymbolic;
        }

        /* embedded Type 1 font file and font name */
        if (this->type == fontType1)
        {
            ObjDictLookupNF(&obj1, "FontFile", &obj2);
            if (isRef(&obj2))
            {
                /* its built-in encoding: GfxFontReadBuiltinEncoding */
                this->embFontID = getRef(&obj2);
            }
            ObjFree(&obj2);

            /* embedded TrueType font file */
        }
        else if (this->type == fontTrueType)
        {
            ObjDictLookupNF(&obj1, "FontFile2", &obj2);
            if (isRef(&obj2))
            {
                this->embFontID = getRef(&obj2);
            }
            ObjFree(&obj2);
        }
    }
    ObjFree(&obj1);

    /*
     * Type0: codes, widths and char mapping come from the CIDFont
     * descendant and /ToUnicode (main/cidFont.c), none of the 8 bit
     * encoding work below applies.
     */
    if (this->type == fontType0)
    {
        GfxCidFontInit(this, fontDict, xref);
        GfxFontNameStyle(this);
        return;
    }

    /*
     * Check for an explicit /Widths array EARLY, before any of the inline
     * standard-font fallback width lookups below ~= 85760 comparisons.
     */
    DictLookup(fontDict, "Widths", &obj1, xref);
    hasWidthsArray = isArray(&obj1);
    ObjFree(&obj1);

    /*
     * Zero this->widths[] here, before any code path that computes standard-
     * font fallback widths inline as it discovers glyph names.
     */
    memset(this->widths, 0, 256 * sizeof(short));
    memset(this->symChars, 0, sizeof(this->symChars));

    /*
     * duplicate the standard (or symbol) character map -- moved here so this
     * sees this->flags' FINAL value.
     */

    if (this->flags & fontSymbolic)
    {
        for (code = 0; code < 256; code ++)
        {
            this->charMap[code] = code;
        }
    }
    else
    {
        MemLock(OptrToHandle(@pdfToGeosMap));
        pPdfToGeosMap = LMemDeref(@pdfToGeosMap);
        memcpy(this->charMap, pPdfToGeosMap, sizeof (this->charMap));
        MemUnlock(OptrToHandle(@pdfToGeosMap));
    }

    /*
     * Skip this whole block (including the lock/unlock) when the font has an
     * explicit /Widths array -- see hasWidthsArray's own comment above.
     */
    if (!hasWidthsArray)
    {
        MemLock(OptrToHandle(@standardEncodingNames));
        pNameMap = LMemDeref((this->flags & fontSymbolic ?
            @symbolEncodingNames : @standardEncodingNames));
        /*
         * Compute fallback widths inline; no persistent charNames table is
         * needed.
         */
        for (code = 0; code < 256; ++code)
        {
            if (pNameMap[code] != NULL)
            {
                this->widths[code] = GfxFontLookupStandardWidth(this,
                    pNameMap[code]);
            }
        }
        MemUnlock(OptrToHandle(@standardEncodingNames));
    }

    /*
     * An embedded Type 1 font without a named /Encoding uses the encoding
     * built into the font file (pdfTeX: all fonts, /Flags 4 = symbolic).
     * The glyph names tell the characters, so it is a text font.
     */
    if (this->type == fontType1 && this->embFontID.num >= 0)
    {
        if (GfxFontReadBuiltinEncoding(this, xref, hasWidthsArray) > 0)
        {
            this->flags &= ~fontSymbolic;
        }
    }

    GfxFontNameStyle(this);

    /* Homegrown char encoding merging */
    if (this->type != fontType0)
    {
        GfxFontMakeEncoding(this, fontDict, xref, hasWidthsArray);
        /* Make widths too */
        GfxFontMakeWidths(this, fontDict, xref);
    }

    /*
     * /ToUnicode, if present, is the most reliable source of truth we have for
     * what a character code actually means -- so it comes last and wins
     * over /Encoding and /Differences (unknown glyph names map to 0 there).
     */
    toUniAppliedCount = 0;
    GfxFontReadToUnicode(this, fontDict, xref, &toUniAppliedCount);
    /* fontSymbolic selects the Symbol or Dingbat GEOS font family. */
    if (toUniAppliedCount > 0)
    {
        this->flags &= ~fontSymbolic;
    }

}

/***********************************************************************
 *      GfxFontFree
 ***********************************************************************
 * SYNOPSIS:        Release.
 * PARAMETERS:      GfxFont *this    this
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void GfxFontFree(GfxFont *this)
{
    GStrFree(&this->tag);
    GStrFree(&this->name);

    GfxCidFontFree(this);

}

/* Read the array of widths from the font dict. */

/***********************************************************************
 *      GfxFontLookupStandardWidth
 ***********************************************************************
 * SYNOPSIS:        Look up standard width.
 * PARAMETERS:      GfxFont *this    this
 *                  char *name    name
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/
static short GfxFontLookupStandardWidth(GfxFont *this, char *name)
{
    optr owidths = @helveticaWidths;
    unsigned short *widths;
    int j, tableLen;
    char **pNames;
    long style = this->flags & (fontBold | fontItalic);
    short result;

    if (this->flags & fontSerif)
    {
        /* Times-Roman derivatives */
        if (style == (fontBold | fontItalic))
        /* Times-BoldItalic */
        {
            owidths = @timesBoldItalicWidths;
        }
        else if (style == fontBold)
        /* Times-Bold */
        {
            owidths = @timesBoldWidths;
        }
        else if (style == fontItalic)
        /* Times-Italic */
        {
            owidths = @timesItalicWidths;
        }
        else
        /* Times-Roman */
        {
            owidths = @timesRomanWidths;
        }
    }
    else if (this->flags & fontFixedWidth)
    /* all Courier derivatives have the same widths */
    {
        owidths = @courierWidths;
    }
    else if (this->flags & fontSymbolic)
    /* Symbol */
    {
        owidths = @symbolWidths;
    }
    else
    {
        if (style == (fontBold | fontItalic))
        /* Helvetica-BoldOblique */
        {
            owidths = @helveticaBoldObliqueWidths;
        }
        else if (style == fontBold)
        /* Helvetica-Bold */
        {
            owidths = @helveticaBoldWidths;
        }
        else if (style == fontItalic)
        /* Helvetica-Oblique */
        {
            owidths = @helveticaObliqueWidths;
        }
        else
        /* Helvetica */
        {
            owidths = @helveticaWidths;
        }
    }

    result = 0;
    MemLock(OptrToHandle(owidths));
    widths = LMemDeref(owidths);
    MemLock(OptrToHandle(@standardEncodingNames));
    pNames = LMemDeref((this->flags & fontSymbolic) ?
        @symbolEncodingNames : @standardEncodingNames);
    tableLen = (this->flags & fontSymbolic) ?
        symbolEncodingSize : standardEncodingSize;
    for (j = 0; j < tableLen; ++j)
    {
        if (pNames[j] != NULL &&
            ((name == pNames[j]) || !strcmp(name, pNames[j])))
        {
            result = widths[j];
            break;
        }
    }
    MemUnlock(OptrToHandle(@standardEncodingNames));
    MemUnlock(OptrToHandle(owidths));
    if (result == 0 && !strcmp(name, "Euro"))
    {
        /* not in the old standard tables; current Adobe core font AFMs */
        result = (this->flags & fontFixedWidth) ? 600 :
            (this->flags & fontSerif) ? 500 : 556;
    }
    return result;
}

/***********************************************************************
 *      GfxFontMakeWidths
 ***********************************************************************
 * SYNOPSIS:        Create widths.
 * PARAMETERS:      GfxFont *this    this
 *                  Dict *fontDict    font dict
 *                  XRef *xref    cross-reference table
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void GfxFontMakeWidths(GfxFont *this, Dict *fontDict, XRef *xref)
{
    Obj obj1, obj2;
    short firstChar, lastChar;
    short code;

    /* Initialize widths before performing inline fallback lookup. */

    DictLookup(fontDict, "FirstChar", &obj1, xref);
    firstChar = isInt(&obj1) ? getInt(&obj1) : 0;
    ObjFree(&obj1);
    DictLookup(fontDict, "LastChar", &obj1, xref);
    lastChar = isInt(&obj1) ? getInt(&obj1) : 255;
    ObjFree(&obj1);
    /* widths[] has 256 entries: never trust the file */
    if (firstChar < 0)
    {
        firstChar = 0;
    }
    if (lastChar > 255)
    {
        lastChar = 255;
    }

    DictLookup(fontDict, "Widths", &obj1, xref);
    if (isArray(&obj1))
    {
        for (code = firstChar; code <= lastChar; ++code)
        {
            ObjArrayGet(&obj1, code - firstChar, &obj2, xref);
            if (isNum(&obj2))
            {
                this->widths[code] = GdoubleToWord(getNum(&obj2));
            }
            ObjFree(&obj2);
        }
    }
    /*
     * No "else" branch needed anymore: when there's no explicit /Widths array,
     * this->widths[] already holds the standard-font fallback values computed
     * during encoding.
     */

    ObjFree(&obj1);
}

/***********************************************************************
 *      GfxFontMakeEncoding
 ***********************************************************************
 * SYNOPSIS:        Create encoding.
 * PARAMETERS:      GfxFont *this    this
 *                  Dict *fontDict    font dict
 *                  XRef *xref    cross-reference table
 *                  GBool hasWidthsArray    has widths array
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void GfxFontMakeEncoding(GfxFont *this, Dict *fontDict, XRef *xref,
    GBool hasWidthsArray)
{

    Obj obj1, obj2, obj3;
    word code, i;
    DictLookup(fontDict, "Encoding", &obj1, xref);

    /* encoding specified by dictionary */
    if (isDict(&obj1))
    {
        ObjDictLookup(&obj1, "BaseEncoding", &obj2, xref);
        if (isName(&obj2))
        {
            CopyNamedEncoding(this, &obj2, hasWidthsArray);
        }
        ObjFree(&obj2);

        ObjDictLookup(&obj1, "Differences", &obj2, xref);
        if (isArray(&obj2))
        {
            code = 0;
            for (i = 0; i < ObjArrayGetLength(&obj2); ++i)
            {
                ObjArrayGet(&obj2, i, &obj3, xref);
                if (isInt(&obj3))
                {
                    code = getInt(&obj3);
                }
                else if (isName(&obj3))
                {
                    if (code < 256)
                    {
                        GfxFontAddChar(this, code, getName(&obj3),
                            hasWidthsArray);
                    }
                    ++code;
                }
                else
                {
                    EC_WARNING(-1);

                }
                ObjFree(&obj3);
            }
        }
        ObjFree(&obj2);

        /* encoding specified by name or null */
    }
    else if (isName(&obj1))
    {
        CopyNamedEncoding(this, &obj1, hasWidthsArray);
    }

    ObjFree(&obj1);

}

/***********************************************************************
 *      CopyNamedEncoding
 ***********************************************************************
 * SYNOPSIS:        Copy named encoding.
 * PARAMETERS:      GfxFont *this    this
 *                  Obj *pObj    p obj
 *                  GBool hasWidthsArray    has widths array
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  mevissen    6/02/99     Initial Revision
 *
 ***********************************************************************/
void CopyNamedEncoding(GfxFont *this, Obj *pObj, GBool hasWidthsArray)
{
    optr charMap, nameMap;
    char **pNameMap;
    word code;

    if (isNameSame(pObj, "MacRomanEncoding"))
    {
        charMap = @macRomanToGeosMap;
        nameMap = @macRomanEncodingNames;
    }
    else if (isNameSame(pObj, "WinAnsiEncoding"))
    {
        charMap = @winAnsiToGeosMap;
        nameMap = @winAnsiEncodingNames;
    }
    else
    {
        return;
    }

    MemLock(OptrToHandle(charMap));
    memcpy(this->charMap, LMemDeref(charMap), sizeof (this->charMap));
    MemUnlock(OptrToHandle(charMap));
    memset(this->symChars, 0, sizeof(this->symChars));

    /* Compute fallback widths inline instead of storing glyph names. */
    if (!hasWidthsArray)
    {
        MemLock(OptrToHandle(nameMap));
        pNameMap = LMemDeref(nameMap);
        for (code = 0; code < 256; ++code)
        {
            if (pNameMap[code] != NULL)
            {
                this->widths[code] = GfxFontLookupStandardWidth(this,
                    pNameMap[code]);
            }
        }
        MemUnlock(OptrToHandle(nameMap));
    }
}

/***********************************************************************
 *      GfxFontAddChar
 ***********************************************************************
 * SYNOPSIS:        Add char.
 * PARAMETERS:      GfxFont *this    this
 *                  word code    character code
 *                  char *name    name
 *                  GBool hasWidthsArray    has widths array
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/
static void
GfxFontAddChar(GfxFont *this, word code, char *name, GBool hasWidthsArray)
{
    char **pCharNames;
    char *pCharGEOSEquiv;
    int searchResult;
    word sym;

    this->symChars[code >> 3] &= (byte)~(1 << (code & 7));

    /* if a (normal) single-char name, simply use that character */
    if (name[1] == '\0')
    {
        if (name[0] >= ' ' && name[0] < C_DELETE)
        {
            this->charMap[code] = (byte)name[0];
            if (!hasWidthsArray)
            {
                this->widths[code] = GfxFontLookupStandardWidth(this, name);
            }
            return;
        }
    }
    /*
     * if name == ".notdef", we zero out that encoding -- no width lookup,
     * matching the original behavior of leaving *charName NULL there
     */
    if (!strcmp(name, ".notdef"))
    {
        this->charMap[code] = 0;
        return;
    }

    /*
     * if name == "H###", I think that's an embedded char which we don't know
     * how to decode.
     */
    if (name[0] == 'H' && name[1] >= '0' && name[1] <= '9')
    {
        this->charMap[code] = 0;
        if (!hasWidthsArray)
        {
            this->widths[code] = GfxFontLookupStandardWidth(this, name);
        }
        return;
    }
    /* if name == "G###", take a chance and decode the integer value. */
    if (name[0] == 'G' && name[1] >= '0' && name[1] <= '9')
    {
        int value = atoi(name + 1);
        if (value < 256)
        {
            MemLock(OptrToHandle(@pdfToGeosMap));
            pCharGEOSEquiv = LMemDeref(@pdfToGeosMap);
            value = pCharGEOSEquiv[value];
            MemUnlock(OptrToHandle(@pdfToGeosMap));
        }
        else
        {
            value = 0;
        }
        this->charMap[code] = value;
        if (!hasWidthsArray)
        {
            this->widths[code] = GfxFontLookupStandardWidth(this, name);
        }
        return;
    }

    /*
     * else, we need to search for this name and use the GEOS char code that it
     * maps to
     */

    MemLock(OptrToHandle(@charGEOSEquiv));
    pCharNames = LMemDeref(@charNames);
    pCharGEOSEquiv = LMemDeref(@charGEOSEquiv);

    /*
     * and divide by 4 to get the # of elements Else, I'm not sure how we get
     * the (unpadded) size of the arrays.)
     */
    searchResult = GfxFontEncodingBinarySearch(name,
        0,
        (LMemGetChunkSize(@charNames) >> 2) - 1,
        pCharNames);
    if (searchResult != -1)
    {
        this->charMap[code] = pCharGEOSEquiv[searchResult];
    }
    else
    {
        this->charMap[code] = 0;
    }
    MemUnlock(OptrToHandle(@charGEOSEquiv));
    if (searchResult == -1)
    {
        /* "Euro", "uniXXXX", "uXXXX" are not in charNames */
        this->charMap[code] = GfxGlyphNameToGeosChar(name);
    }
    if (this->charMap[code] == 0)
    {
        /* Greek letter from the Symbol font, TeX size variants */
        sym = GfxFontSymbolChar(name, 0);
        if (sym & 0x100)
        {
            this->charMap[code] = (byte)sym;
            this->symChars[code >> 3] |= (byte)(1 << (code & 7));
        }
        else
        {
            this->charMap[code] = (byte)sym;
        }
    }
    if (!hasWidthsArray)
    {
        this->widths[code] = GfxFontLookupStandardWidth(this, name);
    }
}

/* recursively search for a name matching 'name' */
/***********************************************************************
 *      GfxFontEncodingBinarySearch
 ***********************************************************************
 * SYNOPSIS:        Process gfx font encoding binary search.
 * PARAMETERS:      char *name    name
 *                  int start    start
 *                  int end    end
 *                  char **pCharNames    p char names
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

int GfxFontEncodingBinarySearch(char *name, int start, int end,
    char **pCharNames)
{
    int ind;
    sword comp;

    ind = (start + end) >> 1;
    if (!(comp = strcmp(pCharNames[ind], name)))
    {
        return ind;
    }
    /* Search again */
    if (comp > 0)
    {
        if (ind == start)
        {
            return - 1;
        }
        return GfxFontEncodingBinarySearch(name, start, ind - 1,
            pCharNames);
    }
    else
    {
        if (ind == end)
        {
            return - 1;
        }
        return GfxFontEncodingBinarySearch(name, ind + 1, end,
            pCharNames);
    }
}

/***********************************************************************
 *      GfxFontMapChar
 ***********************************************************************
 * SYNOPSIS:        Map char.
 * PARAMETERS:      GfxFont *this    this
 *                  unsigned char c    c
 *                  char defaultChar    default char
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

char GfxFontMapChar(GfxFont *this, unsigned char c, char defaultChar)
{
    char trans = this->charMap[c];

    if (trans == 0)
    {
        trans = defaultChar;
    }
    return trans;
}

/* Map a string to the GEOS charset */
/***********************************************************************
 *      GfxFontFindChar
 ***********************************************************************
 * SYNOPSIS:        Find char.
 * PARAMETERS:      GfxFont *this    this
 *                  unsigned char ch    ch
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

char GfxFontFindChar(GfxFont *this, unsigned char ch)
{
    int i;
    for (i = 1; i < 256; ++i)
    {
        if (ch == this->charMap[i])
        {
            return i;
        }
    }
    return 0;
}

/***********************************************************************
 *      GfxUnicodeToGeosChar
 ***********************************************************************
 * SYNOPSIS:        Process gfx unicode to geos char.
 * PARAMETERS:      word unicodeVal    unicode val
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/
word GfxUnicodeToGeosChar(word unicodeVal)
{
    word i;

    if (unicodeVal == 0)
    {
        return 0;
    }
    for (i = 0; i < NUM_CHARMAPENTRIES; ++i)
    {
        if (geosCharMap[i] == unicodeVal)
        {
            return(word)(i + MIN_GEOS_CHAR);
        }
    }
    return 0;
}

/***********************************************************************
 *      GfxGeosCharToUnicode
 ***********************************************************************
 * SYNOPSIS:        Unicode value of a GEOS char.
 * RETURNS:         Unicode value, 0 for control codes
 ***********************************************************************/
word GfxGeosCharToUnicode(byte ch)
{
    if (ch < MIN_GEOS_CHAR ||
        (word)GEOS_CHAR_INDEX(ch) >= (word)NUM_CHARMAPENTRIES)
    {
        return 0;
    }
    return geosCharMap[GEOS_CHAR_INDEX(ch)];
}

/***********************************************************************
 *      GfxGlyphNameToGeosChar
 ***********************************************************************
 * SYNOPSIS:        GEOS char for a PostScript glyph name.
 * RETURNS:         GEOS char or C_xx_LIGATURE, 0 if unknown
 * STRATEGY:        Same name table as GfxFontAddChar, plus the ligatures
 *                  and the "uniXXXX" / "uXXXX" names of the Adobe Glyph
 *                  List specification.
 ***********************************************************************/
byte GfxGlyphNameToGeosChar(char *name)
{
    char **pCharNames;
    char *pCharGEOSEquiv;
    int searchResult;
    byte ch = 0;
    word uni, len, idx;
    char *p;

    if (name[0] == '\0')
    {
        return 0;
    }
    if (name[1] == '\0')
    {
        return (name[0] >= ' ' && name[0] < C_DELETE) ? (byte)name[0] : 0;
    }
    if (!strcmp(name, "ff"))
    {
        return C_FF_LIGATURE;
    }
    if (!strcmp(name, "fi"))
    {
        return C_FI_LIGATURE;
    }
    if (!strcmp(name, "fl"))
    {
        return C_FL_LIGATURE;
    }
    if (!strcmp(name, "ffi"))
    {
        return C_FFI_LIGATURE;
    }
    if (!strcmp(name, "ffl"))
    {
        return C_FFL_LIGATURE;
    }
    if (!strcmp(name, "Euro"))
    {
        /* not in charNames (predates the Euro) */
        return (byte)GfxUnicodeToGeosChar(0x20AC);
    }
    if ((name[0] == 'u' && name[1] == 'n' && name[2] == 'i' &&
         strlen(name) == 7) || (name[0] == 'u' && strlen(name) == 5))
    {
        p = (name[1] == 'n') ? name + 3 : name + 1;
        uni = 0;
        while (*p && isxdigit(*p))
        {
            uni = (uni << 4) |
                (word)(isdigit(*p) ? *p - '0' : (toupper(*p) - 'A' + 10));
            ++p;
        }
        if (*p == '\0')
        {
            return (byte)GfxUnicodeToGeosChar(uni);
        }
    }

    MemLock(OptrToHandle(@charGEOSEquiv));
    pCharNames = LMemDeref(@charNames);
    pCharGEOSEquiv = LMemDeref(@charGEOSEquiv);
    searchResult = GfxFontEncodingBinarySearch(name,
        0,
        (LMemGetChunkSize(@charNames) >> 2) - 1,
        pCharNames);
    if (searchResult != -1)
    {
        ch = (byte)pCharGEOSEquiv[searchResult];
    }
    MemUnlock(OptrToHandle(@charGEOSEquiv));
    if (ch == 0)
    {
        /* math characters of the GEOS set: "lessequal", "summation" ... */
        uni = 0;
        len = strlen(name);
        MemLock(OptrToHandle(@mathNames));
        p = LMemDeref(@mathNames);
        for (idx = 0; *p; ++idx)
        {
            if (!strncmp(p, name, len) && p[len] == '|')
            {
                uni = ((word *)LMemDeref(@mathUnicode))[idx];
                break;
            }
            while (*p && *p != '|')
            {
                ++p;
            }
            if (*p)
            {
                ++p;
            }
        }
        MemUnlock(OptrToHandle(@mathNames));
        if (uni)
        {
            ch = (byte)GfxUnicodeToGeosChar(uni);
        }
    }
    return ch;
}

/***********************************************************************
 *      GfxFontStringToUnicode
 ***********************************************************************
 * SYNOPSIS:        Process gfx font string to unicode.
 * PARAMETERS:      Obj *strObj    str obj
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/
static word GfxFontStringToUnicode(Obj *strObj)
{
    char *bytes;
    word len;

    bytes = GStrGetCString(getString(strObj));
    len = GStrGetLength(getString(strObj));

    if (len == 0)
    {
        return 0;
    }
    else if (len == 1)
    {
        return(word)(Guchar)bytes[0];
    }
    else
    {
        return(word)(((Guchar)bytes[0] << 8) | (Guchar)bytes[1]);
    }
}

/***********************************************************************
 *      GfxFontSetUnicode
 ***********************************************************************
 * SYNOPSIS:        Map one code from /ToUnicode.
 * STRATEGY:        GEOS character if there is one, else a Greek letter
 *                  of the Symbol font; nothing for other characters
 *                  (the encoding stays).
 ***********************************************************************/
static void GfxFontSetUnicode(GfxFont *this, Guchar code, word unicodeVal,
    word *appliedCount)
{
    word geosChar = GfxUnicodeToGeosChar(unicodeVal);
    word sym;

    if (geosChar != 0)
    {
        this->charMap[code] = (byte)geosChar;
        this->symChars[code >> 3] &= (byte)~(1 << (code & 7));
        ++(*appliedCount);
        return;
    }
    sym = GfxFontSymbolChar((void *)0, unicodeVal);
    if (sym & 0x100)
    {
        this->charMap[code] = (byte)sym;
        this->symChars[code >> 3] |= (byte)(1 << (code & 7));
        ++(*appliedCount);
    }
}

/***********************************************************************
 *      GfxFontParseBfChar
 ***********************************************************************
 * SYNOPSIS:        Parse bf char.
 * PARAMETERS:      Parser *parser    parser
 *                  GfxFont *this    this
 *                  word *appliedCount    applied count
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/
static void
GfxFontParseBfChar(Parser *parser, GfxFont *this, word *appliedCount)
{
    Obj codeObj, uniObj;
    Guchar code;
    word unicodeVal;

    ParserGetObj(parser, &codeObj);
    while (!isEOF(&codeObj) && !isCmdSame(&codeObj, "endbfchar"))
    {
        if (!isString(&codeObj))
        {
            ObjFree(&codeObj);
            break;
        }
        code = (Guchar)GfxFontStringToUnicode(&codeObj);
        ObjFree(&codeObj);

        ParserGetObj(parser, &uniObj);
        if (isString(&uniObj))
        {
            unicodeVal = GfxFontStringToUnicode(&uniObj);
            GfxFontSetUnicode(this, code, unicodeVal, appliedCount);
        }
        ObjFree(&uniObj);

        ParserGetObj(parser, &codeObj);
    }
    ObjFree(&codeObj);
}

/***********************************************************************
 *      GfxFontParseBfRange
 ***********************************************************************
 * SYNOPSIS:        Parse bf range.
 * PARAMETERS:      Parser *parser    parser
 *                  GfxFont *this    this
 *                  word *appliedCount    applied count
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/
static void
GfxFontParseBfRange(Parser *parser, GfxFont *this, word *appliedCount)
{
    Obj loObj, hiObj, dstObj, elemObj;
    Guchar lo, hi, c;
    word base, unicodeVal;
    word arrayIdx;

    ParserGetObj(parser, &loObj);
    while (!isEOF(&loObj) && !isCmdSame(&loObj, "endbfrange"))
    {
        if (!isString(&loObj))
        {
            ObjFree(&loObj);
            break;
        }
        lo = (Guchar)GfxFontStringToUnicode(&loObj);
        ObjFree(&loObj);

        ParserGetObj(parser, &hiObj);
        if (!isString(&hiObj))
        {
            ObjFree(&hiObj);
            break;
        }
        hi = (Guchar)GfxFontStringToUnicode(&hiObj);
        ObjFree(&hiObj);

        ParserGetObj(parser, &dstObj);
        if (isString(&dstObj))
        {
            /* contiguous form: base unicode value, +1 per code */
            base = GfxFontStringToUnicode(&dstObj);
            for (c = lo; c <= hi; ++c)
            {
                unicodeVal = (word)(base + (c - lo));
                GfxFontSetUnicode(this, c, unicodeVal, appliedCount);
                if (c == 255)
                {
                    break;
                } /* avoid wrapping Guchar past 255 */
            }
        }
        else if (isArray(&dstObj))
        {
            /* explicit form: one destination value per code, in order */
            c = lo;
            for (arrayIdx = 0; arrayIdx <= (word)(hi - lo); ++arrayIdx)
            {
                ObjArrayGet(&dstObj, arrayIdx, &elemObj,
                    LexerGetXRef(parser->lexer));
                if (isString(&elemObj))
                {
                    unicodeVal = GfxFontStringToUnicode(&elemObj);
                    GfxFontSetUnicode(this, c, unicodeVal, appliedCount);
                }
                ObjFree(&elemObj);
                if (c == 255)
                {
                    break;
                }
                ++c;
            }
        }
        ObjFree(&dstObj);

        ParserGetObj(parser, &loObj);
    }
    ObjFree(&loObj);
}

/***********************************************************************
 *      GfxFontReadToUnicode
 ***********************************************************************
 * SYNOPSIS:        Read to unicode.
 * PARAMETERS:      GfxFont *this    this
 *                  Dict *fontDict    font dict
 *                  XRef *xref    cross-reference table
 *                  word *appliedCount    applied count
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/
static void GfxFontReadToUnicode(GfxFont *this, Dict *fontDict, XRef *xref,
    word *appliedCount)
{
    Obj refObj, streamObj, tokObj;
    Lexer *lexer;
    Parser parser;

    DictLookupNF(fontDict, "ToUnicode", &refObj);
    if (!isRef(&refObj))
    {
        ObjFree(&refObj);
        return;
    }
    XRefFetch(xref, getRefNum(&refObj), getRefGen(&refObj), &streamObj);
    ObjFree(&refObj);
    if (!isStream(&streamObj))
    {
        ObjFree(&streamObj);
        return;
    }

    lexer = gmalloc(sizeof (Lexer));
    if (!lexer)
    {
        ObjFree(&streamObj);
        return;
    }
    LexerInitFromStream(lexer, getStream(&streamObj), xref);
    if (GMemHadError())
    {
        LexerFree(lexer);
        gfree(lexer);
        return;
    }
    ParserInit(&parser, lexer);

    ParserGetObj(&parser, &tokObj);
    while (!isEOF(&tokObj))
    {
        if (isCmdSame(&tokObj, "beginbfchar"))
        {
            ObjFree(&tokObj);
            GfxFontParseBfChar(&parser, this, appliedCount);
        }
        else if (isCmdSame(&tokObj, "beginbfrange"))
        {
            ObjFree(&tokObj);
            GfxFontParseBfRange(&parser, this, appliedCount);
        }
        else
        {
            ObjFree(&tokObj);
        }
        ParserGetObj(&parser, &tokObj);
    }
    ObjFree(&tokObj);

    /* LexerInitFromStream takes ownership of streamObj's stream. */
    ParserFree(&parser);
}

/* GfxFontDict */

/***********************************************************************
 *      GfxFontDictInit
 ***********************************************************************
 * SYNOPSIS:        Initialize.
 * PARAMETERS:      GfxFontDict *this    this
 *                  Dict *fontDict    font dict
 *                  XRef *xref    cross-reference table
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void GfxFontDictInit(GfxFontDict *this, Dict *fontDict, XRef *xref)
{
    word i;
    Obj obj1, obj2;

    this->lastFont = NULL;
    initNull(&obj1);
    initNull(&obj2);

    this->numFonts = DictGetLength(fontDict);
    this->fonts = (GfxFont **)gmalloc(this->numFonts * sizeof(GfxFont *));
    if (!this->fonts)
    {
        this->numFonts = 0;
        return;
    }
    for (i = 0; i < this->numFonts; ++i)
    {
        DictGetValNF(fontDict, i, &obj1);
        ObjFetch(&obj2, &obj1, xref);
        /* Font dictionaries may also be direct objects (no reference). */
        if (ObjIsDictSame(&obj2, "Font"))
        {
            Ref fontRef;

            if (isRef(&obj1))
            {
                fontRef = getRef(&obj1);
            }
            else
            {
                fontRef.num = -1;
                fontRef.gen = 0;
            }
            this->fonts[i] = gmalloc(sizeof(GfxFont));
            if (this->fonts[i])
            {
                GfxFontInit(this->fonts[i], DictGetKey(fontDict, i),
                    fontRef, getDict(&obj2), xref);
            }
        }
        else
        {
            EC_WARNING(-1);

            this->fonts[i] = NULL;
        }
        ObjFree(&obj1);
        ObjFree(&obj2);
    }
}

/***********************************************************************
 *      GfxFontDictFree
 ***********************************************************************
 * SYNOPSIS:        Release.
 * PARAMETERS:      GfxFontDict *this    this
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void GfxFontDictFree(GfxFontDict *this)
{
    word i;

    for (i = 0; i < this->numFonts; ++i)
    {
        if (this->fonts[i])
        {
            GfxFontFree(this->fonts[i]);
            gfree(this->fonts[i]);
        }
    }
    gfree(this->fonts);
}

/***********************************************************************
 *      GfxFontDictLookup
 ***********************************************************************
 * SYNOPSIS:        Look up.
 * PARAMETERS:      GfxFontDict *this    this
 *                  char *tag    tag
 *
 * RETURNS:         result pointer
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

GfxFont *GfxFontDictLookup(GfxFontDict *this, char *tag)
{
    word i;

    /* Check the last font before scanning the full font list. */
    if (this->lastFont && GfxFontMatches(this->lastFont, tag))
    {
        return this->lastFont;
    }

    for (i = 0; i < this->numFonts; ++i)
    {
        if (this->fonts[i] && GfxFontMatches(this->fonts[i], tag))
        {
            this->lastFont = this->fonts[i];
            return this->fonts[i];
        }
    }
    return NULL;
}

/***********************************************************************
 *      GfxFontDictLookupRef
 ***********************************************************************
 * SYNOPSIS:        Font of the dictionary with the given object reference.
 * RETURNS:         font or NULL
 ***********************************************************************/

GfxFont *GfxFontDictLookupRef(GfxFontDict *this, Ref ref)
{
    word i;

    for (i = 0; i < this->numFonts; ++i)
    {
        if (this->fonts[i] && this->fonts[i]->id.num == ref.num &&
            this->fonts[i]->id.gen == ref.gen)
        {
            return this->fonts[i];
        }
    }
    return NULL;
}

GBool GfxFontMatches(GfxFont *this, char *tag1)
{ 
    return !GStrCmpString(&this->tag, tag1); 
}

/***********************************************************************
 *      GfxFontIs16Bit
 ***********************************************************************
 * SYNOPSIS:        Process gfx font is16 bit.
 * PARAMETERS:      GfxFont *this    this
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

GBool GfxFontIs16Bit(GfxFont *this)
{
    return this->is16;
}


#pragma code_seg("PdfText")

/***********************************************************************
 *      PdfTextStringToGeos
 ***********************************************************************
 * SYNOPSIS:        Convert a PDF text string to the GEOS character set.
 * PARAMETERS:      GooString *str    PDF string (decrypted)
 *                  char *dst    output buffer
 *                  word dstSize    size of dst including the null
 *
 * RETURNS:         length of the converted string
 *
 * STRATEGY:        UTF-16BE (BOM FE FF) or PDFDocEncoding -> Unicode ->
 *                  GEOS char via GfxUnicodeToGeosChar. UTF-16 language
 *                  escapes (U+001B ... U+001B) are skipped, surrogate
 *                  pairs become '?'. Tab/CR/LF become a space, other
 *                  control characters are dropped.
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      11/23/26    Initial version (B4)
 *
 ***********************************************************************/

word PdfTextStringToGeos(GooString *str, char *dst, word dstSize)
{
    Guchar *s;
    long len, i;
    word n = 0;
    word uni, ch;
    GBool utf16, inEscape = gFalse;
    word *high;

    if (dstSize == 0)
    {
        return 0;
    }
    s = (Guchar *)GStrGetCString(str);
    len = GStrGetLength(str);
    utf16 = (len >= 2 && s[0] == 0xFE && s[1] == 0xFF);
    i = utf16 ? 2 : 0;

    MemLock(OptrToHandle(@pdfDocEncodingHigh));
    high = LMemDeref(@pdfDocEncodingHigh);
    while (i < len && n + 1 < dstSize)
    {
        if (utf16)
        {
            if (i + 1 >= len)
            {
                break;
            }
            uni = ((word)s[i] << 8) | s[i + 1];
            i += 2;
            if (uni == 0x001B)
            {
                inEscape = !inEscape;
                continue;
            }
            if (inEscape)
            {
                continue;
            }
            if (uni >= 0xD800 && uni <= 0xDBFF)
            {
                i += 2;         /* skip the low surrogate */
                uni = '?';
            }
        }
        else
        {
            uni = s[i++];
            if (uni >= 0x18 && uni <= 0x1F)
            {
                uni = high[uni - 0x18];
            }
            else if (uni >= 0x80 && uni <= 0xA0)
            {
                uni = high[8 + uni - 0x80];
            }
        }

        if (uni == '\t' || uni == '\r' || uni == '\n')
        {
            ch = ' ';
        }
        else if (uni < 0x20)
        {
            continue;
        }
        else if (uni < 0x7F)
        {
            ch = uni;
        }
        else
        {
            ch = GfxUnicodeToGeosChar(uni);
            if (ch == 0)
            {
                ch = '?';
            }
        }
        dst[n++] = (char)ch;
    }
    MemUnlock(OptrToHandle(@pdfDocEncodingHigh));
    dst[n] = 0;
    return n;
}

/***********************************************************************
 *      GfxFontReadBuiltinEncoding
 ***********************************************************************
 * SYNOPSIS:        Apply the encoding built into an embedded Type 1
 *                  font file (FontFile, clear text part).
 * PARAMETERS:      GfxFont *this           font, embFontID set
 *                  XRef *xref              cross-reference table
 *                  GBool hasWidthsArray    font has /Widths
 * RETURNS:         number of codes set (0 = none found, charMap kept)
 * STRATEGY:        The clear text part before "eexec" holds either
 *                  "/Encoding StandardEncoding def" (nothing to do) or
 *                  "dup <code> /<glyph> put" entries, one or more per
 *                  line. The first entry clears the charMap, then every
 *                  entry goes through GfxFontAddChar (glyph name -> GEOS
 *                  char). /Encoding and /Differences are applied after
 *                  this and override it.
 *                  ATTENTION: Only Type 1 (FontFile). The built-in
 *                  encoding of CFF (FontFile3) and TrueType fonts is not
 *                  read; those need /Encoding or /ToUnicode.
 ***********************************************************************/
static word GfxFontReadBuiltinEncoding(GfxFont *this, XRef *xref,
    GBool hasWidthsArray)
{
    Obj ref, fileObj;
    char *buf;
    char *p, *name;
    word line, code, count = 0;

    buf = gmalloc(256);
    if (!buf)
    {
        return 0;
    }
    initRef(&ref, this->embFontID.num, this->embFontID.gen);
    ObjFetch(&fileObj, &ref, xref);
    if (isStream(&fileObj))
    {
        ObjStreamReset(&fileObj);
        for (line = 0; line < 600; ++line)
        {
            ObjStreamGetLine(&fileObj, buf, 256);
            if (buf[0] == '\0' && ObjStreamLookChar(&fileObj) == EOF)
            {
                break;
            }
            if (strstr(buf, "eexec") || strstr(buf, "StandardEncoding"))
            {
                break;
            }
            for (p = strstr(buf, "dup "); p; p = strstr(p, "dup "))
            {
                p += 4;
                if (!isdigit(*p))
                {
                    continue;
                }
                code = 0;
                while (isdigit(*p) && code < 1000)
                {
                    code = code * 10 + (*p++ - '0');
                }
                while (*p == ' ')
                {
                    ++p;
                }
                if (*p != '/' || code > 255)
                {
                    continue;
                }
                name = ++p;
                while (*p && *p != ' ' && *p != '/')
                {
                    ++p;
                }
                if (*p == '\0' || p == name)
                {
                    continue;   /* glyph name cut by the line buffer */
                }
                *p++ = '\0';
                if (count == 0)
                {
                    memset(this->charMap, 0, sizeof(this->charMap));
                    memset(this->symChars, 0, sizeof(this->symChars));
                }
                GfxFontAddChar(this, code, name, hasWidthsArray);
                ++count;
            }
        }
    }
    ObjFree(&fileObj);
    gfree(buf);
    return count;
}

/***********************************************************************
 *      GfxFontSymbolChar
 ***********************************************************************
 * SYNOPSIS:        Character for a glyph name or Unicode value that the
 *                  GEOS character set does not have.
 * PARAMETERS:      name          glyph name, or NULL
 *                  unicodeVal    Unicode value (used if name is NULL)
 * RETURNS:         0x100 | Symbol font code (Greek letter), or a GEOS
 *                  char (TeX size variant), or 0
 * STRATEGY:        TeX names big operators "summationtext",
 *                  "integraldisplay" ...; without the suffix they are in
 *                  the GEOS character set. Greek letters come from the
 *                  GEOS Symbol font (Adobe Symbol encoding: alpha = 'a',
 *                  Gamma = 'G'), TeX variants theta1/phi1/sigma1/omega1
 *                  have own Symbol codes.
 *                  PM-TODO: A Unicode GEOS has the Greek letters in the
 *                  text fonts; remove the Symbol font detour then.
 ***********************************************************************/
static word GfxFontSymbolChar(const char *name, word unicodeVal)
{
    char buf[24];
    char *names, *letters, *p;
    word len, idx;
    byte ch = 0;
    GBool upper;

    if (name == (void *)0)
    {
        MemLock(OptrToHandle(@greekUnicodeLower));
        if (unicodeVal >= 0x03B1 && unicodeVal <= 0x03C9)
        {
            ch = ((char *)LMemDeref(@greekUnicodeLower))[unicodeVal - 0x03B1];
        }
        else if (unicodeVal >= 0x0391 && unicodeVal <= 0x03A9)
        {
            ch = ((char *)LMemDeref(@greekUnicodeUpper))[unicodeVal - 0x0391];
        }
        else if (unicodeVal == 0x03D1)
        {
            ch = 'J';   /* theta symbol */
        }
        else if (unicodeVal == 0x03D5)
        {
            ch = 'j';   /* phi symbol */
        }
        else if (unicodeVal == 0x03D6)
        {
            ch = 'v';   /* pi symbol */
        }
        MemUnlock(OptrToHandle(@greekUnicodeLower));
        return (ch && ch != '?') ? (word)(0x100 | ch) : 0;
    }

    len = strlen(name);
    if (len == 0 || len >= sizeof(buf))
    {
        return 0;
    }
    strcpy(buf, name);

    /* TeX big operators: "summationtext" -> "summation" */
    if (len > 4 && !strcmp(buf + len - 4, "text"))
    {
        buf[len - 4] = '\0';
        return GfxGlyphNameToGeosChar(buf);
    }
    if (len > 7 && !strcmp(buf + len - 7, "display"))
    {
        buf[len - 7] = '\0';
        return GfxGlyphNameToGeosChar(buf);
    }

    /* TeX variants of Greek letters */
    if (buf[len - 1] == '1')
    {
        buf[--len] = '\0';
        if (!strcmp(buf, "theta"))
        {
            return 0x100 | 'J';
        }
        if (!strcmp(buf, "phi"))
        {
            return 0x100 | 'j';
        }
        if (!strcmp(buf, "sigma"))
        {
            return 0x100 | 'V';
        }
        if (!strcmp(buf, "omega"))
        {
            return 0x100 | 'v';
        }
    }

    /* Greek letter names, lower or upper case */
    upper = (buf[0] >= 'A' && buf[0] <= 'Z');
    if (upper)
    {
        buf[0] = (char)(buf[0] - 'A' + 'a');
    }
    MemLock(OptrToHandle(@greekNames));
    names = LMemDeref(@greekNames);
    letters = LMemDeref(@greekSymbolLetters);
    for (p = names, idx = 0; *p; ++idx)
    {
        if (!strncmp(p, buf, len) && p[len] == '|')
        {
            ch = (byte)letters[idx];
            if (upper)
            {
                ch = (byte)(ch - 'a' + 'A');
            }
            break;
        }
        while (*p && *p != '|')
        {
            ++p;
        }
        if (*p)
        {
            ++p;
        }
    }
    MemUnlock(OptrToHandle(@greekNames));
    return ch ? (word)(0x100 | ch) : 0;
}

/***********************************************************************
 *      GfxFontIsSymbolChar
 ***********************************************************************
 * SYNOPSIS:        TRUE if the mapped code is drawn with the GEOS Symbol
 *                  font (see GfxFontSymbolChar).
 ***********************************************************************/
GBool GfxFontIsSymbolChar(GfxFont *this, byte code)
{
    return (this->symChars[code >> 3] & (1 << (code & 7))) != 0;
}

/* GfxFont */

/***********************************************************************
 *      GfxFontCheckWellKnown
 ***********************************************************************
 * SYNOPSIS:        Check well known.
 * PARAMETERS:      GfxFont *this    this
 *                  const char *name    name
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void GfxFontCheckWellKnown(GfxFont *this, const char *name)
{
    WellKnownFont *pFont = wellKnownFonts;
    int i;

    /* Ignore any unique tag (name starts with "AAAAAA+"). */
    if (strlen(name) > 8 && isalpha(name[0]) && isalpha(name[1])
        && isalpha(name[2]) && isalpha(name[3]) && isalpha(name[4])
        && isalpha(name[5]) && name[6] == '+')
    {
        name = &name[7];
    }

    /*
     * A match is found if the well-known font name matches a substring of the
     * passed name, where the substring must begin at the first character.
     */

    for (i = 0, pFont = wellKnownFonts;
        i < ARRAY_LEN(wellKnownFonts, WellKnownFont);
        i++, pFont++)
    {
        if (!strncmp(name, pFont->WKF_name, strlen(pFont->WKF_name)))
        {
            this->flags &= ~(fontSymbolic | fontSerif | fontFixedWidth);
            this->flags |= pFont->WKF_flags;
            break;
        }
    }
}

/***********************************************************************
 *      GfxFontInit
 ***********************************************************************
 * SYNOPSIS:        Initialize.
 * PARAMETERS:      GfxFont *this    this
 *                  char *tag1    tag1
 *                  Ref id1    id1
 *                  Dict *fontDict    font dict
 *                  XRef *xref    cross-reference table
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void GfxFontInit(GfxFont *this, char *tag1, Ref id1, Dict *fontDict, XRef *xref)
{

    char buf[256];
    Obj obj1, obj2, obj3;
    char *p1, *p2;
    char *pPdfToGeosMap;
    char **pNameMap;
    word i;
    int code;
    word toUniAppliedCount;
    GBool hasWidthsArray;

    /* make cleanup safe even if a string allocation below fails */
    this->tag.s = this->name.s = this->embFontName.s = this->extFontFile.s =
        NULL;
    this->tag.length = this->name.length = this->embFontName.length =
        this->extFontFile.length = 0;

    GStrInitString(&this->tag, tag1);
    if (GMemHadError())
    {
        return;
    }
    this->id.num = id1.num;
    this->id.gen = id1.gen;

    GStrInit(&this->name);
    if (GMemHadError())
    {
        return;
    }
    DictLookup(fontDict, "BaseFont", &obj1, xref);
    if (isName(&obj1))
    {
        GStrAppendString(&this->name, getName(&obj1));
    }
    ObjFree(&obj1);

    /* is it a built-in font? */

    this->type = fontUnknownType;
    DictLookup(fontDict, "Subtype", &obj1, xref);
    if (isNameSame(&obj1, "Type1"))
    {
        this->type = fontType1;
    }
    else if (isNameSame(&obj1, "Type3"))
    {
        this->type = fontType3;
    }
    else if (isNameSame(&obj1, "TrueType"))
    {
        this->type = fontTrueType;
    }
    else if (isNameSame(&obj1, "Type0"))
    {
        this->type = fontType0;
    }
    ObjFree(&obj1);
    this->is16 = gFalse;

    /* consult the WellKnownFonts table for anything more specific -- */
    /* unified with the /FontDescriptor-symbolic-correction path below, */
    /* which used to be the *only* place this table got consulted (see */
    /* the project roadmap's fontmapping-unification entry). */
    /* conditioned on font Subtype (TrueType vs Type1): a real-world PDF */
    /* can legitimately have either type carry any of these names, and */
    /* gating on Subtype only ever narrowed the match, never broadened it. */
    this->flags = fontSerif; /* assume Times-Roman by default */
    GfxFontCheckWellKnown(this, GStrGetCString(&this->name));

    this->embFontID.num = -1;
    this->embFontID.gen = -1;
    this->hasCharSet = gFalse;
    this->fontWidthFactor = 0;
    GStrInit(&this->embFontName);
    GStrInit(&this->extFontFile);
    if (GMemHadError())
    {
        return;
    }

    DictLookup(fontDict, "FontDescriptor", &obj1, xref);
    if (isDict(&obj1))
    {

        /* Is CharSet entry present? */

        ObjDictLookup(&obj1, "CharSet", &obj2, xref);
        if (!isNull(&obj2))
        {
            this->hasCharSet = gTrue;
        }
        ObjFree(&obj2);

        /* flags */
        ObjDictLookup(&obj1, "Flags", &obj2, xref);
        if (isInt(&obj2))
        {
            this->flags = getInt(&obj2);
        }
        ObjFree(&obj2);
        /*
         * I've had trouble with various fonts having 'symbol' set in their
         * flags.
         */
        if (this->flags & fontSymbolic)
        {
            GfxFontCheckWellKnown(this, GStrGetCString(&this->name));
        }
        /*
         * Maybe this is too tailored to a specific problem, but I've had a
         * case of the 'symbol' flag getting set for non-symbol fonts:
         */
        if (this->flags & (fontSerif | fontFixedWidth))
        {
            this->flags &= ~fontSymbolic;
        }

        /* embedded Type 1 font file and font name */
        if (this->type == fontType1)
        {
            ObjDictLookupNF(&obj1, "FontFile", &obj2);
            if (isRef(&obj2))
            {
                this->embFontID = getRef(&obj2);

                /*
                 * sometimes use the 'AAAAAA+foo' name and sometimes use just
                 * 'foo'
                 */
                ObjFetch(&obj3, &obj2, xref);
                if (isStream(&obj3))
                {
                    ObjStreamReset(&obj3);
                    for (i = 0; i < 64; ++i)
                    {
                        ObjStreamGetLine(&obj3, buf, sizeof(buf));
                        if (!strncmp(buf, "/FontName", 9))
                        {
                            if ((p1 = strchr(buf + 9, '/')) != NULL)
                            {
                                ++p1;
                                for (p2 = p1; *p2 && !isspace(*p2); ++p2) ;
                                GStrAppendStringN(&this->embFontName, p1,
                                    p2 - p1);
                            }
                            break;
                        }
                    }
                }
                ObjFree(&obj3);
                ObjFree(&obj2);

                /*
                 * couldn't find font name so just use the one in the PDF font
                 */
                /* descriptor */
                if (!GStrGetLength(&this->embFontName))
                {
                    ObjDictLookup(&obj1, "FontName", &obj2, xref);
                    if (isName(&obj2))
                    {
                        GStrAppendString(&this->embFontName, getName(&obj2));
                    }
                }
            }
            ObjFree(&obj2);

            /* embedded TrueType font file */
        }
        else if (this->type == fontTrueType)
        {
            ObjDictLookupNF(&obj1, "FontFile2", &obj2);
            if (isRef(&obj2))
            {
                this->embFontID = getRef(&obj2);
            }
            ObjFree(&obj2);
        }
    }
    ObjFree(&obj1);

    /*
     * Check for an explicit /Widths array EARLY, before any of the inline
     * standard-font fallback width lookups below ~= 85760 comparisons.
     */
    DictLookup(fontDict, "Widths", &obj1, xref);
    hasWidthsArray = isArray(&obj1);
    ObjFree(&obj1);

    /*
     * Zero this->widths[] here, before any code path that computes standard-
     * font fallback widths inline as it discovers glyph names.
     */
    memset(this->widths, 0, 256 * sizeof(short));

    /*
     * duplicate the standard (or symbol) character map -- moved here so this
     * sees this->flags' FINAL value.
     */

    if (this->flags & fontSymbolic)
    {
        for (code = 0; code < 256; code ++)
        {
            this->charMap[code] = code;
        }
    }
    else
    {
        MemLock(OptrToHandle(@pdfToGeosMap));
        pPdfToGeosMap = LMemDeref(@pdfToGeosMap);
        memcpy(this->charMap, pPdfToGeosMap, sizeof (this->charMap));
        MemUnlock(OptrToHandle(@pdfToGeosMap));
    }

    /*
     * Skip this whole block (including the lock/unlock) when the font has an
     * explicit /Widths array -- see hasWidthsArray's own comment above.
     */
    if (!hasWidthsArray)
    {
        MemLock(OptrToHandle(@standardEncodingNames));
        pNameMap = LMemDeref((this->flags & fontSymbolic ?
            @symbolEncodingNames : @standardEncodingNames));
        /*
         * Compute fallback widths inline; no persistent charNames table is
         * needed.
         */
        for (code = 0; code < 256; ++code)
        {
            if (pNameMap[code] != NULL)
            {
                this->widths[code] = GfxFontLookupStandardWidth(this,
                    pNameMap[code]);
            }
        }
        MemUnlock(OptrToHandle(@standardEncodingNames));
    }

    /*
     * /ToUnicode, if present, is the most reliable source of truth we have for
     * what a character code actually means.
     */
    toUniAppliedCount = 0;
    GfxFontReadToUnicode(this, fontDict, xref, &toUniAppliedCount);
    /* fontSymbolic selects the Symbol or Dingbat GEOS font family. */
    if (toUniAppliedCount > 0)
    {
        this->flags &= ~fontSymbolic;
    }

    /*
     * The font code uses the fontBold and fontItalic flags to set the bold and
     * italic text styles, respectively.
     */
    if (strstr(GStrGetCString(&this->name), "Bold")
        || strstr(GStrGetCString(&this->name), "Black"))
    {
        this->flags |= fontBold;
    }
    if (strstr(GStrGetCString(&this->name), "Italic")
        || strstr(GStrGetCString(&this->name), "Oblique"))
    {
        this->flags |= fontItalic;
    }

#if 0
    if (this->type == fontType0)
    {
        getType0EncAndWidths(fontDict);
    }
    else if (builtinFont)
    {
        makeEncoding(fontDict, builtinFont->encoding);
        makeWidths(fontDict, builtinFont->encoding, builtinFont->widths);
    }
    else
    {
        makeEncoding(fontDict, NULL);
        makeWidths(fontDict, NULL, NULL);
    }
#else
    /* Homegrown char encoding merging */
    if (this->type != fontType0)
    {
        GfxFontMakeEncoding(this, fontDict, xref, hasWidthsArray);
        /* Make widths too */
        GfxFontMakeWidths(this, fontDict, xref);
    }

#endif
}

/***********************************************************************
 *      GfxFontFree
 ***********************************************************************
 * SYNOPSIS:        Release.
 * PARAMETERS:      GfxFont *this    this
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void GfxFontFree(GfxFont *this)
{
    GStrFree(&this->tag);
    GStrFree(&this->name);

    GStrFree(&this->embFontName);
    GStrFree(&this->extFontFile);

}

/* Read the array of widths from the font dict. */

/***********************************************************************
 *      GfxFontLookupStandardWidth
 ***********************************************************************
 * SYNOPSIS:        Look up standard width.
 * PARAMETERS:      GfxFont *this    this
 *                  char *name    name
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/
static short GfxFontLookupStandardWidth(GfxFont *this, char *name)
{
    optr owidths = @helveticaWidths;
    unsigned short *widths;
    int j, tableLen;
    char **pNames;
    long style = this->flags & (fontBold | fontItalic);
    short result;

    if (this->flags & fontSerif)
    {
        /* Times-Roman derivatives */
        if (style == (fontBold | fontItalic))
        /* Times-BoldItalic */
        {
            owidths = @timesBoldItalicWidths;
        }
        else if (style == fontBold)
        /* Times-Bold */
        {
            owidths = @timesBoldWidths;
        }
        else if (style == fontItalic)
        /* Times-Italic */
        {
            owidths = @timesItalicWidths;
        }
        else
        /* Times-Roman */
        {
            owidths = @timesRomanWidths;
        }
    }
    else if (this->flags & fontFixedWidth)
    /* all Courier derivatives have the same widths */
    {
        owidths = @courierWidths;
    }
    else if (this->flags & fontSymbolic)
    /* Symbol */
    {
        owidths = @symbolWidths;
    }
    else
    {
        if (style == (fontBold | fontItalic))
        /* Helvetica-BoldOblique */
        {
            owidths = @helveticaBoldObliqueWidths;
        }
        else if (style == fontBold)
        /* Helvetica-Bold */
        {
            owidths = @helveticaBoldWidths;
        }
        else if (style == fontItalic)
        /* Helvetica-Oblique */
        {
            owidths = @helveticaObliqueWidths;
        }
        else
        /* Helvetica */
        {
            owidths = @helveticaWidths;
        }
    }

    result = 0;
    MemLock(OptrToHandle(owidths));
    widths = LMemDeref(owidths);
    MemLock(OptrToHandle(@standardEncodingNames));
    pNames = LMemDeref((this->flags & fontSymbolic) ?
        @symbolEncodingNames : @standardEncodingNames);
    tableLen = (this->flags & fontSymbolic) ?
        symbolEncodingSize : standardEncodingSize;
    for (j = 0; j < tableLen; ++j)
    {
        if (pNames[j] != NULL &&
            ((name == pNames[j]) || !strcmp(name, pNames[j])))
        {
            result = widths[j];
            break;
        }
    }
    MemUnlock(OptrToHandle(@standardEncodingNames));
    MemUnlock(OptrToHandle(owidths));
    return result;
}

/***********************************************************************
 *      GfxFontMakeWidths
 ***********************************************************************
 * SYNOPSIS:        Create widths.
 * PARAMETERS:      GfxFont *this    this
 *                  Dict *fontDict    font dict
 *                  XRef *xref    cross-reference table
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void GfxFontMakeWidths(GfxFont *this, Dict *fontDict, XRef *xref)
{
    Obj obj1, obj2;
    short firstChar, lastChar;
    short code;

    /* Initialize widths before performing inline fallback lookup. */

    DictLookup(fontDict, "FirstChar", &obj1, xref);
    firstChar = isInt(&obj1) ? getInt(&obj1) : 0;
    ObjFree(&obj1);
    DictLookup(fontDict, "LastChar", &obj1, xref);
    lastChar = isInt(&obj1) ? getInt(&obj1) : 255;
    ObjFree(&obj1);

    DictLookup(fontDict, "Widths", &obj1, xref);
    if (isArray(&obj1))
    {
        for (code = firstChar; code <= lastChar; ++code)
        {
            ObjArrayGet(&obj1, code - firstChar, &obj2, xref);
            if (isNum(&obj2))
            {
                this->widths[code] = GdoubleToWord(getNum(&obj2));
            }
            ObjFree(&obj2);
        }
    }
    /*
     * No "else" branch needed anymore: when there's no explicit /Widths array,
     * this->widths[] already holds the standard-font fallback values computed
     * during encoding.
     */

    ObjFree(&obj1);
}

/***********************************************************************
 *      GfxFontMakeEncoding
 ***********************************************************************
 * SYNOPSIS:        Create encoding.
 * PARAMETERS:      GfxFont *this    this
 *                  Dict *fontDict    font dict
 *                  XRef *xref    cross-reference table
 *                  GBool hasWidthsArray    has widths array
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void GfxFontMakeEncoding(GfxFont *this, Dict *fontDict, XRef *xref,
    GBool hasWidthsArray)
{

    Obj obj1, obj2, obj3;
    word code, i;
    DictLookup(fontDict, "Encoding", &obj1, xref);

    /* encoding specified by dictionary */
    if (isDict(&obj1))
    {
        ObjDictLookup(&obj1, "BaseEncoding", &obj2, xref);
        if (isName(&obj2))
        {
            CopyNamedEncoding(this, &obj2, hasWidthsArray);
        }
        ObjFree(&obj2);

        ObjDictLookup(&obj1, "Differences", &obj2, xref);
        if (isArray(&obj2))
        {
            code = 0;
            for (i = 0; i < ObjArrayGetLength(&obj2); ++i)
            {
                ObjArrayGet(&obj2, i, &obj3, xref);
                if (isInt(&obj3))
                {
                    code = getInt(&obj3);
                }
                else if (isName(&obj3))
                {
                    if (code < 256)
                    {
                        GfxFontAddChar(this, code, getName(&obj3),
                            hasWidthsArray);
                    }
                    ++code;
                }
                else
                {
                    EC_WARNING(-1);

                }
                ObjFree(&obj3);
            }
        }
        ObjFree(&obj2);

        /* encoding specified by name or null */
    }
    else if (isName(&obj1))
    {
        CopyNamedEncoding(this, &obj1, hasWidthsArray);
    }

    ObjFree(&obj1);

}

/***********************************************************************
 *      CopyNamedEncoding
 ***********************************************************************
 * SYNOPSIS:        Copy named encoding.
 * PARAMETERS:      GfxFont *this    this
 *                  Obj *pObj    p obj
 *                  GBool hasWidthsArray    has widths array
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  mevissen    6/02/99     Initial Revision
 *
 ***********************************************************************/
void CopyNamedEncoding(GfxFont *this, Obj *pObj, GBool hasWidthsArray)
{
    optr charMap, nameMap;
    char **pNameMap;
    word code;

    if (isNameSame(pObj, "MacRomanEncoding"))
    {
        charMap = @macRomanToGeosMap;
        nameMap = @macRomanEncodingNames;
    }
    else if (isNameSame(pObj, "WinAnsiEncoding"))
    {
        charMap = @winAnsiToGeosMap;
        nameMap = @winAnsiEncodingNames;
    }
    else
    {
        return;
    }

    MemLock(OptrToHandle(charMap));
    memcpy(this->charMap, LMemDeref(charMap), sizeof (this->charMap));
    MemUnlock(OptrToHandle(charMap));

    /* Compute fallback widths inline instead of storing glyph names. */
    if (!hasWidthsArray)
    {
        MemLock(OptrToHandle(nameMap));
        pNameMap = LMemDeref(nameMap);
        for (code = 0; code < 256; ++code)
        {
            if (pNameMap[code] != NULL)
            {
                this->widths[code] = GfxFontLookupStandardWidth(this,
                    pNameMap[code]);
            }
        }
        MemUnlock(OptrToHandle(nameMap));
    }
}

/***********************************************************************
 *      GfxFontAddChar
 ***********************************************************************
 * SYNOPSIS:        Add char.
 * PARAMETERS:      GfxFont *this    this
 *                  word code    character code
 *                  char *name    name
 *                  GBool hasWidthsArray    has widths array
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/
static void
GfxFontAddChar(GfxFont *this, word code, char *name, GBool hasWidthsArray)
{
    char **pCharNames;
    char *pCharGEOSEquiv;
    int searchResult;

    /* if a (normal) single-char name, simply use that character */
    if (name[1] == '\0')
    {
        if (name[0] >= ' ' && name[0] < C_DELETE)
        {
            this->charMap[code] = (byte)name[0];
            if (!hasWidthsArray)
            {
                this->widths[code] = GfxFontLookupStandardWidth(this, name);
            }
            return;
        }
    }
    /*
     * if name == ".notdef", we zero out that encoding -- no width lookup,
     * matching the original behavior of leaving *charName NULL there
     */
    if (!strcmp(name, ".notdef"))
    {
        this->charMap[code] = 0;
        return;
    }

    /*
     * if name == "H###", I think that's an embedded char which we don't know
     * how to decode.
     */
    if (name[0] == 'H' && name[1] >= '0' && name[1] <= '9')
    {
        this->charMap[code] = 0;
        if (!hasWidthsArray)
        {
            this->widths[code] = GfxFontLookupStandardWidth(this, name);
        }
        return;
    }
    /* if name == "G###", take a chance and decode the integer value. */
    if (name[0] == 'G' && name[1] >= '0' && name[1] <= '9')
    {
        int value = atoi(name + 1);
        if (value < 256)
        {
            MemLock(OptrToHandle(@pdfToGeosMap));
            pCharGEOSEquiv = LMemDeref(@pdfToGeosMap);
            value = pCharGEOSEquiv[value];
            MemUnlock(OptrToHandle(@pdfToGeosMap));
        }
        else
        {
            value = 0;
        }
        this->charMap[code] = value;
        if (!hasWidthsArray)
        {
            this->widths[code] = GfxFontLookupStandardWidth(this, name);
        }
        return;
    }

    /*
     * else, we need to search for this name and use the GEOS char code that it
     * maps to
     */

    MemLock(OptrToHandle(@charGEOSEquiv));
    pCharNames = LMemDeref(@charNames);
    pCharGEOSEquiv = LMemDeref(@charGEOSEquiv);

    /*
     * and divide by 4 to get the # of elements Else, I'm not sure how we get
     * the (unpadded) size of the arrays.)
     */
    searchResult = GfxFontEncodingBinarySearch(name,
        0,
        (LMemGetChunkSize(@charNames) >> 2) - 1,
        pCharNames);
    if (searchResult != -1)
    {
        this->charMap[code] = pCharGEOSEquiv[searchResult];
    }
    else
    {
        this->charMap[code] = 0;
    }
    MemUnlock(OptrToHandle(@charGEOSEquiv));
    if (!hasWidthsArray)
    {
        this->widths[code] = GfxFontLookupStandardWidth(this, name);
    }
}

/* recursively search for a name matching 'name' */
/***********************************************************************
 *      GfxFontEncodingBinarySearch
 ***********************************************************************
 * SYNOPSIS:        Process gfx font encoding binary search.
 * PARAMETERS:      char *name    name
 *                  int start    start
 *                  int end    end
 *                  char **pCharNames    p char names
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

int GfxFontEncodingBinarySearch(char *name, int start, int end,
    char **pCharNames)
{
    int ind;
    sword comp;

    ind = (start + end) >> 1;
    if (!(comp = strcmp(pCharNames[ind], name)))
    {
        return ind;
    }
    /* Search again */
    if (comp > 0)
    {
        if (ind == start)
        {
            return - 1;
        }
        return GfxFontEncodingBinarySearch(name, start, ind - 1,
            pCharNames);
    }
    else
    {
        if (ind == end)
        {
            return - 1;
        }
        return GfxFontEncodingBinarySearch(name, ind + 1, end,
            pCharNames);
    }
}

/***********************************************************************
 *      GfxFontMapChar
 ***********************************************************************
 * SYNOPSIS:        Map char.
 * PARAMETERS:      GfxFont *this    this
 *                  unsigned char c    c
 *                  char defaultChar    default char
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

char GfxFontMapChar(GfxFont *this, unsigned char c, char defaultChar)
{
    char trans = this->charMap[c];

    if (trans == 0)
    {
        trans = defaultChar;
    }
    return trans;
}

/* Map a string to the GEOS charset */
/***********************************************************************
 *      GfxFontFindChar
 ***********************************************************************
 * SYNOPSIS:        Find char.
 * PARAMETERS:      GfxFont *this    this
 *                  unsigned char ch    ch
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

char GfxFontFindChar(GfxFont *this, unsigned char ch)
{
    int i;
    for (i = 1; i < 256; ++i)
    {
        if (ch == this->charMap[i])
        {
            return i;
        }
    }
    return 0;
}

/***********************************************************************
 *      GfxUnicodeToGeosChar
 ***********************************************************************
 * SYNOPSIS:        Process gfx unicode to geos char.
 * PARAMETERS:      word unicodeVal    unicode val
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/
word GfxUnicodeToGeosChar(word unicodeVal)
{
    word i;

    if (unicodeVal == 0)
    {
        return 0;
    }
    for (i = 0; i < NUM_CHARMAPENTRIES; ++i)
    {
        if (geosCharMap[i] == unicodeVal)
        {
            return(word)(i + MIN_GEOS_CHAR);
        }
    }
    return 0;
}

/***********************************************************************
 *      GfxFontStringToUnicode
 ***********************************************************************
 * SYNOPSIS:        Process gfx font string to unicode.
 * PARAMETERS:      Obj *strObj    str obj
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/
static word GfxFontStringToUnicode(Obj *strObj)
{
    char *bytes;
    word len;

    bytes = GStrGetCString(getString(strObj));
    len = GStrGetLength(getString(strObj));

    if (len == 0)
    {
        return 0;
    }
    else if (len == 1)
    {
        return(word)(Guchar)bytes[0];
    }
    else
    {
        return(word)(((Guchar)bytes[0] << 8) | (Guchar)bytes[1]);
    }
}

/***********************************************************************
 *      GfxFontParseBfChar
 ***********************************************************************
 * SYNOPSIS:        Parse bf char.
 * PARAMETERS:      Parser *parser    parser
 *                  GfxFont *this    this
 *                  word *appliedCount    applied count
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/
static void
GfxFontParseBfChar(Parser *parser, GfxFont *this, word *appliedCount)
{
    Obj codeObj, uniObj;
    Guchar code;
    word unicodeVal, geosChar;

    ParserGetObj(parser, &codeObj);
    while (!isEOF(&codeObj) && !isCmdSame(&codeObj, "endbfchar"))
    {
        if (!isString(&codeObj))
        {
            ObjFree(&codeObj);
            break;
        }
        code = (Guchar)GfxFontStringToUnicode(&codeObj);
        ObjFree(&codeObj);

        ParserGetObj(parser, &uniObj);
        if (isString(&uniObj))
        {
            unicodeVal = GfxFontStringToUnicode(&uniObj);
            geosChar = GfxUnicodeToGeosChar(unicodeVal);
            if (geosChar != 0)
            {
                this->charMap[code] = (byte)geosChar;
                ++(*appliedCount);
            }
        }
        ObjFree(&uniObj);

        ParserGetObj(parser, &codeObj);
    }
    ObjFree(&codeObj);
}

/***********************************************************************
 *      GfxFontParseBfRange
 ***********************************************************************
 * SYNOPSIS:        Parse bf range.
 * PARAMETERS:      Parser *parser    parser
 *                  GfxFont *this    this
 *                  word *appliedCount    applied count
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/
static void
GfxFontParseBfRange(Parser *parser, GfxFont *this, word *appliedCount)
{
    Obj loObj, hiObj, dstObj, elemObj;
    Guchar lo, hi, c;
    word base, unicodeVal, geosChar;
    word arrayIdx;

    ParserGetObj(parser, &loObj);
    while (!isEOF(&loObj) && !isCmdSame(&loObj, "endbfrange"))
    {
        if (!isString(&loObj))
        {
            ObjFree(&loObj);
            break;
        }
        lo = (Guchar)GfxFontStringToUnicode(&loObj);
        ObjFree(&loObj);

        ParserGetObj(parser, &hiObj);
        if (!isString(&hiObj))
        {
            ObjFree(&hiObj);
            break;
        }
        hi = (Guchar)GfxFontStringToUnicode(&hiObj);
        ObjFree(&hiObj);

        ParserGetObj(parser, &dstObj);
        if (isString(&dstObj))
        {
            /* contiguous form: base unicode value, +1 per code */
            base = GfxFontStringToUnicode(&dstObj);
            for (c = lo; c <= hi; ++c)
            {
                unicodeVal = (word)(base + (c - lo));
                geosChar = GfxUnicodeToGeosChar(unicodeVal);
                if (geosChar != 0)
                {
                    this->charMap[c] = (byte)geosChar;
                    ++(*appliedCount);
                }
                if (c == 255)
                {
                    break;
                } /* avoid wrapping Guchar past 255 */
            }
        }
        else if (isArray(&dstObj))
        {
            /* explicit form: one destination value per code, in order */
            c = lo;
            for (arrayIdx = 0; arrayIdx <= (word)(hi - lo); ++arrayIdx)
            {
                ObjArrayGet(&dstObj, arrayIdx, &elemObj,
                    LexerGetXRef(parser->lexer));
                if (isString(&elemObj))
                {
                    unicodeVal = GfxFontStringToUnicode(&elemObj);
                    geosChar = GfxUnicodeToGeosChar(unicodeVal);
                    if (geosChar != 0)
                    {
                        this->charMap[c] = (byte)geosChar;
                        ++(*appliedCount);
                    }
                }
                ObjFree(&elemObj);
                if (c == 255)
                {
                    break;
                }
                ++c;
            }
        }
        ObjFree(&dstObj);

        ParserGetObj(parser, &loObj);
    }
    ObjFree(&loObj);
}

/***********************************************************************
 *      GfxFontReadToUnicode
 ***********************************************************************
 * SYNOPSIS:        Read to unicode.
 * PARAMETERS:      GfxFont *this    this
 *                  Dict *fontDict    font dict
 *                  XRef *xref    cross-reference table
 *                  word *appliedCount    applied count
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/
static void GfxFontReadToUnicode(GfxFont *this, Dict *fontDict, XRef *xref,
    word *appliedCount)
{
    Obj refObj, streamObj, tokObj;
    Lexer *lexer;
    Parser parser;

    DictLookupNF(fontDict, "ToUnicode", &refObj);
    if (!isRef(&refObj))
    {
        ObjFree(&refObj);
        return;
    }
    XRefFetch(xref, getRefNum(&refObj), getRefGen(&refObj), &streamObj);
    ObjFree(&refObj);
    if (!isStream(&streamObj))
    {
        ObjFree(&streamObj);
        return;
    }

    lexer = gmalloc(sizeof (Lexer));
    if (!lexer)
    {
        ObjFree(&streamObj);
        return;
    }
    LexerInitFromStream(lexer, getStream(&streamObj), xref);
    if (GMemHadError())
    {
        LexerFree(lexer);
        gfree(lexer);
        return;
    }
    ParserInit(&parser, lexer);

    ParserGetObj(&parser, &tokObj);
    while (!isEOF(&tokObj))
    {
        if (isCmdSame(&tokObj, "beginbfchar"))
        {
            ObjFree(&tokObj);
            GfxFontParseBfChar(&parser, this, appliedCount);
        }
        else if (isCmdSame(&tokObj, "beginbfrange"))
        {
            ObjFree(&tokObj);
            GfxFontParseBfRange(&parser, this, appliedCount);
        }
        else
        {
            ObjFree(&tokObj);
        }
        ParserGetObj(&parser, &tokObj);
    }
    ObjFree(&tokObj);

    /* LexerInitFromStream takes ownership of streamObj's stream. */
    ParserFree(&parser);
}

/* GfxFontDict */

/***********************************************************************
 *      GfxFontDictInit
 ***********************************************************************
 * SYNOPSIS:        Initialize.
 * PARAMETERS:      GfxFontDict *this    this
 *                  Dict *fontDict    font dict
 *                  XRef *xref    cross-reference table
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void GfxFontDictInit(GfxFontDict *this, Dict *fontDict, XRef *xref)
{
    word i;
    Obj obj1, obj2;

    this->lastFont = NULL;
    initNull(&obj1);
    initNull(&obj2);

    this->numFonts = DictGetLength(fontDict);
    this->fonts = (GfxFont **)gmalloc(this->numFonts * sizeof(GfxFont *));
    if (!this->fonts)
    {
        this->numFonts = 0;
        return;
    }
    for (i = 0; i < this->numFonts; ++i)
    {
        DictGetValNF(fontDict, i, &obj1);
        ObjFetch(&obj2, &obj1, xref);
        if (isRef(&obj1) && ObjIsDictSame(&obj2, "Font"))
        {
            this->fonts[i] = gmalloc(sizeof(GfxFont));
            if (this->fonts[i])
            {
                GfxFontInit(this->fonts[i], DictGetKey(fontDict, i),
                    getRef(&obj1),
                    getDict(&obj2), xref);
            }
        }
        else
        {
            EC_WARNING(-1);

            this->fonts[i] = NULL;
        }
        ObjFree(&obj1);
        ObjFree(&obj2);
    }
}

/***********************************************************************
 *      GfxFontDictFree
 ***********************************************************************
 * SYNOPSIS:        Release.
 * PARAMETERS:      GfxFontDict *this    this
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void GfxFontDictFree(GfxFontDict *this)
{
    word i;

    for (i = 0; i < this->numFonts; ++i)
    {
        if (this->fonts[i])
        {
            GfxFontFree(this->fonts[i]);
            gfree(this->fonts[i]);
        }
    }
    gfree(this->fonts);
}

/***********************************************************************
 *      GfxFontDictLookup
 ***********************************************************************
 * SYNOPSIS:        Look up.
 * PARAMETERS:      GfxFontDict *this    this
 *                  char *tag    tag
 *
 * RETURNS:         result pointer
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

GfxFont *GfxFontDictLookup(GfxFontDict *this, char *tag)
{
    word i;

    /* Check the last font before scanning the full font list. */
    if (this->lastFont && GfxFontMatches(this->lastFont, tag))
    {
        return this->lastFont;
    }

    for (i = 0; i < this->numFonts; ++i)
    {
        if (GfxFontMatches(this->fonts[i], tag))
        {
            this->lastFont = this->fonts[i];
            return this->fonts[i];
        }
    }
    return NULL;
}

GBool GfxFontMatches(GfxFont *this, char *tag1)
{ 
    return !GStrCmpString(&this->tag, tag1); 
}

/***********************************************************************
 *      GfxFontIs16Bit
 ***********************************************************************
 * SYNOPSIS:        Process gfx font is16 bit.
 * PARAMETERS:      GfxFont *this    this
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

GBool GfxFontIs16Bit(GfxFont *this)
{
    return this->is16;
}


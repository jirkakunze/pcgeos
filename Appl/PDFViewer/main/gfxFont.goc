/*
 * forward decls
 */
void CopyNamedEncoding(GfxFont *this, Obj *pObj, GBool hasWidthsArray);
static void GfxFontMakeWidths(GfxFont *this, Dict *fontDict, XRef *xref);
static short GfxFontLookupStandardWidth(GfxFont *this, char *name);
static void GfxFontMakeEncoding(GfxFont *this, Dict *fontDict, XRef *xref, GBool hasWidthsArray);
static void GfxFontAddChar(GfxFont *this, word code, char *name, GBool hasWidthsArray);

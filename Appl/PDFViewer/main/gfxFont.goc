    word *appliedCount);
static GBool GfxFontMatches(GfxFont *this, char *tag1);

/********************************************************************
 *                      GfxFontNameRule
 ********************************************************************
 * SYNOPSIS:      Generic name rules for fonts not in fontNameMap.
 *
 * PARAMETERS:    *name                 Ptr to the normalized font name.
 *
 * RETURNS:       char                  Class letter (see fontNameMap), 0 if no
 *                                      rule applies.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static char GfxFontNameRule(const char *name)
{
    const char *p;

    /* "Mono" as a word: not "Monotype", "Monoline" */
    for (p = strstr(name, "Mono"); p; p = strstr(p + 1, "Mono"))
    {
        if (!islower(p[4]) || !strncmp(p + 4, "space", 5))
        {
            return 'M';
        }
    }
    if (strstr(name, "Code") || strstr(name, "Console") ||
        strstr(name, "Typewriter"))
    {
        return 'M';
    }
    if (strstr(name, "Serif") && !strstr(name, "Sans"))
    {
        return 'S';
    }
    if (strstr(name, "Sans") || strstr(name, "Gothic") ||
        strstr(name, "Grotesk"))
    {
        return 'N';
    }
    if (strstr(name, "Roman") || strstr(name, "Antiqua"))
    {
        return 'S';
    }
    return 0;
}

/********************************************************************
 *                      GfxFontMapName
 ********************************************************************
 * SYNOPSIS:      Select the GEOS substitute font class from the font name.
 *
 * PARAMETERS:    *this                 Ptr to the font.
 *                *name                 Ptr to the font name.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Names are more reliable than /Flags (often just 32). The name
 *                is normalized (no subset tag, spaces or "_"), looked up as a
 *                prefix in fontNameMap, then the generic rules; else /Flags
 *                stay.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
void GfxFontMapName(GfxFont *this, const char *name)
{
    char buf[48];
    char *map, *entry, *end;
    char cls = 0;
    word len, n = 0;

    /* Ignore any unique tag (name starts with "AAAAAA+"). */
    if (strlen(name) > 8 && isalpha(name[0]) && isalpha(name[1])
        && isalpha(name[2]) && isalpha(name[3]) && isalpha(name[4])
        && isalpha(name[5]) && name[6] == '+')
    {
        name = &name[7];
    }
    for (; *name && n < sizeof(buf) - 1; ++name)
    {
        if (*name != ' ' && *name != '_')
        {
            buf[n++] = *name;
        }
    }
    buf[n] = '\0';
    if (n == 0)
    {
        return;
    }

    MemLock(OptrToHandle(@fontNameMap));
    map = LMemDeref(@fontNameMap);
    for (entry = map; *entry; entry = (*end) ? end + 1 : end)
    {
        for (end = entry + 1; *end && *end != '|'; ++end)
        {
        }
        len = end - entry - 1;
        if (len && !strncmp(buf, entry + 1, len))
        {
            cls = entry[0];
            break;
        }
    }
    MemUnlock(OptrToHandle(@fontNameMap));

    if (cls == 0)
    {
        cls = GfxFontNameRule(buf);
    }
    if (cls == 0)
    {
        return;
    }
    this->flags &= ~(fontSymbolic | fontSerif | fontFixedWidth);
    switch (cls)
    {
        case 'M':
            this->flags |= fontFixedWidth;
            break;
        case 'S':
            this->flags |= fontSerif;
            break;
        case 'Y':
            this->flags |= fontSymbolic;
            break;
    }
}

/********************************************************************
 *                      GfxFontNameStyle
 ********************************************************************
 * SYNOPSIS:      Set bold and italic from the font name.
 *
 * PARAMETERS:    *this                 Ptr to the font.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Many fonts set no style flags: words like "Bold" or "Italic"
 *                in the name decide (also TeX names such as CMBX, CMTI).
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxFontNameStyle(GfxFont *this)
{
    if (strstr(GStrGetCString(&this->name), "Bold")
        || strstr(GStrGetCString(&this->name), "Black")
        || strstr(GStrGetCString(&this->name), "CMBX"))
    {
        this->flags |= fontBold;
    }
    if (strstr(GStrGetCString(&this->name), "Italic")
        || strstr(GStrGetCString(&this->name), "Oblique")
        || strstr(GStrGetCString(&this->name), "CMTI")
        || strstr(GStrGetCString(&this->name), "CMSL")
        || strstr(GStrGetCString(&this->name), "CMMI"))
    {
        this->flags |= fontItalic;
    }
}

/********************************************************************
 *                      GfxFontInit
 ********************************************************************
 * SYNOPSIS:      Initialize a font from its font dictionary.
 *
 * PARAMETERS:    *this                 Ptr to the font.
 *                *tag1                 Ptr to the resource name.
 *                id1                   Object reference of the font.
 *                *fontDict             Ptr to the font dictionary.
 *                *xref                 Ptr to the cross-reference table.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Read the name and the descriptor flags, select the substitute
 *                font, then the encoding (named, /Differences, built-in), the
 *                widths and /ToUnicode, which wins last. Type0 fonts use
 *                cidFont.c.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxFontInit(GfxFont *this, char *tag1, Ref id1, Dict *fontDict, XRef *xref)
{

    Obj obj1, obj2;
    char *pPdfToGeosMap;
    char *pNameMap;
    word nameLen;
    int code;
    word toUniAppliedCount;
    optr owidths;
    unsigned short *pStdWidths;
    GBool hasWidthsArray;

    /* make cleanup safe even if a string allocation below fails */
    this->cidMap = this->cidRanges = NullHandle;
    this->cidCount = this->cidRangeCount = 0;
    this->cidDefaultWidth = 1000;
    this->charRise = 0;
    this->tag.s = this->name.s = NULL;
    this->tag.length = this->name.length = 0;

    GStrInitString(&this->tag, tag1);
    if (GMemHadError())
    {
        return;
    }
    this->id.num = id1.num;
    this->id.gen = id1.gen;

    GStrInit(&this->name);
    if (GMemHadError())
    {
        return;
    }
    DictLookup(fontDict, "BaseFont", &obj1, xref);
    if (isName(&obj1))
    {
        GStrAppendString(&this->name, getName(&obj1));
    }
    ObjFree(&obj1);

    /* is it a built-in font? */

    /* CMEX: big operators hang below the baseline */
    if (strstr(GStrGetCString(&this->name), "CMEX"))
    {
        this->charRise = -800;
    }

    this->type = fontUnknownType;
    DictLookup(fontDict, "Subtype", &obj1, xref);
    if (isNameSame(&obj1, "Type1"))
    {
        this->type = fontType1;
    }
    else if (isNameSame(&obj1, "Type3"))
    {
        this->type = fontType3;
    }
    else if (isNameSame(&obj1, "TrueType"))
    {
        this->type = fontTrueType;
    }
    else if (isNameSame(&obj1, "Type0"))
    {
        this->type = fontType0;
    }
    ObjFree(&obj1);
    this->is16 = gFalse;

    /* Font class: Times-Roman, then the font name decides */
    this->flags = fontSerif;
    GfxFontMapName(this, GStrGetCString(&this->name));

    this->embFontID.num = -1;
    this->embFontID.gen = -1;
    this->hasCharSet = gFalse;
    this->fontWidthFactor = 0;

    DictLookup(fontDict, "FontDescriptor", &obj1, xref);
    if (isDict(&obj1))
    {

        /* Is CharSet entry present? */

        ObjDictLookup(&obj1, "CharSet", &obj2, xref);
        if (!isNull(&obj2))
        {
            this->hasCharSet = gTrue;
        }
        ObjFree(&obj2);

        ObjDictLookup(&obj1, "Flags", &obj2, xref);
        if (isInt(&obj2))
        {
            this->flags = getInt(&obj2);
        }
        ObjFree(&obj2);
        /* The name decides over the flags */
        GfxFontMapName(this, GStrGetCString(&this->name));
        /* Serif or mono fonts are never symbolic */
        if (this->flags & (fontSerif | fontFixedWidth))
        {
            this->flags &= ~fontSymbolic;
        }

        /* embedded Type 1 font file and font name */
        if (this->type == fontType1)
        {
            ObjDictLookupNF(&obj1, "FontFile", &obj2);
            if (isRef(&obj2))
            {
                /* its built-in encoding: GfxFontReadBuiltinEncoding */
                this->embFontID = getRef(&obj2);
            }
            ObjFree(&obj2);

            /* embedded TrueType font file */
        }
        else if (this->type == fontTrueType)
        {
            ObjDictLookupNF(&obj1, "FontFile2", &obj2);
            if (isRef(&obj2))
            {
                this->embFontID = getRef(&obj2);
            }
            ObjFree(&obj2);
        }
    }
    ObjFree(&obj1);

    /* Type0: everything from the CIDFont and /ToUnicode (cidFont.c) */
    if (this->type == fontType0)
    {
        GfxCidFontInit(this, fontDict, xref);
        GfxFontNameStyle(this);
        return;
    }

    /* Check /Widths first: no standard width lookups then */
    DictLookup(fontDict, "Widths", &obj1, xref);
    hasWidthsArray = isArray(&obj1);
    ObjFree(&obj1);

    /* Clear the widths before standard widths are filled in */
    memset(this->widths, 0, 256 * sizeof(short));
    memset(this->symChars, 0, sizeof(this->symChars));

    /* Standard or symbol char map, after the final flags */

    if (this->flags & fontSymbolic)
    {
        for (code = 0; code < 256; ++code)
        {
            this->charMap[code] = code;
        }
    }
    else
    {
        MemLock(OptrToHandle(@pdfToGeosMap));
        pPdfToGeosMap = LMemDeref(@pdfToGeosMap);
        memcpy(this->charMap, pPdfToGeosMap, sizeof (this->charMap));
        MemUnlock(OptrToHandle(@pdfToGeosMap));
    }

    if (!hasWidthsArray)
    {
        /*
         * Standard widths: one name list entry per code. The width tables
         * are indexed like the name list, and the names of codes 0-255
         * are unique in both lists. Thus the width of a code is the table
         * entry of the code: no name search is necessary. Lock the table
         * one time for all codes.
         */
        owidths = GfxFontWidthTable(this);
        MemLock(OptrToHandle(owidths));
        pStdWidths = LMemDeref(owidths);
        MemLock(OptrToHandle(@standardEncodingNames));
        pNameMap = LMemDeref((this->flags & fontSymbolic ?
            @symbolEncodingNames : @standardEncodingNames));
        for (code = 0; code < 256 && *pNameMap; ++code)
        {
            nameLen = GfxNameListEntryLen(pNameMap);
            if (nameLen)
            {
                this->widths[code] = (short)pStdWidths[code];
            }
            pNameMap += nameLen + 1;
        }
        MemUnlock(OptrToHandle(@standardEncodingNames));
        MemUnlock(OptrToHandle(owidths));
    }

    /* Embedded Type 1 without /Encoding: the built-in encoding */
    if (this->type == fontType1 && this->embFontID.num >= 0)
    {
        if (GfxFontReadBuiltinEncoding(this, xref, hasWidthsArray) > 0)
        {
            this->flags &= ~fontSymbolic;
        }
    }

    GfxFontNameStyle(this);

    /* Apply /Encoding and /Differences */
    if (this->type != fontType0)
    {
        GfxFontMakeEncoding(this, fontDict, xref, hasWidthsArray);
        /* /Widths */
        GfxFontMakeWidths(this, fontDict, xref);
    }

    /* /ToUnicode last: it wins over the encoding */
    toUniAppliedCount = 0;
    GfxFontReadToUnicode(this, fontDict, xref, &toUniAppliedCount);
    /* fontSymbolic selects the Symbol or Dingbat GEOS font family. */
    if (toUniAppliedCount > 0)
    {
        this->flags &= ~fontSymbolic;
    }

}

/********************************************************************
 *                      GfxFontFree
 ********************************************************************
 * SYNOPSIS:      Free the data of a font.
 *
 * PARAMETERS:    *this                 Ptr to the font.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxFontFree(GfxFont *this)
{
    GStrFree(&this->tag);
    GStrFree(&this->name);

    GfxCidFontFree(this);

}

/********************************************************************
 *                      GfxFontWidthTable
 ********************************************************************
 * SYNOPSIS:      Return the width table of the base 14 font that matches
 *                the font flags.
 *
 * PARAMETERS:    *this                 Ptr to the font.
 *
 * RETURNS:       optr                  Width table (WIDTHS resource). It is
 *                                      indexed like the standard name list
 *                                      (symbol name list for Symbol).
 *
 * STRATEGY:      Times by style, Courier, Symbol, else Helvetica by style.
 *                Oblique Courier and Helvetica have the same widths as the
 *                upright fonts, thus they share their tables.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision (GfxFontLookupStandardWidth)
 *      11/28/26  Claude/jkunze  Own function, shared oblique tables
 *******************************************************************/
static optr GfxFontWidthTable(GfxFont *this)
{
    long style = this->flags & (fontBold | fontItalic);

    EC(ECCheckBounds(this));

    if (this->flags & fontSerif)
    {
        if (style == (fontBold | fontItalic))
        {
            return @timesBoldItalicWidths;
        }
        if (style == fontBold)
        {
            return @timesBoldWidths;
        }
        if (style == fontItalic)
        {
            return @timesItalicWidths;
        }
        return @timesRomanWidths;
    }
    if (this->flags & fontFixedWidth)
    {
        /* all Courier derivatives have the same widths */
        return @courierWidths;
    }
    if (this->flags & fontSymbolic)
    {
        return @symbolWidths;
    }
    /* Helvetica-Oblique and -BoldOblique: same widths as upright */
    if (style & fontBold)
    {
        return @helveticaBoldWidths;
    }
    return @helveticaWidths;
}

/********************************************************************
 *                      GfxFontLookupStandardWidth
 ********************************************************************
 * SYNOPSIS:      Return the standard width of a glyph name.
 *
 * PARAMETERS:    *this                 Ptr to the font.
 *                *name                 Ptr to the glyph name (need not end with
 *                                      NUL).
 *                len                   Length of the name.
 *
 * RETURNS:       short                 Width (1/1000 em), 0 if not known.
 *
 * STRATEGY:      Width table of the matching base 14 font (Times, Helvetica,
 *                Courier, Symbol by the flags), indexed by the position of the
 *                name in the standard or symbol name list.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static short GfxFontLookupStandardWidth(GfxFont *this, const char *name,
    word len)
{
    optr owidths;
    unsigned short *widths;
    sword j;
    word tableLen;
    char *pNames;
    short result;

    owidths = GfxFontWidthTable(this);

    result = 0;
    MemLock(OptrToHandle(owidths));
    widths = LMemDeref(owidths);
    MemLock(OptrToHandle(@standardEncodingNames));
    pNames = LMemDeref((this->flags & fontSymbolic) ?
        @symbolEncodingNames : @standardEncodingNames);
    tableLen = (this->flags & fontSymbolic) ?
        symbolEncodingSize : standardEncodingSize;
    j = GfxNameListFind(pNames, name, len);
    if (j >= 0 && (word)j < tableLen)
    {
        result = widths[j];
    }
    MemUnlock(OptrToHandle(@standardEncodingNames));
    MemUnlock(OptrToHandle(owidths));
    if (result == 0 && len == 4 && !strncmp(name, "Euro", 4))
    {
        /* not in the old standard tables; current Adobe core font AFMs */
        result = (this->flags & fontFixedWidth) ? 600 :
            (this->flags & fontSerif) ? 500 : 556;
    }
    return result;
}

/********************************************************************
 *                      GfxFontMakeWidths
 ********************************************************************
 * SYNOPSIS:      Read /FirstChar, /LastChar and /Widths.
 *
 * PARAMETERS:    *this                 Ptr to the font.
 *                *fontDict             Ptr to the font dictionary.
 *                *xref                 Ptr to the cross-reference table.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Only codes 0-255 are used.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxFontMakeWidths(GfxFont *this, Dict *fontDict, XRef *xref)
{
    Obj obj1, obj2;
    short firstChar, lastChar;
    short code;

    /* Initialize widths before performing inline fallback lookup. */

    DictLookup(fontDict, "FirstChar", &obj1, xref);
    firstChar = isInt(&obj1) ? getInt(&obj1) : 0;
    ObjFree(&obj1);
    DictLookup(fontDict, "LastChar", &obj1, xref);
    lastChar = isInt(&obj1) ? getInt(&obj1) : 255;
    ObjFree(&obj1);
    /* widths[] has 256 entries: never trust the file */
    if (firstChar < 0)
    {
        firstChar = 0;
    }
    if (lastChar > 255)
    {
        lastChar = 255;
    }

    DictLookup(fontDict, "Widths", &obj1, xref);
    if (isArray(&obj1))
    {
        for (code = firstChar; code <= lastChar; ++code)
        {
            ObjArrayGet(&obj1, code - firstChar, &obj2, xref);
            if (isNum(&obj2))
            {
                this->widths[code] = GdoubleToWord(getNum(&obj2));
            }
            ObjFree(&obj2);
        }
    }
    /* Without /Widths, widths[] has the standard widths already */

    ObjFree(&obj1);
}

/********************************************************************
 *                      GfxFontMakeEncoding
 ********************************************************************
 * SYNOPSIS:      Apply /Encoding (a name or a dictionary with /Differences).
 *
 * PARAMETERS:    *this                 Ptr to the font.
 *                *fontDict             Ptr to the font dictionary.
 *                *xref                 Ptr to the cross-reference table.
 *                hasWidthsArray        TRUE if the font has /Widths (no
 *                                      standard widths needed).
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxFontMakeEncoding(GfxFont *this, Dict *fontDict, XRef *xref,
    GBool hasWidthsArray)
{

    Obj obj1, obj2, obj3;
    word code, i;
    DictLookup(fontDict, "Encoding", &obj1, xref);

    /* /Encoding dictionary */
    if (isDict(&obj1))
    {
        ObjDictLookup(&obj1, "BaseEncoding", &obj2, xref);
        if (isName(&obj2))
        {
            CopyNamedEncoding(this, &obj2, hasWidthsArray);
        }
        ObjFree(&obj2);

        ObjDictLookup(&obj1, "Differences", &obj2, xref);
        if (isArray(&obj2))
        {
            code = 0;
            for (i = 0; i < ObjArrayGetLength(&obj2); ++i)
            {
                ObjArrayGet(&obj2, i, &obj3, xref);
                if (isInt(&obj3))
                {
                    code = getInt(&obj3);
                }
                else if (isName(&obj3))
                {
                    if (code < 256)
                    {
                        GfxFontAddChar(this, code, getName(&obj3),
                            hasWidthsArray);
                    }
                    ++code;
                }
                else
                {
                    EC_WARNING(-1);

                }
                ObjFree(&obj3);
            }
        }
        ObjFree(&obj2);

        /* /Encoding name or none */
    }
    else if (isName(&obj1))
    {
        CopyNamedEncoding(this, &obj1, hasWidthsArray);
    }

    ObjFree(&obj1);

}

/********************************************************************
 *                      CopyNamedEncoding
 ********************************************************************
 * SYNOPSIS:      Apply MacRomanEncoding or WinAnsiEncoding.
 *
 * PARAMETERS:    *this                 Ptr to the font.
 *                *pObj                 Ptr to the encoding name.
 *                hasWidthsArray        TRUE if the font has /Widths (no
 *                                      standard widths needed).
 *
 * RETURNS:       void
 *
 * STRATEGY:      Copy the char map and, without /Widths, set the standard
 *                widths. Other names do nothing.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      6/02/99   mevissen  Initial Revision
 *******************************************************************/
static void CopyNamedEncoding(GfxFont *this, Obj *pObj, GBool hasWidthsArray)
{
    optr charMap, nameMap;
    char *pNameMap;
    word code;
    word nameLen;

    if (isNameSame(pObj, "MacRomanEncoding"))
    {
        charMap = @macRomanToGeosMap;
        nameMap = @macRomanEncodingNames;
    }
    else if (isNameSame(pObj, "WinAnsiEncoding"))
    {
        charMap = @winAnsiToGeosMap;
        nameMap = @winAnsiEncodingNames;
    }
    else
    {
        return;
    }

    MemLock(OptrToHandle(charMap));
    memcpy(this->charMap, LMemDeref(charMap), sizeof (this->charMap));
    MemUnlock(OptrToHandle(charMap));
    memset(this->symChars, 0, sizeof(this->symChars));

    /* Compute fallback widths inline instead of storing glyph names. */
    if (!hasWidthsArray)
    {
        MemLock(OptrToHandle(nameMap));
        pNameMap = LMemDeref(nameMap);
        for (code = 0; code < 256 && *pNameMap; ++code)
        {
            nameLen = GfxNameListEntryLen(pNameMap);
            if (nameLen)
            {
                this->widths[code] = GfxFontLookupStandardWidth(this,
                    pNameMap, nameLen);
            }
            pNameMap += nameLen + 1;
        }
        MemUnlock(OptrToHandle(nameMap));
    }
}

/********************************************************************
 *                      GfxFontAddChar
 ********************************************************************
 * SYNOPSIS:      Map one code to the GEOS char of a glyph name.
 *
 * PARAMETERS:    *this                 Ptr to the font.
 *                code                  Code 0-255.
 *                *name                 Ptr to the glyph name.
 *                hasWidthsArray        TRUE if the font has /Widths (no
 *                                      standard widths needed).
 *
 * RETURNS:       void
 *
 * STRATEGY:      One-char names directly, ".notdef" clears the code, "G###"
 *                gives a code number, other names through charNames, the Adobe
 *                Glyph List rules and the Symbol font (Greek, math).
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void
GfxFontAddChar(GfxFont *this, word code, char *name, GBool hasWidthsArray)
{
    char *pCharNames;
    char *pCharGEOSEquiv;
    sword searchResult;
    word sym;

    this->symChars[code >> 3] &= (byte)~(1 << (code & 7));

    /* if a (normal) single-char name, simply use that character */
    if (name[1] == '\0')
    {
        if (name[0] >= ' ' && name[0] < C_DELETE)
        {
            this->charMap[code] = (byte)name[0];
            if (!hasWidthsArray)
            {
                this->widths[code] = GfxFontLookupStandardWidth(this, name,
                strlen(name));
            }
            return;
        }
    }
    /* ".notdef": no char and no width */
    if (!strcmp(name, ".notdef"))
    {
        this->charMap[code] = 0;
        return;
    }

    /*
     * Type 3 "c###": Ghostscript (pdfwrite) gives the glyphs of its Type 3
     * fonts the names "c" plus the decimal char code of the source font.
     * We do not draw the glyph procedures (/CharProcs). Thus we read the
     * number as a MacRoman code and show the char in a GEOS font.
     * ATTENTION: This is a heuristic. It is correct for Ghostscript output
     * of Mac and Latin text. Other producers can use the names freely,
     * then the text is wrong. The GEOS font is selected without a font
     * name (Type 3 has no /BaseFont), thus the face can differ. The glyph
     * widths assume a /FontMatrix of 0.001 (see doShowText). Upgrade
     * path: run the /CharProcs as content streams (d0, d1).
     */
    if (this->type == fontType3 && name[0] == 'c' && name[1] != '\0' &&
        strlen(name) <= 4 && strspn(name + 1, "0123456789") ==
        strlen(name + 1))
    {
        int value = atoi(name + 1);

        if (value < 256)
        {
            MemLock(OptrToHandle(@macRomanToGeosMap));
            this->charMap[code] =
                ((byte *)LMemDeref(@macRomanToGeosMap))[value];
            MemUnlock(OptrToHandle(@macRomanToGeosMap));
        }
        else
        {
            this->charMap[code] = 0;
        }
        /* Type 3 fonts always have /Widths: no standard widths here */
        return;
    }

    /* "H###": an embedded char code, not decoded */
    if (name[0] == 'H' && name[1] >= '0' && name[1] <= '9')
    {
        this->charMap[code] = 0;
        if (!hasWidthsArray)
        {
            this->widths[code] = GfxFontLookupStandardWidth(this, name,
                strlen(name));
        }
        return;
    }
    /* if name == "G###", take a chance and decode the integer value. */
    if (name[0] == 'G' && name[1] >= '0' && name[1] <= '9')
    {
        int value = atoi(name + 1);
        if (value < 256)
        {
            MemLock(OptrToHandle(@pdfToGeosMap));
            pCharGEOSEquiv = LMemDeref(@pdfToGeosMap);
            value = pCharGEOSEquiv[value];
            MemUnlock(OptrToHandle(@pdfToGeosMap));
        }
        else
        {
            value = 0;
        }
        this->charMap[code] = value;
        if (!hasWidthsArray)
        {
            this->widths[code] = GfxFontLookupStandardWidth(this, name,
                strlen(name));
        }
        return;
    }

    /* Look up the glyph name */

    MemLock(OptrToHandle(@charGEOSEquiv));
    pCharNames = LMemDeref(@charNames);
    pCharGEOSEquiv = LMemDeref(@charGEOSEquiv);

    searchResult = GfxNameListFind(pCharNames, name, strlen(name));
    if (searchResult != -1)
    {
        this->charMap[code] = pCharGEOSEquiv[searchResult];
    }
    else
    {
        this->charMap[code] = 0;
    }
    MemUnlock(OptrToHandle(@charGEOSEquiv));
    if (searchResult == -1)
    {
        /* "Euro", "uniXXXX", "uXXXX" are not in charNames */
        this->charMap[code] = GfxGlyphNameToGeosChar(name);
    }
    if (this->charMap[code] == 0)
    {
        /* Greek letter from the Symbol font, TeX size variants */
        sym = GfxFontSymbolChar(name, 0);
        if (sym & 0x100)
        {
            this->charMap[code] = (byte)sym;
            this->symChars[code >> 3] |= (byte)(1 << (code & 7));
        }
        else
        {
            this->charMap[code] = (byte)sym;
        }
    }
    if (!hasWidthsArray)
    {
        this->widths[code] = GfxFontLookupStandardWidth(this, name,
                strlen(name));
    }
}

/********************************************************************
 *                      GfxNameListEntryLen
 ********************************************************************
 * SYNOPSIS:      Return the length of one entry of a glyph name list.
 *
 * PARAMETERS:    *entry                Ptr to the entry.
 *
 * RETURNS:       word                  Number of chars before the "|" (0 =
 *                                      empty entry).
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static word GfxNameListEntryLen(const char *entry)
{
    word len = 0;

    while (entry[len] != '|')
    {
        EC_ERROR_IF(entry[len] == '\0', -1);
        ++len;
    }
    return len;
}

/********************************************************************
 *                      GfxNameListFind
 ********************************************************************
 * SYNOPSIS:      Find a name in a glyph name list.
 *
 * PARAMETERS:    *list                 Ptr to the locked list
 *                                      ("name|name|...|").
 *                *name                 Ptr to the name (need not end with NUL).
 *                len                   Length of the name.
 *
 * RETURNS:       sword                 Index of the first equal entry, -1 if
 *                                      not found.
 *
 * STRATEGY:      Linear search (at most 335 entries, only while a font is
 *                loaded). An empty name or a name with "|" is never found.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static sword GfxNameListFind(const char *list, const char *name, word len)
{
    sword idx;
    word entryLen;

    EC(ECCheckBounds((void *)list));
    if (len == 0 || memchr(name, '|', len) != NULL)
    {
        return -1;
    }
    for (idx = 0; *list; ++idx)
    {
        entryLen = GfxNameListEntryLen(list);
        if (entryLen == len && !strncmp(list, name, len))
        {
            return idx;
        }
        list += entryLen + 1;
    }
    return -1;
}

/********************************************************************
 *                      GfxFontMapChar
 ********************************************************************
 * SYNOPSIS:      Return the GEOS char of a code.
 *
 * PARAMETERS:    *this                 Ptr to the font.
 *                c                     Code.
 *                defaultChar           Char for codes without a GEOS char.
 *
 * RETURNS:       char                  GEOS char.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
char GfxFontMapChar(GfxFont *this, unsigned char c, char defaultChar)
{
    char trans = this->charMap[c];

    if (trans == 0)
    {
        trans = defaultChar;
    }
    return trans;
}

/********************************************************************
 *                      GfxFontFindChar
 ********************************************************************
 * SYNOPSIS:      Return the code of a GEOS char.
 *
 * PARAMETERS:    *this                 Ptr to the font.
 *                ch                    GEOS char.
 *
 * RETURNS:       char                  Code, 0 if not found.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
char GfxFontFindChar(GfxFont *this, unsigned char ch)
{
    int i;
    for (i = 1; i < 256; ++i)
    {
        if (ch == this->charMap[i])
        {
            return i;
        }
    }
    return 0;
}

/********************************************************************
 *                      GfxUnicodeToGeosChar
 ********************************************************************
 * SYNOPSIS:      Return the GEOS char of a Unicode value.
 *
 * PARAMETERS:    unicodeVal            Unicode value.
 *
 * RETURNS:       word                  GEOS char, 0 if there is none.
 *
 * STRATEGY:      Linear search in geosCharMap (locked only during the search).
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
word GfxUnicodeToGeosChar(word unicodeVal)
{
    word i;
    word *mapP;
    word result = 0;

    if (unicodeVal == 0)
    {
        return 0;
    }
    MemLock(OptrToHandle(@geosCharMap));
    mapP = LMemDeref(@geosCharMap);
    EC_ERROR_IF(LMemGetChunkSize(@geosCharMap) !=
        NUM_CHARMAPENTRIES * sizeof(word), -1);
    for (i = 0; i < NUM_CHARMAPENTRIES; ++i)
    {
        if (mapP[i] == unicodeVal)
        {
            result = (word)(i + MIN_GEOS_CHAR);
            break;
        }
    }
    MemUnlock(OptrToHandle(@geosCharMap));
    return result;
}

/********************************************************************
 *                      GfxGeosCharToUnicode
 ********************************************************************
 * SYNOPSIS:      Return the Unicode value of a GEOS char.
 *
 * PARAMETERS:    ch                    GEOS char.
 *
 * RETURNS:       word                  Unicode value, 0 for control codes.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
word GfxGeosCharToUnicode(byte ch)
{
    word result;

    if (ch < MIN_GEOS_CHAR ||
        (word)GEOS_CHAR_INDEX(ch) >= (word)NUM_CHARMAPENTRIES)
    {
        return 0;
    }
    MemLock(OptrToHandle(@geosCharMap));
    result = ((word *)LMemDeref(@geosCharMap))[GEOS_CHAR_INDEX(ch)];
    MemUnlock(OptrToHandle(@geosCharMap));
    return result;
}

/********************************************************************
 *                      GfxGlyphNameToGeosChar
 ********************************************************************
 * SYNOPSIS:      Return the GEOS char of a PostScript glyph name.
 *
 * PARAMETERS:    *name                 Ptr to the glyph name.
 *
 * RETURNS:       byte                  GEOS char or C_xx_LIGATURE, 0 if not
 *                                      known.
 *
 * STRATEGY:      charNames, the ligatures, "uniXXXX"/"uXXXX" (Adobe Glyph List)
 *                and the math names of mathNames.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
byte GfxGlyphNameToGeosChar(char *name)
{
    char *pCharNames;
    char *pCharGEOSEquiv;
    sword searchResult;
    byte ch = 0;
    word uni, len, idx;
    char *p;

    if (name[0] == '\0')
    {
        return 0;
    }
    if (name[1] == '\0')
    {
        return (name[0] >= ' ' && name[0] < C_DELETE) ? (byte)name[0] : 0;
    }
    if (!strcmp(name, "ff"))
    {
        return C_FF_LIGATURE;
    }
    if (!strcmp(name, "fi"))
    {
        return C_FI_LIGATURE;
    }
    if (!strcmp(name, "fl"))
    {
        return C_FL_LIGATURE;
    }
    if (!strcmp(name, "ffi"))
    {
        return C_FFI_LIGATURE;
    }
    if (!strcmp(name, "ffl"))
    {
        return C_FFL_LIGATURE;
    }
    if (!strcmp(name, "Euro"))
    {
        /* not in charNames (predates the Euro) */
        return (byte)GfxUnicodeToGeosChar(0x20AC);
    }
    if ((name[0] == 'u' && name[1] == 'n' && name[2] == 'i' &&
         strlen(name) == 7) || (name[0] == 'u' && strlen(name) == 5))
    {
        p = (name[1] == 'n') ? name + 3 : name + 1;
        uni = 0;
        while (*p && isxdigit(*p))
        {
            uni = (uni << 4) |
                (word)(isdigit(*p) ? *p - '0' : (toupper(*p) - 'A' + 10));
            ++p;
        }
        if (*p == '\0')
        {
            return (byte)GfxUnicodeToGeosChar(uni);
        }
    }

    MemLock(OptrToHandle(@charGEOSEquiv));
    pCharNames = LMemDeref(@charNames);
    pCharGEOSEquiv = LMemDeref(@charGEOSEquiv);
    searchResult = GfxNameListFind(pCharNames, name, strlen(name));
    if (searchResult != -1)
    {
        ch = (byte)pCharGEOSEquiv[searchResult];
    }
    MemUnlock(OptrToHandle(@charGEOSEquiv));
    if (ch == 0)
    {
        /* math characters of the GEOS set: "lessequal", "summation" ... */
        uni = 0;
        len = strlen(name);
        MemLock(OptrToHandle(@mathNames));
        p = LMemDeref(@mathNames);
        for (idx = 0; *p; ++idx)
        {
            if (!strncmp(p, name, len) && p[len] == '|')
            {
                uni = ((word *)LMemDeref(@mathUnicode))[idx];
                break;
            }
            while (*p && *p != '|')
            {
                ++p;
            }
            if (*p)
            {
                ++p;
            }
        }
        MemUnlock(OptrToHandle(@mathNames));
        if (uni)
        {
            ch = (byte)GfxUnicodeToGeosChar(uni);
        }
    }
    return ch;
}

/********************************************************************
 *                      GfxFontStringToUnicode
 ********************************************************************
 * SYNOPSIS:      Return the value of a 1- or 2-byte CMap string.
 *
 * PARAMETERS:    *strObj               Ptr to the string object.
 *
 * RETURNS:       word                  Value (big-endian), 0 for an empty
 *                                      string.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static word GfxFontStringToUnicode(Obj *strObj)
{
    char *bytes;
    word len;

    bytes = GStrGetCString(getString(strObj));
    len = GStrGetLength(getString(strObj));

    if (len == 0)
    {
        return 0;
    }
    else if (len == 1)
    {
        return(word)(Guchar)bytes[0];
    }
    else
    {
        return(word)(((Guchar)bytes[0] << 8) | (Guchar)bytes[1]);
    }
}

/********************************************************************
 *                      GfxFontSetUnicode
 ********************************************************************
 * SYNOPSIS:      Map one code from /ToUnicode.
 *
 * PARAMETERS:    *this                 Ptr to the font.
 *                code                  Code.
 *                unicodeVal            Unicode value.
 *                *appliedCount         Ptr to the count of mapped codes
 *                                      (in/out).
 *
 * RETURNS:       void
 *
 * STRATEGY:      The GEOS char if there is one, else a Greek letter of the
 *                Symbol font; other values keep the encoding.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxFontSetUnicode(GfxFont *this, Guchar code, word unicodeVal,
    word *appliedCount)
{
    word geosChar = GfxUnicodeToGeosChar(unicodeVal);
    word sym;

    if (geosChar != 0)
    {
        this->charMap[code] = (byte)geosChar;
        this->symChars[code >> 3] &= (byte)~(1 << (code & 7));
        ++(*appliedCount);
        return;
    }
    sym = GfxFontSymbolChar((void *)0, unicodeVal);
    if (sym & 0x100)
    {
        this->charMap[code] = (byte)sym;
        this->symChars[code >> 3] |= (byte)(1 << (code & 7));
        ++(*appliedCount);
    }
}

/********************************************************************
 *                      GfxFontParseBfChar
 ********************************************************************
 * SYNOPSIS:      Read a bfchar section of /ToUnicode.
 *
 * PARAMETERS:    *parser               Ptr to the parser after "beginbfchar".
 *                *this                 Ptr to the font.
 *                *appliedCount         Ptr to the count of mapped codes
 *                                      (in/out).
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void
GfxFontParseBfChar(Parser *parser, GfxFont *this, word *appliedCount)
{
    Obj codeObj, uniObj;
    Guchar code;
    word unicodeVal;

    ParserGetObj(parser, &codeObj);
    while (!isEOF(&codeObj) && !isCmdSame(&codeObj, "endbfchar"))
    {
        if (!isString(&codeObj))
        {
            ObjFree(&codeObj);
            break;
        }
        code = (Guchar)GfxFontStringToUnicode(&codeObj);
        ObjFree(&codeObj);

        ParserGetObj(parser, &uniObj);
        if (isString(&uniObj))
        {
            unicodeVal = GfxFontStringToUnicode(&uniObj);
            GfxFontSetUnicode(this, code, unicodeVal, appliedCount);
        }
        ObjFree(&uniObj);

        ParserGetObj(parser, &codeObj);
    }
    ObjFree(&codeObj);
}

/********************************************************************
 *                      GfxFontParseBfRange
 ********************************************************************
 * SYNOPSIS:      Read a bfrange section of /ToUnicode.
 *
 * PARAMETERS:    *parser               Ptr to the parser after "beginbfrange".
 *                *this                 Ptr to the font.
 *                *appliedCount         Ptr to the count of mapped codes
 *                                      (in/out).
 *
 * RETURNS:       void
 *
 * STRATEGY:      Contiguous form (one start value, +1 per code) and array form.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void
GfxFontParseBfRange(Parser *parser, GfxFont *this, word *appliedCount)
{
    Obj loObj, hiObj, dstObj, elemObj;
    Guchar lo, hi, c;
    word base, unicodeVal;
    word arrayIdx;

    ParserGetObj(parser, &loObj);
    while (!isEOF(&loObj) && !isCmdSame(&loObj, "endbfrange"))
    {
        if (!isString(&loObj))
        {
            ObjFree(&loObj);
            break;
        }
        lo = (Guchar)GfxFontStringToUnicode(&loObj);
        ObjFree(&loObj);

        ParserGetObj(parser, &hiObj);
        if (!isString(&hiObj))
        {
            ObjFree(&hiObj);
            break;
        }
        hi = (Guchar)GfxFontStringToUnicode(&hiObj);
        ObjFree(&hiObj);

        ParserGetObj(parser, &dstObj);
        if (isString(&dstObj))
        {
            /* contiguous form: base unicode value, +1 per code */
            base = GfxFontStringToUnicode(&dstObj);
            for (c = lo; c <= hi; ++c)
            {
                unicodeVal = (word)(base + (c - lo));
                GfxFontSetUnicode(this, c, unicodeVal, appliedCount);
                if (c == 255)
                {
                    break;
                } /* avoid wrapping Guchar past 255 */
            }
        }
        else if (isArray(&dstObj))
        {
            /* explicit form: one destination value per code, in order */
            c = lo;
            for (arrayIdx = 0; arrayIdx <= (word)(hi - lo); ++arrayIdx)
            {
                ObjArrayGet(&dstObj, arrayIdx, &elemObj,
                    LexerGetXRef(parser->lexer));
                if (isString(&elemObj))
                {
                    unicodeVal = GfxFontStringToUnicode(&elemObj);
                    GfxFontSetUnicode(this, c, unicodeVal, appliedCount);
                }
                ObjFree(&elemObj);
                if (c == 255)
                {
                    break;
                }
                ++c;
            }
        }
        ObjFree(&dstObj);

        ParserGetObj(parser, &loObj);
    }
    ObjFree(&loObj);
}

/********************************************************************
 *                      GfxFontReadToUnicode
 ********************************************************************
 * SYNOPSIS:      Apply the /ToUnicode CMap of a simple font.
 *
 * PARAMETERS:    *this                 Ptr to the font.
 *                *fontDict             Ptr to the font dictionary.
 *                *xref                 Ptr to the cross-reference table.
 *                *appliedCount         Ptr to the count of mapped codes (out).
 *
 * RETURNS:       void
 *
 * STRATEGY:      Parse the CMap with the normal parser; only bfchar and bfrange
 *                sections are read.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxFontReadToUnicode(GfxFont *this, Dict *fontDict, XRef *xref,
    word *appliedCount)
{
    Obj refObj, streamObj, tokObj;
    Lexer *lexer;
    Parser parser;

    DictLookupNF(fontDict, "ToUnicode", &refObj);
    if (!isRef(&refObj))
    {
        ObjFree(&refObj);
        return;
    }
    XRefFetch(xref, getRefNum(&refObj), getRefGen(&refObj), &streamObj);
    ObjFree(&refObj);
    if (!isStream(&streamObj))
    {
        ObjFree(&streamObj);
        return;
    }

    lexer = gmalloc(sizeof (Lexer));
    if (!lexer)
    {
        ObjFree(&streamObj);
        return;
    }
    LexerInitFromStream(lexer, getStream(&streamObj), xref);
    if (GMemHadError())
    {
        LexerFree(lexer);
        gfree(lexer);
        return;
    }
    ParserInit(&parser, lexer);

    ParserGetObj(&parser, &tokObj);
    while (!isEOF(&tokObj))
    {
        if (isCmdSame(&tokObj, "beginbfchar"))
        {
            ObjFree(&tokObj);
            GfxFontParseBfChar(&parser, this, appliedCount);
        }
        else if (isCmdSame(&tokObj, "beginbfrange"))
        {
            ObjFree(&tokObj);
            GfxFontParseBfRange(&parser, this, appliedCount);
        }
        else
        {
            ObjFree(&tokObj);
        }
        ParserGetObj(&parser, &tokObj);
    }
    ObjFree(&tokObj);

    /* LexerInitFromStream takes ownership of streamObj's stream. */
    ParserFree(&parser);
}

/********************************************************************
 *                      GfxFontDictInit
 ********************************************************************
 * SYNOPSIS:      Load all fonts of a /Font resource dictionary.
 *
 * PARAMETERS:    *this                 Ptr to the font dictionary object.
 *                *fontDict             Ptr to the /Font dictionary.
 *                *xref                 Ptr to the cross-reference table.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Fonts may be references or direct dictionaries.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
void GfxFontDictInit(GfxFontDict *this, Dict *fontDict, XRef *xref)
{
    word i;
    Obj obj1, obj2;

    this->lastFont = NULL;
    initNull(&obj1);
    initNull(&obj2);

    this->numFonts = DictGetLength(fontDict);
    this->fonts = (GfxFont **)gmalloc(this->numFonts * sizeof(GfxFont *));
    if (!this->fonts)
    {
        this->numFonts = 0;
        return;
    }
    for (i = 0; i < this->numFonts; ++i)
    {
        DictGetValNF(fontDict, i, &obj1);
        ObjFetch(&obj2, &obj1, xref);
        /* Font dictionaries may also be direct objects (no reference). */
        if (ObjIsDictSame(&obj2, "Font"))
        {
            Ref fontRef;

            if (isRef(&obj1))
            {
                fontRef = getRef(&obj1);
            }
            else
            {
                fontRef.num = -1;
                fontRef.gen = 0;
            }
            this->fonts[i] = gmalloc(sizeof(GfxFont));
            if (this->fonts[i])
            {
                GfxFontInit(this->fonts[i], DictGetKey(fontDict, i),
                    fontRef, getDict(&obj2), xref);
            }
        }
        else
        {
            EC_WARNING(-1);

            this->fonts[i] = NULL;
        }
        ObjFree(&obj1);
        ObjFree(&obj2);
    }
}

/********************************************************************
 *                      GfxFontDictFree
 ********************************************************************
 * SYNOPSIS:      Free all fonts of a font dictionary.
 *
 * PARAMETERS:    *this                 Ptr to the font dictionary object.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
void GfxFontDictFree(GfxFontDict *this)
{
    word i;

    for (i = 0; i < this->numFonts; ++i)
    {
        if (this->fonts[i])
        {
            GfxFontFree(this->fonts[i]);
            gfree(this->fonts[i]);
        }
    }
    gfree(this->fonts);
}

/********************************************************************
 *                      GfxFontDictLookup
 ********************************************************************
 * SYNOPSIS:      Find a font by its resource name.
 *
 * PARAMETERS:    *this                 Ptr to the font dictionary object.
 *                *tag                  Ptr to the resource name.
 *
 * RETURNS:       GfxFont *             Ptr to the font, NULL if not found.
 *
 * STRATEGY:      The last font found is checked first.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
GfxFont *GfxFontDictLookup(GfxFontDict *this, char *tag)
{
    word i;

    /* Check the last font before scanning the full font list. */
    if (this->lastFont && GfxFontMatches(this->lastFont, tag))
    {
        return this->lastFont;
    }

    for (i = 0; i < this->numFonts; ++i)
    {
        if (this->fonts[i] && GfxFontMatches(this->fonts[i], tag))
        {
            this->lastFont = this->fonts[i];
            return this->fonts[i];
        }
    }
    return NULL;
}

/********************************************************************
 *                      GfxFontDictLookupRef
 ********************************************************************
 * SYNOPSIS:      Find a font by its object reference.
 *
 * PARAMETERS:    *this                 Ptr to the font dictionary object.
 *                ref                   Object reference.
 *
 * RETURNS:       GfxFont *             Ptr to the font, NULL if not found.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
GfxFont *GfxFontDictLookupRef(GfxFontDict *this, Ref ref)
{
    word i;

    for (i = 0; i < this->numFonts; ++i)
    {
        if (this->fonts[i] && this->fonts[i]->id.num == ref.num &&
            this->fonts[i]->id.gen == ref.gen)
        {
            return this->fonts[i];
        }
    }
    return NULL;
}

static GBool GfxFontMatches(GfxFont *this, char *tag1)
{ 
    return !strcmp(GStrGetCString(&this->tag), tag1);
}

GBool GfxFontIs16Bit(GfxFont *this)
{
    return this->is16;
}

#pragma code_seg("PdfText")

/********************************************************************
 *                      PdfTextStringToGeos
 ********************************************************************
 * SYNOPSIS:      Convert a PDF text string to the GEOS character set.
 *
 * PARAMETERS:    *str                  Ptr to the text string (UTF-16BE or
 *                                      PDFDocEncoding).
 *                *dst                  Ptr to the result (out, NUL-terminated).
 *                dstSize               Size of dst.
 *
 * RETURNS:       word                  Length of the result.
 *
 * STRATEGY:      UTF-16BE (BOM FE FF) or PDFDocEncoding to Unicode to GEOS.
 *                Language escapes are skipped, surrogate pairs and chars
 *                without a GEOS char become "?", tab/CR/LF a space.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      11/23/26  JK        Initial version
 *******************************************************************/
word PdfTextStringToGeos(GooString *str, char *dst, word dstSize)
{
    Guchar *s;
    long len, i;
    word n = 0;
    word uni, ch;
    GBool utf16, inEscape = gFalse;
    word *high;

    if (dstSize == 0)
    {
        return 0;
    }
    s = (Guchar *)GStrGetCString(str);
    len = GStrGetLength(str);
    utf16 = (len >= 2 && s[0] == 0xFE && s[1] == 0xFF);
    i = utf16 ? 2 : 0;

    MemLock(OptrToHandle(@pdfDocEncodingHigh));
    high = LMemDeref(@pdfDocEncodingHigh);
    while (i < len && n + 1 < dstSize)
    {
        if (utf16)
        {
            if (i + 1 >= len)
            {
                break;
            }
            uni = ((word)s[i] << 8) | s[i + 1];
            i += 2;
            if (uni == 0x001B)
            {
                inEscape = !inEscape;
                continue;
            }
            if (inEscape)
            {
                continue;
            }
            if (uni >= 0xD800 && uni <= 0xDBFF)
            {
                i += 2;         /* skip the low surrogate */
                uni = '?';
            }
        }
        else
        {
            uni = s[i++];
            if (uni >= 0x18 && uni <= 0x1F)
            {
                uni = high[uni - 0x18];
            }
            else if (uni >= 0x80 && uni <= 0xA0)
            {
                uni = high[8 + uni - 0x80];
            }
        }

        if (uni == '\t' || uni == '\r' || uni == '\n')
        {
            ch = ' ';
        }
        else if (uni < 0x20)
        {
            continue;
        }
        else if (uni < 0x7F)
        {
            ch = uni;
        }
        else
        {
            ch = GfxUnicodeToGeosChar(uni);
            if (ch == 0)
            {
                ch = '?';
            }
        }
        dst[n++] = (char)ch;
    }
    MemUnlock(OptrToHandle(@pdfDocEncodingHigh));
    dst[n] = 0;
    return n;
}

/********************************************************************
 *                      GfxFontReadBuiltinEncoding
 ********************************************************************
 * SYNOPSIS:      Apply the encoding built into an embedded Type 1 font file.
 *
 * PARAMETERS:    *this                 Ptr to the font.
 *                *xref                 Ptr to the cross-reference table.
 *                hasWidthsArray        TRUE if the font has /Widths (no
 *                                      standard widths needed).
 *
 * RETURNS:       word                  Number of codes mapped, 0 if there is no
 *                                      built-in encoding.
 *
 * STRATEGY:      Read "dup <code> /<glyph> put" entries in the clear text part
 *                of /FontFile (before "eexec"). ATTENTION: CFF and TrueType
 *                built-in encodings are not read.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static word GfxFontReadBuiltinEncoding(GfxFont *this, XRef *xref,
    GBool hasWidthsArray)
{
    Obj ref, fileObj;
    char *buf;
    char *p, *name;
    word line, code, count = 0;

    buf = gmalloc(256);
    if (!buf)
    {
        return 0;
    }
    initRef(&ref, this->embFontID.num, this->embFontID.gen);
    ObjFetch(&fileObj, &ref, xref);
    if (isStream(&fileObj))
    {
        ObjStreamReset(&fileObj);
        for (line = 0; line < 600; ++line)
        {
            ObjStreamGetLine(&fileObj, buf, 256);
            if (buf[0] == '\0' && ObjStreamLookChar(&fileObj) == EOF)
            {
                break;
            }
            if (strstr(buf, "eexec") || strstr(buf, "StandardEncoding"))
            {
                break;
            }
            for (p = strstr(buf, "dup "); p; p = strstr(p, "dup "))
            {
                p += 4;
                if (!isdigit(*p))
                {
                    continue;
                }
                code = 0;
                while (isdigit(*p) && code < 1000)
                {
                    code = code * 10 + (*p++ - '0');
                }
                while (*p == ' ')
                {
                    ++p;
                }
                if (*p != '/' || code > 255)
                {
                    continue;
                }
                name = ++p;
                while (*p && *p != ' ' && *p != '/')
                {
                    ++p;
                }
                if (*p == '\0' || p == name)
                {
                    continue;   /* glyph name cut by the line buffer */
                }
                *p++ = '\0';
                if (count == 0)
                {
                    memset(this->charMap, 0, sizeof(this->charMap));
                    memset(this->symChars, 0, sizeof(this->symChars));
                }
                GfxFontAddChar(this, code, name, hasWidthsArray);
                ++count;
            }
        }
    }
    ObjFree(&fileObj);
    gfree(buf);
    return count;
}

/********************************************************************
 *                      GfxFontSymbolChar
 ********************************************************************
 * SYNOPSIS:      Return a char for a glyph name or Unicode value that GEOS does
 *                not have.
 *
 * PARAMETERS:    *name                 Ptr to the glyph name, or NULL.
 *                unicodeVal            Unicode value if name is NULL.
 *
 * RETURNS:       word                  GEOS char; with 0x100 set: a char of the
 *                                      GEOS Symbol font; 0 if there is none.
 *
 * STRATEGY:      TeX size variants ("summationtext") become the base name;
 *                Greek letters come from the Symbol font (Adobe Symbol
 *                encoding).
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static word GfxFontSymbolChar(const char *name, word unicodeVal)
{
    char buf[24];
    char *names, *letters, *p;
    word len, idx;
    byte ch = 0;
    GBool upper;

    if (name == (void *)0)
    {
        MemLock(OptrToHandle(@greekUnicodeLower));
        if (unicodeVal >= 0x03B1 && unicodeVal <= 0x03C9)
        {
            ch = ((char *)LMemDeref(@greekUnicodeLower))[unicodeVal - 0x03B1];
        }
        else if (unicodeVal >= 0x0391 && unicodeVal <= 0x03A9)
        {
            ch = ((char *)LMemDeref(@greekUnicodeUpper))[unicodeVal - 0x0391];
        }
        else if (unicodeVal == 0x03D1)
        {
            ch = 'J';   /* theta symbol */
        }
        else if (unicodeVal == 0x03D5)
        {
            ch = 'j';   /* phi symbol */
        }
        else if (unicodeVal == 0x03D6)
        {
            ch = 'v';   /* pi symbol */
        }
        MemUnlock(OptrToHandle(@greekUnicodeLower));
        return (ch && ch != '?') ? (word)(0x100 | ch) : 0;
    }

    len = strlen(name);
    if (len == 0 || len >= sizeof(buf))
    {
        return 0;
    }
    strcpy(buf, name);

    /* TeX big operators: "summationtext" -> "summation" */
    if (len > 4 && !strcmp(buf + len - 4, "text"))
    {
        buf[len - 4] = '\0';
        return GfxGlyphNameToGeosChar(buf);
    }
    if (len > 7 && !strcmp(buf + len - 7, "display"))
    {
        buf[len - 7] = '\0';
        return GfxGlyphNameToGeosChar(buf);
    }

    /* TeX variants of Greek letters */
    if (buf[len - 1] == '1')
    {
        buf[--len] = '\0';
        if (!strcmp(buf, "theta"))
        {
            return 0x100 | 'J';
        }
        if (!strcmp(buf, "phi"))
        {
            return 0x100 | 'j';
        }
        if (!strcmp(buf, "sigma"))
        {
            return 0x100 | 'V';
        }
        if (!strcmp(buf, "omega"))
        {
            return 0x100 | 'v';
        }
    }

    /* Greek letter names, lower or upper case */
    upper = (buf[0] >= 'A' && buf[0] <= 'Z');
    if (upper)
    {
        buf[0] = (char)(buf[0] - 'A' + 'a');
    }
    MemLock(OptrToHandle(@greekNames));
    names = LMemDeref(@greekNames);
    letters = LMemDeref(@greekSymbolLetters);
    for (p = names, idx = 0; *p; ++idx)
    {
        if (!strncmp(p, buf, len) && p[len] == '|')
        {
            ch = (byte)letters[idx];
            if (upper)
            {
                ch = (byte)(ch - 'a' + 'A');
            }
            break;
        }
        while (*p && *p != '|')
        {
            ++p;
        }
        if (*p)
        {
            ++p;
        }
    }
    MemUnlock(OptrToHandle(@greekNames));
    return ch ? (word)(0x100 | ch) : 0;
}

GBool GfxFontIsSymbolChar(GfxFont *this, byte code)
{
    return (this->symChars[code >> 3] & (1 << (code & 7))) != 0;
}

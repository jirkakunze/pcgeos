#include <Ansi/string.h>
#include <heap.h>
#include <lmem.h>
#include <ec.h>

#include "obj.h"
#include "array.h"
#include "dict.h"
#include "gstr.h"
#include "gmem.h"
#include "crypt.h"

/* MD5 and security handler tables: in a data resource, not in dgroup */
@start CRYPTDATA, data;

@chunk dword md5K[] = {
    0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee,
        0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
        0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be,
        0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
        0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa,
        0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
        0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed,
        0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
        0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c,
        0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
        0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05,
        0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
        0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039,
        0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
        0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1,
        0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391
};

@chunk byte md5S[] = {
    7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
        5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
        4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
        6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21
};

/* Padding string of the standard security handler (PDF spec 7.6.3.3) */
@chunk byte pdfPadding[] = {
    0x28, 0xbf, 0x4e, 0x5e, 0x4e, 0x75, 0x8a, 0x41,
        0x64, 0x00, 0x4e, 0x56, 0xff, 0xfa, 0x01, 0x08,
        0x2e, 0x2e, 0x00, 0xb6, 0xd0, 0x68, 0x3e, 0x80,
        0x2f, 0x0c, 0xa9, 0xfe, 0x64, 0x53, 0x69, 0x7a
};

@end CRYPTDATA;

static dword md5RotL(dword x, short c)
{
    return(x << c) | (x >> (32 - c));
}

/********************************************************************
 *                      MD5Compute
 ********************************************************************
 * SYNOPSIS:      Compute the MD5 digest of a byte block (RFC 1321).
 *
 * PARAMETERS:    *data                 Ptr to the data.
 *                len                   Number of bytes.
 *                *digest               Ptr to the 16-byte digest (out). May be
 *                                      the same as data.
 *
 * RETURNS:       void
 *
 * STRATEGY:      One-shot: copy the data into a padded buffer, then process the
 *                64-byte chunks. Out of memory: the digest is all 0.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void MD5Compute(Guchar *data, word len, Guchar digest[16])
{
    dword a0 = 0x67452301, b0 = 0xefcdab89, c0 = 0x98badcfe, d0 = 0x10325476;
    dword a, b, c, d, f, m, temp;
    word paddedLen, chunkStart, i;
    short g, j;
    Guchar *msg;
    dword bitLen;
    dword *kP;
    byte *sP;

    /* Padding: 0x80, zeros up to 56 mod 64, then the bit length */
    paddedLen = (word)((len + 72) & 0xffc0);
    msg = gmalloc(paddedLen);
    if (!msg)
    {
        memset(digest, 0, 16);
        return;
    }
    memcpy(msg, data, len);
    msg[len] = 0x80;
    for (i = len + 1; i < paddedLen - 8; ++i)
    {
        msg[i] = 0;
    }
    bitLen = ((dword)len) << 3;
    for (i = 0; i < 4; ++i)
    {
        msg[paddedLen - 8 + i] = (Guchar)(bitLen >> (i << 3));
    }
    for (i = 4; i < 8; ++i)
    {
        msg[paddedLen - 8 + i] = 0;
    }

    /* Lock the MD5 tables only while the chunks are processed */
    MemLock(OptrToHandle(@md5K));
    kP = LMemDeref(@md5K);
    sP = LMemDeref(@md5S);
    for (chunkStart = 0; chunkStart < paddedLen; chunkStart += 64)
    {
        dword w[16];
        for (i = 0; i < 16; ++i)
        {
            w[i] = ((dword)msg[chunkStart + (i << 2) + 0]) |
            ((dword)msg[chunkStart + (i << 2) + 1] << 8) |
            ((dword)msg[chunkStart + (i << 2) + 2] << 16) |
            ((dword)msg[chunkStart + (i << 2) + 3] << 24);
        }

        /* 64 steps: four rounds of 16 */
        a = a0; b = b0; c = c0; d = d0;

        for (j = 0; j < 64; ++j)
        {
            if (j < 16)
            {
                f = (b & c) | (~b & d);
                g = j;
            }
            else if (j < 32)
            {
                f = (d & b) | (~d & c);
                g = (5 * j + 1) & 15;
            }
            else if (j < 48)
            {
                f = b ^ c ^ d;
                g = (3 * j + 5) & 15;
            }
            else
            {
                f = c ^ (b | ~d);
                g = (7 * j) & 15;
            }
            temp = d;
            d = c;
            c = b;
            m = a + f + kP[j] + w[g];
            b = b + md5RotL(m, sP[j]);
            a = temp;
        }

        a0 += a; b0 += b; c0 += c; d0 += d;
    }
    MemUnlock(OptrToHandle(@md5K));

    for (i = 0; i < 4; ++i)
    {
        digest[i] = (Guchar)(a0 >> (i << 3));
        digest[4 + i] = (Guchar)(b0 >> (i << 3));
        digest[8 + i] = (Guchar)(c0 >> (i << 3));
        digest[12 + i] = (Guchar)(d0 >> (i << 3));
    }

    gfree(msg);
}

/********************************************************************
 *                      RC4KeySchedule
 ********************************************************************
 * SYNOPSIS:      Initialize an RC4 state with a key.
 *
 * PARAMETERS:    *key                  Ptr to the key.
 *                keyLen                Key length in bytes.
 *                *sBox                 Ptr to the 256-byte RC4 state (out).
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
void RC4KeySchedule(Guchar *key, short keyLen, Guchar sBox[256])
{
    short i, j;
    Guchar tmp;

    for (i = 0; i < 256; ++i)
    {
        sBox[i] = (Guchar)i;
    }
    j = 0;
    for (i = 0; i < 256; ++i)
    {
        j = (j + sBox[i] + key[i % keyLen]) & 0xff;
        tmp = sBox[i];
        sBox[i] = sBox[j];
        sBox[j] = tmp;
    }
}

/********************************************************************
 *                      RC4NextByte
 ********************************************************************
 * SYNOPSIS:      Return the next RC4 key stream byte.
 *
 * PARAMETERS:    *sBox                 Ptr to the RC4 state.
 *                *rc4i                 Ptr to the index i (in/out).
 *                *rc4j                 Ptr to the index j (in/out).
 *
 * RETURNS:       Guchar                Key stream byte.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
Guchar RC4NextByte(Guchar sBox[256], Guchar *rc4i, Guchar *rc4j)
{
    Guchar i, j, tmp;

    i = (*rc4i + 1) & 0xff;
    j = (*rc4j + sBox[i]) & 0xff;
    tmp = sBox[i];
    sBox[i] = sBox[j];
    sBox[j] = tmp;
    *rc4i = i;
    *rc4j = j;
    return sBox[(sBox[i] + sBox[j]) & 0xff];
}

/********************************************************************
 *                      RC4Apply
 ********************************************************************
 * SYNOPSIS:      Encrypt or decrypt a byte block in place with RC4.
 *
 * PARAMETERS:    *key                  Ptr to the key.
 *                keyLen                Key length in bytes.
 *                *data                 Ptr to the data.
 *                len                   Number of bytes.
 *
 * RETURNS:       void
 *
 * STRATEGY:      The 256-byte state is on the stack; use it only for short
 *                blocks (passwords, keys, strings).
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
void RC4Apply(Guchar *key, short keyLen, Guchar *data, long len)
{
    Guchar sBox[256];
    Guchar rc4i, rc4j;
    long i;

    RC4KeySchedule(key, keyLen, sBox);
    rc4i = rc4j = 0;
    for (i = 0; i < len; ++i)
    {
        data[i] ^= RC4NextByte(sBox, &rc4i, &rc4j);
    }
}

/********************************************************************
 *                      XRefCopyPadding
 ********************************************************************
 * SYNOPSIS:      Copy the start of the padding string of the standard security
 *                handler.
 *
 * PARAMETERS:    *dst                  Ptr to the destination.
 *                n                     Number of bytes, max. 32.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void XRefCopyPadding(Guchar *dst, word n)
{
    EC_ERROR_IF(n > 32, -1);
    MemLock(OptrToHandle(@pdfPadding));
    memcpy(dst, LMemDeref(@pdfPadding), n);
    MemUnlock(OptrToHandle(@pdfPadding));
}

/********************************************************************
 *                      XRefDeriveFileKey
 ********************************************************************
 * SYNOPSIS:      Compute the file key from a padded password (PDF spec
 *                Algorithm 2).
 *
 * PARAMETERS:    *paddedPw             Ptr to the password padded to 32 bytes.
 *                *ownerHash            Ptr to the /O value.
 *                perms                 /P value.
 *                *id0                  Ptr to the first /ID string.
 *                id0Len                Length of id0.
 *                revision              /R value.
 *                keyLenBytes           Key length in bytes.
 *                encryptMetadata       /EncryptMetadata value.
 *                *outKey               Ptr to the file key (out).
 *
 * RETURNS:       void
 *
 * STRATEGY:      Revision 3 hashes the digest 50 more times.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void XRefDeriveFileKey(Guchar *paddedPw, Guchar *ownerHash, dword perms,
    Guchar *id0, word id0Len,
    short revision, short keyLenBytes, GBool encryptMetadata, Guchar outKey[16])
{
    Guchar buf[32 + 32 + 4 + 64 + 4];
    word pos;
    Guchar digest[16];
    short round;

    pos = 0;
    memcpy(&buf[pos], paddedPw, 32);
    pos += 32;
    memcpy(&buf[pos], ownerHash, 32);
    pos += 32;
    buf[pos++] = (Guchar)(perms);
    buf[pos++] = (Guchar)(perms >> 8);
    buf[pos++] = (Guchar)(perms >> 16);
    buf[pos++] = (Guchar)(perms >> 24);
    if (id0Len > 64)
    {
        id0Len = 64;
    }
    memcpy(&buf[pos], id0, id0Len);
    pos += id0Len;
    if (revision >= 4 && !encryptMetadata)
    {
        buf[pos++] = 0xff;
        buf[pos++] = 0xff;
        buf[pos++] = 0xff;
        buf[pos++] = 0xff;
    }

    MD5Compute(buf, pos, digest);

    if (revision >= 3)
    {
        for (round = 0; round < 50; ++round)
        {
            MD5Compute(digest, (word)keyLenBytes, digest);
        }
    }

    memcpy(outKey, digest, keyLenBytes);
}

/********************************************************************
 *                      XRefCheckUValue
 ********************************************************************
 * SYNOPSIS:      Check a file key against the /U value (Algorithms 4 and 5).
 *
 * PARAMETERS:    *fileKey              Ptr to the file key.
 *                keyLenBytes           Key length in bytes.
 *                revision              /R value.
 *                *id0                  Ptr to the first /ID string.
 *                id0Len                Length of id0.
 *                *uValue               Ptr to the /U value.
 *
 * RETURNS:       GBool                 gTrue if the key is correct.
 *
 * STRATEGY:      Revision 3 compares only the first 16 bytes.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static GBool XRefCheckUValue(Guchar *fileKey, short keyLenBytes, 
    short revision, Guchar *id0, word id0Len, Guchar *uValue)
{
    Guchar result[32];
    Guchar roundKey[16];
    Guchar digest[16];
    Guchar buf[32 + 64];
    short round, i;

    if (revision == 2)
    {
        XRefCopyPadding(result, 32);
        RC4Apply(fileKey, keyLenBytes, result, 32);
        return memcmp(result, uValue, 32) == 0;
    }

    /* Revision 3 */
    if (id0Len > 64)
    {
        id0Len = 64;
    }
    XRefCopyPadding(buf, 32);
    memcpy(&buf[32], id0, id0Len);
    MD5Compute(buf, (word)(32 + id0Len), digest);

    memcpy(result, digest, 16);
    RC4Apply(fileKey, keyLenBytes, result, 16);

    /* 19 more RC4 passes with key XOR round */
    for (round = 1; round <= 19; ++round)
    {
        for (i = 0; i < keyLenBytes; ++i)
        {
            roundKey[i] = fileKey[i] ^ (Guchar)round;
        }
        RC4Apply(roundKey, keyLenBytes, result, 16);
    }

    return memcmp(result, uValue, 16) == 0;
}

/*
 * Everything from the /Encrypt dictionary and the trailer /ID that the
 * password checks need (heap: the process stack is small).
 */
typedef struct CryptParams
{
    Guchar oValue[32];
    Guchar uValue[32];
    Guchar id0[64];
    word id0Len;
    dword perms;
    short revision;
    short keyLenBytes;
    GBool encryptMetadata;
} CryptParams;

/********************************************************************
 *                      XRefPadPassword
 ********************************************************************
 * SYNOPSIS:      Pad or cut a password to 32 bytes (Algorithm 2, step a).
 *
 * PARAMETERS:    *password             Ptr to the password, NULL for the empty
 *                                      password.
 *                *out                  Ptr to the 32-byte result (out).
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void XRefPadPassword(const char *password, Guchar out[32])
{
    word len = 0;

    if (password)
    {
        while (len < 32 && password[len])
        {
            out[len] = (Guchar)password[len];
            ++len;
        }
    }
    XRefCopyPadding(out + len, 32 - len);
}

/********************************************************************
 *                      XRefTryUserPassword
 ********************************************************************
 * SYNOPSIS:      Check a padded password as the user password (Algorithm 6).
 *
 * PARAMETERS:    *cp                   Ptr to the encryption parameters.
 *                *padded               Ptr to the padded password.
 *                *outKey               Ptr to the file key (out).
 *
 * RETURNS:       GBool                 gTrue if the password is correct.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static GBool XRefTryUserPassword(CryptParams *cp, Guchar padded[32],
    Guchar outKey[16])
{
    XRefDeriveFileKey(padded, cp->oValue, cp->perms, cp->id0, cp->id0Len,
        cp->revision, cp->keyLenBytes, cp->encryptMetadata, outKey);
    return XRefCheckUValue(outKey, cp->keyLenBytes, cp->revision,
        cp->id0, cp->id0Len, cp->uValue);
}

/********************************************************************
 *                      XRefTryOwnerPassword
 ********************************************************************
 * SYNOPSIS:      Check a padded password as the owner password (Algorithm 7).
 *
 * PARAMETERS:    *cp                   Ptr to the encryption parameters.
 *                *padded               Ptr to the padded password.
 *                *outKey               Ptr to the file key (out).
 *
 * RETURNS:       GBool                 gTrue if the password is correct.
 *
 * STRATEGY:      Decrypt /O with a key from the owner password; the result is
 *                the user password, which is then checked.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static GBool XRefTryOwnerPassword(CryptParams *cp, Guchar padded[32],
    Guchar outKey[16])
{
    Guchar digest[16];
    Guchar key[16];
    Guchar userPw[32];
    short round, i;

    MD5Compute(padded, 32, digest);
    if (cp->revision >= 3)
    {
        for (round = 0; round < 50; ++round)
        {
            MD5Compute(digest, 16, digest);
        }
    }

    memcpy(userPw, cp->oValue, 32);
    if (cp->revision == 2)
    {
        RC4Apply(digest, cp->keyLenBytes, userPw, 32);
    }
    else
    {
        /* Algorithm 3 f in reverse: keys XORed with 19 down to 0 */
        for (round = 19; round >= 0; --round)
        {
            for (i = 0; i < cp->keyLenBytes; ++i)
            {
                key[i] = digest[i] ^ (Guchar)round;
            }
            RC4Apply(key, cp->keyLenBytes, userPw, 32);
        }
    }

    return XRefTryUserPassword(cp, userPw, outKey);
}

/********************************************************************
 *                      XRefSetupEncryption
 ********************************************************************
 * SYNOPSIS:      Read /Encrypt and authenticate a password.
 *
 * PARAMETERS:    *xref                 Ptr to the cross-reference table.
 *                *password             Ptr to the password, NULL or "" for
 *                                      none.
 *
 * RETURNS:       XRefCryptStatus       CRYPT_OK, CRYPT_BAD_PASSWORD or
 *                                      CRYPT_UNSUPPORTED.
 *
 * STRATEGY:      Only the standard security handler with RC4 (V 1/2, R 2/3) is
 *                supported. The password is tried as user password, then as
 *                owner password; only the owner password lifts the /P
 *                restrictions (xref->ownerAccess).
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
XRefCryptStatus XRefSetupEncryption(XRef *xref, const char *password)
{
    Obj encryptObj, fieldObj, idObj, id0Obj;
    Dict *encryptDict;
    long v, r, p;
    short keyLenBits, keyLenBytes;
    Guchar oValue[32], uValue[32];
    /* Only 16 bytes (an MD5 hash) are usual; longer IDs are cut */
    Guchar id0[64];
    long id0Len;
    GBool encryptMetadata;
    GBool ok;
    Guchar padded[32];
    CryptParams *cp;

    xref->encrypted = gFalse;

    ObjDictLookup(&xref->trailerDict, "Encrypt", &encryptObj, xref);
    if (!isDict(&encryptObj))
    {
        ObjFree(&encryptObj);
        return CRYPT_UNSUPPORTED;
    }
    encryptDict = getDict(&encryptObj);

    DictLookup(encryptDict, "Filter", &fieldObj, xref);
    ok = isName(&fieldObj) && isNameSame(&fieldObj, "Standard");
    ObjFree(&fieldObj);
    if (!ok)
    {
        ObjFree(&encryptObj);
        return CRYPT_UNSUPPORTED;
    }

    DictLookup(encryptDict, "V", &fieldObj, xref);
    v = isInt(&fieldObj) ? getInt(&fieldObj) : 0;
    ObjFree(&fieldObj);
    if (v != 1 && v != 2)
    {
        ObjFree(&encryptObj);
        return CRYPT_UNSUPPORTED;
    }

    DictLookup(encryptDict, "R", &fieldObj, xref);
    r = isInt(&fieldObj) ? getInt(&fieldObj) : 0;
    ObjFree(&fieldObj);
    if (r != 2 && r != 3)
    {
        ObjFree(&encryptObj);
        return CRYPT_UNSUPPORTED;
    }

    DictLookup(encryptDict, "Length", &fieldObj, xref);
    keyLenBits = isInt(&fieldObj) ? getInt(&fieldObj) : 40;
    ObjFree(&fieldObj);
    keyLenBytes = keyLenBits / 8;
    if (keyLenBytes < 5 || keyLenBytes > 16)
    {
        ObjFree(&encryptObj);
        return CRYPT_UNSUPPORTED;
    }

    DictLookup(encryptDict, "O", &fieldObj, xref);
    if (!isString(&fieldObj) || GStrGetLength(getString(&fieldObj)) < 32)
    {
        ObjFree(&fieldObj);
        ObjFree(&encryptObj);
        return CRYPT_UNSUPPORTED;
    }
    memcpy(oValue, GStrGetCString(getString(&fieldObj)), 32);
    ObjFree(&fieldObj);

    DictLookup(encryptDict, "U", &fieldObj, xref);
    if (!isString(&fieldObj) || GStrGetLength(getString(&fieldObj)) < 32)
    {
        ObjFree(&fieldObj);
        ObjFree(&encryptObj);
        return CRYPT_UNSUPPORTED;
    }
    memcpy(uValue, GStrGetCString(getString(&fieldObj)), 32);
    ObjFree(&fieldObj);

    DictLookup(encryptDict, "P", &fieldObj, xref);
    p = isInt(&fieldObj) ? getInt(&fieldObj) : 0;
    ObjFree(&fieldObj);

    DictLookup(encryptDict, "EncryptMetadata", &fieldObj, xref);
    encryptMetadata = isBool(&fieldObj) ? getBool(&fieldObj) : gTrue;
    ObjFree(&fieldObj);

    ObjFree(&encryptObj);

    ObjDictLookup(&xref->trailerDict, "ID", &idObj, xref);
    if (!isArray(&idObj) || ObjArrayGetLength(&idObj) < 1)
    {
        ObjFree(&idObj);
        return CRYPT_UNSUPPORTED;
    }
    ObjArrayGet(&idObj, 0, &id0Obj, xref);
    ObjFree(&idObj);
    if (!isString(&id0Obj))
    {
        ObjFree(&id0Obj);
        return CRYPT_UNSUPPORTED;
    }
    id0Len = GStrGetLength(getString(&id0Obj));
    if (id0Len > 64)
    {
        id0Len = 64;
    }
    memcpy(id0, GStrGetCString(getString(&id0Obj)), id0Len);
    ObjFree(&id0Obj);

    /* The parameters are too large for the stack */
    cp = gmalloc(sizeof(CryptParams));
    if (!cp)
    {
        return CRYPT_UNSUPPORTED;
    }
    memcpy(cp->oValue, oValue, 32);
    memcpy(cp->uValue, uValue, 32);
    memcpy(cp->id0, id0, (word)id0Len);
    cp->id0Len = (word)id0Len;
    cp->perms = (dword)p;
    cp->revision = (short)r;
    cp->keyLenBytes = keyLenBytes;
    cp->encryptMetadata = encryptMetadata;

    /* The password can be the user or the owner password */
    XRefPadPassword(password, padded);
    xref->ownerAccess = gFalse;
    ok = XRefTryUserPassword(cp, padded, xref->fileKey);
    if (!ok)
    {
        /* only the owner password lifts the /P restrictions */
        ok = xref->ownerAccess =
            XRefTryOwnerPassword(cp, padded, xref->fileKey);
    }
    gfree(cp);
    if (!ok)
    {
        return CRYPT_BAD_PASSWORD;
    }

    xref->fileKeyLen = keyLenBytes;
    xref->encryptRevision = (short)r;
    xref->permissions = p;
    xref->encrypted = gTrue;
    return CRYPT_OK;
}

/********************************************************************
 *                      XRefDeriveObjectKey
 ********************************************************************
 * SYNOPSIS:      Compute the RC4 key of one object (Algorithm 1).
 *
 * PARAMETERS:    *xref                 Ptr to the cross-reference table.
 *                num                   Object number.
 *                gen                   Generation number.
 *                *outKey               Ptr to the key (out).
 *                *outKeyLen            Ptr to the key length (out).
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
void XRefDeriveObjectKey(XRef *xref, long num, long gen,
    Guchar outKey[16], short *outKeyLen)
{
    Guchar buf[16 + 5];
    Guchar digest[16];
    short objKeyLen;

    memcpy(buf, xref->fileKey, xref->fileKeyLen);
    buf[xref->fileKeyLen + 0] = (Guchar)(num);
    buf[xref->fileKeyLen + 1] = (Guchar)(num >> 8);
    buf[xref->fileKeyLen + 2] = (Guchar)(num >> 16);
    buf[xref->fileKeyLen + 3] = (Guchar)(gen);
    buf[xref->fileKeyLen + 4] = (Guchar)(gen >> 8);

    MD5Compute(buf, (word)(xref->fileKeyLen + 5), digest);

    objKeyLen = xref->fileKeyLen + 5;
    if (objKeyLen > 16)
    {
        objKeyLen = 16;
    }
    memcpy(outKey, digest, objKeyLen);
    *outKeyLen = objKeyLen;
}


#ifdef __WATCOMC__
#pragma code_seg("GFXImage")
#endif

/********************************************************************
 *                      GfxDrawImageRows
 ********************************************************************
 * SYNOPSIS:      Draw the decoded rows of an image bitmap.
 *
 * PARAMETERS:    gstring               Handle of the GString.
 *                vmFile                VM file of the bitmap.
 *                bitmap                HugeArray of the bitmap.
 *                sampledWidth          Bitmap width.
 *                sampledHeight         Bitmap height.
 *                validRows             Number of complete rows (from the top).
 *                fill                  gTrue: monochrome bitmap, fill its set
 *                                      bits with the area color
 *                                      (GrFillHugeBitmap).
 *
 * RETURNS:       void
 *
 * STRATEGY:      A truncated image is clipped to its complete rows.
 *                GrDrawHugeBitmap and GrFillHugeBitmap copy the bitmap into
 *                the GString: the caller can free it afterwards.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *      11/28/26  Claude/jkunze  Fill mode for stencil masks
 *******************************************************************/
static void GfxDrawImageRows(GStateHandle gstring, VMFileHandle vmFile,
    VMBlockHandle bitmap, word sampledWidth, word sampledHeight,
    word validRows, GBool fill)
{
    GBool clip;

    if (validRows == 0)
    {
        return;
    }
    clip = (validRows < sampledHeight);
    if (clip)
    {
        GrSaveState(gstring);
        GrSetClipRect(gstring, PCT_INTERSECTION,
            0, (sword)(sampledHeight - validRows),
            (sword)sampledWidth, (sword)sampledHeight);
    }
    if (fill)
    {
        GrFillHugeBitmap(gstring, 0, 0, vmFile, bitmap);
    }
    else
    {
        GrDrawHugeBitmap(gstring, 0, 0, vmFile, bitmap);
    }
    if (clip)
    {
        GrRestoreState(gstring);
    }
}

/********************************************************************
 *                      GfxImageMaskStream
 ********************************************************************
 * SYNOPSIS:      Read the size and the parameters of a mask image.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *maskObj              Ptr to the /SMask or /Mask stream
 *                                      object.
 *                *m                    Ptr to the mask data (out); m->str is
 *                                      NULL if the mask is not usable.
 *
 * RETURNS:       void
 *
 * STRATEGY:      A JPEG mask is read at the reduced size of its decoder.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxImageMaskStream(Gfx *gfx, Obj *maskObj, GfxImageMask *m)
{
    Dict *mdict = ObjStreamGetDict(maskObj);
    Obj obj1, obj2;
    long val;

    m->str = NULL;
    m->width = m->height = 0;
    m->bits = 8;
    m->invert = gFalse;

    DictLookup(mdict, "Width", &obj1, gfx->xref);
    val = isInt(&obj1) ? getInt(&obj1) : 0;
    ObjFree(&obj1);
    if (val <= 0 || val > 65535)
    {
        return;
    }
    m->width = (word)val;
    DictLookup(mdict, "Height", &obj1, gfx->xref);
    val = isInt(&obj1) ? getInt(&obj1) : 0;
    ObjFree(&obj1);
    if (val <= 0 || val > 65535)
    {
        return;
    }
    m->height = (word)val;
    DictLookup(mdict, "BitsPerComponent", &obj1, gfx->xref);
    if (isInt(&obj1))
    {
        val = getInt(&obj1);
        if (val == 1 || val == 2 || val == 4 || val == 8 || val == 16)
        {
            m->bits = (short)val;
        }
    }
    ObjFree(&obj1);
    DictLookup(mdict, "ImageMask", &obj1, gfx->xref);
    if (isBool(&obj1) && getBool(&obj1))
    {
        m->bits = 1;
    }
    ObjFree(&obj1);
    DictLookup(mdict, "Decode", &obj1, gfx->xref);
    if (isArray(&obj1))
    {
        ObjArrayGet(&obj1, 0, &obj2, gfx->xref);
        if (isNum(&obj2) && getNum(&obj2) > 0)
        {
            m->invert = gTrue;
        }
        ObjFree(&obj2);
    }
    ObjFree(&obj1);

    m->str = getStream(maskObj);
    if (m->str->kind == strDCT)
    {
        /* JPEG soft mask: decoded at reduced size like any JPEG */
        val = DCTStreamScaleFor(m->width, m->height);
        m->width = (word)(((dword)m->width + val - 1) / val);
        m->height = (word)(((dword)m->height + val - 1) / val);
    }
    if (!StreamResetImage(m->str, m->width, 1, m->bits))
    {
        m->str = NULL;
    }
}

/********************************************************************
 *                      GfxDrawImageMask
 ********************************************************************
 * SYNOPSIS:      Draw a stencil mask (/ImageMask) in the fill color.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *str                  Ptr to the image stream.
 *                width                 Image width.
 *                height                Image height.
 *                invert                gTrue for /Decode [1 0].
 *                inlineImage           gTrue for an inline image.
 *
 * RETURNS:       void
 *
 * STRATEGY:      A monochrome bitmap: GrFillHugeBitmap fills its set bits
 *                with the area color (the fill color, see GfxSetFillRGB).
 *                1 bit per pixel instead of 24 bits plus a 1-bit mask.
 *                /ca is dithered into the bits. Images over 1500 pixels are
 *                sampled. Progress and cancel are checked per row.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      5/21/99   mevissen  Initial Revision
 *      11/28/26  Claude/jkunze  Monochrome bitmap and GrFillHugeBitmap
 *******************************************************************/
static void GfxDrawImageMask(Gfx *gfx, Stream *str, word width, word height,
    GBool invert, GBool inlineImage)
{

    Guchar pixBuf[4];
    word i, j;

    VMBlockHandle bitmap;
    GStateHandle bmState;
    byte *line;
    dword nElements;
    dword bitmapBytes;
    word size;
    Handle gstring = gfx->state->gstring;
    word maskBytes, sx, alpha, dither;
    sdword fa;
    word xSamp, ySamp, xMod, yCount;
    word sampledWidth, sampledHeight, arrayInd;
    GBool useLine;
    GBool dataEnd = gFalse;  /* image data ended early */
    word validRows = 0;      /* complete bitmap rows */
    /* Reverse the invert test */
    invert = !invert;

    if (!StreamResetImage(str, width, 1, 1))
    {
        return;
    }

    if (!inlineImage && gfx->progressCallback)
    {
        GfxReportProgress(gfx, PDF_PROGRESS_IMAGE_BEGIN, 0, height);
    }

    /* Sample images over 1500 pixels, as GfxDrawImage */
    xSamp = width / 1500 + 1;
    ySamp = height / 1500 + 1;

    /* Ceiling division: floor made the bitmap one pixel too small */
    sampledWidth = (word)(((dword)width + xSamp - 1) / xSamp);
    sampledHeight = (word)(((dword)height + ySamp - 1) / ySamp);

    /* PDF image space is a unit square */
    GrSaveTransform(gstring);
    GrApplyScale(gstring,
        (1L << 16) / sampledWidth,
        (1L << 16) / sampledHeight);
    /* Mask: monochrome bitmap, set bits are filled with the fill color */
    fa = (GrMulWWFixed(gfx->state->fillAlpha, IntToGdouble(255)) +
        0x8000L) >> 16;
    alpha = (fa < 0) ? 0 : (fa > 255) ? 255 : (word)fa;
    maskBytes = (sampledWidth + 7) >> 3;
    bitmapBytes = (dword)maskBytes * (dword)sampledHeight;
    if (!GfxCheckPageResourceBudget(gfx, bitmapBytes))
    {
        GrRestoreTransform(gstring);
        if (!inlineImage && gfx->progressCallback)
        {
            GfxReportProgress(gfx, PDF_PROGRESS_IMAGE_END, height, height);
        }
        return;
    }

    bitmap = GrCreateBitmap(BMF_MONO | BMT_COMPLEX,
        sampledWidth,
        sampledHeight,
        gfx->vmFile,
        0,
        &bmState);

    if (!bitmap)
    {
        gfx->resourceLimitExceeded = gTrue;
        GrRestoreTransform(gstring);
        if (!inlineImage && gfx->progressCallback)
        {
            GfxReportProgress(gfx, PDF_PROGRESS_IMAGE_END, height, height);
        }
        return;
    }

    GrDestroyBitmap(bmState, BMD_LEAVE_DATA);

    /* account the pixel payload; the GString keeps a copy (see below) */
    if (bitmap)
    {
        gfx->pageResourceBytes += bitmapBytes;
    }

    if (bitmap)
    {
        arrayInd = sampledHeight;
        yCount = 0;
        for (i = 0; i < height; ++i)
        {
            /* PDF y goes up the page: flip the rows */
            useLine = (yCount == 0);
            if (++yCount == ySamp)
            {
                yCount = 0;
            }
            if (useLine)
            {
                arrayInd--;
                nElements = HugeArrayLock(gfx->vmFile,
                    bitmap,
                    arrayInd,
                    (void **) & line,
                    &size);
            }
            else
            {
                nElements = 0;
            }
            if (nElements & 0xffff0000)
            {
                /* All bits clear: nothing is painted */
                EC_ERROR_IF(size < maskBytes, -1);
                memset(line, 0, maskBytes);
            }

            xMod = 0;
            sx = 0;
            for (j = 0; j < width; ++j)
            {

                /* Check the cancel flag also within a row */
                if ((j & 0xff) == 0 && gfx->cancelFlag && *gfx->cancelFlag)
                {
                    break;
                }

                if (StreamGetImagePixel(str, pixBuf) == EOF)
                {
                    dataEnd = gTrue;
                    break;
                }

                if (nElements & 0xffff0000 && xMod == 0)
                {

                    /* Source bit XOR invert selects the painted pixels */
                    /* 4x4 ordered dither threshold for /ca, 8 .. 248 */
                    dither = sx ^ arrayInd;
                    dither = ((dither & 1) << 3) | ((arrayInd & 1) << 2) |
                        (dither & 2) | ((arrayInd & 2) >> 1);
                    if (((pixBuf[0] & 1) ^ (invert ? 1 : 0)) &&
                        alpha > (dither << 4) + 8)
                    {
                        line[sx >> 3] |= (byte)(0x80 >> (sx & 7));
                    }
                    ++sx;
                }
                if (++xMod == xSamp)
                {
                    xMod = 0;
                }
            }

            if (nElements & 0xffff0000)
            {
                HugeArrayDirty(line);
                HugeArrayUnlock(line);
            }
            if (dataEnd)
            {
                break;
            }
            if (useLine)
            {
                ++validRows;
            }
            /* Progress every 32 rows */
            if (!(i & 0x1f))
            {
                if (gfx->progressCallback)
                {
                    GfxReportProgress(gfx, PDF_PROGRESS_IMAGE_UPDATE, i, height);
                }
            }
            if (gfx->cancelFlag && *gfx->cancelFlag)
            {
                break;
            }
        }
    }
    if (bitmap && !(gfx->cancelFlag && *gfx->cancelFlag))
    {
        if (alpha < 255)
        {
            /* /ca is in the bitmap mask, not the area mask */
            GrSetAreaMaskSys(gstring, SDM_100);
        }
        GfxDrawImageRows(gstring, gfx->vmFile, bitmap, sampledWidth,
            sampledHeight, validRows, gTrue);
        if (alpha < 255)
        {
            GrSetAreaMaskSys(gstring, GfxAlphaMask(gfx->state->fillAlpha));
        }
    }
    if (bitmap)
    {
        /* the GString holds a copy now, see GfxDrawImageRows */
        HugeArrayDestroy(gfx->vmFile, bitmap);
    }
    GrRestoreTransform(gstring);
    if (!inlineImage && gfx->progressCallback)
    {
        GfxReportProgress(gfx, PDF_PROGRESS_IMAGE_END, height, height);
    }
}

/********************************************************************
 *                      GfxImageRowToRGB
 ********************************************************************
 * SYNOPSIS:      Convert one row of 8-bit samples to RGB.
 *
 * PARAMETERS:    *cm                   Ptr to the color map.
 *                *src                  Ptr to the samples.
 *                *dst                  Ptr to the RGB row (out).
 *                count                 Number of pixels to write.
 *                xSamp                 Sample step (1 = every pixel).
 *                nComps                Components per pixel.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Indexed lookup, gray to RGB or RGB copy (fast path of
 *                GfxDrawImage).
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      11/25/26  JK        Initial version
 *******************************************************************/
static void GfxImageRowToRGB(GfxImageColorMap *cm, Guchar *src, byte *dst,
    word count, word xSamp, short nComps)
{
    word step = xSamp * nComps;
    short *p;

    EC(ECCheckBounds(src));
    EC(ECCheckBounds(dst));

    if (cm->indexed)
    {
        while (count--)
        {
            p = cm->lookup[*src];
            dst[0] = (byte)p[0];
            dst[1] = (byte)p[1];
            dst[2] = (byte)p[2];
            dst += 3;
            src += step;
        }
    }
    else if (nComps == 1)
    {
        while (count--)
        {
            dst[0] = dst[1] = dst[2] = *src;
            dst += 3;
            src += step;
        }
    }
    else if (xSamp == 1)
    {
        memcpy(dst, src, count * 3);
    }
    else
    {
        while (count--)
        {
            dst[0] = src[0];
            dst[1] = src[1];
            dst[2] = src[2];
            dst += 3;
            src += step;
        }
    }
}

/********************************************************************
 *                      GfxDrawImage
 ********************************************************************
 * SYNOPSIS:      Decode an image into a bitmap and draw it.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *str                  Ptr to the image stream.
 *                width                 Image width.
 *                height                Image height.
 *                *colorMap             Ptr to the color map.
 *                inlineImage           gTrue for an inline image.
 *                *m                    Ptr to the mask data (soft mask, stencil
 *                                      or color key).
 *
 * RETURNS:       void
 *
 * STRATEGY:      Images over 1500 pixels are sampled; large JPEGs are read at
 *                the reduced decoder size. 8-bit gray, RGB and Indexed images
 *                without mask are read row by row (fast path), others pixel by
 *                pixel. With a mask the bitmap gets a 1-bit mask (partial alpha
 *                dithered). The bitmap is freed after it is copied into the
 *                GString.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      5/17/99   mevissen  Initial Revision
 *      11/24/26  JK        Bitmap mask for /SMask, /Mask, /ca
 *******************************************************************/
static void GfxDrawImage(Gfx *gfx, Stream *str, word width, word height,
    GfxImageColorMap *colorMap, GBool inlineImage, GfxImageMask *m)
{

    Guchar pixBuf[4];
    Guchar maskPixBuf[4];
    Guchar *maskRowBuf;
    long maskRowLoaded;
    long maskTargetRow;
    word maskCol;
    long maskAccum;
    word alpha, fillAlpha, dither;
    short nComps, nBits, k;
    GfxColor color;
    word i, j;
    word sampledWidth, sampledHeight, arrayInd;
    VMBlockHandle bitmap;
    GStateHandle bmState;
    byte *line;
    byte *maskLine;
    dword nElements;
    dword bitmapBytes;
    word size;
    Handle gstring = gfx->state->gstring;
    word xSamp, ySamp, xMod, yCount;
    word maskBytes, sx;
    GBool useLine, useMask;
    GBool dataEnd = gFalse;  /* image data ended early */
    word validRows = 0;      /* complete bitmap rows */
    GBool fastRows;          /* whole rows through StreamRead */
    word n;

    /* Sample images over 1500 pixels (some pages are one image) */
    xSamp = width / 1500 + 1;
    ySamp = height / 1500 + 1;

    /* Ceiling division, as in GfxDrawImageMask */
    sampledWidth = (word)(((dword)width + xSamp - 1) / xSamp);
    sampledHeight = (word)(((dword)height + ySamp - 1) / ySamp);

    nComps = GfxImageColorMapGetNumPixelComps(colorMap);
    nBits = GfxImageColorMapGetBits(colorMap);

    /* Large JPEGs: use the reduced size the decoder delivers */
    if (str->kind == strDCT)
    {
        k = (short)DCTStreamScaleFor(width, height);
        width = (word)(((dword)width + k - 1) / k);
        height = (word)(((dword)height + k - 1) / k);
        xSamp = width / 1500 + 1;
        ySamp = height / 1500 + 1;
        sampledWidth = (word)(((dword)width + xSamp - 1) / xSamp);
        sampledHeight = (word)(((dword)height + ySamp - 1) / ySamp);
    }

    /* constant fill alpha 0..255 */
    {
        sdword fa = (GrMulWWFixed(gfx->state->fillAlpha,
            IntToGdouble(255)) + 0x8000L) >> 16;
        fillAlpha = (fa < 0) ? 0 : (fa > 255) ? 255 : (word)fa;
    }
    if (m->nKey > nComps)
    {
        m->nKey = 0;
    }
    useMask = (m->str != NULL || m->nKey > 0 || fillAlpha < 255);
    maskBytes = useMask ? ((sampledWidth + 7) >> 3) : 0;

    /* Fast path: 8-bit Gray/RGB (default /Decode) or Indexed, no mask */
    fastRows = (nBits == 8 && !useMask &&
        !colorMap->colorSpace->hasFunction &&
        ((colorMap->indexed && nComps == 1) ||
         (colorMap->isIdentity &&
          ((colorMap->mode == colorRGB && nComps == 3) ||
           (colorMap->mode == colorGray && nComps == 1)))));

    /* Mask row buffer: one decoded row at a time */
    maskRowBuf = NULL;
    maskRowLoaded = -1;
    maskAccum = 0;
    maskTargetRow = 0;
    if (m->str)
    {
        maskRowBuf = gmalloc(m->width);
        if (!maskRowBuf)
        {
            return;
        }
    }

    if (!StreamResetImage(str, width, nComps, nBits))
    {
        gfree(maskRowBuf);
        return;
    }
    if (!inlineImage && gfx->progressCallback)
    {
        GfxReportProgress(gfx, PDF_PROGRESS_IMAGE_BEGIN, 0, height);
    }

    /* PDF image space is a unit square */
    GrSaveTransform(gstring);
    GrApplyScale(gstring,
        (1L << 16) / sampledWidth,
        (1L << 16) / sampledHeight);

    bitmapBytes = ((dword)sampledWidth * 3UL + maskBytes) *
        (dword)sampledHeight;

    bitmap = NullHandle;
    if (GfxCheckPageResourceBudget(gfx, bitmapBytes))
    {
        bitmap = GrCreateBitmap(BMF_24BIT | BMT_COMPLEX |
            (useMask ? BMT_MASK : 0),
            sampledWidth,
            sampledHeight,
            gfx->vmFile,
            0,
            &bmState);
        if (bitmap)
        {
            GrDestroyBitmap(bmState, BMD_LEAVE_DATA);
            /* account the pixel payload; the GString keeps a copy */
            gfx->pageResourceBytes += bitmapBytes;
        }
        else
        {
            gfx->resourceLimitExceeded = gTrue;
        }
    }

    if (bitmap)
    {
        arrayInd = sampledHeight;
        yCount = 0;
        for (i = 0; i < height; ++i)
        {
            /* PDF y goes up the page: flip the rows */
            useLine = (yCount == 0);
            if (++yCount == ySamp)
            {
                yCount = 0;
            }
            if (useLine)
            {
                arrayInd--;
            }

            if (m->str)
            {
                if (m->height == height)
                {
                    maskTargetRow = i;
                }

                while (maskRowLoaded < maskTargetRow)
                {
                    for (maskCol = 0; maskCol < m->width; ++maskCol)
                    {
                        StreamGetImagePixel(m->str, maskPixBuf);
                        switch (m->bits)
                        {
                            case 1:
                                alpha = maskPixBuf[0] ? 255 : 0;
                                break;
                            case 2:
                                alpha = maskPixBuf[0] * 85;
                                break;
                            case 4:
                                alpha = maskPixBuf[0] * 17;
                                break;
                            default:
                                alpha = maskPixBuf[0];
                                break;
                        }
                        maskRowBuf[maskCol] = (Guchar)(m->invert ?
                            255 - alpha : alpha);
                    }
                    ++maskRowLoaded;
                }

                if (m->height != height)
                {
                    maskAccum += m->height;
                    while (maskAccum >= (long)height)
                    {
                        maskAccum -= height;
                        ++maskTargetRow;
                    }
                }
            }
            if (useLine)
            {
                nElements = HugeArrayLock(gfx->vmFile,
                    bitmap, arrayInd, (void **) & line, &size);
            }
            else
            {
                nElements = 0;
            }
            maskLine = line;
            if (nElements & 0xffff0000)
            {
                if (maskBytes)
                {
                    memset(maskLine, 0, maskBytes);
                    line += maskBytes;
                }
            }

            xMod = 0;
            sx = 0;

            if (fastRows)
            {
                /* the row buffer of StreamResetImage holds one raw row */
                n = StreamRead(str, str->rawLine, str->rowBytes);
                if (n == 0)
                {
                    dataEnd = gTrue;
                }
                else
                {
                    if (n < str->rowBytes)
                    {
                        /* truncated image data -- fill the rest of the row */
                        memset(str->rawLine + n, 0, str->rowBytes - n);
                    }
                    if (nElements & 0xffff0000)
                    {
                        GfxImageRowToRGB(colorMap, str->rawLine, line,
                            sampledWidth, xSamp, nComps);
                    }
                }
                j = width;          /* skip the per pixel loop */
            }
            else
            {
                j = 0;
            }

            for (; j < width; ++j)
            {

                /* Check the cancel flag also within a row */
                if ((j & 0xff) == 0 && gfx->cancelFlag && *gfx->cancelFlag)
                {
                    break;
                }

                if (StreamGetImagePixel(str, pixBuf) == EOF)
                {
                    dataEnd = gTrue;
                    break;
                }
                /* Transfer the pixel if the line is locked and sampled */
                if (nElements & 0xffff0000 &&
                    (xMod == 0))
                {

                    GfxImageColorMapGetColor(colorMap, pixBuf, &color);
                    *line++ = (byte)color.r;
                    *line++ = (byte)color.g;
                    *line++ = (byte)color.b;

                    if (useMask)
                    {
                        alpha = fillAlpha;
                        if (m->str)
                        {
                            maskCol = (m->width == width) ? j : (word)
                                ((long)j * m->width / width);
                            alpha = (word)(((word)maskRowBuf[maskCol] *
                                alpha + 127) / 255);
                        }
                        if (m->nKey)
                        {
                            for (k = 0; k < m->nKey; ++k)
                            {
                                if (pixBuf[k] < m->keyMin[k] ||
                                    pixBuf[k] > m->keyMax[k])
                                {
                                    break;
                                }
                            }
                            if (k == m->nKey)
                            {
                                alpha = 0;
                            }
                        }
                        /* 4x4 ordered dither threshold, 8 .. 248 */
                        dither = sx ^ arrayInd;
                        dither = ((dither & 1) << 3) | ((arrayInd & 1) << 2) |
                            (dither & 2) | ((arrayInd & 2) >> 1);
                        if (alpha > (dither << 4) + 8)
                        {
                            maskLine[sx >> 3] |= (byte)(0x80 >> (sx & 7));
                        }
                    }
                    ++sx;
                }
                if (++xMod == xSamp)
                {
                    xMod = 0;
                }
            }
            if (nElements & 0xffff0000)
            {
                HugeArrayDirty(maskLine);
                HugeArrayUnlock(maskLine);
            }
            if (dataEnd)
            {
                break;
            }
            if (useLine)
            {
                ++validRows;
            }
            /* Progress every 32 rows */
            if (!(i & 0x1f))
            {
                if (gfx->progressCallback)
                {
                    GfxReportProgress(gfx, PDF_PROGRESS_IMAGE_UPDATE, i, height);
                }
            }
            if (gfx->cancelFlag && *gfx->cancelFlag)
            {
                break;
            }
        }
    }
    if (bitmap && !(gfx->cancelFlag && *gfx->cancelFlag))
    {
        if (fillAlpha < 255)
        {
            /* /ca is in the bitmap mask, not the area mask */
            GrSetAreaMaskSys(gstring, SDM_100);
        }
        GfxDrawImageRows(gstring, gfx->vmFile, bitmap, sampledWidth,
            sampledHeight, validRows, gFalse);
        if (fillAlpha < 255)
        {
            GrSetAreaMaskSys(gstring, GfxAlphaMask(gfx->state->fillAlpha));
        }
    }
    GrRestoreTransform(gstring);
    if (!inlineImage && gfx->progressCallback)
    {
        GfxReportProgress(gfx, PDF_PROGRESS_IMAGE_END, height, height);
    }
    if (bitmap)
    {
        /* the GString holds a copy now, see GfxDrawImageRows */
        HugeArrayDestroy(gfx->vmFile, bitmap);
    }
    if (maskRowBuf)
    {
        gfree(maskRowBuf);
    }
}

/*
 * Stroking: GrDrawPath strokes every path element on its own
 * (kernel StrokePath), so line joins and the miter limit never apply
 * between two lineto segments, and a polyline in a kernel path would be
 * closed automatically by the next moveto. The fill/clip path is still
 * built in the kernel; for stroking the segments are also recorded here
 * and drawn directly: runs of lines as one polyline, closed subpaths of
 * lines as a polygon, curves as GrDrawCurve. If the buffer overflows,
 * GrDrawPath strokes as before.
 */
#pragma code_seg("GFXPath")

#define GFX_PATH_MAX 256

typedef struct
{
    word count;
    GBool overflow;
    Point pts[GFX_PATH_MAX];
    byte types[GFX_PATH_MAX];
} GfxPathBuf;

/********************************************************************
 *                      GfxPathReset
 ********************************************************************
 * SYNOPSIS:      Start recording a new path.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *
 * RETURNS:       void
 *
 * STRATEGY:      The path buffer is allocated on the first use; without memory
 *                GfxStrokePath uses GrDrawPath.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxPathReset(Gfx *gfx)
{
    GfxPathBuf *buf = (GfxPathBuf *)gfx->pathBuf;

    if (!buf)
    {
        buf = gmalloc(sizeof(GfxPathBuf));
        gfx->pathBuf = buf;
        if (!buf)
        {
            return;             /* GfxStrokePath falls back */
        }
    }
    buf->count = 0;
    buf->overflow = gFalse;
}

/********************************************************************
 *                      GfxPathAdd
 ********************************************************************
 * SYNOPSIS:      Record one point of the current path.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                type                  GFX_SEG_MOVE, GFX_SEG_LINE or
 *                                      GFX_SEG_CLOSE.
 *                x                     x.
 *                y                     y.
 *
 * RETURNS:       void
 *
 * STRATEGY:      A full buffer sets the overflow flag.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxPathAdd(Gfx *gfx, byte type, sword x, sword y)
{
    GfxPathBuf *buf = (GfxPathBuf *)gfx->pathBuf;

    if (!buf || buf->overflow)
    {
        return;
    }
    if (buf->count >= GFX_PATH_MAX)
    {
        buf->overflow = gTrue;
        return;
    }
    buf->pts[buf->count].P_x = x;
    buf->pts[buf->count].P_y = y;
    buf->types[buf->count] = type;
    ++buf->count;
}

/********************************************************************
 *                      GfxPathAddCurve
 ********************************************************************
 * SYNOPSIS:      Record a Bezier curve (three points).
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *p                    Ptr to the control points and the end
 *                                      point.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxPathAddCurve(Gfx *gfx, const Point *p)
{
    GfxPathAdd(gfx, GFX_SEG_CURVE, p[0].P_x, p[0].P_y);
    GfxPathAdd(gfx, GFX_SEG_CURVE, p[1].P_x, p[1].P_y);
    GfxPathAdd(gfx, GFX_SEG_CURVE, p[2].P_x, p[2].P_y);
}

/********************************************************************
 *                      GfxPathClose
 ********************************************************************
 * SYNOPSIS:      Close the current subpath in the kernel path and in the
 *                buffer.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxPathClose(Gfx *gfx)
{
    GfxState *state = gfx->state;

    if (state->pathSubpathStartValid)
    {
        GrDrawLineTo(state->gstring, state->pathSubpathStartX,
            state->pathSubpathStartY);
        GrCloseSubPath(state->gstring);
        GfxPathAdd(gfx, GFX_SEG_CLOSE, state->pathSubpathStartX,
            state->pathSubpathStartY);
    }
}

/********************************************************************
 *                      GfxStrokePath
 ********************************************************************
 * SYNOPSIS:      Stroke the recorded path.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Lines as one polyline, closed line subpaths as a polygon,
 *                curves with GrDrawCurve: so the line joins and the miter limit
 *                apply. On overflow use GrDrawPath.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      11/23/26  JK        Initial version
 *******************************************************************/
static void GfxStrokePath(Gfx *gfx)
{
    GfxPathBuf *buf = (GfxPathBuf *)gfx->pathBuf;
    Handle gstring = gfx->state->gstring;
    word i, j, k, m, n;
    GBool closed, allLines;
    Point *pts;

    if (!buf || buf->overflow || buf->count == 0)
    {
        GrDrawPath(gstring);
        return;
    }
    pts = buf->pts;

    i = 0;
    while (i < buf->count)
    {
        /* subpath: anchor i, segments i+1 .. j-1 */
        allLines = gTrue;
        for (j = i + 1; j < buf->count && buf->types[j] != GFX_SEG_MOVE &&
            buf->types[j] != GFX_SEG_CLOSE; ++j)
        {
            if (buf->types[j] == GFX_SEG_CURVE)
            {
                allLines = gFalse;
            }
        }
        closed = (j < buf->count && buf->types[j] == GFX_SEG_CLOSE);
        n = j - i;                      /* points including the anchor */

        if (closed && allLines && n >= 3)
        {
            if (pts[j - 1].P_x == pts[i].P_x && pts[j - 1].P_y == pts[i].P_y)
            {
                --n;                    /* explicit line back to start */
            }
            GrDrawPolygon(gstring, &pts[i], n);
        }
        else if (n >= 2)
        {
            k = i;
            while (k + 1 < j)
            {
                if (buf->types[k + 1] == GFX_SEG_LINE)
                {
                    for (m = k + 1; m + 1 < j &&
                        buf->types[m + 1] == GFX_SEG_LINE; ++m)
                    {
                    }
                    GrDrawPolyline(gstring, &pts[k], m - k + 1);
                    k = m;
                }
                else if (k + 3 < j)
                {
                    GrDrawCurve(gstring, &pts[k]);
                    k += 3;
                }
                else
                {
                    break;              /* incomplete curve */
                }
            }
            if (closed && (pts[j - 1].P_x != pts[i].P_x ||
                pts[j - 1].P_y != pts[i].P_y))
            {
                GrDrawLine(gstring, pts[j - 1].P_x, pts[j - 1].P_y,
                    pts[i].P_x, pts[i].P_y);
            }
        }
        i = j;                  /* CLOSE entry anchors the next subpath */
    }
}

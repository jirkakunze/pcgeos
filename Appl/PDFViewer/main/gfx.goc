/* path segment operators */

/***********************************************************************
 *      opMoveTo
 ***********************************************************************
 * SYNOPSIS:        Move to.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opMoveTo(Gfx *gfx, Obj args[], int numArgs)
{
    Handle gstring = gfx->state->gstring;
    gdouble x, y;
    sword pathX, pathY;

    x = getNum(&args[0]);
    y = getNum(&args[1]);
    pathX = GdoubleToWordRounded(x);
    pathY = GdoubleToWordRounded(y);

    if (gfx->state->pathType != PATH_NORMAL)
    {
        GrBeginPath(gstring, PCT_REPLACE); /* new path */
        gfx->state->pathType = PATH_NORMAL;
        gfx->state->pathRawBoundsValid = gFalse;
    }
    GfxUpdatePathBounds(gfx->state, x, y);
    gfx->state->pathSubpathStartX = pathX;
    gfx->state->pathSubpathStartY = pathY;
    gfx->state->pathSubpathStartValid = gTrue;
    GrMoveTo(gstring, pathX, pathY);
    GrDrawLineTo(gstring, pathX, pathY);
    (void)numArgs;
}

/***********************************************************************
 *      opLineTo
 ***********************************************************************
 * SYNOPSIS:        Process op line to.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opLineTo(Gfx *gfx, Obj args[], int numArgs)
{
    gdouble x, y;

    x = getNum(&args[0]);
    y = getNum(&args[1]);
    GfxUpdatePathBounds(gfx->state, x, y);
    GrDrawLineTo(gfx->state->gstring,
        GdoubleToWordRounded(x),
        GdoubleToWordRounded(y));
    (void)numArgs;
}

/***********************************************************************
 *      opCurveTo
 ***********************************************************************
 * SYNOPSIS:        Process op curve to.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opCurveTo(Gfx *gfx, Obj args[], int numArgs)
{
    Point p[3];
    Handle gstring = gfx->state->gstring;

    p[0].P_x = GdoubleToWordRounded(getNum(&args[0]));
    p[0].P_y = GdoubleToWordRounded(getNum(&args[1]));
    p[1].P_x = GdoubleToWordRounded(getNum(&args[2]));
    p[1].P_y = GdoubleToWordRounded(getNum(&args[3]));
    p[2].P_x = GdoubleToWordRounded(getNum(&args[4]));
    p[2].P_y = GdoubleToWordRounded(getNum(&args[5]));

    GfxUpdatePathBounds(gfx->state, getNum(&args[0]), getNum(&args[1]));
    GfxUpdatePathBounds(gfx->state, getNum(&args[2]), getNum(&args[3]));
    GfxUpdatePathBounds(gfx->state, getNum(&args[4]), getNum(&args[5]));

    GrDrawCurveTo(gstring, p);
    (void)numArgs;
}

/***********************************************************************
 *      opCurveTo1
 ***********************************************************************
 * SYNOPSIS:        Process op curve to1.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opCurveTo1(Gfx *gfx, Obj args[], int numArgs)
{
    Point p[3];
    XYValueAsDWord curPos;
    Handle gstring = gfx->state->gstring;

    curPos = GrGetCurPos(gstring);

    p[0].P_x = (curPos & 0xffff);
    p[0].P_y = (curPos >> 16);
    p[1].P_x = GdoubleToWordRounded(getNum(&args[0]));
    p[1].P_y = GdoubleToWordRounded(getNum(&args[1]));
    p[2].P_x = GdoubleToWordRounded(getNum(&args[2]));
    p[2].P_y = GdoubleToWordRounded(getNum(&args[3]));

    /* Only args[0..3] are fresh PDF coordinates for raw bounds. */
    GfxUpdatePathBounds(gfx->state, getNum(&args[0]), getNum(&args[1]));
    GfxUpdatePathBounds(gfx->state, getNum(&args[2]), getNum(&args[3]));

    GrDrawCurveTo(gstring, p);
    (void)numArgs;
}

/***********************************************************************
 *      opCurveTo2
 ***********************************************************************
 * SYNOPSIS:        Process op curve to2.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opCurveTo2(Gfx *gfx, Obj args[], int numArgs)
{
    Point p[3];
    Handle gstring = gfx->state->gstring;

    p[0].P_x = GdoubleToWordRounded(getNum(&args[0]));
    p[0].P_y = GdoubleToWordRounded(getNum(&args[1]));
    p[2].P_x = p[1].P_x = GdoubleToWordRounded(getNum(&args[2]));
    p[2].P_y = p[1].P_y = GdoubleToWordRounded(getNum(&args[3]));

    GfxUpdatePathBounds(gfx->state, getNum(&args[0]), getNum(&args[1]));
    GfxUpdatePathBounds(gfx->state, getNum(&args[2]), getNum(&args[3]));

    GrDrawCurveTo(gstring, p);
    (void)numArgs;
}

/***********************************************************************
 *      opRectangle
 ***********************************************************************
 * SYNOPSIS:        Process op rectangle.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opRectangle(Gfx *gfx, Obj args[], int numArgs)
{
    sword x, y, x2, y2;
    Handle gstring = gfx->state->gstring;
    gdouble x0, y0, w0, h0;

    x0 = getNum(&args[0]);
    y0 = getNum(&args[1]);
    w0 = getNum(&args[2]);
    h0 = getNum(&args[3]);

    if (gfx->state->pathType != PATH_NORMAL)
    {
        GrBeginPath(gstring, PCT_REPLACE); /* new path */
        gfx->state->pathType = PATH_NORMAL;
        gfx->state->pathRawBoundsValid = gFalse;
    }

    GfxUpdatePathBounds(gfx->state, x0, y0);
    GfxUpdatePathBounds(gfx->state, x0 + w0, y0 + h0);

    x = GdoubleToWordRounded(x0);
    y = GdoubleToWordRounded(y0);
    x2 = x + GdoubleToWordRounded(w0);
    y2 = y + GdoubleToWordRounded(h0);

    if (w0 > 0)
    {
        --x2;
    }
    else if (w0 < 0)
    {
        ++x2;
    }

    if (h0 > 0)
    {
        --y2;
    }
    else if (h0 < 0)
    {
        ++y2;
    }

    GrDrawRect(gstring, x, y, x2, y2);

    gfx->state->pathSubpathStartValid = gFalse;
    (void)numArgs;
}

/***********************************************************************
 *      opClosePath
 ***********************************************************************
 * SYNOPSIS:        Close path.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opClosePath(Gfx *gfx, Obj args[], int numArgs)
{
    if (gfx->state->pathSubpathStartValid)
    {
        GrDrawLineTo(gfx->state->gstring,
            gfx->state->pathSubpathStartX,
            gfx->state->pathSubpathStartY);
        GrCloseSubPath(gfx->state->gstring);
    }
    (void)args;
    (void)numArgs;
}

/* path painting operators */

/***********************************************************************
 *      opEndPath
 ***********************************************************************
 * SYNOPSIS:        End path.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opEndPath(Gfx *gfx, Obj args[], int numArgs)
{
    doEndPath(gfx->state);
    (void)args;
    (void)numArgs;
}

/***********************************************************************
 *      opStroke
 ***********************************************************************
 * SYNOPSIS:        Process op stroke.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opStroke(Gfx *gfx, Obj args[], int numArgs)
{
    if (doEndPath(gfx->state))
    {
        GrDrawPath(gfx->state->gstring);
    }
    (void)args;
    (void)numArgs;
}

/***********************************************************************
 *      opCloseStroke
 ***********************************************************************
 * SYNOPSIS:        Close stroke.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opCloseStroke(Gfx *gfx, Obj args[], int numArgs)
{
    Handle gstring = gfx->state->gstring;

    if (gfx->state->pathSubpathStartValid)
    {
        GrDrawLineTo(gstring, gfx->state->pathSubpathStartX,
            gfx->state->pathSubpathStartY);
        GrCloseSubPath(gstring);
    }
    if (doEndPath(gfx->state))
    {
        GrDrawPath(gstring);
    }
    (void)args;
    (void)numArgs;
}

/***********************************************************************
 *      GfxFillWithMinThickness
 ***********************************************************************
 * SYNOPSIS:        Fill with min thickness.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  RegionFillRule rule    rule
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/
static GBool
GfxFillWithMinThickness(Gfx *gfx, RegionFillRule rule)
{
    GfxState *state = gfx->state;
    Handle gstring = state->gstring;
    gdouble rawW, rawH;
    sword minX, minY, maxX, maxY;
    GBool collapsedX, collapsedY;

    if (!state->pathRawBoundsValid)
    {
        return gFalse;
    }

    rawW = state->pathRawMaxX - state->pathRawMinX;
    rawH = state->pathRawMaxY - state->pathRawMinY;

    minX = GdoubleToWordRounded(state->pathRawMinX);
    maxX = GdoubleToWordRounded(state->pathRawMaxX);
    minY = GdoubleToWordRounded(state->pathRawMinY);
    maxY = GdoubleToWordRounded(state->pathRawMaxY);

    /*
     * Only step in when rounding would collapse a dimension that had genuine
     * (not already-zero) extent.
     */
    collapsedX = (maxX == minX) && (rawW > 0.01);
    collapsedY = (maxY == minY) && (rawH > 0.01);

    if (!collapsedX && !collapsedY)
    {
        return gFalse;
    }

    if (collapsedX)
    {
        maxX = minX + 1;
    }
    if (collapsedY)
    {
        maxY = minY + 1;
    }

    /*
     * Properly end whatever (degenerate) path is still open from the preceding
     * opMoveTo/opLineTo calls -- those never got a matching GrEndPath .
     */
    GrEndPath(gstring);
    GrBeginPath(gstring, PCT_REPLACE);
    GrMoveTo(gstring, minX, minY);
    GrDrawLineTo(gstring, maxX, minY);
    GrDrawLineTo(gstring, maxX, maxY);
    GrDrawLineTo(gstring, minX, maxY);
    GrDrawLineTo(gstring, minX, minY);
    GrCloseSubPath(gstring);
    GrEndPath(gstring);
    GrFillPath(gstring, rule);

    state->pathType = PATH_NONE;
    state->pathSubpathStartValid = gFalse;
    return gTrue;
}

/***********************************************************************
 *      opFill
 ***********************************************************************
 * SYNOPSIS:        Fill.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opFill(Gfx *gfx, Obj args[], int numArgs)
{

    if (gfx->state->pathSubpathStartValid)
    {
        GrDrawLineTo(gfx->state->gstring, gfx->state->pathSubpathStartX,
            gfx->state->pathSubpathStartY);
    }
    if (GfxFillWithMinThickness(gfx, WINDING))
    {
        return;
    }
    if (doEndPath(gfx->state))
    {
        GrFillPath(gfx->state->gstring, WINDING);
    }
    (void)args;
    (void)numArgs;
}

/***********************************************************************
 *      opEOFill
 ***********************************************************************
 * SYNOPSIS:        Process op eofill.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args

    (void)numArgs;
}

/***********************************************************************
 *      opSetFont
 ***********************************************************************
 * SYNOPSIS:        Set font.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void

/********************************************************************
 *                      opSetExtGState
 ********************************************************************
 * SYNOPSIS:      Operator gs: apply an ExtGState resource.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:      ca and CA become dither masks (the background shows through).
 *                Line parameters and /Font are set by GfxExtGStateLineParams.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opSetExtGState(Gfx *gfx, Obj args[], int numArgs)
{
    Obj gsObj, fieldObj;
    word mask;

    if (numArgs < 1 || !isName(&args[0]))
    {
        return;
    }
    GfxLookupExtGState(gfx, getName(&args[0]), &gsObj);
    if (!isDict(&gsObj))
    {
        GfxObjFree(&gsObj);
        return;
    }

    /* constant alpha: dither masks (GfxAlphaMask), saved with q/Q */
    DictLookup(getDict(&gsObj), "ca", &fieldObj, gfx->xref);
    if (isNum(&fieldObj))
    {
        gfx->state->fillAlpha = getNum(&fieldObj);
        mask = GfxAlphaMask(gfx->state->fillAlpha);
        GrSetAreaMaskSys(gfx->state->gstring, mask);
        GrSetTextMaskSys(gfx->state->gstring, mask);
    }
    GfxObjFree(&fieldObj);

    DictLookup(getDict(&gsObj), "CA", &fieldObj, gfx->xref);
    if (isNum(&fieldObj))
    {
        gfx->state->strokeAlpha = getNum(&fieldObj);
        GrSetLineMaskSys(gfx->state->gstring,
            GfxAlphaMask(gfx->state->strokeAlpha));
    }
    GfxObjFree(&fieldObj);

    GfxExtGStateLineParams(gfx, getDict(&gsObj));

    GfxObjFree(&gsObj);
}

/********************************************************************
 *                      GfxExtGStateLineParams
 ********************************************************************
 * SYNOPSIS:      Apply /LW, /LC, /LJ, /ML, /D and /Font of an ExtGState.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *gs                   Ptr to the ExtGState dictionary.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Call the operator functions with the values (same checks).
 *                /Font must be a font of the /Font resources.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      11/23/26  JK        Initial version
 *******************************************************************/
static void _near GfxExtGStateLineParams(Gfx *gfx, Dict *gs)
{
    Obj fieldObj;
    Obj args[2];
    GfxResources *resPtr;
    GfxFont *font;

    DictLookup(gs, "LW", &fieldObj, gfx->xref);
    if (isNum(&fieldObj))
    {
        opSetLineWidth(gfx, &fieldObj, 1);
    }
    GfxObjFree(&fieldObj);

    DictLookup(gs, "LC", &fieldObj, gfx->xref);
    if (isInt(&fieldObj) && getInt(&fieldObj) >= 0 && getInt(&fieldObj) <= 2)
    {
        opSetLineCap(gfx, &fieldObj, 1);
    }
    GfxObjFree(&fieldObj);

    DictLookup(gs, "LJ", &fieldObj, gfx->xref);
    if (isInt(&fieldObj) && getInt(&fieldObj) >= 0 && getInt(&fieldObj) <= 2)
    {
        opSetLineJoin(gfx, &fieldObj, 1);
    }
    GfxObjFree(&fieldObj);

    DictLookup(gs, "ML", &fieldObj, gfx->xref);
    if (isNum(&fieldObj))
    {
        opSetMiterLimit(gfx, &fieldObj, 1);
    }
    GfxObjFree(&fieldObj);

    /* /D [dashArray dashPhase] */
    DictLookup(gs, "D", &fieldObj, gfx->xref);
    if (isArray(&fieldObj) && ObjArrayGetLength(&fieldObj) == 2)
    {
        ObjArrayGet(&fieldObj, 0, &args[0], gfx->xref);
        ObjArrayGet(&fieldObj, 1, &args[1], gfx->xref);
        if (isArray(&args[0]) && isNum(&args[1]))
        {
            opSetDash(gfx, args, 2);
        }
        GfxObjFree(&args[0]);
        GfxObjFree(&args[1]);
    }
    GfxObjFree(&fieldObj);

    /* /Font [fontRef size] */
    DictLookup(gs, "Font", &fieldObj, gfx->xref);
    if (isArray(&fieldObj) && ObjArrayGetLength(&fieldObj) == 2)
    {
        ObjArrayGetNF(&fieldObj, 0, &args[0]);
        ObjArrayGet(&fieldObj, 1, &args[1], gfx->xref);
        if (isRef(&args[0]) && isNum(&args[1]))
        {
            font = NULL;
            for (resPtr = gfx->res; resPtr && !font; resPtr = resPtr->next)
            {
                if (resPtr->fonts)
                {
                    font = GfxFontDictLookupRef(resPtr->fonts,
                        getRef(&args[0]));
                }
            }
            if (font)
            {
                GfxStateSetFont(gfx->state, font, getNum(&args[1]));
                gfx->fontChanged = gTrue;
            }
            else
            {
                EC_WARNING(-1);
            }
        }
        GfxObjFree(&args[0]);
        GfxObjFree(&args[1]);
    }
    GfxObjFree(&fieldObj);
}

/********************************************************************
 *                      GfxAlphaMask
 ********************************************************************
 * SYNOPSIS:      Return the dither mask for an alpha value.
 *
 * PARAMETERS:    alpha                 Alpha 0-1 (WWFixed).
 *
 * RETURNS:       word                  SDM_100 (opaque) to SDM_0 (invisible) in
 *                                      64 steps.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static word GfxAlphaMask(gdouble alpha)
{
    /* 64 dither steps from transparent to opaque */
    sdword steps = (GrMulWWFixed(alpha, IntToGdouble(64)) + 0x8000L) >> 16;

    if (steps < 0)
    {
        steps = 0;
    }
    else if (steps > 64)
    {
        steps = 64;
    }
    return (word)(SDM_0 - (word)steps);
}

/********************************************************************
 *                      GfxSetFillRGB
 ********************************************************************
 * SYNOPSIS:      Set the fill and text color.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                r                     Red 0-255.
 *                g                     Green 0-255.
 *                b                     Blue 0-255.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxSetFillRGB(Gfx *gfx, sword r, sword g, sword b)
{
    GfxState *state = gfx->state;

    state->fillColor.r = r;
    state->fillColor.g = g;
    state->fillColor.b = b;
    GrSetAreaColor(state->gstring, CF_RGB, r, g, b);
    GrSetTextColor(state->gstring, CF_RGB, r, g, b);
}

static void GfxSetStrokeRGB(Gfx *gfx, sword r, sword g, sword b)
{
    GrSetLineColor(gfx->state->gstring, CF_RGB, r, g, b);
}


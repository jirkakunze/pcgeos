static void GfxDrawImageMask(Gfx *gfx, Stream *str, word width, word height,
    GBool invert, GBool inlineImage);
/*
 * Image transparency: a soft mask (/SMask), an explicit stencil
 * (/Mask stream) or a color key (/Mask array). Drawn as a 1-bit GEOS
 * bitmap mask (BMT_MASK); partial alpha is dithered like /ca.
 */
typedef struct {
    Stream *str;        /* /SMask or /Mask stream, NULL = none */
    word width, height; /* mask image size */
    short bits;         /* mask bits per sample */
    GBool invert;       /* sample 1 = transparent (/Mask stencil) */
    short nKey;         /* color key components, 0 = none */
    Guchar keyMin[4];
    Guchar keyMax[4];
} GfxImageMask;

static void GfxDrawImage(Gfx *gfx, Stream *str, word width, word height,
    GfxImageColorMap *colorMap, GBool inlineImage, GfxImageMask *imgMask);

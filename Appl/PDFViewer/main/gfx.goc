/* text positioning operators */

/***********************************************************************
 *      opTextMove
 ***********************************************************************
 * SYNOPSIS:        Move.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opTextMove(Gfx *gfx, Obj args[], int numArgs)
{
    gdouble tx, ty;

    tx = gfx->state->lineX + getNum(&args[0]);
    ty = gfx->state->lineY + getNum(&args[1]);
    GfxStateTextMoveTo(gfx->state, tx, ty);

    (void)numArgs;
}

/***********************************************************************
 *      opTextMoveSet
 ***********************************************************************
 * SYNOPSIS:        Move set.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opTextMoveSet(Gfx *gfx, Obj args[], int numArgs)
{
    gdouble tx, ty;
    GfxState *state = gfx->state;

    tx = state->lineX + getNum(&args[0]);
    ty = getNum(&args[1]);
    GfxStateSetLeading(state, -ty);
    ty += state->lineY;
    GfxStateTextMoveTo(state, tx, ty);

    (void)numArgs;
}

/***********************************************************************
 *      opSetTextMatrix
 ***********************************************************************
 * SYNOPSIS:        Set text matrix.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opSetTextMatrix(Gfx *gfx, Obj args[], int numArgs)
{
    GfxState *state = gfx->state;

    GfxStateSetTextMat(state, getNum(&args[0]), getNum(&args[1]),
        getNum(&args[2]), getNum(&args[3]),
        getNum(&args[4]), getNum(&args[5]));

    GfxStateTextMoveTo(state, IntToGdouble(0), IntToGdouble(0));

    gfx->fontChanged = gTrue;
    (void)numArgs;
}

/***********************************************************************
 *      opTextNextLine
 ***********************************************************************
 * SYNOPSIS:        Process op text next line.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opTextNextLine(Gfx *gfx, Obj args[], int numArgs)
{
    gdouble tx, ty;
    GfxState *state = gfx->state;

    tx = state->lineX;
    ty = state->lineY - GfxStateGetLeading(state);
    GfxStateTextMoveTo(state, tx, ty);

    (void)args;
    (void)numArgs;
}

/* text string operators */

/***********************************************************************
 *      opShowText
 ***********************************************************************
 * SYNOPSIS:        Process op show text.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opShowText(Gfx *gfx, Obj args[], int numArgs)
{
    if (!GfxStateGetFont(gfx->state))
    {
        EC_WARNING(-1);

        return;
    }
    setTextTransform(gfx);
    doShowText(gfx, getString(&args[0]));
    resetTextTransform(gfx);
    (void)numArgs;
}

/***********************************************************************
 *      opMoveShowText
 ***********************************************************************
 * SYNOPSIS:        Move show text.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opMoveShowText(Gfx *gfx, Obj args[], int numArgs)
{
    gdouble tx, ty;
    GfxState *state = gfx->state;

    if (!GfxStateGetFont(state))
    {
        EC_WARNING(-1);

        return;
    }
    tx = state->lineX;
    ty = state->lineY - GfxStateGetLeading(gfx->state);
    GfxStateTextMoveTo(state, tx, ty);

    setTextTransform(gfx);
    doShowText(gfx, getString(&args[0]));
    resetTextTransform(gfx);
    (void)numArgs;
}

/***********************************************************************
 *      opMoveSetShowText
 ***********************************************************************
 * SYNOPSIS:        Move set show text.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opMoveSetShowText(Gfx *gfx, Obj args[], int numArgs)
{
    gdouble tx, ty;
    GfxState *state = gfx->state;

    if (!GfxStateGetFont(state))
    {
        EC_WARNING(-1);

        return;
    }
    GfxStateSetWordSpace(state, getNum(&args[0]));
    GfxStateSetCharSpace(state, getNum(&args[1]));
    tx = state->lineX;
    ty = state->lineY - GfxStateGetLeading(state);
    GfxStateTextMoveTo(state, tx, ty);

    setTextTransform(gfx);
    doShowText(gfx, getString(&args[2]));
    resetTextTransform(gfx);
    (void)numArgs;
}

/***********************************************************************
 *      opShowSpaceText
 ***********************************************************************
 * SYNOPSIS:        Process op show space text.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opShowSpaceText(Gfx *gfx, Obj args[], int numArgs)
{
    Array *a;
    Obj obj;
    word i;
    GfxState *state = gfx->state;

    if (!GfxStateGetFont(state))
    {
        EC_WARNING(-1);

        return;
    }
    a = getArray(&args[0]);
    setTextTransform(gfx);
    for (i = 0; i < ArrayGetLength(a); ++i)
    {
        ArrayGet(a, i, &obj, gfx->xref);
        if (isNum(&obj))
        {
            GfxStateTextShift(state,
                -(getNum(&obj) / 1000) *
                GdoubleToWord(GfxStateGetFontSize(state)));

        }
        else if (isString(&obj))
        {
            doShowText(gfx, getString(&obj));
        }
        else
        {
            EC_WARNING(-1);
            /*
             * error(getPos(), "Element of show/space array must be number or
             * string");
             */
        }
        GfxObjFree(&obj);
    }
    resetTextTransform(gfx);
    (void)numArgs;
}

#define WWFixedToDWord(ww) (((long)ww.WWF_int << 16) | ww.WWF_frac)

/***********************************************************************
 *      setTextTransform
 ***********************************************************************
 * SYNOPSIS:        Set text transform.
 * PARAMETERS:      Gfx *gfx    graphics context
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void setTextTransform(Gfx *gfx)
{
    GfxFont *font;
    Handle gstring = gfx->state->gstring;
    char ch;
    WWFixedAsDWord geosWidthM, pdfWidthM;
    WWFixedAsDWord scaledWidthFactor;

    if (gfx->fontChanged)
    {

        GfxUpdateFont(gfx);
        gfx->fontChanged = gFalse;
        font = GfxStateGetFont(gfx->state);

        if (!font->fontWidthFactor)
        {

            if ((ch = GfxFontFindChar(font, 'm')) == 0)
            {
                pdfWidthM = 0;
            }
            else
            {
                pdfWidthM = MakeWWFixed(font->widths[(unsigned char)ch]) / 1000;
            }

            if (pdfWidthM)
            {
                geosWidthM = GrTextWidthWWFixed(gstring, "m", 1) >> 5;

                if (geosWidthM)
                {
                    font->fontWidthFactor =
                        GrUDivWWFixed(
                        GrMulWWFixed(
                        GdoubleToWWFixed(GfxStateGetFontSize(gfx->state)),
                        pdfWidthM),
                        geosWidthM);
                }
                else
                {
                    font->fontWidthFactor = 1L << 16;
                }

            }
            else
            {
                /* No pdf width */
                font->fontWidthFactor = 1L << 16;
            }
            /*
             * Tweaks: disallow font expansion, or compression more than a
             * factor of 3.
             */
            if (font->fontWidthFactor > (1L << 16))
            {
                font->fontWidthFactor = 1L << 16;
            }
            else
            if (font->fontWidthFactor < 0x5555)
            {
                font->fontWidthFactor = 1L << 16;
            }
        }
        /*
         * Don't forget the horizontal scaling -- but into a LOCAL variable,
         * not back into font->fontWidthFactor itself (see project roadmap R4).
         */
        scaledWidthFactor = GrMulWWFixed(font->fontWidthFactor,
            GfxStateGetHorizScaling(gfx->state));

        GrSetFontWidth(gstring, IntegerOf(scaledWidthFactor * 100));

    } /* if fontChanged */

    GrSaveTransform(gstring);

    /* Apply text rise (super/sub scripting) */
    GrApplyTranslation(gstring,
        0,
        GfxStateGetRise(gfx->state));

    GrApplyScale(gstring, MakeWWFixed(1) / FONT_SCALING_FACTOR,
        (-1L << 16) / FONT_SCALING_FACTOR);
}

/***********************************************************************
 *      resetTextTransform
 ***********************************************************************
 * SYNOPSIS:        Reset text transform.
 * PARAMETERS:      Gfx *gfx    graphics context
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void resetTextTransform(Gfx *gfx)
{
    GrRestoreTransform(gfx->state->gstring);
}

/***********************************************************************
 *      doShowText
 ***********************************************************************
 * SYNOPSIS:        Process do show text.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  GooString *s    s
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void doShowText(Gfx *gfx, GooString *s)
{
    GfxFont *font;

    GfxState *state = gfx->state;
    WWFixedAsDWord width, fWidth;
    WWFixedAsDWord widthScale, charSpace, wordSpace;
    Handle gstring = state->gstring;

    word len;
    word render;
    short i;
    char *cp;

    font = GfxStateGetFont(state);
    /*
     * If the font has a charset and is symbolic, it probably has drawing
     * commands for the glyphs embedded in its FontFile.
     */
    if (font->hasCharSet && (font->flags & fontSymbolic))
    {
        return;
    }

    render = GfxStateGetRender(state);
    if (render != 0)
    {
        GrBeginPath(gstring, PCT_REPLACE);
    }

    /*
     * fontSize, horizScaling, charSpace, wordSpace, and state itself are all
     * unchanged for the whole duration of one doShowText call.
     */
    widthScale = GrMulWWFixed(GdoubleToWWFixed(GfxStateGetFontSize(state)),
        GfxStateGetHorizScaling(state));
    /* Fold PDF's 1/1000 glyph scale into the per-call width factor. */
    widthScale = widthScale / 1000;
    charSpace = GdoubleToWWFixed(GfxStateGetCharSpace(state));
    wordSpace = GdoubleToWWFixed(GfxStateGetWordSpace(state));

    /* ----- 16-bit font */
    if (GfxFontIs16Bit(font))
    {

        /* ----- 8-bit font */
    }
    else
    {
        /* Draw a string. */
        /* The text matrix is now set overall when in text mode. */

        len = GStrGetLength(s);
        if (len != 0)
        {

            cp = GStrGetCString(s);
            for (i = 0; i < len; i++, cp++)
            {
                char c = GfxFontMapChar(font, *cp, ' ');

                /* If the character's not a space, */
                if (c != C_SPACE)
                {
                    /*
                     * Move to the correct position if drawing past the first
                     * character or drawing to a path.
                     */
                    if (i > 0 || render != 0)
                    {
                        GrMoveToWWFixed(gstring,
                            ((sdword)((dword)state->curTextX << 5)),
                            ((sdword)((dword)(-state->lineY) << 5)));
                    }

                    if (c == C_FI_LIGATURE)
                    {
                        GrDrawTextAtCP(gstring, "fi", 2);
                    }
                    else
                    {
                        GrDrawCharAtCP(gstring, (byte)c);
                    }
                }

                /*
                 * fWidth used to come from GfxFontGetWidthChar(font, *cp),
                 * which divides by 1000 internally -- now folded into
                 * widthScale above .
                 */
                fWidth = MakeWWFixed(font->widths[(unsigned char)* cp]);
                width = GrMulWWFixed(widthScale, fWidth) + charSpace;
                if (*cp == ' ')
                {
                    width += wordSpace;
                }
                state->curTextX += width;
            }
        }
    }

    if (render != 0)
    {
        GrEndPath(gstring);

        if (render == 0 || render == 2 || render == 4 || render == 6)
        {
            GrFillPath(gstring, ODD_EVEN);
        }
        if (render == 1 || render == 2 || render == 5 || render == 6)
        {
            GrDrawPath(gstring);
        }
        if (render >= 4)
        {
            GrSetClipPath(gstring, PCT_INTERSECTION, ODD_EVEN);
        }
    }

    /*
     * Setup the current pen position for the next character (assuming there IS
     * a next character).
     */
    GrMoveToWWFixed(gstring,
        ((sdword)((dword)gfx->state->curTextX << 5)),
        ((sdword)((dword)(-gfx->state->lineY) << 5)));
}

#if 0
/***********************************************************************
 *      getNextChar16
 ***********************************************************************
 * SYNOPSIS:        Get next char16.
 * PARAMETERS:      GfxFontEncoding16 *enc    enc
 *                  Guchar *p    pointer
 *                  long *c16    c16
 *
 * RETURNS:         result value
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

long getNextChar16(GfxFontEncoding16 *enc, Guchar *p, long *c16)
{
    int n;
    int code;
    int a, b, m;

    n = enc->codeLen[*p];
    if (n == 1)
    {
        *c16 = enc->map1[*p];
    }
    else
    {
        code = (p[0] << 8) + p[1];
        a = 0;
        b = enc->map2Len;
        /* invariant: map2[2*a] <= code < map2[2*b] */
        while (b - a > 1)
        {
            m = (a + b) >> 1;
            if (enc->map2[2 * m] <= code)
            {
                a = m;
            }
            else if (enc->map2[2 * m] > code)
            {
                b = m;
            }
            else
            {
                break;
            }
        }
        *c16 = enc->map2[2 * a + 1] + (code - enc->map2[2 * a]);
    }
    return n;
}
#endif


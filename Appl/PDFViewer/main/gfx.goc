/*
 * Maximum nesting of Form XObjects. Guards against self-referencing forms
 * and keeps the recursion (GfxDisplay -> GfxGo -> opXObject -> GfxDoForm,
 * a few hundred bytes of stack per level) within the process stack.
 */
#define PDF_MAX_FORM_DEPTH                4
/*
 * q nesting limit (ISO 32000-1 Annex C: 28). Every level holds a GfxState
 * on the heap and a saved GState; deeper q are ignored with their Q.
 */
#define GFX_MAX_SAVE_DEPTH                32
/* Largest line width of GrSetLineWidth (kernel MAX_LINE_WIDTH) */
#define GFX_MAX_LINE_WIDTH                4096
static void buildImageStream(Gfx *gfx, Stream **str);

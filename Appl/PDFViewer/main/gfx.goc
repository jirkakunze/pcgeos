/***********************************************************************
 *      opConcat
 ***********************************************************************
 * SYNOPSIS:        Process op concat.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opConcat(Gfx *gfx, Obj args[], int numArgs)
{
    TransMatrix tm;
    sdword tmp;

    /* this is painful... */

    tmp = GdoubleToWWFixed(getNum(&args[0]));

    tm.TM_e11.WWF_int = IntegerOf(tmp);
    tm.TM_e11.WWF_frac = FractionOf(tmp);
    tmp = getNum(&args[1]);
    tm.TM_e12.WWF_int = IntegerOf(tmp);
    tm.TM_e12.WWF_frac = FractionOf(tmp);
    tmp = getNum(&args[2]);
    tm.TM_e21.WWF_int = IntegerOf(tmp);
    tm.TM_e21.WWF_frac = FractionOf(tmp);
    tmp = getNum(&args[3]);
    tm.TM_e22.WWF_int = IntegerOf(tmp);
    tm.TM_e22.WWF_frac = FractionOf(tmp);
    tmp = getNum(&args[4]);
    tm.TM_e31.DWF_int = (sword)IntegerOf(tmp);
    tm.TM_e31.DWF_frac = FractionOf(tmp);
    tmp = getNum(&args[5]);
    tm.TM_e32.DWF_int = (sword)IntegerOf(tmp);
    tm.TM_e32.DWF_frac = FractionOf(tmp);

    GrApplyTransform(gfx->state->gstring, &tm);
    (void)numArgs;
}

/***********************************************************************
 *      opSetDash
 ***********************************************************************
 * SYNOPSIS:        Set dash.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opSetDash(Gfx *gfx, Obj args[], int numArgs)
{
    Array *a;
    word length;
    Obj obj;

    word            i;
    byte            dash[MAX_DASH_ARRAY_PAIRS * 2];
    Handle          gstring = gfx->state->gstring;
    WWFixedAsDWord  lineWidth;

    a = getArray(&args[0]);
    length = ArrayGetLength(a);
    if (length == 0)
    {
        GrSetLineStyle(gstring, LS_SOLID, 0, 0, 0);
    }
    else
    {
        lineWidth = GrGetLineWidth(gstring);
        
        for (i = 0; i < length && i < MAX_DASH_ARRAY_PAIRS * 2; ++i)
        {
            ArrayGet(a, i, &obj, gfx->xref);
#ifdef USE_NATIVE_FLOAT_TYPE
            if (lineWidth)
            {
                dash[i] = (byte)((0x8000 + GrUDivWWFixed(getNum(&obj), lineWidth)) >> 16);
            }
            else
            {
                dash[i] = (byte)((0x8000 + getNum(&obj)) >> 16);
            }
#else
            dash[i] = (byte)(0.5 + getNum(&obj));
#endif
            if (i & 1)
            {
                ++dash[i];
            }

            if (!dash[i])
            {
                dash[i] = 1;
            }
            GfxObjFree(&obj);
        }

        if (length == 1) { /* single # implies two...*/
            dash[1] = dash[0];
            length = 2;
        }
        GrSetLineStyle(gstring, LS_CUSTOM, GdoubleToWord(getNum(&args[1])),
            (word *)dash, length >> 1);
    }

    (void)numArgs;
}


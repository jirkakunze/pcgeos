/********************************************************************
 *                      opBeginText
 ********************************************************************
 * SYNOPSIS:      Operator BT: begin a text object.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Not used.
 *                numArgs               Not used.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Save the transform; the text matrix starts as identity.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opBeginText(Gfx *gfx, Obj args[], int numArgs)
{

    GrSaveTransform(gfx->state->gstring);
    gfx->textClip = gFalse;

    GfxStateSetTextMat(gfx->state, IntToGdouble(1), IntToGdouble(0),
        IntToGdouble(0), IntToGdouble(1),
        IntToGdouble(0), IntToGdouble(0));

    GfxStateTextMoveTo(gfx->state, IntToGdouble(0), IntToGdouble(0));

    gfx->fontChanged = gTrue;
    (void)args;
    (void)numArgs;
}

/********************************************************************
 *                      opEndText
 ********************************************************************
 * SYNOPSIS:      Operator ET: end a text object.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Not used.
 *                numArgs               Not used.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Text in clip modes (Tr 4-7) has collected its glyphs in the
 *                kernel path: now it becomes the clip.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opEndText(Gfx *gfx, Obj args[], int numArgs)
{
    /* Tr 4-7: the glyphs collected in the kernel path become the clip */
    if (gfx->textClip)
    {
        GrSetClipPath(gfx->state->gstring, PCT_INTERSECTION, ODD_EVEN);
        gfx->textClip = gFalse;
    }
    GrRestoreTransform(gfx->state->gstring);
    (void)args;
    (void)numArgs;
}

/********************************************************************
 *                      opSetCharSpacing
 ********************************************************************
 * SYNOPSIS:      Operator Tc: set the character spacing.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.

/***********************************************************************
 *      GfxUpdatePathBounds
 ***********************************************************************
 * SYNOPSIS:        Update path bounds.
 * PARAMETERS:      GfxState *state    graphics state
 *                  gdouble x    x
 *                  gdouble y    y
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/
static void
GfxUpdatePathBounds(GfxState *state, gdouble x, gdouble y)
{
    if (!state->pathRawBoundsValid)
    {
        state->pathRawMinX = state->pathRawMaxX = x;
        state->pathRawMinY = state->pathRawMaxY = y;
        state->pathRawBoundsValid = gTrue;
    }
    else
    {
        if (x < state->pathRawMinX)
        {
            state->pathRawMinX = x;
        }
        if (x > state->pathRawMaxX)
        {
            state->pathRawMaxX = x;
        }
        if (y < state->pathRawMinY)
        {
            state->pathRawMinY = y;
        }
        if (y > state->pathRawMaxY)
        {
            state->pathRawMaxY = y;
        }
    }
}

/***********************************************************************
 *      doEndPath
 ***********************************************************************
 * SYNOPSIS:        End path.
 * PARAMETERS:      GfxState *state    graphics state
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static GBool doEndPath(GfxState *state)
{
    Handle gstring = state->gstring;

    GrEndPath(gstring);
    state->pathSubpathStartValid = gFalse;

    if (state->pathType == PATH_NORMAL)
    {
        state->pathType = PATH_NONE;
        return gTrue;
    }

    if (state->pathType == PATH_CLIP)
    {
        GrSetClipPath(gstring, PCT_INTERSECTION, WINDING);
        state->pathType = PATH_NONE;
        return gTrue;
    }

    if (state->pathType == PATH_CLIP_EO)
    {
        GrSetClipPath(gstring, PCT_INTERSECTION, ODD_EVEN);
        state->pathType = PATH_NONE;
        return gTrue;
    }

    state->pathType = PATH_NONE;
    return gFalse;
}


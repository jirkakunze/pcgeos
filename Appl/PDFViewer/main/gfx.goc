static void _near opSetWordSpacing(Gfx *gfx, Obj args[], int numArgs)
{

    GfxStateSetWordSpace(gfx->state, getNum(&args[0]));

    GrSetTextSpacePad(gfx->state->gstring,
        ((sdword)((dword)GdoubleToWWFixed(getNum(&args[0])) << 5)));

// #define numOps (sizeof(opTab) / sizeof(Operator))

#define numOps 71

//------------------------------------------------------------------------
// Gfx
//------------------------------------------------------------------------

//Gfx::Gfx(OutputDev *out1, int pageNum, Dict *resDict,
//	 int dpi, double x1, double y1, double x2, double y2, GBool crop,
//	 double cropX1, double cropY1, double cropX2, double cropY2,
//	 int rotate) {
#ifdef __BORLANDC__
#pragma codeseg GFXCore
#endif
#ifdef __WATCOMC__
#pragma code_seg("GFXCore")
#endif

/* SEG-03B: resource-local ObjFree fastpath for the common scalar Object
 * types used by content operators.  Owned payload types still go through
 * GfxObjFree().  DEBUG_MEM keeps the original path so allocation accounting
 * remains exact. */
static void _near GfxObjFree(Obj *obj) {
#ifdef DEBUG_MEM
  ObjFree(obj);
#else
  switch (obj->type) {
  case objBool:
  case objInt:
  case objReal:
  case objNull:
  case objRef:
  case objError:
  case objEOF:
  case objNone:
    obj->type = objNone;
    break;
  default:
    ObjFree(obj);
    break;
  }
#endif
}

void GfxInit(Gfx *this, Handle gstring, Dict *resDict, XRef *xref,
	     VMFileHandle vmFile1) {

  Obj obj1;

  // start the resource stack
  this->res = NULL;
  this->state = NULL;
  this->parser = 0;
  this->res = gmalloc( sizeof(GfxResources) );
  if (!this->res)
    return;
  GfxResourcesInit(this->res, NULL);

  // build font dictionary
  this->res->fonts = NULL;
  if (resDict) {
    DictLookup(resDict, "Font", &obj1, xref);
    if (isDict(&obj1)) {
      this->res->fonts = gmalloc( sizeof(GfxFontDict) );
      if (this->res->fonts)
        GfxFontDictInit(this->res->fonts, getDict(&obj1), xref);
    }
    GfxObjFree(&obj1);
  }

  // get XObject dictionary
  if (resDict)
    DictLookup(resDict, "XObject", &this->res->xObjDict, xref);
  else
    initNull(&this->res->xObjDict);

  // get colorspace dictionary
  if (resDict)
    DictLookup(resDict, "ColorSpace", &this->res->colorSpaceDict, xref);
  else
    initNull(&this->res->colorSpaceDict);

  // get ExtGState dictionary (opSetExtGState / GfxLookupExtGState)
  if (resDict)
    DictLookup(resDict, "ExtGState", &this->res->extGStateDict, xref);
  else
    initNull(&this->res->extGStateDict);

  // initialize
//  out = out1;
//  state = new GfxState(dpi, x1, y1, x2, y2, rotate, out->upsideDown());
  this->state = gmalloc( sizeof(GfxState) );
  if (!this->state)
    return;
  GfxStateInit(this->state, gstring);

  this->fontChanged = gFalse;
//  clip = clipNone;
  this->ignoreUndef = 0;
//  out->startPage(pageNum, state);
//  out->setDefaultCTM(state->getCTM());
//  out->updateAll(state);

  this->parser = 0;
  this->xref = xref;
  this->vmFile = vmFile1;
  this->nImages = 0;
  this->resourceLimitExceeded = gFalse;
  this->pageResourceList = NullHandle;
  this->pageResourceCount = 0;
  this->pageResourceBytes = 0;

  /*
   * Phase 4: safe defaults. main/pdfEngine.goc's PdfDecodePage sets
   * these to the real callback/flag right after GfxInit returns; any
   * other caller (there isn't one today) gets a Gfx that silently
   * skips progress reporting and never reports cancellation, rather
   * than dereferencing garbage.
   */
  this->progressCallback = NULL;
  this->progressUserData = NULL;
  this->cancelFlag = NULL;

}

void GfxFree(Gfx *this) {
  GfxResources *resPtr;

  while (this->res) {
    resPtr = this->res->next;
    GfxResourcesFree(this->res);
    gfree(this->res);
    this->res = resPtr;
  }
  if (this->state) {
    GfxStateFree(this->state);
    gfree(this->state);
  }
/*
 * An active parser here is an internal lifetime error.  GfxDisplay()
 * points this field at its stack-local Parser and clears it before
 * returning, so attempting to free it here would corrupt memory.
 */
  EC_ERROR_IF(this->parser != NULL, -1);
}

void GfxResourcesInit(GfxResources *this, GfxResources *next1) {
    this->next = next1;
    this->fonts = NULL;
    initNull(&this->xObjDict);
    initNull(&this->colorSpaceDict);
    initNull(&this->extGStateDict);
}

void GfxResourcesFree(GfxResources *this) {
    if (this->fonts) {
	GfxFontDictFree(this->fonts);
	gfree(this->fonts);
    }
    GfxObjFree(&this->xObjDict);
    GfxObjFree(&this->colorSpaceDict);
    GfxObjFree(&this->extGStateDict);
}


GBool GfxDisplay(Gfx *this, Obj *obj) {
  Obj obj2;
  word i;
  Parser parser;
  Lexer *lexer;
  XRef *xref = this->xref;
  GBool goRetval;

  if (isArray(obj)) {
    for (i = 0; i < ObjArrayGetLength(obj); ++i) {
      ObjArrayGet(obj, i, &obj2, xref);
      if (!isStream(&obj2)) {
	EC_WARNING(-1);
//	error(-1, "Weird page contents");
	GfxObjFree(&obj2);
	return gFalse;
      }
      GfxObjFree(&obj2);
    }
  } else if (!isStream(obj)) {
    EC_WARNING(-1);
//    error(-1, "Weird page contents");
    return gFalse;
  }
//  parser = new Parser(new Lexer(obj));

  lexer = gmalloc( sizeof(Lexer) );	/* ParserFree frees this */
  if (!lexer)
    return gFalse;
  LexerInitFromObj(lexer, obj, xref);
  if (GMemHadError()) {
    LexerFree(lexer);
    gfree(lexer);
    return gFalse;
  }
  ParserInit(&parser, lexer);

  this->parser = &parser;
  goRetval = GfxGo(this, &parser);
  ParserFree(&parser);
  this->parser = 0;

  return goRetval;
}

static GBool GfxGo(Gfx *this, Parser *parser) {
  Obj obj;
  Obj args[maxArgs];
  Operator *pOpTab;
  long streamStart;
  long streamLen;
  int numCmds, numArgs;
  short i;
  GfxState *state = this->state;
  (void) state;

  // scan a sequence of objects
  numCmds = 0;
  numArgs = 0;
/*
 * save stream start pos for progress update
 */
  streamStart = ParserGetPos(parser);
  streamLen = ParserGetLength(parser);
/*
 * Lock down op table
 */
  MemLock(OptrToHandle(@opTab));
  pOpTab = LMemDeref(@opTab);
/*
 * Loop over commands
 */
  ParserGetObj(parser, &obj);
  while (!isEOF(&obj)) {

    // got a command - execute it
    if (isCmd(&obj)) {
      GfxExecOp(this, &obj, args, numArgs, pOpTab);
      GfxObjFree(&obj);
      for (i = 0; i < numArgs; ++i)
	GfxObjFree(&args[i]);
      numArgs = 0;

      /* OPT-15: a resource-limit hit inside an image operator must
       * abort the page instead of continuing with missing images. */
      if (this->resourceLimitExceeded) {
          break;
      }

      // periodically update display
      if (++numCmds > 200) {
	  numCmds = 0;
	  if (this->progressCallback) {
	      ProcCallFixedOrMovable_cdecl(this->progressCallback,
					   PDF_PROGRESS_PAGE,
					   ParserGetPos(parser) - streamStart,
					   streamLen,
					   this->progressUserData);
	  }
	  /*
	   * Check for a cancel request at the same checkpoint as the
	   * progress callback (see project optimization analysis U1)
	   * -- previously, cancellation was only checked inside the
	   * image-drawing loops (see U5), so a page with lots of
	   * path/text operators but no images couldn't be cancelled
	   * mid-render at all, only noticed once the whole page
	   * finished. `break` here reaches this function's own
	   * existing cleanup right after the loop (ObjFree/MemUnlock)
	   * -- exactly what this function's own long-standing comment
	   * below already anticipated ("make sure all Objects are
	   * ObjFree'd and the optable is unlocked before returning").
	   * No need to free obj/args here first -- both are already
	   * correctly cleaned up by the code just above (obj freed,
	   * args freed and numArgs reset to 0), so the post-loop
	   * cleanup's own GfxObjFree(&obj) call safely hits ObjFree's
	   * objNone/default case, same as it does on every other exit
	   * path.
	   */
	  if (this->cancelFlag && *this->cancelFlag) {
	      break;
	  }
      }

    // got an argument - save it
    } else if (numArgs < maxArgs) {
      ObjMove(&args[numArgs++], &obj);

    // too many arguments - something is wrong
    } else {
	EC_WARNING(-1);
//      error(getPos(), "Too many args in content stream");
      GfxObjFree(&obj);
    }

    // grab the next object
    ParserGetObj(parser, &obj);
  }
  GfxObjFree(&obj);
/*
 * Unlock the op table
 */
  MemUnlock(OptrToHandle(@opTab));

  // args at end with no command
  if (numArgs > 0) {
      EC_WARNING(-1);
//    error(getPos(), "Leftover args in content stream");
    for (i = 0; i < numArgs; ++i)
      GfxObjFree(&args[i]);
  }

/*
 * This return value now does exactly what the comment above always
 * anticipated: gFalse means the content stream was cancelled partway
 * through (see project optimization analysis U1), not that anything
 * went wrong -- callers that care about the difference between
 * "finished" and "cancelled" can check this->cancelFlag themselves
 * after the fact if needed.
 */
  return !this->resourceLimitExceeded &&
         !(this->cancelFlag && *this->cancelFlag);
}


static void GfxExecOp(Gfx *gfx, Obj *cmd, Obj args[], int numArgs, Operator *pOpTab) {
  Operator *op;
  char *name;
  int i;

  EC( ECCheckBounds(gfx) );
  EC( ECCheckBounds(cmd) );
  EC( ECCheckBounds(args) );
  EC( ECCheckBounds(pOpTab) );

  // find operator
  name = getName(cmd);
  if (!(op = GfxFindOp(name, pOpTab))) {
//    if (ignoreUndef == 0)
//	EC_WARNING(-1);
//      error(getPos(), "Unknown operator '%s'", name);
    return;
  }

  // type check args
  if (op->numArgs >= 0) {
    if (numArgs != op->numArgs) {
	EC_WARNING(-1);
//      error(getPos(), "Wrong number (%d) of args to '%s' operator",
//	    numArgs, name);
      return;
    }
  } else {
    if (numArgs > -op->numArgs) {
	EC_WARNING(-1);
//      error(getPos(), "Too many (%d) args to '%s' operator",
//	    numArgs, name);
      return;
    }
  }
  for (i = 0; i < numArgs; ++i) {
    if (!GfxCheckArg(&args[i], op->tchk[i])) {
	EC_WARNING(-1);
//      error(getPos(), "Arg #%d to '%s' operator is wrong type (%s)",
//	    i, name, args[i].getTypeName());
      return;
    }
  }

  // SEG-01G: every operator-table target now lives in GFXCore.
  // BI/Do use local wrappers which make ordinary named calls into GFXImage.
  // Therefore the generic movable-function-pointer trampoline is no longer
  // needed on the hot operator-dispatch path.
  (op->func)(gfx, args, numArgs);
}

/* SEG-01G: keep the operator function pointers local to GFXCore.
 * The real BI/Do implementations remain in GFXImage; normal named calls
 * across code resources are handled by the compiler/linker. */
static void _near opBeginImageDispatch(Gfx *gfx, Obj args[], int numArgs) {
  opBeginImage(gfx, args, numArgs);
}

static void _near opXObjectDispatch(Gfx *gfx, Obj args[], int numArgs) {
  opXObject(gfx, args, numArgs);
}

static Operator *GfxFindOp(char *name, Operator *opTab) {
  short a, b, m, cmp;

  a = -1;
  b = numOps;
  // invariant: opTab[a] < name < opTab[b]
  while (b - a > 1) {
    m = (a + b) >> 1;
    cmp = strcmp(opTab[m].name, name);
    if (cmp < 0)
      a = m;
    else if (cmp > 0)
      b = m;
    else
      a = b = m;
  }
  if (cmp != 0)
    return NULL;
  return &opTab[a];
}

static GBool GfxCheckArg(Obj *arg, TchkType type) {
  switch (type) {
  case tchkBool:   return isBool(arg);
  case tchkInt:    return isInt(arg);
  case tchkNum:    return isNum(arg);
  case tchkString: return isString(arg);
  case tchkName:   return isName(arg);
  case tchkArray:  return isArray(arg);
  case tchkProps:  return isDict(arg) || isName(arg);
  case tchkSCN:    return isNum(arg) || isName(arg);
  case tchkNone:   return gFalse;
  }
  return gFalse;
}


static GfxFont *GfxLookupFont(Gfx *this, char *name) {
  GfxFont *font;
  GfxResources *resPtr;

  for (resPtr = this->res; resPtr; resPtr = resPtr->next) {
    if (resPtr->fonts) {
      if ((font = GfxFontDictLookup(resPtr->fonts, name)))
	return font;
    }
  }
//  error(getPos(), "unknown font tag '%s'", name);
  EC_WARNING(-1);
  return NULL;
}

static GBool GfxLookupXObject(Gfx *this, char *name, Obj *obj) {
  GfxResources *resPtr;

  for (resPtr = this->res; resPtr; resPtr = resPtr->next) {
    if (isDict(&resPtr->xObjDict)) {
	ObjDictLookup(&resPtr->xObjDict, name, obj, this->xref);
	if (!isNull(obj))
	    return gTrue;
	GfxObjFree(obj);
    }
  }
  EC_WARNING(-1);
//  error(getPos(), "XObject '%s' is unknown", name);
  return gFalse;
}


//int Gfx::getPos() {
//  return parser->getPos();
//}

static void GfxLookupColorSpace(Gfx *this, char *name, Obj *obj) {
  GfxResources *resPtr;

  for (resPtr = this->res; resPtr; resPtr = resPtr->next) {
    if (isDict(&resPtr->colorSpaceDict)) {
	ObjDictLookup(&resPtr->colorSpaceDict, name, obj, this->xref);
	if (!isNull(obj))
	    return;
	GfxObjFree(obj);
    }
  }
  initNull(obj);
}

static void GfxLookupExtGState(Gfx *this, char *name, Obj *obj) {
  GfxResources *resPtr;

  for (resPtr = this->res; resPtr; resPtr = resPtr->next) {
    if (isDict(&resPtr->extGStateDict)) {
	ObjDictLookup(&resPtr->extGStateDict, name, obj, this->xref);
	if (!isNull(obj))
	    return;
	GfxObjFree(obj);
    }
  }
  initNull(obj);
}



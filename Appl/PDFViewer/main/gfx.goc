/***********************************************************************
 *		GfxApplyColorArray
 ***********************************************************************
 * SYNOPSIS:	    Compute a color from raw 0-255 component values in
 *		    the given colorspace (via GfxColorSpaceGetColor,
 *		    the same function GfxImageColorMapGetColor already
 *		    uses for images -- Separation/DeviceN/ICCBased/etc.
 *		    all get the same treatment for fills as they do for
 *		    images), and push it into GEOS's native area/text
 *		    (fill) or line (stroke) color, same as
 *		    opSetFillRGBColor etc. already do for the simple
 *		    cases.
 *
 ***********************************************************************/
static void
GfxApplyColorArray(Gfx *gfx, GfxColorSpace *cs, short x[4], GBool stroke)
{
    GfxColor color;
    sword r, g, b;

    GfxColorSpaceGetColor(cs, x, &color);
    r = color.r; g = color.g; b = color.b;
    GfxBlendAlpha(&r, &g, &b, stroke ? gfx->state->strokeAlpha
				      : gfx->state->fillAlpha);

    if (stroke) {
	GrSetLineColor(gfx->state->gstring, CF_RGB, r, g, b);
    } else {
	gfx->state->fillColor.r = r;
	gfx->state->fillColor.g = g;
	gfx->state->fillColor.b = b;
	GrSetAreaColor(gfx->state->gstring, CF_RGB, r, g, b);
	GrSetTextColor(gfx->state->gstring, CF_RGB, r, g, b);
    }
}

/***********************************************************************
 *		GfxApplyColorN
 ***********************************************************************
 * SYNOPSIS:	    Same as GfxApplyColorArray, but parses the raw
 *		    0.0-1.0 numeric operands (as many as numArgs says)
 *		    into the 0-255 array first. Unused slots (numArgs <
 *		    the colorspace's real numComps, e.g. a malformed
 *		    file) are left at 0 rather than reading garbage.
 *
 ***********************************************************************/
static void
GfxApplyColorN(Gfx *gfx, GfxColorSpace *cs, Obj args[], int numArgs, GBool stroke)
{
    short x[4];
    short i;

    if (numArgs < 1 || numArgs > 4) {
	EC_WARNING(-1);
	return;
    }
    x[0] = x[1] = x[2] = x[3] = 0;
    for (i = 0; i < numArgs; ++i) {
	if (!isNum(&args[i])) {
	    EC_WARNING(-1);
	    return;
	}
	x[i] = GdoubleToWord(255 * getNum(&args[i]));
    }

    GfxApplyColorArray(gfx, cs, x, stroke);
}

static void _near opSetFillColorSpace(Gfx *gfx, Obj args[], int numArgs) {
    Obj obj, resolved;
    GfxColorSpace cs;
    short zero[4];

    GfxLookupColorSpace(gfx, getName(&args[0]), &resolved);
    if (!isNull(&resolved)) {
	ObjMove(&obj, &resolved);
    } else {
	GfxObjFree(&resolved);
	ObjMove(&obj, &args[0]);
    }

    GfxColorSpaceInit(&cs, &obj, gfx->xref);
    GfxObjFree(&obj);

    if (cs.ok && !cs.indexed) {
	/* Indexed isn't supported as a fill/stroke colorspace -- see
	 * the comment on GfxState.fillColorSpace in pdfGeode.goh for
	 * why (the lookup table's shallow q/Q copy). Rare in practice
	 * for plain fills (Indexed is almost always used for images),
	 * so this is a deliberate, narrow gap, not a bug. */
	gfx->state->fillColorSpace = cs;

	/* spec default: color 0 in the new colorspace (black, or
	 * close to it -- same simplification upstream xpdf's own
	 * disabled version of this code already made) */
	zero[0] = zero[1] = zero[2] = zero[3] = 0;
	GfxApplyColorArray(gfx, &gfx->state->fillColorSpace, zero, gFalse);
    } else {
	EC_WARNING(-1);
    }
  (void) numArgs;
}

static void _near opSetStrokeColorSpace(Gfx *gfx, Obj args[], int numArgs) {
    Obj obj, resolved;
    GfxColorSpace cs;
    short zero[4];

    GfxLookupColorSpace(gfx, getName(&args[0]), &resolved);
    if (!isNull(&resolved)) {
	ObjMove(&obj, &resolved);
    } else {
	GfxObjFree(&resolved);
	ObjMove(&obj, &args[0]);
    }

    GfxColorSpaceInit(&cs, &obj, gfx->xref);
    GfxObjFree(&obj);

    if (cs.ok && !cs.indexed) {
	gfx->state->strokeColorSpace = cs;
	zero[0] = zero[1] = zero[2] = zero[3] = 0;
	GfxApplyColorArray(gfx, &gfx->state->strokeColorSpace, zero, gTrue);
    } else {
	EC_WARNING(-1);
    }
  (void) numArgs;
}

static void _near opSetFillColor(Gfx *gfx, Obj args[], int numArgs) {

    if (numArgs == gfx->state->fillColorSpace.numComps) {
	GfxApplyColorN(gfx, &gfx->state->fillColorSpace, args, numArgs, gFalse);
	return;
    }

    /*
     * numArgs doesn't match the colorspace cs/CS actually set (most
     * often: no cs/CS was ever sent for this fill at all, leaving
     * the PDF-spec default of DeviceGray/numComps=1 in place, while
     * this operator is being used loosely with 3 or 4 args). Fall
     * back to the old argument-count guess rather than reject a
     * content stream that used to render under it.
     */
    if (numArgs == 1) {
	opSetFillGray(gfx, args, numArgs);

    } else if (numArgs == 3) {
	opSetFillRGBColor(gfx, args, numArgs);

    } else if (numArgs == 4) {
	opSetFillCMYKColor(gfx, args, numArgs);

    } else {
	EC_WARNING(-1);
    }
}

static void _near opSetStrokeColor(Gfx *gfx, Obj args[], int numArgs) {

    if (numArgs == gfx->state->strokeColorSpace.numComps) {
	GfxApplyColorN(gfx, &gfx->state->strokeColorSpace, args, numArgs, gTrue);
	return;
    }

    if (numArgs == 1) {
	opSetStrokeGray(gfx, args, numArgs);

    } else if (numArgs == 3) {
	opSetStrokeRGBColor(gfx, args, numArgs);

    } else if (numArgs == 4) {
	opSetStrokeCMYKColor(gfx, args, numArgs);

    } else {
	EC_WARNING(-1);
    }
}

static void _near opSetFillColorN(Gfx *gfx, Obj args[], int numArgs) {
    if (numArgs > 0 && isName(&args[numArgs - 1])) {
	/* Pattern colorspace fill (a pattern name instead of, or
	 * after, numeric components) -- not supported. Leave the
	 * current color as-is rather than misinterpret the name as a
	 * number. */
	EC_WARNING(-1);
	return;
    }
    GfxApplyColorN(gfx, &gfx->state->fillColorSpace, args, numArgs, gFalse);
}

static void _near opSetStrokeColorN(Gfx *gfx, Obj args[], int numArgs) {
    if (numArgs > 0 && isName(&args[numArgs - 1])) {
	EC_WARNING(-1);
	return;
    }
    GfxApplyColorN(gfx, &gfx->state->strokeColorSpace, args, numArgs, gTrue);
}

#ifdef __BORLANDC__
#pragma codeseg GFXCore
#endif
#ifdef __WATCOMC__
#pragma code_seg("GFXCore")
#endif

//------------------------------------------------------------------------
// path segment operators
//------------------------------------------------------------------------

static void _near opMoveTo(Gfx *gfx, Obj args[], int numArgs) {
    Handle gstring = gfx->state->gstring;
    gdouble x, y;
    sword pathX, pathY;

    x = getNum(&args[0]);
    y = getNum(&args[1]);
    pathX = GdoubleToWordRounded(x);
    pathY = GdoubleToWordRounded(y);

//  state->moveTo(args[0].getNum(), args[1].getNum());
    if (gfx->state->pathType != PATH_NORMAL) {
	GrBeginPath(gstring, PCT_REPLACE);	/* new path */
	gfx->state->pathType = PATH_NORMAL;
	gfx->state->pathRawBoundsValid = gFalse;    /* fresh path: forget
						      * whatever the last
						      * one's raw extent was */
    }
    GfxUpdatePathBounds(gfx->state, x, y);
    gfx->state->pathSubpathStartX = pathX;
    gfx->state->pathSubpathStartY = pathY;
    gfx->state->pathSubpathStartValid = gTrue;
    GrMoveTo(gstring, pathX, pathY);
    GrDrawLineTo(gstring, pathX, pathY);
  (void) numArgs;
}

static void _near opLineTo(Gfx *gfx, Obj args[], int numArgs) {
//  if (!state->isCurPt()) {
//    error(getPos(), "No current point in lineto");
//    return;
//  }
//  state->lineTo(args[0].getNum(), args[1].getNum());
    gdouble x, y;

    x = getNum(&args[0]);
    y = getNum(&args[1]);
    GfxUpdatePathBounds(gfx->state, x, y);
    GrDrawLineTo(gfx->state->gstring, 
		 GdoubleToWordRounded(x),
		 GdoubleToWordRounded(y));
  (void) numArgs;
}

static void _near opCurveTo(Gfx *gfx, Obj args[], int numArgs) {
    Point p[3];
    Handle gstring = gfx->state->gstring;

    p[0].P_x = GdoubleToWordRounded(getNum(&args[0]));
    p[0].P_y = GdoubleToWordRounded(getNum(&args[1]));
    p[1].P_x = GdoubleToWordRounded(getNum(&args[2]));
    p[1].P_y = GdoubleToWordRounded(getNum(&args[3]));
    p[2].P_x = GdoubleToWordRounded(getNum(&args[4]));
    p[2].P_y = GdoubleToWordRounded(getNum(&args[5]));

    GfxUpdatePathBounds(gfx->state, getNum(&args[0]), getNum(&args[1]));
    GfxUpdatePathBounds(gfx->state, getNum(&args[2]), getNum(&args[3]));
    GfxUpdatePathBounds(gfx->state, getNum(&args[4]), getNum(&args[5]));

//dbg    GrDrawLineTo(gstring, p[2].P_x, p[2].P_y);
    GrDrawCurveTo(gstring, p);
  (void) numArgs;
}

static void _near opCurveTo1(Gfx *gfx, Obj args[], int numArgs) {
    Point p[3];
    XYValueAsDWord curPos;
    Handle gstring = gfx->state->gstring;

    curPos = GrGetCurPos(gstring);

    p[0].P_x = (curPos & 0xffff);
    p[0].P_y = (curPos>>16);
    p[1].P_x = GdoubleToWordRounded(getNum(&args[0]));
    p[1].P_y = GdoubleToWordRounded(getNum(&args[1]));
    p[2].P_x = GdoubleToWordRounded(getNum(&args[2]));
    p[2].P_y = GdoubleToWordRounded(getNum(&args[3]));

    /* p[0] is the already-rounded current point, not a fresh PDF
     * coordinate -- nothing new to feed the raw bounds tracker from
     * it, only args[0..3] are actual incoming PDF-space numbers. */
    GfxUpdatePathBounds(gfx->state, getNum(&args[0]), getNum(&args[1]));
    GfxUpdatePathBounds(gfx->state, getNum(&args[2]), getNum(&args[3]));

//dbg    GrDrawLineTo(gstring, p[2].P_x, p[2].P_y);
    GrDrawCurveTo(gstring, p);
  (void) numArgs;
}

static void _near opCurveTo2(Gfx *gfx, Obj args[], int numArgs) {
    Point p[3];
    Handle gstring = gfx->state->gstring;

    p[0].P_x = GdoubleToWordRounded(getNum(&args[0]));
    p[0].P_y = GdoubleToWordRounded(getNum(&args[1]));
    p[2].P_x = p[1].P_x = GdoubleToWordRounded(getNum(&args[2]));
    p[2].P_y = p[1].P_y = GdoubleToWordRounded(getNum(&args[3]));

    GfxUpdatePathBounds(gfx->state, getNum(&args[0]), getNum(&args[1]));
    GfxUpdatePathBounds(gfx->state, getNum(&args[2]), getNum(&args[3]));

//dbg    GrDrawLineTo(gstring, p[2].P_x, p[2].P_y);
    GrDrawCurveTo(gstring, p);
  (void) numArgs;
}

static void _near opRectangle(Gfx *gfx, Obj args[], int numArgs) {
    sword x, y;
    Handle gstring = gfx->state->gstring;
    gdouble x0, y0, w0, h0;

    x0 = getNum(&args[0]);
    y0 = getNum(&args[1]);
    w0 = getNum(&args[2]);
    h0 = getNum(&args[3]);

    if (gfx->state->pathType != PATH_NORMAL) {
	GrBeginPath(gstring, PCT_REPLACE);	/* new path */
	gfx->state->pathType = PATH_NORMAL;
	gfx->state->pathRawBoundsValid = gFalse;
    }
    GfxUpdatePathBounds(gfx->state, x0, y0);
    GfxUpdatePathBounds(gfx->state, x0 + w0, y0 + h0);
    GrDrawRect(gstring,
	       x = GdoubleToWordRounded(x0),
	       y = GdoubleToWordRounded(y0),
	       x + GdoubleToWordRounded(w0),
	       y + GdoubleToWordRounded(h0));
    gfx->state->pathSubpathStartValid = gFalse;
  (void) numArgs;
}

static void _near opClosePath(Gfx *gfx, Obj args[], int numArgs) {
//  if (!state->isPath()) {
//    error(getPos(), "No current point in closepath");
//    return;
//  }
//  state->closePath();

    if (gfx->state->pathSubpathStartValid) {
	GrDrawLineTo(gfx->state->gstring,
		     gfx->state->pathSubpathStartX,
		     gfx->state->pathSubpathStartY);
	GrCloseSubPath(gfx->state->gstring);
    }
  (void) args;
  (void) numArgs;
}

//------------------------------------------------------------------------
// path painting operators
//------------------------------------------------------------------------

static void _near opEndPath(Gfx *gfx, Obj args[], int numArgs) {
    doEndPath(gfx->state);
  (void) args;
  (void) numArgs;
}

static void _near opStroke(Gfx *gfx, Obj args[], int numArgs) {
//  if (!state->isCurPt()) {
//    //error(getPos(), "No path in stroke");
//    return;
//  }
//  if (state->isPath())
//    out->stroke(state);
//  doEndPath();

    if (doEndPath(gfx->state))
	GrDrawPath(gfx->state->gstring);
  (void) args;
  (void) numArgs;
}

static void _near opCloseStroke(Gfx *gfx, Obj args[], int numArgs) {
    Handle gstring = gfx->state->gstring;


    if (gfx->state->pathSubpathStartValid) {
	GrDrawLineTo(gstring, gfx->state->pathSubpathStartX,
		     gfx->state->pathSubpathStartY);
	GrCloseSubPath(gstring);
    }
    if (doEndPath(gfx->state))
	GrDrawPath(gstring);
  (void) args;
  (void) numArgs;
}

/***********************************************************************
 *		GfxFillWithMinThickness
 ***********************************************************************
 * SYNOPSIS:	    Check whether the path about to be filled would
 *		    collapse to zero area in some dimension purely
 *		    because of GrMoveTo/GrDrawLineTo/GrDrawRect's
 *		    integer-only coordinates (see project roadmap 2.6),
 *		    even though its true, unrounded extent was clearly
 *		    meant to be visible (e.g. a hairline table border
 *		    drawn as a thin filled rectangle). If so, replace
 *		    the path GEOS already built with a small, explicit
 *		    rectangle nudged to at least 1 unit in the
 *		    collapsing dimension(s), covering the same raw
 *		    area, and fill *that* instead.
 * PARAMETERS:	    Gfx *gfx, RegionFillRule rule -- WINDING or
 *		    ODD_EVEN, matching whichever of f/f* triggered this
 * RETURNS:	    gTrue if it substituted and filled a nudged
 *		    rectangle itself (caller should do nothing further);
 *		    gFalse if there was nothing to fix (caller should
 *		    fall back to the normal doEndPath+GrFillPath path,
 *		    completely unaffected by any of this)
 ***********************************************************************/
static GBool
GfxFillWithMinThickness(Gfx *gfx, RegionFillRule rule)
{
    GfxState *state = gfx->state;
    Handle gstring = state->gstring;
    gdouble rawW, rawH;
    sword minX, minY, maxX, maxY;
    GBool collapsedX, collapsedY;

    if (!state->pathRawBoundsValid) {
	return gFalse;
    }

    rawW = state->pathRawMaxX - state->pathRawMinX;
    rawH = state->pathRawMaxY - state->pathRawMinY;

    minX = GdoubleToWordRounded(state->pathRawMinX);
    maxX = GdoubleToWordRounded(state->pathRawMaxX);
    minY = GdoubleToWordRounded(state->pathRawMinY);
    maxY = GdoubleToWordRounded(state->pathRawMaxY);

    /*
     * Only step in when rounding would collapse a dimension that
     * had genuine (not already-zero) extent -- 0.01 units is well
     * under any real hairline (typically >=0.1 units) but excludes
     * paths that are legitimately zero-area to begin with (some
     * generators emit degenerate no-op fills; those should stay
     * invisible, not get a phantom 1-unit rectangle).
     */
    collapsedX = (maxX == minX) && (rawW > 0.01);
    collapsedY = (maxY == minY) && (rawH > 0.01);

    if (!collapsedX && !collapsedY) {
	return gFalse;
    }

    if (collapsedX) {
	maxX = minX + 1;
    }
    if (collapsedY) {
	maxY = minY + 1;
    }

    /* Properly end whatever (degenerate) path is still open from
     * the preceding opMoveTo/opLineTo calls -- those never got a
     * matching GrEndPath (that's normally doEndPath's job, called
     * from the ordinary opFill/opEOFill path we're bypassing here).
     * Calling GrBeginPath straight onto a still-open path crashed
     * (fatal error inside GrBeginPath, observed via a font-related
     * caller elsewhere -- looks like corrupted state rather than a
     * clean, local failure, consistent with skipping a required
     * GrEndPath). */
    GrEndPath(gstring);
    GrBeginPath(gstring, PCT_REPLACE);
    GrMoveTo(gstring, minX, minY);
    GrDrawLineTo(gstring, maxX, minY);
    GrDrawLineTo(gstring, maxX, maxY);
    GrDrawLineTo(gstring, minX, maxY);
    GrDrawLineTo(gstring, minX, minY);
    GrCloseSubPath(gstring);
    GrEndPath(gstring);
    GrFillPath(gstring, rule);

    state->pathType = PATH_NONE;
    state->pathSubpathStartValid = gFalse;
    return gTrue;
}

static void _near opFill(Gfx *gfx, Obj args[], int numArgs) {

    if (gfx->state->pathSubpathStartValid)
	GrDrawLineTo(gfx->state->gstring, gfx->state->pathSubpathStartX,
		     gfx->state->pathSubpathStartY);
    if (GfxFillWithMinThickness(gfx, WINDING))
	return;
    if (doEndPath(gfx->state))
	GrFillPath(gfx->state->gstring, WINDING);
  (void) args;
  (void) numArgs;
}

static void _near opEOFill(Gfx *gfx, Obj args[], int numArgs) {

    if (gfx->state->pathSubpathStartValid)
	GrDrawLineTo(gfx->state->gstring, gfx->state->pathSubpathStartX,
		     gfx->state->pathSubpathStartY);
    if (GfxFillWithMinThickness(gfx, ODD_EVEN))
	return;
    if (doEndPath(gfx->state))
	GrFillPath(gfx->state->gstring, ODD_EVEN);
  (void) args;
  (void) numArgs;
}

static void _near opFillStroke(Gfx *gfx, Obj args[], int numArgs) {

    if (doEndPath(gfx->state)) {
	GrFillPath(gfx->state->gstring, WINDING);
	GrDrawPath(gfx->state->gstring);
    }
  (void) args;
  (void) numArgs;
}

static void _near opCloseFillStroke(Gfx *gfx, Obj args[], int numArgs) {
    Handle gstring = gfx->state->gstring;


    if (gfx->state->pathSubpathStartValid) {
	GrDrawLineTo(gstring, gfx->state->pathSubpathStartX,
		     gfx->state->pathSubpathStartY);
	GrCloseSubPath(gstring);
    }
    if (doEndPath(gfx->state)) {
	GrFillPath(gstring, WINDING);
	GrDrawPath(gstring);
    }
  (void) numArgs;
  (void) args;
}

static void _near opEOFillStroke(Gfx *gfx, Obj args[], int numArgs) {
    Handle gstring = gfx->state->gstring;


    if (doEndPath(gfx->state)) {
	GrFillPath(gstring, ODD_EVEN);
	GrDrawPath(gstring);
    }
  (void) args;
  (void) numArgs;
}

static void _near opCloseEOFillStroke(Gfx *gfx, Obj args[], int numArgs) {
    Handle gstring = gfx->state->gstring;


    if (gfx->state->pathSubpathStartValid) {
	GrDrawLineTo(gstring, gfx->state->pathSubpathStartX,
		     gfx->state->pathSubpathStartY);
	GrCloseSubPath(gstring);
    }
    if (doEndPath(gfx->state)) {
	GrFillPath(gstring, ODD_EVEN);
    GrDrawPath(gstring);
    }
  (void) args;
  (void) numArgs;
}

/***********************************************************************
 *		GfxUpdatePathBounds
 ***********************************************************************
 * SYNOPSIS:	    Extend state's raw (pre-rounding) path bounding box
 *		    to include one more point. Called from
 *		    opMoveTo/opLineTo/opCurveTo* as each point comes
 *		    in, in parallel with the already-rounded path GEOS
 *		    itself is building -- see project roadmap 2.6 and
 *		    the pathRawMinX etc. fields' own comment in
 *		    pdfGeode.goh for why this exists.
 * PARAMETERS:	    GfxState *state, gdouble x, gdouble y -- the raw
 *		    (unrounded) PDF-space coordinate of this point
 ***********************************************************************/
static void
GfxUpdatePathBounds(GfxState *state, gdouble x, gdouble y)
{
    if (!state->pathRawBoundsValid) {
	state->pathRawMinX = state->pathRawMaxX = x;
	state->pathRawMinY = state->pathRawMaxY = y;
	state->pathRawBoundsValid = gTrue;
    } else {
	if (x < state->pathRawMinX) state->pathRawMinX = x;
	if (x > state->pathRawMaxX) state->pathRawMaxX = x;
	if (y < state->pathRawMinY) state->pathRawMinY = y;
	if (y > state->pathRawMaxY) state->pathRawMaxY = y;
    }
}

static GBool doEndPath(GfxState *state) {
    Handle gstring = state->gstring;


    GrEndPath(gstring);
    state->pathSubpathStartValid = gFalse;

    if (state->pathType == PATH_NORMAL) {
	state->pathType = PATH_NONE;
	return gTrue;
    }

    if (state->pathType == PATH_CLIP) {
	GrSetClipPath(gstring, PCT_INTERSECTION, WINDING);
    } else if (state->pathType == PATH_CLIP_EO) {
	GrSetClipPath(gstring, PCT_INTERSECTION, ODD_EVEN);
    }

    state->pathType = PATH_NONE;
    return gFalse;
}

//------------------------------------------------------------------------
// path clipping operators
//------------------------------------------------------------------------

static void _near opClip(Gfx *gfx, Obj args[], int numArgs) {
//  clip = clipNormal;
    gfx->state->pathType = PATH_CLIP;
  (void) args;
  (void) numArgs;
}

static void _near opEOClip(Gfx *gfx, Obj args[], int numArgs) {
//  clip = clipEO;
    gfx->state->pathType = PATH_CLIP_EO;
  (void) args;
  (void) numArgs;
}

#ifdef __BORLANDC__
#pragma codeseg GFXCore
#endif
#ifdef __WATCOMC__
#pragma code_seg("GFXCore")
#endif

//------------------------------------------------------------------------
// text object operators
//------------------------------------------------------------------------

static void _near opBeginText(Gfx *gfx, Obj args[], int numArgs) {

  GrSaveTransform(gfx->state->gstring);

  GfxStateSetTextMat(gfx->state, IntToGdouble(1), IntToGdouble(0), 
		     IntToGdouble(0), IntToGdouble(1), 
		     IntToGdouble(0), IntToGdouble(0));

  GfxStateTextMoveTo(gfx->state, IntToGdouble(0), IntToGdouble(0));

//  out->updateTextMat(state);
//  out->updateTextPos(state);
  gfx->fontChanged = gTrue;
  (void) args;
  (void) numArgs;
}

static void _near opEndText(Gfx *gfx, Obj args[], int numArgs) {

    GrRestoreTransform(gfx->state->gstring);
  (void) args;
  (void) numArgs;
}

//------------------------------------------------------------------------
// text state operators
//------------------------------------------------------------------------

static void _near opSetCharSpacing(Gfx *gfx, Obj args[], int numArgs) {
    GfxStateSetCharSpace(gfx->state, getNum(&args[0]));
//  out->updateCharSpace(state);
  (void) numArgs;
}

static void _near opSetFont(Gfx *gfx, Obj args[], int numArgs) {
  GfxFont *font;

  if (!(font = GfxLookupFont(gfx, getName(&args[0]))))
    return;
  GfxStateSetFont(gfx->state, font, getNum(&args[1]));
  gfx->fontChanged = gTrue;
  (void) numArgs;
}

static void _near opSetTextLeading(Gfx *gfx, Obj args[], int numArgs) {
  GfxStateSetLeading(gfx->state, getNum(&args[0]));
  (void) numArgs;
}

static void _near opSetTextRender(Gfx *gfx, Obj args[], int numArgs) {
  GfxStateSetRender(gfx->state, getInt(&args[0]));
//  out->updateRender(state);
  (void) numArgs;
}

static void _near opSetTextRise(Gfx *gfx, Obj args[], int numArgs) {
  GfxStateSetRise(gfx->state, getNum(&args[0]));
//  out->updateRise(state);
  (void) numArgs;
}

static void _near opSetWordSpacing(Gfx *gfx, Obj args[], int numArgs) {
//  out->updateWordSpace(state);
  GfxStateSetWordSpace(gfx->state, getNum(&args[0]));

//  GfxStateSetWordSpace(gfx->state, getNum(&args[0]));
  GrSetTextSpacePad(gfx->state->gstring, 
		    ((sdword)((dword)GdoubleToWWFixed(getNum(&args[0])) << 5)));
  (void) numArgs;
}

static void _near opSetHorizScaling(Gfx *gfx, Obj args[], int numArgs) {
  GfxStateSetHorizScaling(gfx->state, getNum(&args[0]));
//  out->updateHorizScaling(state);
  (void) numArgs;
}

//------------------------------------------------------------------------
// text positioning operators
//------------------------------------------------------------------------

static void _near opTextMove(Gfx *gfx, Obj args[], int numArgs) {
  gdouble tx, ty;

  tx = gfx->state->lineX + getNum(&args[0]);
  ty = gfx->state->lineY + getNum(&args[1]);
  GfxStateTextMoveTo(gfx->state, tx, ty);
//  out->updateTextPos(state);
  (void) numArgs;
}

static void _near opTextMoveSet(Gfx *gfx, Obj args[], int numArgs) {
  gdouble tx, ty;
  GfxState *state = gfx->state;

  tx = state->lineX + getNum(&args[0]);
  ty = getNum(&args[1]);
  GfxStateSetLeading(state, -ty);
  ty += state->lineY;
  GfxStateTextMoveTo(state, tx, ty);
//  out->updateTextPos(state);
  (void) numArgs;
}

static void _near opSetTextMatrix(Gfx *gfx, Obj args[], int numArgs) {
  GfxState *state = gfx->state;

  GfxStateSetTextMat(state, getNum(&args[0]), getNum(&args[1]),
		     getNum(&args[2]), getNum(&args[3]),
		     getNum(&args[4]), getNum(&args[5]));

  GfxStateTextMoveTo(state, IntToGdouble(0), IntToGdouble(0));

//  out->updateTextMat(state);
//  out->updateTextPos(state);
  gfx->fontChanged = gTrue;
  (void) numArgs;
}

static void _near opTextNextLine(Gfx *gfx, Obj args[], int numArgs) {
  gdouble tx, ty;
  GfxState *state = gfx->state;

  tx = state->lineX;
  ty = state->lineY - GfxStateGetLeading(state);
  GfxStateTextMoveTo(state, tx, ty);
//  out->updateTextPos(state);
  (void) args;
  (void) numArgs;
}

//------------------------------------------------------------------------
// text string operators
//------------------------------------------------------------------------

static void _near opShowText(Gfx *gfx, Obj args[], int numArgs) {
  if (!GfxStateGetFont(gfx->state)) {
      EC_WARNING(-1);
//    error(getPos(), "No font in show");
    return;
  }
  setTextTransform(gfx);
  doShowText(gfx, getString(&args[0]));
  resetTextTransform(gfx);
  (void) numArgs;
}

static void _near opMoveShowText(Gfx *gfx, Obj args[], int numArgs) {
  gdouble tx, ty;
  GfxState *state = gfx->state;

  if (!GfxStateGetFont(state)) {
      EC_WARNING(-1);
//    error(getPos(), "No font in move/show");
    return;
  }
  tx = state->lineX;
  ty = state->lineY - GfxStateGetLeading(gfx->state);
  GfxStateTextMoveTo(state, tx, ty);
//  out->updateTextPos(state);
  setTextTransform(gfx);
  doShowText(gfx, getString(&args[0]));
  resetTextTransform(gfx);
  (void) numArgs;
}

static void _near opMoveSetShowText(Gfx *gfx, Obj args[], int numArgs) {
  gdouble tx, ty;
  GfxState *state = gfx->state;

  if (!GfxStateGetFont(state)) {
      EC_WARNING(-1);
//    error(getPos(), "No font in move/set/show");
    return;
  }
  GfxStateSetWordSpace(state, getNum(&args[0]));
  GfxStateSetCharSpace(state, getNum(&args[1]));
  tx = state->lineX;
  ty = state->lineY - GfxStateGetLeading(state);
  GfxStateTextMoveTo(state, tx, ty);
//  out->updateWordSpace(state);
//  out->updateCharSpace(state);
//  out->updateTextPos(state);
  setTextTransform(gfx);
  doShowText(gfx, getString(&args[2]));
  resetTextTransform(gfx);
  (void) numArgs;
}

static void _near opShowSpaceText(Gfx *gfx, Obj args[], int numArgs) {
  Array *a;
  Obj obj;
  word i;
  GfxState *state = gfx->state;

  if (!GfxStateGetFont(state)) {
      EC_WARNING(-1);
//    error(getPos(), "No font in show/space");
    return;
  }
  a = getArray(&args[0]);
  setTextTransform(gfx);
  for (i = 0; i < ArrayGetLength(a); ++i) {
    ArrayGet(a, i, &obj, gfx->xref);
    if (isNum(&obj)) {
	GfxStateTextShift(state, 
			  -(getNum(&obj) / 1000) *
			  GdoubleToWord(GfxStateGetFontSize(state)));
//      out->updateTextShift(state, obj.getNum());
    } else if (isString(&obj)) {
      doShowText(gfx, getString(&obj));
    } else {
	EC_WARNING(-1);
//      error(getPos(), "Element of show/space array must be number or string");
    }
    GfxObjFree(&obj);
  }
  resetTextTransform(gfx);
  (void) numArgs;
}

#define WWFixedToDWord(ww) (((long)ww.WWF_int << 16) | ww.WWF_frac)

void setTextTransform(Gfx *gfx)
{
  GfxFont *font;
  Handle gstring = gfx->state->gstring;
  char ch;
  WWFixedAsDWord geosWidthM, pdfWidthM;
  WWFixedAsDWord scaledWidthFactor;

  if (gfx->fontChanged) {
//    out->updateFont(state);

      GfxUpdateFont(gfx);
      gfx->fontChanged = gFalse;
/*
 * Set font-width factor, based on width of 'm' char
 */
      font = GfxStateGetFont(gfx->state);

      if (!font->fontWidthFactor) {

      if ((ch = GfxFontFindChar(font, 'm')) == 0)
          pdfWidthM = 0;
      else
    	  pdfWidthM = MakeWWFixed(font->widths[(unsigned char)ch]) / 1000;

	  if (pdfWidthM) {
/*
 * geosWidthM should also be divided by the font size; the pdfwidths are based
 * on a 1-pt font.  We fold the font size factor in as a multiplication below.
 */
	      geosWidthM = GrTextWidthWWFixed(gstring, "m", 1) >> 5;

	      if (geosWidthM) {
		  font->fontWidthFactor = 
		      GrUDivWWFixed(
			  GrMulWWFixed(
			      GdoubleToWWFixed(GfxStateGetFontSize(gfx->state)), pdfWidthM),
			  geosWidthM);
	      } else {
		  font->fontWidthFactor = 1L<<16;
	      }
	      
	  } else {
	      /* No pdf width */
	      font->fontWidthFactor = 1L<<16;
	  }
/*
 * Tweaks: disallow font expansion, or compression more than a factor of 3.
 * Why disallow expansion?  It seems to cause more text collisions than it avoids.
 */
	  if (font->fontWidthFactor > (1L<<16)) {
	      font->fontWidthFactor = 1L<<16;
	  } else
/*
 * This much compression is usually an error; go with factor of 1.
 * (I have a case where 'm' is not used in any string for that font, so the pdf 
 * generator assigns it a bogus width of 250 (instead of around 700-900).  Thus,
 * that font's strings get horribly compressed for no reason.)
 */
	  if (font->fontWidthFactor < 0x5555) {
	      font->fontWidthFactor = 1L<<16;
	  }
      }
      /*
       * Don't forget the horizontal scaling -- but into a LOCAL
       * variable, not back into font->fontWidthFactor itself (see
       * project roadmap R4). font->fontWidthFactor is a cached,
       * font-intrinsic value (computed once per font, guarded by
       * the `if (!font->fontWidthFactor)` above, then reused for
       * every subsequent switch back to this same font within the
       * document). Overwriting it in place with its own product
       * against horizScaling meant every repeated switch back to an
       * already-used font multiplied the ALREADY-scaled cached
       * value again -- compounding across repeated font switches
       * (confirmed: with a 50% horizontal scaling, four visits to
       * the same font shrank the effective width factor from 0.5 to
       * 0.0625). Invisible whenever horizScaling is exactly 1.0 (the
       * common case, PDF's own default), which is presumably why
       * this went unnoticed -- only visible with an explicit /Tz
       * other than 100 combined with reusing a font.
       */
      scaledWidthFactor = GrMulWWFixed(font->fontWidthFactor,
	      GfxStateGetHorizScaling(gfx->state));

      GrSetFontWidth(gstring, IntegerOf(scaledWidthFactor * 100));

  } /* if fontChanged */

  GrSaveTransform(gstring);

/*
 * Apply text rise (super/sub scripting)
 */
  GrApplyTranslation(gstring, 
		     0,
		     GfxStateGetRise(gfx->state));

/* text matrix already applied; apply font scaling factor, flip writing */
  GrApplyScale(gstring, MakeWWFixed(1) / FONT_SCALING_FACTOR,
		(-1L<<16)/FONT_SCALING_FACTOR);
}

void resetTextTransform(Gfx *gfx)
{
  GrRestoreTransform(gfx->state->gstring);
}

static void doShowText(Gfx *gfx, GooString *s) {
  GfxFont *font;
//  GfxFontEncoding16 *enc;
//  Guchar c8;
//  long c16;
//  GooString *s16;
//  long m, n;
//  double dx, dy, width, w, h;
  GfxState *state = gfx->state;
  WWFixedAsDWord width, fWidth;
  WWFixedAsDWord widthScale, charSpace, wordSpace;
  Handle gstring = state->gstring;
//  PointWWFixed curPos, curPos2;
//  WWFixedAsDWord stringWidth;
  word len;
  word render;
  short i;
  char *cp;

  font = GfxStateGetFont(state);
  /*
   * If the font has a charset and is symbolic, it probably has drawing commands for the glyphs
   * embedded in its FontFile.  So, draw nothing.
   */
  if (font->hasCharSet && (font->flags & fontSymbolic)) {
      return;
  }

	/* For efficiency: if we're in the normal rendering mode,
	 * we simply draw the text directly; otherwise, we draw the
	 * path, then stroke it.
	 */

  render = GfxStateGetRender(state);
  if (render != 0) 
  {
      GrBeginPath(gstring, PCT_REPLACE);
  }

  /*
   * fontSize, horizScaling, charSpace, wordSpace, and state itself
   * are all unchanged for the whole duration of one doShowText call
   * (nothing in the character loop below mutates any of them) --
   * precompute the per-character-width building blocks once here
   * instead of re-deriving them (getter calls, gdouble conversions,
   * a WWFixed multiply) for every single character.
   */
  widthScale = GrMulWWFixed(GdoubleToWWFixed(GfxStateGetFontSize(state)),
			     GfxStateGetHorizScaling(state));
  /*
   * PDF glyph widths are in thousandths of text space -- fold that
   * /1000 in here, once per doShowText call, instead of doing it
   * once per character in the loop below (previously via
   * GfxFontGetWidthChar, called once per character). See project
   * optimization analysis P3.
   */
  widthScale = widthScale / 1000;
  charSpace = GdoubleToWWFixed(GfxStateGetCharSpace(state));
  wordSpace = GdoubleToWWFixed(GfxStateGetWordSpace(state));

  //----- 16-bit font
  if (GfxFontIs16Bit(font)) {

  //----- 8-bit font
  } else {
/*
 * Draw a string.
 * PDF maintains a seperate "text transformation matrix", which we have
 * to fold in when drawing text.
 * Our gstate is upside down relative to PDF-standard, so we have to
 * flip the y-axis to make the chars come out upside-right.
 */
/*
 * The text matrix is now set overall when in text mode.
 * We still have to flip the chars, though, and apply any rise or horiz
 * scaling.  The FONT_SCALING_FACTOR is to overcome precision problems in
 * specifying small fonts (e.g., 1-pt), which seems to be done a lot.
 */

	len = GStrGetLength(s);
	if (len != 0) {
	    /* Draw 'em accurately */
        
	    cp = GStrGetCString(s);
	    for (i = 0; i < len; i++, cp++)
	    {
		char c = GfxFontMapChar(font, *cp, ' ');
		
		/* If the character's not a space, */
		if (c != C_SPACE)
		{
		    /* Move to the correct position if drawing past the first
		       character or drawing to a path. */
		    if (i > 0 || render != 0)
			GrMoveToWWFixed(gstring,
				((sdword)((dword)state->curTextX << 5)),
				((sdword)((dword)(-state->lineY) << 5)));
		    
		    /* Draw a character */
		    if (c == C_FI_LIGATURE)
			GrDrawTextAtCP(gstring, "fi", 2);
		    else
			GrDrawCharAtCP(gstring, (byte)c);
		}
		
		/* Update what the x position should be */
		/* fWidth used to come from GfxFontGetWidthChar(font, *cp),
		 * which divides by 1000 internally -- now folded into
		 * widthScale above (once per call, not once per
		 * character). MakeWWFixed is a cheap shift, not a
		 * division, so this loop no longer does any division
		 * at all for the common case. */
		fWidth = MakeWWFixed(font->widths[(unsigned char)*cp]);
		width = GrMulWWFixed(widthScale, fWidth) + charSpace;
		if (*cp == ' ')
		    width += wordSpace;
		state->curTextX += width;
	    }
	}
  }
  
  if (render != 0) {
      GrEndPath(gstring);
      
      if (render == 0 || render == 2 || render == 4 || render == 6) {
	  GrFillPath(gstring, ODD_EVEN);
      }
      if (render == 1 || render == 2 || render == 5 || render == 6) {
	  GrDrawPath(gstring);
      }
      if (render >= 4) {
	  GrSetClipPath(gstring, PCT_INTERSECTION, ODD_EVEN);
      }
  }
  
  /* Setup the current pen position for the next character (assuming there
     IS a next character). */
  GrMoveToWWFixed(gstring,
		  ((sdword)((dword)gfx->state->curTextX << 5)),
		  ((sdword)((dword)(-gfx->state->lineY) << 5)));
}

#if 0
long getNextChar16(GfxFontEncoding16 *enc, Guchar *p, long *c16) {
  int n;
  int code;
  int a, b, m;

  n = enc->codeLen[*p];
  if (n == 1) {
    *c16 = enc->map1[*p];
  } else {
    code = (p[0] << 8) + p[1];
    a = 0;
    b = enc->map2Len;
    // invariant: map2[2*a] <= code < map2[2*b]
    while (b - a > 1) {
      m = (a + b) >> 1;
      if (enc->map2[2*m] <= code)
	a = m;
      else if (enc->map2[2*m] > code)
	b = m;
      else
	break;
    }
    *c16 = enc->map2[2*a+1] + (code - enc->map2[2*a]);
  }
  return n;
}
#endif


/***********************************************************************
 *      GfxCheckPageResourceBudget
 ***********************************************************************
 * SYNOPSIS:        Check page resource budget.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  dword bytes    bytes
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static GBool GfxCheckPageResourceBudget(Gfx *gfx, dword bytes)
{
    EC(ECCheckBounds(gfx));

    if (gfx->nImages >= PDF_PAGE_RESOURCE_OBJECT_LIMIT ||
        bytes > PDF_PAGE_RESOURCE_VM_BUDGET ||
        gfx->pageResourceBytes > PDF_PAGE_RESOURCE_VM_BUDGET - bytes)
    {
        gfx->resourceLimitExceeded = gTrue;
        EC_WARNING(-1);
        return gFalse;
    }

    ++gfx->nImages;
    return gTrue;
}

/* XObject operators */

/***********************************************************************
 *      opXObject
 ***********************************************************************
 * SYNOPSIS:        Process op xobject.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void opXObject(Gfx *gfx, Obj args[], int numArgs)
{
#if 1
    Obj obj1, obj2;

    if (!GfxLookupXObject(gfx, getName(&args[0]), &obj1))
    {
        return;
    }
    if (!ObjIsStream(&obj1, "XObject"))
    {
        EC_WARNING(-1);

        ObjFree(&obj1);
        return;
    }
    DictLookup(ObjStreamGetDict(&obj1), "Subtype", &obj2, gfx->xref);
    if (isNameSame(&obj2, "Image"))
    {
        GfxDoImage(gfx, getStream(&obj1), gFalse);
    }
    else if (isNameSame(&obj2, "Form"))
    {
        GfxDoForm(gfx, &obj1);
    }
    else if (isName(&obj2))
    {
        EC_WARNING(-1);
    }

    else
    {
        EC_WARNING(-1);
    }

    ObjFree(&obj2);
    ObjFree(&obj1);
#endif
    (void)numArgs;
}

/***********************************************************************
 *      GfxDoImage
 ***********************************************************************
 * SYNOPSIS:        Process gfx do image.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Stream *str    string
 *                  GBool inlineImg    inline img
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void GfxDoImage(Gfx *gfx, Stream *str, GBool inlineImg)
{
#if 1
    Dict *dict;
    Obj obj1, obj2;
    word width, height;
    short bits;
    long rawVal;
    GBool mask;
    GfxColorSpace colorSpace;
    GfxImageColorMap colorMap;
    GBool invert;
    Stream *smaskStr;
    Obj smaskRef, smaskObj;
    Dict *smaskDict;
    word smaskWidth, smaskHeight;
    short smaskBits;

    /*
     * OPT-24: resource admission is deferred until the sampled bitmap
     * dimensions and pixel format are known.
     */

    dict = StreamGetDict(str);

    DictLookup(dict, "Width", &obj1, gfx->xref);
    if (isNull(&obj1))
    {
        ObjFree(&obj1);
        DictLookup(dict, "W", &obj1, gfx->xref);
    }
    if (!isInt(&obj1))
    {
        goto err2;
    }
    /*
     * Validate the RAW (long) value before it narrows into `width` (word,
     * unsigned 16-bit) -- see project optimization analysis R5.
     */
    rawVal = getInt(&obj1);
    if (rawVal <= 0 || rawVal > 65535)
    {
        goto err2;
    }
    width = (word)rawVal;
    ObjFree(&obj1);
    DictLookup(dict, "Height", &obj1, gfx->xref);
    if (isNull(&obj1))
    {
        ObjFree(&obj1);
        DictLookup(dict, "H", &obj1, gfx->xref);
    }
    if (!isInt(&obj1))
    {
        goto err2;
    }
    /* Same validation as /Width just above. */
    rawVal = getInt(&obj1);
    if (rawVal <= 0 || rawVal > 65535)
    {
        goto err2;
    }
    height = (word)rawVal;
    ObjFree(&obj1);

    /* image or mask? */
    DictLookup(dict, "ImageMask", &obj1, gfx->xref);
    if (isNull(&obj1))
    {
        ObjFree(&obj1);
        DictLookup(dict, "IM", &obj1, gfx->xref);
    }
    mask = gFalse;
    if (isBool(&obj1))
    {
        mask = getBool(&obj1);
    }
    else if (!isNull(&obj1))
    {
        goto err2;
    }
    ObjFree(&obj1);

    /* bit depth */
    DictLookup(dict, "BitsPerComponent", &obj1, gfx->xref);
    if (isNull(&obj1))
    {
        ObjFree(&obj1);
        DictLookup(dict, "BPC", &obj1, gfx->xref);
    }
    if (!isInt(&obj1))
    {
        goto err2;
    }
    rawVal = getInt(&obj1);
    /*
     * BitsPerComponent must be one of these five spec-defined values (PDF
     * 32000-1:2008, Table 89).
     */
    if (rawVal != 1 && rawVal != 2 && rawVal != 4 && rawVal != 8
        && rawVal != 16)
    {
        goto err2;
    }
    bits = (short)rawVal;
    ObjFree(&obj1);

    if (mask)
    {

        if (bits != 1)
        {
            goto err1;
        }
        invert = gFalse;
        DictLookup(dict, "Decode", &obj1, gfx->xref);
        if (isNull(&obj1))
        {
            ObjFree(&obj1);
            DictLookup(dict, "D", &obj1, gfx->xref);
        }
        if (isArray(&obj1))
        {
            ObjArrayGet(&obj1, 0, &obj2, gfx->xref);
            if (isInt(&obj2) && getInt(&obj2) == 1)
            {
                invert = gTrue;
            }
            ObjFree(&obj2);
        }
        else if (!isNull(&obj1))
        {
            goto err2;
        }
        ObjFree(&obj1);

        GfxDrawImageMask(gfx, str, width, height, invert, inlineImg);

    }
    else
    {

        DictLookup(dict, "ColorSpace", &obj1, gfx->xref);
        if (isNull(&obj1))
        {
            ObjFree(&obj1);
            DictLookup(dict, "CS", &obj1, gfx->xref);
        }
        if (isName(&obj1))
        {
            GfxLookupColorSpace(gfx, getName(&obj1), &obj2);
            if (!isNull(&obj2))
            {
                ObjFree(&obj1);
                ObjMove(&obj1, &obj2);
            }
            else
            {
                ObjFree(&obj2);
            }
        }
        GfxColorSpaceInit(&colorSpace, &obj1, gfx->xref);
        ObjFree(&obj1);
        if (!colorSpace.ok)
        {
            GfxColorSpaceFree(&colorSpace);
            goto err1;
        }
        DictLookup(dict, "Decode", &obj1, gfx->xref);
        if (isNull(&obj1))
        {
            ObjFree(&obj1);
            DictLookup(dict, "D", &obj1, gfx->xref);
        }
        GfxImageColorMapInit(&colorMap, bits, &obj1, &colorSpace, gfx->xref);
        ObjFree(&obj1);
        if (!colorMap.ok)
        {
            GfxImageColorMapFree(&colorMap);
            goto err1;
        }

        /*
         * /SMask: a separate, always-DeviceGray image XObject carrying per-
         * pixel opacity .
         */
        smaskStr = NULL;
        smaskWidth = smaskHeight = 0;
        smaskBits = 8;
        initNull(&smaskObj);
        DictLookupNF(dict, "SMask", &smaskRef);
        if (isRef(&smaskRef))
        {
            ObjFetch(&smaskObj, &smaskRef, gfx->xref);
            if (isStream(&smaskObj))
            {
                smaskDict = ObjStreamGetDict(&smaskObj);
                DictLookup(smaskDict, "Width", &obj1, gfx->xref);
                /*
                 * Same raw-value-before-narrowing validation as /Width above
                 * (project optimization analysis R5).
                 */
                if (isInt(&obj1))
                {
                    rawVal = getInt(&obj1);
                    if (rawVal > 0 && rawVal <= 65535)
                    {
                        smaskWidth = (word)rawVal;
                    }
                }
                ObjFree(&obj1);
                DictLookup(smaskDict, "Height", &obj1, gfx->xref);
                if (isInt(&obj1))
                {
                    rawVal = getInt(&obj1);
                    if (rawVal > 0 && rawVal <= 65535)
                    {
                        smaskHeight = (word)rawVal;
                    }
                }
                ObjFree(&obj1);
                DictLookup(smaskDict, "BitsPerComponent", &obj1, gfx->xref);
                if (isInt(&obj1))
                {
                    rawVal = getInt(&obj1);
                    if (rawVal == 1 || rawVal == 2 || rawVal == 4
                        || rawVal == 8 || rawVal == 16)
                    {
                        smaskBits = (short)rawVal;
                    }
                }
                ObjFree(&obj1);
                if (smaskWidth > 0 && smaskHeight > 0)
                {
                    smaskStr = getStream(&smaskObj);
                    if (!StreamResetImage(smaskStr, smaskWidth, 1, smaskBits))
                    {
                        smaskStr = NULL;
                    }
                }
                else
                {
                    smaskStr = NULL;
                }
            }
        }
        ObjFree(&smaskRef);

        GfxDrawImage(gfx, str, width, height, &colorMap, inlineImg,
            smaskStr, smaskWidth, smaskHeight, smaskBits);
        ObjFree(&smaskObj);
        GfxImageColorMapFree(&colorMap);
    }

    return;

    err2:
    ObjFree(&obj1);
    err1:
    EC_WARNING(-1);

#endif
}

/***********************************************************************
 *      GfxDoForm
 ***********************************************************************
 * SYNOPSIS:        Process gfx do form.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj *str    string
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void GfxDoForm(Gfx *gfx, Obj *str)
{
    (void)gfx;
    (void)str;
#if 0
    Parser *oldParser;
    GfxResources *resPtr;
    Dict *dict;
    Dict *resDict;
    Object matrixObj, bboxObj;
    double m[6];
    Object obj1, obj2;
    int i;

    dict = str->streamGetDict();

    dict->lookup("FormType", &obj1);
    if (!(obj1.isInt() && obj1.getInt() == 1))
    {
        obj1.free();
        error(getPos(), "Unknown form type");
        return;
    }
    obj1.free();

    dict->lookup("Matrix", &matrixObj);
    if (!matrixObj.isArray())
    {
        matrixObj.free();
        error(getPos(), "Bad form matrix");
        return;
    }
    dict->lookup("BBox", &bboxObj);
    if (!bboxObj.isArray())
    {
        matrixObj.free();
        bboxObj.free();
        error(getPos(), "Bad form bounding box");
        return;
    }

    /* push new resources on stack */
    dict->lookup("Resources", &obj1);
    if (obj1.isDict())
    {
        resDict = obj1.getDict();
        res = new GfxResources(res);
        res->fonts = NULL;
        resDict->lookup("Font", &obj2);
        if (obj2.isDict())
        {
            res->fonts = new GfxFontDict(obj2.getDict());
        }
        obj2.free();
        resDict->lookup("XObject", &res->xObjDict);
        resDict->lookup("ColorSpace", &res->colorSpaceDict);
        obj1.free();
    }

    out->saveState(state);
    state = state->save();

    oldParser = parser;

    for (i = 0; i < 6; ++i)
    {
        matrixObj.arrayGet(i, &obj1);
        m[i] = obj1.getNum();
        obj1.free();
    }
    state->concatCTM(m[0], m[1], m[2], m[3], m[4], m[5]);
    out->updateCTM(state, m[0], m[1], m[2], m[3], m[4], m[5]);

    for (i = 0; i < 4; ++i)
    {
        bboxObj.arrayGet(i, &obj1);
        m[i] = obj1.getNum();
        obj1.free();
    }
    state->moveTo(m[0], m[1]);
    state->lineTo(m[0] + m[2], m[1]);
    state->lineTo(m[0] + m[2], m[1] + m[3]);
    state->lineTo(m[0], m[1] + m[3]);
    state->closePath();
    out->clip(state);
    state->clearPath();

    display(str);

    matrixObj.free();
    bboxObj.free();

    /* restore parser */
    parser = oldParser;

    /* restore graphics state */
    state = state->restore();
    out->restoreState(state);

    /* pop resource stack */
    resPtr = res->next;
    delete res;
    res = resPtr;

    return;
#endif
}

/* Annotation appearance streams */

/***********************************************************************
 *      GfxApplyMatrix6
 ***********************************************************************
 * SYNOPSIS:        Apply matrix6.
 * PARAMETERS:      Handle gstring    gstring
 *                  gdouble m0    m0
 *                  gdouble m1    m1
 *                  gdouble m2    m2
 *                  gdouble m3    m3
 *                  gdouble m4    m4
 *                  gdouble m5    m5
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/
static void GfxApplyMatrix6(Handle gstring, gdouble m0, gdouble m1, gdouble m2,
    gdouble m3, gdouble m4, gdouble m5)
{
    TransMatrix tm;
    sdword tmp;

    tmp = GdoubleToWWFixed(m0);
    tm.TM_e11.WWF_int = IntegerOf(tmp);
    tm.TM_e11.WWF_frac = FractionOf(tmp);
    tmp = m1;
    tm.TM_e12.WWF_int = IntegerOf(tmp);
    tm.TM_e12.WWF_frac = FractionOf(tmp);
    tmp = m2;
    tm.TM_e21.WWF_int = IntegerOf(tmp);
    tm.TM_e21.WWF_frac = FractionOf(tmp);
    tmp = m3;
    tm.TM_e22.WWF_int = IntegerOf(tmp);
    tm.TM_e22.WWF_frac = FractionOf(tmp);
    tmp = m4;
    tm.TM_e31.DWF_int = (sword)IntegerOf(tmp);
    tm.TM_e31.DWF_frac = FractionOf(tmp);
    tmp = m5;
    tm.TM_e32.DWF_int = (sword)IntegerOf(tmp);
    tm.TM_e32.DWF_frac = FractionOf(tmp);

    GrApplyTransform(gstring, &tm);
}

/***********************************************************************
 *      GfxReadNumArray
 ***********************************************************************
 * SYNOPSIS:        Read number array.
 * PARAMETERS:      Obj *arrObj    arr obj
 *                  gdouble *out    out
 *                  short n    count
 *                  XRef *xref    cross-reference table
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void GfxReadNumArray(Obj *arrObj, gdouble *out, short n, XRef *xref)
{
    short i;
    Obj elem;

    for (i = 0; i < n; ++i)
    {
        ObjArrayGet(arrObj, i, &elem, xref);
        out[i] = isNum(&elem) ? getNum(&elem) : IntToGdouble(0);
        ObjFree(&elem);
    }
}

/***********************************************************************
 *      GfxDrawOneAnnotation
 ***********************************************************************
 * SYNOPSIS:        Draw one annotation.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj *annotObj    annot obj
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/
static void GfxDrawOneAnnotation(Gfx *gfx, Obj *annotObj)
{
    Dict *annotDict, *apDict, *formDict, *resDict;
    Obj rectObj, apObj, nObj, asObj, flagsObj;
    Obj bboxObj, matrixObj, resObj;
    long flags;
    gdouble rect[4], bbox[4], matrix[6];
    gdouble tx0, ty0, tx1, ty1, nx, ny;
    gdouble sx, sy, a[6], combined[6];
    gdouble tmp;
    GfxResources newRes;
    Handle gstring = gfx->state->gstring;

    if (!isDict(annotObj))
    {
        return;
    }
    annotDict = getDict(annotObj);

    /*
     * Hidden (bit 2, value 2) / NoView (bit 6, value 32) -- an annotation with
     * either set is never meant to be painted on screen at all.
     */
    DictLookup(annotDict, "F", &flagsObj, gfx->xref);
    flags = isInt(&flagsObj) ? getInt(&flagsObj) : 0;
    ObjFree(&flagsObj);
    if ((flags & 0x02) || (flags & 0x20))
    {
        return;
    }

    DictLookup(annotDict, "Rect", &rectObj, gfx->xref);
    if (!isArray(&rectObj) || ObjArrayGetLength(&rectObj) < 4)
    {
        ObjFree(&rectObj);
        return;
    }
    GfxReadNumArray(&rectObj, rect, 4, gfx->xref);
    ObjFree(&rectObj);
    /*
     * /Rect's corners aren't guaranteed to already be in (llx,lly,urx,ury)
     * order -- normalize
     */
    if (rect[0] > rect[2])
    {
        tmp = rect[0];
        rect[0] = rect[2];
        rect[2] = tmp;
    }
    if (rect[1] > rect[3])
    {
        tmp = rect[1];
        rect[1] = rect[3];
        rect[3] = tmp;
    }

    DictLookup(annotDict, "AP", &apObj, gfx->xref);
    if (!isDict(&apObj))
    {
        ObjFree(&apObj);
        return;
    }
    apDict = getDict(&apObj);
    DictLookup(apDict, "N", &nObj, gfx->xref);
    ObjFree(&apObj);

    if (isDict(&nObj) && !isStream(&nObj))
    {
        /*
         * No usable fallback if /AS is absent or doesn't match any state; skip
         * cleanly rather than guess.
         */
        Dict *statesDict = getDict(&nObj);
        Obj pickedObj;

        DictLookupNF(annotDict, "AS", &asObj);
        if (isName(&asObj))
        {
            DictLookup(statesDict, getName(&asObj), &pickedObj, gfx->xref);
            ObjFree(&nObj);
            nObj = pickedObj;
        }
        else
        {
            ObjFree(&nObj);
            initNull(&nObj);
        }
        ObjFree(&asObj);
    }

    if (!isStream(&nObj))
    {
        ObjFree(&nObj);
        return;
    }

    formDict = ObjStreamGetDict(&nObj);

    DictLookup(formDict, "BBox", &bboxObj, gfx->xref);
    if (!isArray(&bboxObj) || ObjArrayGetLength(&bboxObj) < 4)
    {
        ObjFree(&bboxObj);
        ObjFree(&nObj);
        return;
    }
    GfxReadNumArray(&bboxObj, bbox, 4, gfx->xref);
    ObjFree(&bboxObj);

    DictLookup(formDict, "Matrix", &matrixObj, gfx->xref);
    if (isArray(&matrixObj) && ObjArrayGetLength(&matrixObj) >= 6)
    {
        GfxReadNumArray(&matrixObj, matrix, 6, gfx->xref);
    }
    else
    {
        matrix[0] = IntToGdouble(1); matrix[1] = 0;
        matrix[2] = 0; matrix[3] = IntToGdouble(1);
        matrix[4] = 0; matrix[5] = 0;
    }
    ObjFree(&matrixObj);

    nx = GrMulWWFixed(bbox[0], matrix[0]) + GrMulWWFixed(bbox[1],
        matrix[2]) + matrix[4];
    ny = GrMulWWFixed(bbox[0], matrix[1]) + GrMulWWFixed(bbox[1],
        matrix[3]) + matrix[5];
    tx0 = tx1 = nx;
    ty0 = ty1 = ny;

    nx = GrMulWWFixed(bbox[2], matrix[0]) + GrMulWWFixed(bbox[1],
        matrix[2]) + matrix[4];
    ny = GrMulWWFixed(bbox[2], matrix[1]) + GrMulWWFixed(bbox[1],
        matrix[3]) + matrix[5];
    if (nx < tx0)
    {
        tx0 = nx;
    }
    if (nx > tx1)
    {
        tx1 = nx;
    }
    if (ny < ty0)
    {
        ty0 = ny;
    }
    if (ny > ty1)
    {
        ty1 = ny;
    }

    nx = GrMulWWFixed(bbox[2], matrix[0]) + GrMulWWFixed(bbox[3],
        matrix[2]) + matrix[4];
    ny = GrMulWWFixed(bbox[2], matrix[1]) + GrMulWWFixed(bbox[3],
        matrix[3]) + matrix[5];
    if (nx < tx0)
    {
        tx0 = nx;
    }
    if (nx > tx1)
    {
        tx1 = nx;
    }
    if (ny < ty0)
    {
        ty0 = ny;
    }
    if (ny > ty1)
    {
        ty1 = ny;
    }

    nx = GrMulWWFixed(bbox[0], matrix[0]) + GrMulWWFixed(bbox[3],
        matrix[2]) + matrix[4];
    ny = GrMulWWFixed(bbox[0], matrix[1]) + GrMulWWFixed(bbox[3],
        matrix[3]) + matrix[5];
    if (nx < tx0)
    {
        tx0 = nx;
    }
    if (nx > tx1)
    {
        tx1 = nx;
    }
    if (ny < ty0)
    {
        ty0 = ny;
    }
    if (ny > ty1)
    {
        ty1 = ny;
    }

    if (tx1 == tx0 || ty1 == ty0)
    {
        ObjFree(&nObj);
        return; /* degenerate BBox */
    }

    /* A: maps the transformed appearance box onto Rect */
    sx = GrUDivWWFixed(rect[2] - rect[0], tx1 - tx0);
    sy = GrUDivWWFixed(rect[3] - rect[1], ty1 - ty0);
    a[0] = sx; a[1] = 0; a[2] = 0; a[3] = sy;
    a[4] = rect[0] - GrMulWWFixed(tx0, sx);
    a[5] = rect[1] - GrMulWWFixed(ty0, sy);

    /* combined = Matrix followed by A */
    combined[0] = GrMulWWFixed(matrix[0], a[0]) + GrMulWWFixed(matrix[1], a[2]);
    combined[1] = GrMulWWFixed(matrix[0], a[1]) + GrMulWWFixed(matrix[1], a[3]);
    combined[2] = GrMulWWFixed(matrix[2], a[0]) + GrMulWWFixed(matrix[3], a[2]);
    combined[3] = GrMulWWFixed(matrix[2], a[1]) + GrMulWWFixed(matrix[3], a[3]);
    combined[4] = GrMulWWFixed(matrix[4], a[0]) + GrMulWWFixed(matrix[5],
        a[2]) + a[4];
    combined[5] = GrMulWWFixed(matrix[4], a[1]) + GrMulWWFixed(matrix[5],
        a[3]) + a[5];

    /*
     * --- push a resource layer for the appearance stream's own /Resources,
     * same construction GfxInit uses for the page's top- level resources.
     */
    DictLookup(formDict, "Resources", &resObj, gfx->xref);
    GfxResourcesInit(&newRes, gfx->res);
    if (isDict(&resObj))
    {
        Obj fontObj;
        resDict = getDict(&resObj);
        DictLookup(resDict, "Font", &fontObj, gfx->xref);
        if (isDict(&fontObj))
        {
            newRes.fonts = gmalloc(sizeof(GfxFontDict));
            if (newRes.fonts)
            {
                GfxFontDictInit(newRes.fonts, getDict(&fontObj), gfx->xref);
            }
        }
        ObjFree(&fontObj);
        DictLookup(resDict, "XObject", &newRes.xObjDict, gfx->xref);
        DictLookup(resDict, "ColorSpace", &newRes.colorSpaceDict, gfx->xref);
        DictLookup(resDict, "ExtGState", &newRes.extGStateDict, gfx->xref);
    }
    ObjFree(&resObj);
    gfx->res = &newRes;

    GfxStateSave(gfx->state);
    GrSaveState(gstring);

    GfxApplyMatrix6(gstring, combined[0], combined[1], combined[2],
        combined[3], combined[4], combined[5]);

    /*
     * clip to BBox in its own (now current) coordinate system -- axis-aligned
     * only, see STRATEGY above
     */
    GrSetClipRect(gstring, PCT_INTERSECTION,
        GdoubleToWord(bbox[0]), GdoubleToWord(bbox[1]),
        GdoubleToWord(bbox[2]), GdoubleToWord(bbox[3]));

    GfxDisplay(gfx, &nObj);

    GfxStateRestore(gfx->state);
    GrRestoreState(gstring);

    gfx->res = newRes.next;
    GfxResourcesFree(&newRes);

    ObjFree(&nObj);
}

/***********************************************************************
 *      GfxDrawAnnotations
 ***********************************************************************
 * SYNOPSIS:        Draw annotations.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj *annotsObj    annots obj
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/
void GfxDrawAnnotations(Gfx *gfx, Obj *annotsObj)
{
    word i, n;
    Obj annotObj;

    if (!isArray(annotsObj))
    {
        return;
    }
    n = ObjArrayGetLength(annotsObj);
    for (i = 0; i < n; ++i)
    {
        ObjArrayGet(annotsObj, i, &annotObj, gfx->xref);
        GfxDrawOneAnnotation(gfx, &annotObj);
        ObjFree(&annotObj);
    }
}

/***********************************************************************
 *      opBeginImage
 ***********************************************************************
 * SYNOPSIS:        Begin image.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void opBeginImage(Gfx *gfx, Obj args[], int numArgs)
{
#if 1
    Stream *str;
    long c1, c2;

    /*
     * This can't be allocated "Stream str" on the stack, because StreamFree
     * might try to free it (if there are chained streams).
     */
    str = gmalloc(sizeof(Stream));
    if (!str)
    {
        return;
    }

    /* build dict/stream */
    buildImageStream(gfx, &str);

    if (str->kind != strEOF)
    {
        GfxDoImage(gfx, str, gTrue);

        c1 = StreamGetChar(str);
        c2 = StreamGetChar(str);
        while (!(c1 == 'E' && c2 == 'I') && c2 != EOF)
        {
            c1 = c2;
            c2 = StreamGetChar(str);
        }
        if (c2 == EOF)
        {
            EC_WARNING(-1);
        } /* no EI tag */

        StreamFree(str);
        gfree(str);
    }
#endif
    (void)args;
    (void)numArgs;
}

/***********************************************************************
 *      buildImageStream
 ***********************************************************************
 * SYNOPSIS:        Build image stream.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Stream **str    string
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void buildImageStream(Gfx *gfx, Stream **str)
{
#if 1
    Obj dict;
    Obj obj;
    char *key;

    /* build dictionary */
    initDict(&dict);
    if (GMemHadError())
    {
        EOFStreamInit(*str, NULL);
        return;
    }
    ParserGetObj(gfx->parser, &obj);
    while (!isCmdSame(&obj, "ID") && !isEOF(&obj))
    {
        if (!isName(&obj))
        {
            EC_WARNING(-1);
            /*
             * error(getPos(), "Inline image dictionary key must be a name
             * object");
             */
            ObjFree(&obj);
            ParserGetObj(gfx->parser, &obj);
        }
        else
        {
            key = copyString(getName(&obj));
            ObjFree(&obj);
            if (!key)
            {
                ObjFree(&dict);
                EOFStreamInit(*str, NULL);
                return;
            }
            ParserGetObj(gfx->parser, &obj);
            if (isEOF(&obj) || isError(&obj))
            {
                break;
            }
            ObjDictAdd(&dict, key, &obj);
        }
        ParserGetObj(gfx->parser, &obj);
    }
    if (isEOF(&obj))
    {
        EC_WARNING(-1);
    }

    ObjFree(&obj);

    /* make stream */
    SubStreamInit(*str, LexerGetStream(gfx->parser->lexer), &dict);
    *str = StreamAddFilters(*str, &dict, gfx->xref);
    ObjFree(&dict);

    return;
#endif
}


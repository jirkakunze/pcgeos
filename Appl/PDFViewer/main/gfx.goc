/********************************************************************
 *                      GfxApplyColorArray
 ********************************************************************
 * SYNOPSIS:      Convert color components and set them as fill or stroke color.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *cs                   Ptr to the color space.
 *                *x                    Ptr to the components (0-255).
 *                stroke                gTrue for the stroke color.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void
GfxApplyColorArray(Gfx *gfx, GfxColorSpace *cs, short x[4], GBool stroke)
{
    GfxColor color;

    GfxColorSpaceGetColor(cs, x, &color);
    if (stroke)
    {
        GfxSetStrokeRGB(gfx, color.r, color.g, color.b);
    }
    else
    {
        GfxSetFillRGB(gfx, color.r, color.g, color.b);
    }
}

/********************************************************************
 *                      GfxApplyColorN
 ********************************************************************
 * SYNOPSIS:      Set a fill or stroke color from color operands.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *cs                   Ptr to the color space.
 *                *args                 Ptr to the operands (0-1).
 *                numArgs               Number of operands (1-4).
 *                stroke                gTrue for the stroke color.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void
GfxApplyColorN(Gfx *gfx, GfxColorSpace *cs, Obj args[], int numArgs, GBool stroke)
{
    short x[4];
    short i;

    if (numArgs < 1 || numArgs > 4)
    {
        EC_WARNING(-1);
        return;
    }
    x[0] = x[1] = x[2] = x[3] = 0;
    for (i = 0; i < numArgs; ++i)
    {
        if (!isNum(&args[i]))
        {
            EC_WARNING(-1);
            return;
        }
        x[i] = GdoubleToWord(255 * getNum(&args[i]));
    }

    GfxApplyColorArray(gfx, cs, x, stroke);
}

/********************************************************************
 *                      opSetFillColorSpace
 ********************************************************************
 * SYNOPSIS:      Operator cs: set the fill color space.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Resource names are resolved first. The color becomes component
 *                0. Pattern spaces keep their base space for uncolored
 *                patterns. Indexed is not supported as a fill color space.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opSetFillColorSpace(Gfx *gfx, Obj args[], int numArgs)
{
    Obj obj, resolved;
    GfxColorSpace cs;
    short zero[4];

    GfxLookupColorSpace(gfx, getName(&args[0]), &resolved);
    if (!isNull(&resolved))
    {
        ObjMove(&obj, &resolved);
    }
    else
    {
        GfxObjFree(&resolved);
        ObjMove(&obj, &args[0]);
    }

    /* Pattern: the color (pattern name) follows with scn */
    cs.ok = gFalse;
    if (GfxIsPatternSpace(gfx, &obj, &cs))
    {
        GfxObjFree(&obj);
        if (cs.ok)
        {
            gfx->state->fillColorSpace = cs;
        }
        (void)numArgs;
        return;
    }

    GfxColorSpaceInit(&cs, &obj, gfx->xref);
    GfxObjFree(&obj);

    if (cs.ok && !cs.indexed)
    {
        /* ATTENTION: Indexed fill color spaces are not supported (rare) */
        gfx->state->fillColorSpace = cs;

        /* PDF default: color 0 in the new color space */
        zero[0] = zero[1] = zero[2] = zero[3] = 0;
        GfxApplyColorArray(gfx, &gfx->state->fillColorSpace, zero, gFalse);
    }
    else
    {
        EC_WARNING(-1);
    }
    (void)numArgs;
}

/********************************************************************
 *                      opSetStrokeColorSpace
 ********************************************************************
 * SYNOPSIS:      Operator CS: set the stroke color space.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Same rules as opSetFillColorSpace.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opSetStrokeColorSpace(Gfx *gfx, Obj args[], int numArgs)
{
    Obj obj, resolved;
    GfxColorSpace cs;
    short zero[4];

    GfxLookupColorSpace(gfx, getName(&args[0]), &resolved);
    if (!isNull(&resolved))
    {
        ObjMove(&obj, &resolved);
    }
    else
    {
        GfxObjFree(&resolved);
        ObjMove(&obj, &args[0]);
    }

    cs.ok = gFalse;
    if (GfxIsPatternSpace(gfx, &obj, &cs))
    {
        GfxObjFree(&obj);
        if (cs.ok)
        {
            gfx->state->strokeColorSpace = cs;
        }
        (void)numArgs;
        return;
    }
    GfxColorSpaceInit(&cs, &obj, gfx->xref);
    GfxObjFree(&obj);

    if (cs.ok && !cs.indexed)
    {
        gfx->state->strokeColorSpace = cs;
        zero[0] = zero[1] = zero[2] = zero[3] = 0;
        GfxApplyColorArray(gfx, &gfx->state->strokeColorSpace, zero, gTrue);
    }
    else
    {
        EC_WARNING(-1);
    }
    (void)numArgs;
}

/********************************************************************
 *                      opSetFillColor
 ********************************************************************
 * SYNOPSIS:      Operator sc: set the fill color.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:      If the operand count does not match the color space, use gray,
 *                RGB or CMYK by the count.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opSetFillColor(Gfx *gfx, Obj args[], int numArgs)
{

    if (numArgs == gfx->state->fillColorSpace.numComps)
    {
        GfxApplyColorN(gfx, &gfx->state->fillColorSpace, args, numArgs, gFalse);
        return;
    }

    /* Operand count does not match cs/CS: use it to select the space */
    if (numArgs == 1)
    {
        opSetFillGray(gfx, args, numArgs);

    }
    else if (numArgs == 3)
    {
        opSetFillRGBColor(gfx, args, numArgs);

    }
    else if (numArgs == 4)
    {
        opSetFillCMYKColor(gfx, args, numArgs);

    }
    else
    {
        EC_WARNING(-1);
    }
}

/********************************************************************
 *                      opSetStrokeColor
 ********************************************************************
 * SYNOPSIS:      Operator SC: set the stroke color.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Same rules as opSetFillColor.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opSetStrokeColor(Gfx *gfx, Obj args[], int numArgs)
{

    if (numArgs == gfx->state->strokeColorSpace.numComps)
    {
        GfxApplyColorN(gfx, &gfx->state->strokeColorSpace, args, numArgs,
            gTrue);
        return;
    }

    if (numArgs == 1)
    {
        opSetStrokeGray(gfx, args, numArgs);

    }
    else if (numArgs == 3)
    {
        opSetStrokeRGBColor(gfx, args, numArgs);

    }
    else if (numArgs == 4)
    {
        opSetStrokeCMYKColor(gfx, args, numArgs);

    }
    else
    {
        EC_WARNING(-1);
    }
}

/********************************************************************
 *                      GfxIsPatternSpace
 ********************************************************************
 * SYNOPSIS:      Check if a color space is a pattern space.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *obj                  Ptr to the color space object.
 *                *base                 Ptr to the base space of [/Pattern base]
 *                                      (out); base->ok is gFalse if there is
 *                                      none.
 *
 * RETURNS:       GBool                 gTrue for /Pattern and [/Pattern ...].
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static GBool GfxIsPatternSpace(Gfx *gfx, Obj *obj, GfxColorSpace *base)
{
    Obj first;
    GBool isPattern = isNameSame(obj, "Pattern");

    if (isArray(obj))
    {
        ObjArrayGet(obj, 0, &first, gfx->xref);
        isPattern = isNameSame(&first, "Pattern");
        ObjFree(&first);

        /* [/Pattern base]: uncolored patterns take their color from base */
        if (isPattern && ObjArrayGetLength(obj) > 1)
        {
            ObjArrayGet(obj, 1, &first, gfx->xref);
            GfxColorSpaceInit(base, &first, gfx->xref);
            ObjFree(&first);
            if (!base->ok || base->indexed)
            {
                base->ok = gFalse;
            }
        }
    }
    return isPattern;
}

/********************************************************************
 *                      GfxPatternMidColor
 ********************************************************************
 * SYNOPSIS:      Return the replacement color of a shading pattern.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *name                 Ptr to the pattern resource name.
 *                *col                  Ptr to the color (out).
 *
 * RETURNS:       GBool                 gFalse if the pattern has no usable
 *                                      shading.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static GBool GfxPatternMidColor(Gfx *gfx, char *name, GfxColor *col)
{
    Obj patObj, shObj;
    Dict *dict;
    GBool ok = gFalse;

    GfxLookupResource(gfx, 0, name, &patObj);
    dict = isDict(&patObj) ? getDict(&patObj) :
        isStream(&patObj) ? ObjStreamGetDict(&patObj) : NULL;
    if (dict)
    {
        DictLookup(dict, "Shading", &shObj, gfx->xref);
        ok = GfxShadingMidColor(gfx, &shObj, col);
        ObjFree(&shObj);
    }
    GfxObjFree(&patObj);
    return ok;
}

/********************************************************************
 *                      opSetFillColorN
 ********************************************************************
 * SYNOPSIS:      Operator scn: set the fill color, also a pattern.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Patterns are not painted: an uncolored tiling pattern uses its
 *                color, a shading pattern its replacement color, others keep
 *                the old color.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opSetFillColorN(Gfx *gfx, Obj args[], int numArgs)
{
    char *name;
    GfxColor col;

    if (numArgs > 0 && isName(&args[numArgs - 1]))
    {
        /* Pattern: not painted; use the color of the pattern if possible */
        name = getName(&args[numArgs - 1]);
        if (numArgs > 1)
        {
            /* uncolored tiling pattern: c1..cn in the base color space */
            GfxApplyColorN(gfx, &gfx->state->fillColorSpace, args,
                numArgs - 1, gFalse);
        }
        else if (GfxPatternMidColor(gfx, name, &col))
        {
            gfx->state->fillColor = col;
            GrSetAreaColor(gfx->state->gstring, CF_RGB, col.r, col.g, col.b);
            GrSetTextColor(gfx->state->gstring, CF_RGB, col.r, col.g, col.b);
        }
        return;
    }
    GfxApplyColorN(gfx, &gfx->state->fillColorSpace, args, numArgs, gFalse);
}

/********************************************************************
 *                      opSetStrokeColorN
 ********************************************************************
 * SYNOPSIS:      Operator SCN: set the stroke color, also a pattern.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Same rules as opSetFillColorN.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opSetStrokeColorN(Gfx *gfx, Obj args[], int numArgs)
{
    GfxColor col;

    if (numArgs > 0 && isName(&args[numArgs - 1]))
    {
        /* Strokes cannot use a pattern: use its color if possible */
        if (numArgs > 1)
        {
            GfxApplyColorN(gfx, &gfx->state->strokeColorSpace, args,
                numArgs - 1, gTrue);
        }
        else if (GfxPatternMidColor(gfx, getName(&args[numArgs - 1]), &col))
        {
            GrSetLineColor(gfx->state->gstring, CF_RGB, col.r, col.g, col.b);
        }
        return;
    }
    GfxApplyColorN(gfx, &gfx->state->strokeColorSpace, args, numArgs, gTrue);
}

#ifdef __BORLANDC__
#pragma codeseg GFXCore
#endif
#ifdef __WATCOMC__
#pragma code_seg("GFXCore")
#endif

/********************************************************************
 *                      opMoveTo
 ********************************************************************
 * SYNOPSIS:      Operator m: start a new subpath.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:      The first m of a path starts a new GEOS path. The point is
 *                also recorded in the path buffer (strokes) and in the raw
 *                bounds (thin fills).
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opMoveTo(Gfx *gfx, Obj args[], int numArgs)
{
    Handle gstring = gfx->state->gstring;
    gdouble x, y;
    sword pathX, pathY;

    x = getNum(&args[0]);
    y = getNum(&args[1]);
    pathX = GdoubleToWordRounded(x);
    pathY = GdoubleToWordRounded(y);

    if (gfx->state->pathType != PATH_NORMAL)
    {
        GrBeginPath(gstring, PCT_REPLACE); /* new path */
        gfx->state->pathType = PATH_NORMAL;
        gfx->state->pathRawBoundsValid = gFalse;
        GfxPathReset(gfx);
    }
    GfxUpdatePathBounds(gfx->state, x, y);
    gfx->state->pathSubpathStartX = pathX;
    gfx->state->pathSubpathStartY = pathY;
    gfx->state->pathSubpathStartValid = gTrue;
    GfxPathAdd(gfx, GFX_SEG_MOVE, pathX, pathY);
    GrMoveTo(gstring, pathX, pathY);
    GrDrawLineTo(gstring, pathX, pathY);
    (void)numArgs;
}

/********************************************************************
 *                      opLineTo
 ********************************************************************
 * SYNOPSIS:      Operator l: add a line to the path.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opLineTo(Gfx *gfx, Obj args[], int numArgs)
{
    gdouble x, y;

    x = getNum(&args[0]);
    y = getNum(&args[1]);
    GfxUpdatePathBounds(gfx->state, x, y);
    GfxPathAdd(gfx, GFX_SEG_LINE, GdoubleToWordRounded(x),
        GdoubleToWordRounded(y));
    GrDrawLineTo(gfx->state->gstring,
        GdoubleToWordRounded(x),
        GdoubleToWordRounded(y));
    (void)numArgs;
}

/********************************************************************
 *                      opCurveTo
 ********************************************************************
 * SYNOPSIS:      Operator c: add a Bezier curve to the path.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opCurveTo(Gfx *gfx, Obj args[], int numArgs)
{
    Point p[3];
    Handle gstring = gfx->state->gstring;

    p[0].P_x = GdoubleToWordRounded(getNum(&args[0]));
    p[0].P_y = GdoubleToWordRounded(getNum(&args[1]));
    p[1].P_x = GdoubleToWordRounded(getNum(&args[2]));
    p[1].P_y = GdoubleToWordRounded(getNum(&args[3]));
    p[2].P_x = GdoubleToWordRounded(getNum(&args[4]));
    p[2].P_y = GdoubleToWordRounded(getNum(&args[5]));

    GfxUpdatePathBounds(gfx->state, getNum(&args[0]), getNum(&args[1]));
    GfxUpdatePathBounds(gfx->state, getNum(&args[2]), getNum(&args[3]));
    GfxUpdatePathBounds(gfx->state, getNum(&args[4]), getNum(&args[5]));

    GfxPathAddCurve(gfx, p);
    GrDrawCurveTo(gstring, p);
    (void)numArgs;
}

/********************************************************************
 *                      opCurveTo1
 ********************************************************************
 * SYNOPSIS:      Operator v: add a Bezier curve; the first control point is the
 *                current point.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opCurveTo1(Gfx *gfx, Obj args[], int numArgs)
{
    Point p[3];
    XYValueAsDWord curPos;
    Handle gstring = gfx->state->gstring;

    curPos = GrGetCurPos(gstring);

    p[0].P_x = (curPos & 0xffff);
    p[0].P_y = (curPos >> 16);
    p[1].P_x = GdoubleToWordRounded(getNum(&args[0]));
    p[1].P_y = GdoubleToWordRounded(getNum(&args[1]));
    p[2].P_x = GdoubleToWordRounded(getNum(&args[2]));
    p[2].P_y = GdoubleToWordRounded(getNum(&args[3]));

    /* Only args[0..3] are fresh PDF coordinates for raw bounds. */
    GfxUpdatePathBounds(gfx->state, getNum(&args[0]), getNum(&args[1]));
    GfxUpdatePathBounds(gfx->state, getNum(&args[2]), getNum(&args[3]));

    GfxPathAddCurve(gfx, p);
    GrDrawCurveTo(gstring, p);
    (void)numArgs;
}

/********************************************************************
 *                      opCurveTo2
 ********************************************************************
 * SYNOPSIS:      Operator y: add a Bezier curve; the second control point is
 *                the end point.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opCurveTo2(Gfx *gfx, Obj args[], int numArgs)
{
    Point p[3];
    Handle gstring = gfx->state->gstring;

    p[0].P_x = GdoubleToWordRounded(getNum(&args[0]));
    p[0].P_y = GdoubleToWordRounded(getNum(&args[1]));
    p[2].P_x = p[1].P_x = GdoubleToWordRounded(getNum(&args[2]));
    p[2].P_y = p[1].P_y = GdoubleToWordRounded(getNum(&args[3]));

    GfxUpdatePathBounds(gfx->state, getNum(&args[0]), getNum(&args[1]));
    GfxUpdatePathBounds(gfx->state, getNum(&args[2]), getNum(&args[3]));

    GfxPathAddCurve(gfx, p);
    GrDrawCurveTo(gstring, p);
    (void)numArgs;
}

/********************************************************************
 *                      opRectangle
 ********************************************************************
 * SYNOPSIS:      Operator re: add a rectangle to the path.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:      GrDrawRect includes the far edge: it is moved back by one
 *                unit. The path buffer gets the exact closed outline for
 *                strokes.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opRectangle(Gfx *gfx, Obj args[], int numArgs)
{
    sword x, y, x2, y2;
    Handle gstring = gfx->state->gstring;
    gdouble x0, y0, w0, h0;

    x0 = getNum(&args[0]);
    y0 = getNum(&args[1]);
    w0 = getNum(&args[2]);
    h0 = getNum(&args[3]);

    if (gfx->state->pathType != PATH_NORMAL)
    {
        GrBeginPath(gstring, PCT_REPLACE); /* new path */
        gfx->state->pathType = PATH_NORMAL;
        gfx->state->pathRawBoundsValid = gFalse;
        GfxPathReset(gfx);
    }

    GfxUpdatePathBounds(gfx->state, x0, y0);
    GfxUpdatePathBounds(gfx->state, x0 + w0, y0 + h0);

    x = GdoubleToWordRounded(x0);
    y = GdoubleToWordRounded(y0);
    x2 = x + GdoubleToWordRounded(w0);
    y2 = y + GdoubleToWordRounded(h0);

    /* stroke outline: exact corners, closed (joins at all corners) */
    GfxPathAdd(gfx, GFX_SEG_MOVE, x, y);
    GfxPathAdd(gfx, GFX_SEG_LINE, x2, y);
    GfxPathAdd(gfx, GFX_SEG_LINE, x2, y2);
    GfxPathAdd(gfx, GFX_SEG_LINE, x, y2);
    GfxPathAdd(gfx, GFX_SEG_CLOSE, x, y);

    if (w0 > 0)
    {
        --x2;
    }
    else if (w0 < 0)
    {
        ++x2;
    }

    if (h0 > 0)
    {
        --y2;
    }
    else if (h0 < 0)
    {
        ++y2;
    }

    GrDrawRect(gstring, x, y, x2, y2);

    gfx->state->pathSubpathStartValid = gFalse;
    (void)numArgs;
}

/********************************************************************
 *                      opClosePath
 ********************************************************************
 * SYNOPSIS:      Operator h: close the current subpath.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Not used.
 *                numArgs               Not used.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opClosePath(Gfx *gfx, Obj args[], int numArgs)
{
    GfxPathClose(gfx);
    (void)args;
    (void)numArgs;
}

/********************************************************************
 *                      opEndPath
 ********************************************************************
 * SYNOPSIS:      Operator n: end the path without painting (applies a pending
 *                clip).
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Not used.
 *                numArgs               Not used.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opEndPath(Gfx *gfx, Obj args[], int numArgs)
{
    doEndPath(gfx->state);
    (void)args;
    (void)numArgs;
}

/********************************************************************
 *                      opStroke
 ********************************************************************
 * SYNOPSIS:      Operator S: stroke the path.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Not used.
 *                numArgs               Not used.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opStroke(Gfx *gfx, Obj args[], int numArgs)
{
    if (doEndPath(gfx->state))
    {
        GfxStrokePath(gfx);
    }
    (void)args;
    (void)numArgs;
}

/********************************************************************
 *                      opCloseStroke
 ********************************************************************
 * SYNOPSIS:      Operator s: close and stroke the path.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Not used.
 *                numArgs               Not used.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opCloseStroke(Gfx *gfx, Obj args[], int numArgs)
{
    GfxPathClose(gfx);
    if (doEndPath(gfx->state))
    {
        GfxStrokePath(gfx);
    }
    (void)args;
    (void)numArgs;
}

/********************************************************************
 *                      GfxFillWithMinThickness
 ********************************************************************
 * SYNOPSIS:      Fill a path that rounding would make zero units thin.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                rule                  Fill rule.
 *
 * RETURNS:       GBool                 gTrue if the path was filled here as a
 *                                      1-unit rectangle.
 *
 * STRATEGY:      Hairline rules (filled thin rectangles) would vanish at GEOS
 *                integer coordinates.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static GBool
GfxFillWithMinThickness(Gfx *gfx, RegionFillRule rule)
{
    GfxState *state = gfx->state;
    Handle gstring = state->gstring;
    gdouble rawW, rawH;
    sword minX, minY, maxX, maxY;
    GBool collapsedX, collapsedY;

    if (!state->pathRawBoundsValid)
    {
        return gFalse;
    }

    rawW = state->pathRawMaxX - state->pathRawMinX;
    rawH = state->pathRawMaxY - state->pathRawMinY;

    minX = GdoubleToWordRounded(state->pathRawMinX);
    maxX = GdoubleToWordRounded(state->pathRawMaxX);
    minY = GdoubleToWordRounded(state->pathRawMinY);
    maxY = GdoubleToWordRounded(state->pathRawMaxY);

    /* Only if rounding makes a real extent zero */
    collapsedX = (maxX == minX) && (rawW > 0.01);
    collapsedY = (maxY == minY) && (rawH > 0.01);

    if (!collapsedX && !collapsedY)
    {
        return gFalse;
    }

    if (collapsedX)
    {
        maxX = minX + 1;
    }
    if (collapsedY)
    {
        maxY = minY + 1;
    }

    /* End the open degenerate path of m/l first */
    GrEndPath(gstring);
    GrBeginPath(gstring, PCT_REPLACE);
    GrMoveTo(gstring, minX, minY);
    GrDrawLineTo(gstring, maxX, minY);
    GrDrawLineTo(gstring, maxX, maxY);
    GrDrawLineTo(gstring, minX, maxY);
    GrDrawLineTo(gstring, minX, minY);
    GrCloseSubPath(gstring);
    GrEndPath(gstring);
    GfxFillPath(gfx, rule);

    state->pathType = PATH_NONE;
    state->pathSubpathStartValid = gFalse;
    return gTrue;
}

static void GfxFillPath(Gfx *gfx, RegionFillRule rule)
{
    /* Patterns are not painted: the color comes from scn */
    GrFillPath(gfx->state->gstring, rule);
}

/*
 * Shading replacement colors in their own segment (GFXCore size).
 * Called directly, never through opTab, and call no _near function.
 */
#pragma code_seg("GFXShade")

/********************************************************************
 *                      GfxShadingMidColor
 ********************************************************************
 * SYNOPSIS:      Return the replacement color of a shading.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *shading              Ptr to the shading dictionary or stream.
 *                *col                  Ptr to the color (out).
 *
 * RETURNS:       GBool                 gFalse if no color can be found.
 *
 * STRATEGY:      Middle of a type 2 function ((C0 + C1) / 2), also of the
 *                middle part of a type 3 function or of one function per
 *                component; else /Background. Shadings are not drawn in real
 *                mode. PM-TODO: draw shadings again (git history before I1:
 *                main/shading.c, main/function.c).
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static GBool GfxShadingMidColor(Gfx *gfx, Obj *shading, GfxColor *col)
{
    Dict *dict;
    Obj csObj, fnObj, sub, arr;
    GfxColorSpace cs;
    gdouble c0[4], c1[4], n;
    short x[4];
    short i, nComps;
    GBool ok = gFalse;

    dict = isDict(shading) ? getDict(shading) :
        isStream(shading) ? ObjStreamGetDict(shading) : NULL;
    if (!dict)
    {
        return gFalse;
    }
    DictLookup(dict, "ColorSpace", &csObj, gfx->xref);
    if (isName(&csObj))
    {
        /* named color space of the resources */
        GfxLookupColorSpace(gfx, getName(&csObj), &sub);
        if (!isNull(&sub))
        {
            ObjFree(&csObj);
            ObjMove(&csObj, &sub);
        }
        else
        {
            ObjFree(&sub);
        }
    }
    GfxColorSpaceInit(&cs, &csObj, gfx->xref);
    ObjFree(&csObj);
    if (!cs.ok)
    {
        GfxColorSpaceFree(&cs);
        return gFalse;
    }
    nComps = GfxColorSpaceGetNumPixelComps(&cs);
    if (nComps > 4)
    {
        nComps = 4;
    }
    x[0] = x[1] = x[2] = x[3] = 0;

    DictLookup(dict, "Function", &fnObj, gfx->xref);
    if (isArray(&fnObj))
    {
        /* one 1-out function per component */
        ok = gTrue;
        for (i = 0; i < nComps && ok; ++i)
        {
            ObjArrayGet(&fnObj, i, &sub, gfx->xref);
            ok = GfxParseType2Function(&sub, gfx->xref, c0, c1, &n);
            ObjFree(&sub);
            x[i] = GdoubleToWord(255 * ((c0[0] + c1[0]) / 2));
        }
    }
    else if (isDict(&fnObj) || isStream(&fnObj))
    {
        ok = GfxParseType2Function(&fnObj, gfx->xref, c0, c1, &n);
        if (!ok && isDict(&fnObj))
        {
            /* Type 3: middle part; a dictionary (types 0 and 4 are streams) */
            ObjDictLookup(&fnObj, "Functions", &arr, gfx->xref);
            if (isArray(&arr) && ObjArrayGetLength(&arr) > 0)
            {
                ObjArrayGet(&arr, ObjArrayGetLength(&arr) / 2, &sub,
                    gfx->xref);
                ok = GfxParseType2Function(&sub, gfx->xref, c0, c1, &n);
                ObjFree(&sub);
            }
            ObjFree(&arr);
        }
        for (i = 0; ok && i < nComps; ++i)
        {
            x[i] = GdoubleToWord(255 * ((c0[i] + c1[i]) / 2));
        }
    }
    ObjFree(&fnObj);

    if (!ok)
    {
        DictLookup(dict, "Background", &arr, gfx->xref);
        if (isArray(&arr) && ObjArrayGetLength(&arr) >= nComps)
        {
            ok = gTrue;
            for (i = 0; i < nComps; ++i)
            {
                ObjArrayGet(&arr, i, &sub, gfx->xref);
                x[i] = isNum(&sub) ? GdoubleToWord(255 * getNum(&sub)) : 0;
                ObjFree(&sub);
            }
        }
        ObjFree(&arr);
    }
    if (ok)
    {
        GfxColorSpaceGetColor(&cs, x, col);
    }
    GfxColorSpaceFree(&cs);
    return ok;
}

/********************************************************************
 *                      GfxShFillMidColor
 ********************************************************************
 * SYNOPSIS:      Fill the clip area with the replacement color of a shading
 *                (sh).
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *shading              Ptr to the shading dictionary or stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:      The clip box is in page space: transform it back with the
 *                inverse CTM.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxShFillMidColor(Gfx *gfx, Obj *shading)
{
    GfxState *state = gfx->state;
    GfxColor col;
    gdouble inv[6], ux, uy;
    Point pts[4];
    word i;

    if (!GfxShadingMidColor(gfx, shading, &col) ||
        !GfxMatInvert(state->ctm, inv))
    {
        return;
    }
    for (i = 0; i < 4; ++i)
    {
        GfxMatApply(inv, state->clipBox[(i == 1 || i == 2) ? 2 : 0],
            state->clipBox[(i >= 2) ? 3 : 1], &ux, &uy);
        /* 16.16 -> integer part: always within the sword range */
        pts[i].P_x = (sword)GdoubleToWord(ux);
        pts[i].P_y = (sword)GdoubleToWord(uy);
    }
    GrSaveState(state->gstring);
    GrSetAreaColor(state->gstring, CF_RGB, col.r, col.g, col.b);
    GrFillPolygon(state->gstring, ODD_EVEN, pts, 4);
    GrRestoreState(state->gstring);
}

#pragma code_seg("GFXCore")

/********************************************************************
 *                      opShFill
 ********************************************************************
 * SYNOPSIS:      Operator sh: paint a shading over the clip area.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opShFill(Gfx *gfx, Obj args[], int numArgs)
{
    Obj obj;

    GfxLookupResource(gfx, 1, getName(&args[0]), &obj);
    if (isDict(&obj) || isStream(&obj))
    {
        GfxShFillMidColor(gfx, &obj);
    }
    else
    {
        EC_WARNING(-1);
    }
    GfxObjFree(&obj);
    (void)numArgs;
}

/********************************************************************
 *                      opFill
 ********************************************************************
 * SYNOPSIS:      Operator f: fill the path (nonzero rule).
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Not used.
 *                numArgs               Not used.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opFill(Gfx *gfx, Obj args[], int numArgs)
{

    /* Close the subpath explicitly for the GEOS fill */
    if (gfx->state->pathSubpathStartValid)
    {
        GrDrawLineTo(gfx->state->gstring, gfx->state->pathSubpathStartX,
            gfx->state->pathSubpathStartY);
    }
    if (GfxFillWithMinThickness(gfx, WINDING))
    {
        return;
    }
    if (doEndPath(gfx->state))
    {
        GfxFillPath(gfx, WINDING);
    }
    (void)args;
    (void)numArgs;
}

/********************************************************************
 *                      opEOFill
 ********************************************************************
 * SYNOPSIS:      Operator f*: fill the path (even-odd rule).
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Not used.
 *                numArgs               Not used.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opEOFill(Gfx *gfx, Obj args[], int numArgs)
{

    /* Close the subpath explicitly for the GEOS fill */
    if (gfx->state->pathSubpathStartValid)
    {
        GrDrawLineTo(gfx->state->gstring, gfx->state->pathSubpathStartX,
            gfx->state->pathSubpathStartY);
    }
    if (GfxFillWithMinThickness(gfx, ODD_EVEN))
    {
        return;
    }
    if (doEndPath(gfx->state))
    {
        GfxFillPath(gfx, ODD_EVEN);
    }
    (void)args;
    (void)numArgs;
}


 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opSetFont(Gfx *gfx, Obj args[], int numArgs)
{
    GfxFont *font;

    if (!(font = GfxLookupFont(gfx, getName(&args[0]))))
    {
        return;
    }
    GfxStateSetFont(gfx->state, font, getNum(&args[1]));
    gfx->fontChanged = gTrue;
    (void)numArgs;
}


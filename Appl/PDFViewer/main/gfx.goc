#pragma code_seg("GFXText")

/********************************************************************
 *                      GfxUpdateFont
 ********************************************************************
 * SYNOPSIS:      Set the GEOS substitute font for the current font.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Mono, serif, symbol or sans by the font flags, with bold and
 *                italic styles.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxUpdateFont(Gfx *gfx)
{

    GfxState *state = gfx->state;
    GfxFont *font = gfx->state->font;
    FontID fontID;
    TextStyle style = 0;

    if (font->flags & fontFixedWidth)
    {
        fontID = FID_DTC_URW_MONO;

    }
    else if (font->flags & fontSerif)
    {
        fontID = FID_DTC_URW_ROMAN;
    }
    else if (font->flags & fontSymbolic)
    {
        fontID = FID_DTC_URW_SYMBOLPS;

    }
    else
    {
        fontID = FID_DTC_URW_SANS;
    }

    if (font->flags & fontItalic)
    {
        style |= TS_ITALIC;
    }

    if (font->flags & fontBold)
    {
        style |= TS_BOLD;
    }

    GrSetFont(state->gstring,
        fontID,
        GdoubleToWWFixed(FONT_SCALING_FACTOR *GfxStateGetFontSize(state)));

    GrSetTextStyle(state->gstring,
        style,
        ~style);
}

#ifdef __BORLANDC__
#pragma codeseg GFXImage
#endif
#ifdef __WATCOMC__
#pragma code_seg("GFXImage")
#endif

/********************************************************************
 *                      GfxReportProgress
 ********************************************************************
 * SYNOPSIS:      Call the progress callback of the engine.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                kind                  PDF_PROGRESS_* value.
 *                current               Progress so far.
 *                total                 Total amount of work.
 *
 * RETURNS:       void
 *
 * STRATEGY:      ProcCallFixedOrMovable_cdecl has no prototype: each argument
 *                is pushed at its own size. This prototyped function makes all
 *                arguments dwords, as the callback expects.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxReportProgress(Gfx *gfx, dword kind, dword current,
    dword total)
{
    if (gfx->progressCallback)
    {
        ProcCallFixedOrMovable_cdecl(gfx->progressCallback,
            kind, current, total, gfx->progressUserData);
    }
}

/********************************************************************
 *                      GfxCheckPageResourceBudget
 ********************************************************************
 * SYNOPSIS:      Count an image against the limits of the page.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                bytes                 Bitmap size of the image.
 *
 * RETURNS:       GBool                 gFalse if the page has too many images
 *                                      or bytes; the page is then cancelled.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static GBool GfxCheckPageResourceBudget(Gfx *gfx, dword bytes)
{
    EC(ECCheckBounds(gfx));

    if (gfx->nImages >= PDF_PAGE_RESOURCE_OBJECT_LIMIT ||
        bytes > PDF_PAGE_RESOURCE_VM_BUDGET ||
        gfx->pageResourceBytes > PDF_PAGE_RESOURCE_VM_BUDGET - bytes)
    {
        gfx->resourceLimitExceeded = gTrue;
        EC_WARNING(-1);
        return gFalse;
    }

    ++gfx->nImages;
    return gTrue;
}

/********************************************************************
 *                      opXObject
 ********************************************************************
 * SYNOPSIS:      Operator Do: draw an image or form XObject.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Called through opXObjectDispatch: the operator table holds
 *                only _near functions of GFXCore.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void opXObject(Gfx *gfx, Obj args[], int numArgs)
{
    Obj obj1, obj2;

    if (!GfxLookupXObject(gfx, getName(&args[0]), &obj1))
    {
        return;
    }
    if (!ObjIsStream(&obj1, "XObject"))
    {
        EC_WARNING(-1);

        ObjFree(&obj1);
        return;
    }
    DictLookup(ObjStreamGetDict(&obj1), "Subtype", &obj2, gfx->xref);
    if (isNameSame(&obj2, "Image"))
    {
        GfxDoImage(gfx, getStream(&obj1), gFalse);
    }
    else if (isNameSame(&obj2, "Form"))
    {
        GfxDoForm(gfx, &obj1);
    }
    else if (isName(&obj2))
    {
        EC_WARNING(-1);
    }

    else
    {
        EC_WARNING(-1);
    }

    ObjFree(&obj2);
    ObjFree(&obj1);
    (void)numArgs;
}

/********************************************************************
 *                      GfxDoImage
 ********************************************************************
 * SYNOPSIS:      Read the image dictionary and draw the image.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *str                  Ptr to the image stream.
 *                inlineImg             gTrue for an inline image (BI ID EI).
 *
 * RETURNS:       void
 *
 * STRATEGY:      Check /Width, /Height (1-65535) and /BitsPerComponent. Stencil
 *                masks go to GfxDrawImageMask; other images get a color map and
 *                an optional mask (/SMask wins over /Mask stream or color key)
 *                for GfxDrawImage. The page resource limit is checked when the
 *                bitmap size is known.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxDoImage(Gfx *gfx, Stream *str, GBool inlineImg)
{
    Dict *dict;
    Obj obj1, obj2;
    word width, height;
    short bits;
    long rawVal;
    GBool mask;
    GfxColorSpace colorSpace;
    GfxImageColorMap colorMap;
    GBool invert;
    Obj maskObj;
    GfxImageMask imgMask;
    short k, nComps;

    dict = StreamGetDict(str);

    DictLookup(dict, "Width", &obj1, gfx->xref);
    if (isNull(&obj1))
    {
        ObjFree(&obj1);
        DictLookup(dict, "W", &obj1, gfx->xref);
    }
    if (!isInt(&obj1))
    {
        goto err2;
    }
    /* Check the long value before it becomes a word */
    rawVal = getInt(&obj1);
    if (rawVal <= 0 || rawVal > 65535)
    {
        goto err2;
    }
    width = (word)rawVal;
    ObjFree(&obj1);
    DictLookup(dict, "Height", &obj1, gfx->xref);
    if (isNull(&obj1))
    {
        ObjFree(&obj1);
        DictLookup(dict, "H", &obj1, gfx->xref);
    }
    if (!isInt(&obj1))
    {
        goto err2;
    }
    /* Same check as for /Width */
    rawVal = getInt(&obj1);
    if (rawVal <= 0 || rawVal > 65535)
    {
        goto err2;
    }
    height = (word)rawVal;
    ObjFree(&obj1);

    DictLookup(dict, "ImageMask", &obj1, gfx->xref);
    if (isNull(&obj1))
    {
        ObjFree(&obj1);
        DictLookup(dict, "IM", &obj1, gfx->xref);
    }
    mask = gFalse;
    if (isBool(&obj1))
    {
        mask = getBool(&obj1);
    }
    else if (!isNull(&obj1))
    {
        goto err2;
    }
    ObjFree(&obj1);

    DictLookup(dict, "BitsPerComponent", &obj1, gfx->xref);
    if (isNull(&obj1))
    {
        ObjFree(&obj1);
        DictLookup(dict, "BPC", &obj1, gfx->xref);
    }
    if (mask && isNull(&obj1))
    {
        rawVal = 1;  /* optional for stencil masks, always 1 */
    }
    else if (!isInt(&obj1))
    {
        goto err2;
    }
    else
    {
        rawVal = getInt(&obj1);
    }
    /* /BitsPerComponent: 1, 2, 4, 8 or 16 (ISO 32000-1 Table 89) */
    if (rawVal != 1 && rawVal != 2 && rawVal != 4 && rawVal != 8
        && rawVal != 16)
    {
        goto err2;
    }
    bits = (short)rawVal;
    ObjFree(&obj1);

    if (mask)
    {

        if (bits != 1)
        {
            goto err1;
        }
        invert = gFalse;
        DictLookup(dict, "Decode", &obj1, gfx->xref);
        if (isNull(&obj1))
        {
            ObjFree(&obj1);
            DictLookup(dict, "D", &obj1, gfx->xref);
        }
        if (isArray(&obj1))
        {
            ObjArrayGet(&obj1, 0, &obj2, gfx->xref);
            if (isInt(&obj2) && getInt(&obj2) == 1)
            {
                invert = gTrue;
            }
            ObjFree(&obj2);
        }
        else if (!isNull(&obj1))
        {
            goto err2;
        }
        ObjFree(&obj1);

        GfxDrawImageMask(gfx, str, width, height, invert, inlineImg);

    }
    else
    {

        DictLookup(dict, "ColorSpace", &obj1, gfx->xref);
        if (isNull(&obj1))
        {
            ObjFree(&obj1);
            DictLookup(dict, "CS", &obj1, gfx->xref);
        }
        if (isName(&obj1))
        {
            GfxLookupColorSpace(gfx, getName(&obj1), &obj2);
            if (!isNull(&obj2))
            {
                ObjFree(&obj1);
                ObjMove(&obj1, &obj2);
            }
            else
            {
                ObjFree(&obj2);
            }
        }
        GfxColorSpaceInit(&colorSpace, &obj1, gfx->xref);
        ObjFree(&obj1);
        if (!colorSpace.ok)
        {
            GfxColorSpaceFree(&colorSpace);
            goto err1;
        }
        DictLookup(dict, "Decode", &obj1, gfx->xref);
        if (isNull(&obj1))
        {
            ObjFree(&obj1);
            DictLookup(dict, "D", &obj1, gfx->xref);
        }
        GfxImageColorMapInit(&colorMap, bits, &obj1, &colorSpace, gfx->xref);
        ObjFree(&obj1);
        if (!colorMap.ok)
        {
            GfxImageColorMapFree(&colorMap);
            goto err1;
        }

        /* /SMask wins over /Mask (stencil stream or color key array) */
        imgMask.str = NULL;
        imgMask.nKey = 0;
        DictLookup(dict, "SMask", &maskObj, gfx->xref);
        if (isStream(&maskObj))
        {
            GfxImageMaskStream(gfx, &maskObj, &imgMask);
        }
        else
        {
            ObjFree(&maskObj);
            DictLookup(dict, "Mask", &maskObj, gfx->xref);
            if (isStream(&maskObj))
            {
                GfxImageMaskStream(gfx, &maskObj, &imgMask);
                imgMask.invert = !imgMask.invert;  /* 1 = masked out */
            }
            else if (isArray(&maskObj))
            {
                nComps = GfxImageColorMapGetNumPixelComps(&colorMap);
                if (nComps <= 4 && ObjArrayGetLength(&maskObj) == 2 * nComps)
                {
                    for (k = 0; k < 2 * nComps; ++k)
                    {
                        ObjArrayGet(&maskObj, k, &obj1, gfx->xref);
                        rawVal = isInt(&obj1) ? getInt(&obj1) : 0;
                        ObjFree(&obj1);
                        if (bits == 16)
                        {
                            rawVal >>= 8;  /* samples keep the high byte */
                        }
                        if (rawVal < 0)
                        {
                            rawVal = 0;
                        }
                        else if (rawVal > 255)
                        {
                            rawVal = 255;
                        }
                        if (k & 1)
                        {
                            imgMask.keyMax[k >> 1] = (Guchar)rawVal;
                        }
                        else
                        {
                            imgMask.keyMin[k >> 1] = (Guchar)rawVal;
                        }
                    }
                    imgMask.nKey = nComps;
                }
            }
        }

        GfxDrawImage(gfx, str, width, height, &colorMap, inlineImg,
            &imgMask);
        ObjFree(&maskObj);
        GfxImageColorMapFree(&colorMap);
    }

    return;

    err2:
    ObjFree(&obj1);
    err1:
    EC_WARNING(-1);

}

/********************************************************************
 *                      GfxPushResources
 ********************************************************************
 * SYNOPSIS:      Push a resource level for a form or annotation.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *res                  Ptr to the new level (caller storage).
 *                *dict                 Ptr to the dictionary with /Resources.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxPushResources(Gfx *gfx, GfxResources *res, Dict *dict)
{
    Obj resObj, fontObj;
    Dict *resDict;

    GfxResourcesInit(res, gfx->res);
    DictLookup(dict, "Resources", &resObj, gfx->xref);
    if (isDict(&resObj))
    {
        resDict = getDict(&resObj);
        DictLookup(resDict, "Font", &fontObj, gfx->xref);
        if (isDict(&fontObj))
        {
            res->fonts = gmalloc(sizeof(GfxFontDict));
            if (res->fonts)
            {
                GfxFontDictInit(res->fonts, getDict(&fontObj), gfx->xref);
            }
        }
        ObjFree(&fontObj);
        DictLookup(resDict, "XObject", &res->xObjDict, gfx->xref);
        DictLookup(resDict, "ColorSpace", &res->colorSpaceDict, gfx->xref);
        DictLookup(resDict, "ExtGState", &res->extGStateDict, gfx->xref);
        DictLookup(resDict, "Pattern", &res->patternDict, gfx->xref);
        DictLookup(resDict, "Shading", &res->shadingDict, gfx->xref);
    }
    ObjFree(&resObj);
    gfx->res = res;
}

/* Per-level state of GfxDoForm, on the heap (small stack) */
typedef struct GfxFormFrame
{
    GfxResources res;
    gdouble bbox[4];
    gdouble matrix[6];
    Obj obj1;
} GfxFormFrame;

/********************************************************************
 *                      GfxDoForm
 ********************************************************************
 * SYNOPSIS:      Draw a form XObject.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *str                  Ptr to the form stream object.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Check /FormType and /BBox, push the form resources, apply
 *                /Matrix, clip to /BBox and draw the content nested. The frame
 *                is on the heap; the depth is limited to PDF_MAX_FORM_DEPTH
 *                (forms that call themselves).
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxDoForm(Gfx *gfx, Obj *str)
{
    Dict *formDict;
    GfxFormFrame *f;
    Handle gstring = gfx->state->gstring;

    if (gfx->formDepth >= PDF_MAX_FORM_DEPTH)
    {
        EC_WARNING(-1);
        return;
    }

    f = gmalloc(sizeof(GfxFormFrame));
    if (!f)
    {
        return;
    }
    formDict = ObjStreamGetDict(str);

    /* /FormType is optional; if present it must be 1 */
    DictLookup(formDict, "FormType", &f->obj1, gfx->xref);
    if (!isNull(&f->obj1) && !(isInt(&f->obj1) && getInt(&f->obj1) == 1))
    {
        ObjFree(&f->obj1);
        gfree(f);
        EC_WARNING(-1);
        return;
    }
    ObjFree(&f->obj1);

    DictLookup(formDict, "BBox", &f->obj1, gfx->xref);
    if (!isArray(&f->obj1) || ObjArrayGetLength(&f->obj1) < 4)
    {
        ObjFree(&f->obj1);
        gfree(f);
        EC_WARNING(-1);
        return;
    }
    GfxReadNumArray(&f->obj1, f->bbox, 4, gfx->xref);
    ObjFree(&f->obj1);

    DictLookup(formDict, "Matrix", &f->obj1, gfx->xref);
    if (isArray(&f->obj1) && ObjArrayGetLength(&f->obj1) >= 6)
    {
        GfxReadNumArray(&f->obj1, f->matrix, 6, gfx->xref);
    }
    else
    {
        f->matrix[0] = IntToGdouble(1); f->matrix[1] = 0;
        f->matrix[2] = 0; f->matrix[3] = IntToGdouble(1);
        f->matrix[4] = 0; f->matrix[5] = 0;
    }
    ObjFree(&f->obj1);

    GfxPushResources(gfx, &f->res, formDict);

    GfxStateSave(gfx->state);
    GrSaveState(gstring);

    GfxApplyMatrix6(gstring, f->matrix[0], f->matrix[1], f->matrix[2],
        f->matrix[3], f->matrix[4], f->matrix[5]);
    GfxConcatCtm(gfx->state, f->matrix);
    GrSetClipRect(gstring, PCT_INTERSECTION,
        GdoubleToWord(f->bbox[0]), GdoubleToWord(f->bbox[1]),
        GdoubleToWord(f->bbox[2]), GdoubleToWord(f->bbox[3]));

    gfx->formDepth++;
    GfxDisplayNested(gfx, str);
    gfx->formDepth--;

    GfxStateRestore(gfx->state);
    GrRestoreState(gstring);

    gfx->res = f->res.next;
    GfxResourcesFree(&f->res);
    gfree(f);
}

/********************************************************************
 *                      GfxApplyMatrix6
 ********************************************************************
 * SYNOPSIS:      Apply a PDF matrix to a GString.
 *
 * PARAMETERS:    gstring               Handle of the GString.
 *                m0                    Matrix a.
 *                m1                    Matrix b.
 *                m2                    Matrix c.
 *                m3                    Matrix d.
 *                m4                    Matrix e (x).
 *                m5                    Matrix f (y).
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxApplyMatrix6(Handle gstring, gdouble m0, gdouble m1, gdouble m2,
    gdouble m3, gdouble m4, gdouble m5)
{
    TransMatrix tm;
    sdword tmp;

    tmp = GdoubleToWWFixed(m0);
    tm.TM_e11.WWF_int = IntegerOf(tmp);
    tm.TM_e11.WWF_frac = FractionOf(tmp);
    tmp = m1;
    tm.TM_e12.WWF_int = IntegerOf(tmp);
    tm.TM_e12.WWF_frac = FractionOf(tmp);
    tmp = m2;
    tm.TM_e21.WWF_int = IntegerOf(tmp);
    tm.TM_e21.WWF_frac = FractionOf(tmp);
    tmp = m3;
    tm.TM_e22.WWF_int = IntegerOf(tmp);
    tm.TM_e22.WWF_frac = FractionOf(tmp);
    tmp = m4;
    tm.TM_e31.DWF_int = (sword)IntegerOf(tmp);
    tm.TM_e31.DWF_frac = FractionOf(tmp);
    tmp = m5;
    tm.TM_e32.DWF_int = (sword)IntegerOf(tmp);
    tm.TM_e32.DWF_frac = FractionOf(tmp);

    GrApplyTransform(gstring, &tm);
}

/********************************************************************
 *                      GfxReadNumArray
 ********************************************************************
 * SYNOPSIS:      Read n numbers of an array.
 *
 * PARAMETERS:    *arrObj               Ptr to the array object.
 *                *out                  Ptr to the values (out); non-numbers are
 *                                      0.
 *                n                     Number of values.
 *                *xref                 Ptr to the cross-reference table.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxReadNumArray(Obj *arrObj, gdouble *out, short n, XRef *xref)
{
    short i;
    Obj elem;

    for (i = 0; i < n; ++i)
    {
        ObjArrayGet(arrObj, i, &elem, xref);
        out[i] = isNum(&elem) ? getNum(&elem) : IntToGdouble(0);
        ObjFree(&elem);
    }
}

/********************************************************************
 *                      opBeginImage
 ********************************************************************
 * SYNOPSIS:      Operator BI: read and draw an inline image.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Called through opBeginImageDispatch. After the image the data
 *                up to "EI" is skipped. The stream is on the heap: StreamFree
 *                may free it.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void opBeginImage(Gfx *gfx, Obj args[], int numArgs)
{
    Stream *str;
    short c1, c2;

    /* On the heap: StreamFree frees chained streams */
    str = gmalloc(sizeof(Stream));
    if (!str)
    {
        return;
    }

    buildImageStream(gfx, &str);

    if (str->kind != strEOF)
    {
        GfxDoImage(gfx, str, gTrue);

        c1 = StreamGetChar(str);
        c2 = StreamGetChar(str);
        while (!(c1 == 'E' && c2 == 'I') && c2 != EOF)
        {
            c1 = c2;
            c2 = StreamGetChar(str);
        }
        if (c2 == EOF)
        {
            EC_WARNING(-1);
        } /* no EI tag */

        StreamFree(str);
        gfree(str);
    }
    (void)args;
    (void)numArgs;
}

/********************************************************************
 *                      buildImageStream
 ********************************************************************
 * SYNOPSIS:      Read the inline image dictionary and make its stream.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *str                  Ptr to the stream (in/out): a substream
 *                                      of the content stream with the filters;
 *                                      an EOF stream on error.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void buildImageStream(Gfx *gfx, Stream **str)
{
    Obj dict;
    Obj obj;
    char *key;

    initDict(&dict);
    if (GMemHadError())
    {
        EOFStreamInit(*str, NULL);
        return;
    }
    ParserGetObj(gfx->parser, &obj);
    while (!isCmdSame(&obj, "ID") && !isEOF(&obj))
    {
        if (!isName(&obj))
        {
            EC_WARNING(-1);
            ObjFree(&obj);
            ParserGetObj(gfx->parser, &obj);
        }
        else
        {
            key = copyString(getName(&obj));
            ObjFree(&obj);
            if (!key)
            {
                ObjFree(&dict);
                EOFStreamInit(*str, NULL);
                return;
            }
            ParserGetObj(gfx->parser, &obj);
            if (isEOF(&obj) || isError(&obj))
            {
                break;
            }
            ObjDictAdd(&dict, key, &obj);
        }
        ParserGetObj(gfx->parser, &obj);
    }
    if (isEOF(&obj))
    {
        EC_WARNING(-1);
    }

    ObjFree(&obj);

    SubStreamInit(*str, LexerGetStream(gfx->parser->lexer), &dict);
    *str = StreamAddFilters(*str, &dict, gfx->xref);
    ObjFree(&dict);

    return;
}


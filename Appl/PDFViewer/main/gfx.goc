/********************************************************************
 *                      opSetWordSpacing
 ********************************************************************
 * SYNOPSIS:      Operator Tw: set the word spacing.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Also set as GEOS space padding.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opSetWordSpacing(Gfx *gfx, Obj args[], int numArgs)
{

    GfxStateSetWordSpace(gfx->state, getNum(&args[0]));

    GrSetTextSpacePad(gfx->state->gstring,
        ((sdword)((dword)GdoubleToWWFixed(getNum(&args[0])) << 5)));

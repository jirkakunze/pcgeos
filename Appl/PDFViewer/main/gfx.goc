/***********************************************************************
 *      GfxObjFree
 ***********************************************************************
 * SYNOPSIS:        Release.
 * PARAMETERS:      Obj *obj    object
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near GfxObjFree(Obj *obj)
{
#ifdef DEBUG_MEM
    ObjFree(obj);
#else
    switch (obj->type)
    {
        case objBool:
        case objInt:
        case objReal:
        case objNull:
        case objRef:
        case objError:
        case objEOF:
        case objNone:
            obj->type = objNone;
            break;
        default:
            ObjFree(obj);
            break;
    }
#endif
}

/***********************************************************************
 *      GfxInit
 ***********************************************************************
 * SYNOPSIS:        Initialize.
 * PARAMETERS:      Gfx *this    this
 *                  Handle gstring    gstring
 *                  Dict *resDict    res dict
 *                  XRef *xref    cross-reference table
 *                  VMFileHandle vmFile1    vm file1
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void GfxInit(Gfx *this, Handle gstring, Dict *resDict, XRef *xref,
    VMFileHandle vmFile1)
{

    Obj obj1;

    /* start the resource stack */
    this->res = NULL;
    this->state = NULL;
    this->parser = 0;
    this->res = gmalloc(sizeof(GfxResources));
    if (!this->res)
    {
        return;
    }
    GfxResourcesInit(this->res, NULL);

    /* build font dictionary */
    this->res->fonts = NULL;
    if (resDict)
    {
        DictLookup(resDict, "Font", &obj1, xref);
        if (isDict(&obj1))
        {
            this->res->fonts = gmalloc(sizeof(GfxFontDict));
            if (this->res->fonts)
            {
                GfxFontDictInit(this->res->fonts, getDict(&obj1), xref);
            }
        }
        GfxObjFree(&obj1);
    }

    if (resDict)
    {
        DictLookup(resDict, "XObject", &this->res->xObjDict, xref);
    }
    else
    {
        initNull(&this->res->xObjDict);
    }

    if (resDict)
    {
        DictLookup(resDict, "ColorSpace", &this->res->colorSpaceDict, xref);
    }
    else
    {
        initNull(&this->res->colorSpaceDict);
    }

    if (resDict)
    {
        DictLookup(resDict, "ExtGState", &this->res->extGStateDict, xref);
    }
    else
    {
        initNull(&this->res->extGStateDict);
    }

    this->state = gmalloc(sizeof(GfxState));
    if (!this->state)
    {
        return;
    }
    GfxStateInit(this->state, gstring);

    this->fontChanged = gFalse;

    this->ignoreUndef = 0;

    this->parser = 0;
    this->xref = xref;
    this->vmFile = vmFile1;
    this->nImages = 0;
    this->resourceLimitExceeded = gFalse;
    this->pageResourceList = NullHandle;
    this->pageResourceCount = 0;
    this->pageResourceBytes = 0;

    this->progressCallback = NULL;
    this->progressUserData = NULL;
    this->cancelFlag = NULL;

}

/***********************************************************************
 *      GfxFree
 ***********************************************************************
 * SYNOPSIS:        Release.
 * PARAMETERS:      Gfx *this    this
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void GfxFree(Gfx *this)
{
    GfxResources *resPtr;

    while (this->res)
    {
        resPtr = this->res->next;
        GfxResourcesFree(this->res);
        gfree(this->res);
        this->res = resPtr;
    }
    if (this->state)
    {
        GfxStateFree(this->state);
        gfree(this->state);
    }
    /* An active parser here is an internal lifetime error. */
    EC_ERROR_IF(this->parser != NULL, -1);
}

/***********************************************************************
 *      GfxResourcesInit
 ***********************************************************************
 * SYNOPSIS:        Initialize.
 * PARAMETERS:      GfxResources *this    this
 *                  GfxResources *next1    next1
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void GfxResourcesInit(GfxResources *this, GfxResources *next1)
{
    this->next = next1;
    this->fonts = NULL;
    initNull(&this->xObjDict);
    initNull(&this->colorSpaceDict);
    initNull(&this->extGStateDict);
}

/***********************************************************************
 *      GfxResourcesFree
 ***********************************************************************
 * SYNOPSIS:        Release.
 * PARAMETERS:      GfxResources *this    this
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

void GfxResourcesFree(GfxResources *this)
{
    if (this->fonts)
    {
        GfxFontDictFree(this->fonts);
        gfree(this->fonts);
    }
    GfxObjFree(&this->xObjDict);
    GfxObjFree(&this->colorSpaceDict);
    GfxObjFree(&this->extGStateDict);
}

/***********************************************************************
 *      GfxDisplay
 ***********************************************************************
 * SYNOPSIS:        Display.
 * PARAMETERS:      Gfx *this    this
 *                  Obj *obj    object
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

GBool GfxDisplay(Gfx *this, Obj *obj)
{
    Obj obj2;
    word i;
    Parser parser;
    Lexer *lexer;
    XRef *xref = this->xref;
    GBool goRetval;

    if (isArray(obj))
    {
        for (i = 0; i < ObjArrayGetLength(obj); ++i)
        {
            ObjArrayGet(obj, i, &obj2, xref);
            if (!isStream(&obj2))
            {
                EC_WARNING(-1);

                GfxObjFree(&obj2);
                return gFalse;
            }
            GfxObjFree(&obj2);
        }
    }
    else if (!isStream(obj))
    {
        EC_WARNING(-1);

        return gFalse;
    }

    lexer = gmalloc(sizeof(Lexer)); /* ParserFree frees this */
    if (!lexer)
    {
        return gFalse;
    }
    LexerInitFromObj(lexer, obj, xref);
    if (GMemHadError())
    {
        LexerFree(lexer);
        gfree(lexer);
        return gFalse;
    }
    ParserInit(&parser, lexer);

    this->parser = &parser;
    goRetval = GfxGo(this, &parser);
    ParserFree(&parser);
    this->parser = 0;

    return goRetval;
}

/***********************************************************************
 *      GfxGo
 ***********************************************************************
 * SYNOPSIS:        Process gfx go.
 * PARAMETERS:      Gfx *this    this
 *                  Parser *parser    parser
 *
 * RETURNS:         success flag
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static GBool GfxGo(Gfx *this, Parser *parser)
{
    Obj obj;
    Obj args[maxArgs];
    Operator *pOpTab;
    long streamStart;
    long streamLen;
    int numCmds, numArgs;
    short i;
    GfxState *state = this->state;
    (void)state;

    /* scan a sequence of objects */
    numCmds = 0;
    numArgs = 0;
    streamStart = ParserGetPos(parser);
    streamLen = ParserGetLength(parser);
    /* Lock down op table */
    MemLock(OptrToHandle(@opTab));
    pOpTab = LMemDeref(@opTab);
    /* Loop over commands */
    ParserGetObj(parser, &obj);
    while (!isEOF(&obj))
    {

        /* got a command - execute it */
        if (isCmd(&obj))
        {
            GfxExecOp(this, &obj, args, numArgs, pOpTab);
            GfxObjFree(&obj);
            for (i = 0; i < numArgs; ++i)
            {
                GfxObjFree(&args[i]);
            }
            numArgs = 0;

            /*
             * OPT-15: a resource-limit hit inside an image operator must abort
             * the page instead of continuing with missing images.
             */
            if (this->resourceLimitExceeded)
            {
                break;
            }

            /* periodically update display */
            if (++numCmds > 200)
            {
                numCmds = 0;
                if (this->progressCallback)
                {
                    ProcCallFixedOrMovable_cdecl(this->progressCallback,
                        PDF_PROGRESS_PAGE,
                        ParserGetPos(parser) - streamStart,
                        streamLen,
                        this->progressUserData);
                }
                /*
                 * Check for a cancel request at the same checkpoint as the
                 * progress callback -- previously, cancellation was only
                 * checked inside the image-drawing loops (see U5).
                 */
                if (this->cancelFlag && *this->cancelFlag)
                {
                    break;
                }
            }

            /* got an argument - save it */
        }
        else if (numArgs < maxArgs)
        {
            ObjMove(&args[numArgs++], &obj);

            /* too many arguments - something is wrong */
        }
        else
        {
            EC_WARNING(-1);

            GfxObjFree(&obj);
        }

        ParserGetObj(parser, &obj);
    }
    GfxObjFree(&obj);
    /* Unlock the op table */
    MemUnlock(OptrToHandle(@opTab));

    /* args at end with no command */
    if (numArgs > 0)
    {
        EC_WARNING(-1);

        for (i = 0; i < numArgs; ++i)
        {
            GfxObjFree(&args[i]);
        }
    }

    /* gFalse reports cancellation, not a rendering error. */
    return !this->resourceLimitExceeded &&
        !(this->cancelFlag && *this->cancelFlag);
}

/***********************************************************************
 *      GfxExecOp
 ***********************************************************************
 * SYNOPSIS:        Process gfx exec op.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj *cmd    cmd
 *                  Obj args[]    args
 *                  int numArgs    num args
 *                  Operator *pOpTab    p op tab
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void GfxExecOp(Gfx *gfx, Obj *cmd, Obj args[], int numArgs, Operator *pOpTab)
{
    Operator *op;
    char *name;
    int i;

    EC(ECCheckBounds(gfx));
    EC(ECCheckBounds(cmd));
    EC(ECCheckBounds(args));
    EC(ECCheckBounds(pOpTab));

    /* find operator */
    name = getName(cmd);
    if (!(op = GfxFindOp(name, pOpTab)))
    {

        return;
    }

    /* type check args */
    if (op->numArgs >= 0)
    {
        if (numArgs != op->numArgs)
        {
            EC_WARNING(-1);

            return;
        }
    }
    else
    {
        if (numArgs > -op->numArgs)
        {
            EC_WARNING(-1);

            return;
        }
    }
    for (i = 0; i < numArgs; ++i)
    {
        if (!GfxCheckArg(&args[i], op->tchk[i]))
        {
            EC_WARNING(-1);

            return;
        }
    }

    (op->func)(gfx, args, numArgs);
}


/***********************************************************************
 *      GfxDrawImageMask
 ***********************************************************************
 * SYNOPSIS:        Draw image mask.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Stream *str    string
 *                  word width    width
 *                  word height    height
 *                  GBool invert    invert
 *                  GBool inlineImage    inline image
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *      DrawImageMask is another output-device method handled by me in
 *      Gfx instead.   Problems:  The mask is supposed to be...
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  mevissen    5/21/99     Initial Revision
 *
 ***********************************************************************/
void GfxDrawImageMask(Gfx *gfx, Stream *str, word width, word height,
    GBool invert, GBool inlineImage)
{

    Guchar pixBuf[4];
    word i, j;

    VMBlockHandle bitmap;
    GStateHandle bmState;
    byte *line;
    dword nElements;
    dword bitmapBytes;
    word size;
    Handle gstring = gfx->state->gstring;
    Guchar fillR, fillG, fillB;
    GBool paint;
    word xSamp, ySamp, xMod, yCount;
    word sampledWidth, sampledHeight, arrayInd;
    GBool useLine;
    /* reverse the sense of the 'invert' test */
    invert = !invert;

    fillR = (Guchar)gfx->state->fillColor.r;
    fillG = (Guchar)gfx->state->fillColor.g;
    fillB = (Guchar)gfx->state->fillColor.b;

    if (!StreamResetImage(str, width, 1, 1))
    {
        return;
    }

    /* reset cancel flag */
    if (gfx->cancelFlag)
    {
        * gfx->cancelFlag = gFalse;
    }
    /* Put up the image-progress dialog */
    if (!inlineImage && gfx->progressCallback)
    {
        ProcCallFixedOrMovable_cdecl(gfx->progressCallback,
            PDF_PROGRESS_IMAGE_BEGIN, 0, height,
            gfx->progressUserData);
    }

    /*
     * Same "some PDFs have full-page-sized images" concern GfxDrawImage
     * already handles (see that function's own comment) applies here too.
     */
    xSamp = width / 1500 + 1;
    ySamp = height / 1500 + 1;

    /*
     * Using floor here (the original code) under-sized the destination bitmap
     * by exactly one pixel whenever width % xSamp != 0.
     */
    sampledWidth = (word)(((dword)width + xSamp - 1) / xSamp);
    sampledHeight = (word)(((dword)height + ySamp - 1) / ySamp);

    /* Scale image coordinates because PDF image space is a unit square. */
    GrSaveTransform(gstring);
    GrApplyScale(gstring,
        (1L << 16) / sampledWidth,
        (1L << 16) / sampledHeight);
    /* ImageMask pixels must carry the current PDF fill color. */

    bitmapBytes = (dword)sampledWidth * (dword)sampledHeight * 3UL;
    if (!GfxCheckPageResourceBudget(gfx, bitmapBytes))
    {
        GrRestoreTransform(gstring);
        if (!inlineImage && gfx->progressCallback)
        {
            ProcCallFixedOrMovable_cdecl(gfx->progressCallback,
                PDF_PROGRESS_IMAGE_END, height, height,
                gfx->progressUserData);
        }
        return;
    }

    bitmap = GrCreateBitmap(BMF_24BIT | BMT_COMPLEX,
        sampledWidth,
        sampledHeight,
        gfx->vmFile,
        0,
        &bmState);

    if (!bitmap)
    {
        gfx->resourceLimitExceeded = gTrue;
        GrRestoreTransform(gstring);
        if (!inlineImage && gfx->progressCallback)
        {
            ProcCallFixedOrMovable_cdecl(gfx->progressCallback,
                PDF_PROGRESS_IMAGE_END, height, height,
                gfx->progressUserData);
        }
        return;
    }

    GrDestroyBitmap(bmState, BMD_LEAVE_DATA);

    /*
     * OPT-10/19: bind this HugeBitmap to the page cache and account its 24-bit
     * RGB pixel payload.
     */
    if (bitmap)
    {
        if (gfx->pageResourceList != NullHandle)
        {
            HugeArrayAppend(gfx->vmFile, gfx->pageResourceList, 1, &bitmap);
            ++gfx->pageResourceCount;
        }
        gfx->pageResourceBytes += bitmapBytes;
    }
    /* Fill the bitmap w/pixel data. */

    if (bitmap)
    {
        arrayInd = sampledHeight;
        yCount = 0;
        for (i = 0; i < height; ++i)
        {
            /*
             * As usual, the pdf object has to be flipped in the y direction
             * because pdf coords are defined with +y going up the page.
             */
            useLine = (yCount == 0);
            if (++yCount == ySamp)
            {
                yCount = 0;
            }
            if (useLine)
            {
                arrayInd--;
                nElements = HugeArrayLock(gfx->vmFile,
                    bitmap,
                    arrayInd,
                    (void **) & line,
                    &size);
            }
            else
            {
                nElements = 0;
            }

            xMod = 0;
            for (j = 0; j < width; ++j)
            {

                /*
                 * Check 'cancel' flag periodically within the row too, not
                 * just once per row after this loop finishes.
                 */
                if ((j & 0xff) == 0 && gfx->cancelFlag && *gfx->cancelFlag)
                {
                    break;
                }

                StreamGetImagePixel(str, pixBuf);

                if (nElements & 0xffff0000 && xMod == 0)
                {

                    /*
                     * same source-bit/invert relationship the old packed-mono-
                     * byte code had (bit XOR invert), just resolved one pixel
                     * at a time instead of eight at a go
                     */
                    paint = invert ? !(pixBuf[0] & 1) : (pixBuf[0] & 1);

                    if (paint)
                    {
                        *line++ = fillR;
                        *line++ = fillG;
                        *line++ = fillB;
                    }
                    else
                    {
                        *line++ = 255;
                        *line++ = 255;
                        *line++ = 255;
                    }
                }
                if (++xMod == xSamp)
                {
                    xMod = 0;
                }
            }

            if (nElements & 0xffff0000)
            {
                /* dirty/unlock the bitmap line data. */
                HugeArrayDirty(line);
                HugeArrayUnlock(line);
            }
            /*
             * Update the image-progress dialog every so often (every 32 lines)
             */
            if (!(i & 0x1f))
            {
                if (gfx->progressCallback)
                {
                    ProcCallFixedOrMovable_cdecl(gfx->progressCallback,
                        PDF_PROGRESS_IMAGE_UPDATE, i, height,
                        gfx->progressUserData);
                }
            }
            if (gfx->cancelFlag && *gfx->cancelFlag)
            {
                break;
            }
        }
    }
    /* Draw the bitmap into our gstring at coords (0,0). */
    if (bitmap && !(gfx->cancelFlag && *gfx->cancelFlag))
    {
        GrDrawHugeBitmap(gstring,
            0, 0,
            gfx->vmFile,
            bitmap);
    }
    /* Restore the transformation matrix */
    GrRestoreTransform(gstring);
    /* Take down the image-decode progress dialog */
    if (!inlineImage && gfx->progressCallback)
    {
        ProcCallFixedOrMovable_cdecl(gfx->progressCallback,
            PDF_PROGRESS_IMAGE_END, height, height,
            gfx->progressUserData);
    }
}

/***********************************************************************
 *      GfxDrawImage
 ***********************************************************************
 * SYNOPSIS:        Draw image.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Stream *str    string
 *                  word width    width
 *                  word height    height
 *                  GfxImageColorMap *colorMap    color map
 *                  GBool inlineImage    inline image
 *                  Stream *smaskStr    smask str
 *                  word smaskWidth    smask width
 *                  word smaskHeight    smask height
 *                  short smaskBits    smask bits
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *      DrawImage is another output-device method handled by me in Gfx.
 *      To do: For efficiency, indexed images should be...
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  mevissen    5/17/99     Initial Revision
 *
 ***********************************************************************/
void GfxDrawImage(Gfx *gfx, Stream *str, word width, word height,
    GfxImageColorMap *colorMap, GBool inlineImage, Stream *smaskStr, 
    word smaskWidth, word smaskHeight, short smaskBits)
{

    Guchar pixBuf[4];
    Guchar smaskPixBuf[4];
    Guchar *smaskRowBuf;
    long smaskRowLoaded;
    long smaskTargetRow, smaskCol;
    long smaskAccum;
    word alpha;
    short nComps, nBits;
    GfxColor color;
    word i, j;
    word sampledWidth, sampledHeight, arrayInd;
    VMBlockHandle bitmap;
    GStateHandle bmState;
    byte *line;
    dword nElements;
    dword bitmapBytes;
    word size;
    Handle gstring = gfx->state->gstring;
    word xSamp, ySamp, xMod, yCount;
    GBool useLine;
    
    /* Some pdf files have pages that are one big image. */
    xSamp = width / 1500 + 1;
    ySamp = height / 1500 + 1;

    /*
     * Ceiling division -- see the matching fix (and full explanation) in
     * GfxDrawImage above; same overflow risk applies here identically.
     */
    sampledWidth = (word)(((dword)width + xSamp - 1) / xSamp);
    sampledHeight = (word)(((dword)height + ySamp - 1) / ySamp);

    nComps = GfxImageColorMapGetNumPixelComps(colorMap);
    nBits = GfxImageColorMapGetBits(colorMap);

    /*
     * SMask row buffer: exactly one decoded row at a time, never the whole
     * mask image -- deliberately.
     */
    smaskRowBuf = NULL;
    smaskRowLoaded = -1;
    smaskAccum = 0;
    smaskTargetRow = 0;
    if (smaskStr)
    {
        smaskRowBuf = gmalloc(smaskWidth);
        if (!smaskRowBuf)
        {
            return;
        }
    }

    if (!StreamResetImage(str, width, nComps, nBits))
    {
        gfree(smaskRowBuf);
        return;
    }
    /* reset cancel flag */
    if (gfx->cancelFlag)
    {
        * gfx->cancelFlag = gFalse;
    }
    /* Put up the image-progress dialog */
    if (!inlineImage && gfx->progressCallback)
    {
        ProcCallFixedOrMovable_cdecl(gfx->progressCallback,
            PDF_PROGRESS_IMAGE_BEGIN, 0, height, gfx->progressUserData);
    }

    /* Scale image coordinates because PDF image space is a unit square. */
    GrSaveTransform(gstring);
    GrApplyScale(gstring,
        (1L << 16) / sampledWidth,
        (1L << 16) / sampledHeight);

    bitmapBytes = (dword)sampledWidth * (dword)sampledHeight * 3UL;

    if (!GfxCheckPageResourceBudget(gfx, bitmapBytes))
    {
        GrRestoreTransform(gstring);
        if (!inlineImage && gfx->progressCallback)
        {
            ProcCallFixedOrMovable_cdecl(gfx->progressCallback,
                PDF_PROGRESS_IMAGE_END, height, height,
                gfx->progressUserData);
        }
        if (smaskRowBuf)
        {
            gfree(smaskRowBuf);
        }
        return;
    }

    bitmap = GrCreateBitmap(BMF_24BIT | BMT_COMPLEX,
        sampledWidth,
        sampledHeight,
        gfx->vmFile,
        0,
        &bmState);

    if (!bitmap)
    {
        gfx->resourceLimitExceeded = gTrue;
        GrRestoreTransform(gstring);
        if (!inlineImage && gfx->progressCallback)
        {
            ProcCallFixedOrMovable_cdecl(gfx->progressCallback,
                PDF_PROGRESS_IMAGE_END, height, height,
                gfx->progressUserData);
        }
        if (smaskRowBuf)
        {
            gfree(smaskRowBuf);
        }
        return;
    }

    GrDestroyBitmap(bmState, BMD_LEAVE_DATA);

    if (bitmap)
    {
        if (gfx->pageResourceList != NullHandle)
        {
            HugeArrayAppend(gfx->vmFile, gfx->pageResourceList, 1, &bitmap);
            ++gfx->pageResourceCount;
        }
        gfx->pageResourceBytes += bitmapBytes;
    }
    /* Fill the bitmap w/pixel data. */

    if (bitmap)
    {
        arrayInd = sampledHeight;
        yCount = 0;
        for (i = 0; i < height; ++i)
        {
            /*
             * As usual, the pdf object has to be flipped in the y direction
             * because pdf coords are defined with +y going up the page.
             */
            useLine = (yCount == 0);
            if (++yCount == ySamp)
            {
                yCount = 0;
            }
            if (useLine)
            {
                arrayInd--;
            }

            if (smaskStr)
            {
                if (smaskHeight == height)
                {
                    smaskTargetRow = i;
                }

                while (smaskRowLoaded < smaskTargetRow)
                {
                    for (smaskCol = 0; smaskCol < smaskWidth; ++smaskCol)
                    {
                        StreamGetImagePixel(smaskStr, smaskPixBuf);
                        switch (smaskBits)
                        {
                            case 1:
                                smaskRowBuf[smaskCol] = smaskPixBuf[0] ?
                                    255 : 0;
                                break;
                            case 2:
                                smaskRowBuf[smaskCol] =
                                    (Guchar)(smaskPixBuf[0] * 85);
                                break;
                            case 4:
                                smaskRowBuf[smaskCol] =
                                    (Guchar)(smaskPixBuf[0] * 17);
                                break;
                            default:
                                smaskRowBuf[smaskCol] = smaskPixBuf[0];
                                break;
                        }
                    }
                    ++smaskRowLoaded;
                }

                if (smaskHeight != height)
                {
                    smaskAccum += smaskHeight;
                    while (smaskAccum >= (long)height)
                    {
                        smaskAccum -= height;
                        ++smaskTargetRow;
                    }
                }
            }
            if (useLine)
            {
                nElements = HugeArrayLock(gfx->vmFile,
                    bitmap, arrayInd, (void **) & line, &size);
            }
            else
            {
                nElements = 0;
            }

            xMod = 0;

            for (j = 0; j < width; ++j)
            {

                /*
                 * Same periodic cancel check as GfxDrawImageMask above -- see
                 * its comment (project optimization analysis U5).
                 */
                if ((j & 0xff) == 0 && gfx->cancelFlag && *gfx->cancelFlag)
                {
                    break;
                }

                StreamGetImagePixel(str, pixBuf);
                /*
                 * If we got the bitmap line locked down, and sampling is
                 * correct, transfer the pixel
                 */
                if (nElements & 0xffff0000 &&
                    (xMod == 0))
                {

                    GfxImageColorMapGetColor(colorMap, pixBuf, &color);
                    if (smaskStr)
                    {
                        if (smaskWidth == width)
                        {
                            alpha = smaskRowBuf[j];
                        }
                        else
                        {
                            smaskCol = (long)j * smaskWidth / width;
                            alpha = smaskRowBuf[smaskCol];
                        }
                        /*
                         * blend against white -- see the STRATEGY note on
                         * GfxDoImage's /SMask handling: we can't read back
                         * whatever's already drawn on the page.
                         */
                        color.r =
                            (short)(((word)color.r *alpha +
                            255 * (255 - alpha)) / 255);
                        color.g =
                            (short)(((word)color.g *alpha +
                            255 * (255 - alpha)) / 255);
                        color.b =
                            (short)(((word)color.b *alpha +
                            255 * (255 - alpha)) / 255);
                    }
                    *line++ = (byte)color.r;
                    *line++ = (byte)color.g;
                    *line++ = (byte)color.b;
                }
                if (++xMod == xSamp)
                {
                    xMod = 0;
                }
            }
            /* dirty/unlock the bitmap line data. */
            if (nElements & 0xffff0000)
            {
                HugeArrayDirty(line);
                HugeArrayUnlock(line);
            }
            /*
             * Update the image-progress dialog every so often (every 32 lines)
             */
            if (!(i & 0x1f))
            {
                if (gfx->progressCallback)
                {
                    ProcCallFixedOrMovable_cdecl(gfx->progressCallback,
                        PDF_PROGRESS_IMAGE_UPDATE, i, height, gfx->progressUserData);
                }
            }
            if (gfx->cancelFlag && *gfx->cancelFlag)
            {
                break;
            }
        }
    }
    if (bitmap && !(gfx->cancelFlag && *gfx->cancelFlag))
    {
        GrDrawHugeBitmap(gstring, 0, 0, gfx->vmFile, bitmap);
    }
    /* Restore the transformation matrix */
    GrRestoreTransform(gstring);
    /* Take down the image-decode progress dialog */
    if (!inlineImage && gfx->progressCallback)
    {
        ProcCallFixedOrMovable_cdecl(gfx->progressCallback,
            PDF_PROGRESS_IMAGE_END, height, height, gfx->progressUserData);
    }
    if (smaskRowBuf)
    {
        gfree(smaskRowBuf);
    }
}


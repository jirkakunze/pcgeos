/*
 * updateFont actually goes with the output device object, but I didn't
 * port that code so I'm adding it here.
 */
static void GfxUpdateFont(Gfx *gfx) {

    GfxState *state = gfx->state;
    GfxFont *font = gfx->state->font;
    FontID fontID;
    TextStyle style = 0;

/*
 * 1st approximation: just use the correct font type (serif, sans-serif, or 
 * fixed-width) at the specified size.
 * Also check flags for italic or bold rendering.  (I'm not sure yet if that flag
 * is set properly based on the font name, e.g. CourierBold, or if it's just
 * read from the flags param in the font dict.)
 */

    
    if (font->flags & fontFixedWidth) {
	fontID = FID_DTC_URW_MONO;

    } else if (font->flags & fontSerif) {
	fontID = FID_DTC_URW_ROMAN;
/*
 * The 'symbol' flag is set a lot of the time, even for regular text fonts.  
 * I don't know why.  I don't know how to distinguish a 'real' symbol font from
 * a bogus one; and we rarely actually see use of the symbol font, so: don't use
 * it.
 *
 * Correction: most of the common cases of fonts flagging themselves as
 * symbol are handled now.  Let the symbol font show once more!  -Dave 1/26/2000
 */
    } else if (font->flags & fontSymbolic) {
 	fontID = FID_DTC_URW_SYMBOLPS;
//	fontID = FID_DTC_URW_SANS;

    } else {
	fontID = FID_DTC_URW_SANS;
    }

    if (font->flags & fontItalic)
	style |= TS_ITALIC;

    if (font->flags & fontBold)
	style |= TS_BOLD;

    GrSetFont(state->gstring,
	      fontID,
	      GdoubleToWWFixed( FONT_SCALING_FACTOR * GfxStateGetFontSize(state)) );

    GrSetTextStyle(state->gstring,
		   style,
		   ~style);
}


#ifdef __BORLANDC__
#pragma codeseg GFXImage
#endif
#ifdef __WATCOMC__
#pragma code_seg("GFXImage")
#endif

/* SEG-01F: this helper is only used by the two image renderers, so
 * keep it in GFXImage instead of the otherwise unrelated default
 * gfx preamble resource. */
static GBool
GfxCheckPageResourceBudget(Gfx *gfx, dword bytes)
{
    EC( ECCheckBounds(gfx) );

    if (gfx->nImages >= PDF_PAGE_RESOURCE_OBJECT_LIMIT ||
        bytes > PDF_PAGE_RESOURCE_VM_BUDGET ||
        gfx->pageResourceBytes > PDF_PAGE_RESOURCE_VM_BUDGET - bytes) {
        gfx->resourceLimitExceeded = gTrue;
        EC_WARNING(-1);
        return gFalse;
    }

    ++gfx->nImages;
    return gTrue;
}

//------------------------------------------------------------------------
// XObject operators
//------------------------------------------------------------------------

static void opXObject(Gfx *gfx, Obj args[], int numArgs) {
#if 1
  Obj obj1, obj2;

  if (!GfxLookupXObject(gfx, getName(&args[0]), &obj1))
    return;
  if (!ObjIsStream(&obj1, "XObject")) {
      EC_WARNING(-1);
//    error(getPos(), "XObject '%s' is wrong type", args[0].getName());
    ObjFree(&obj1);
    return;
  }
  DictLookup(ObjStreamGetDict(&obj1), "Subtype", &obj2, gfx->xref);
  if (isNameSame(&obj2, "Image"))
    GfxDoImage(gfx, getStream(&obj1), gFalse);
  else if (isNameSame(&obj2, "Form"))
    GfxDoForm(gfx, &obj1);
  else if (isName(&obj2))
      EC_WARNING(-1);
//    error(getPos(), "Unknown XObject subtype '%s'", obj2.getName());
  else
      EC_WARNING(-1);
//    error(getPos(), "XObject subtype is missing or wrong type");
  ObjFree(&obj2);
  ObjFree(&obj1);
#endif
  (void) numArgs;
}

static void GfxDoImage(Gfx *gfx, Stream *str, GBool inlineImg) {
#if 1
  Dict *dict;
  Obj obj1, obj2;
  word width, height;
  short bits;
  long rawVal;
  GBool mask;
  GfxColorSpace colorSpace;
  GfxImageColorMap colorMap;
  GBool invert;
  Stream *smaskStr;
  Obj smaskRef, smaskObj;
  Dict *smaskDict;
  word smaskWidth, smaskHeight;
  short smaskBits;

  /* OPT-24: resource admission is deferred until the sampled bitmap
   * dimensions and pixel format are known.  GfxDrawImageMask() and
   * GfxDrawImage() then charge the real estimated VM payload against
   * the shared per-page byte budget. */

  // get stream dict
  dict = StreamGetDict(str);

  // get size
  DictLookup(dict, "Width", &obj1, gfx->xref);
  if (isNull(&obj1)) {
    ObjFree(&obj1);
    DictLookup(dict, "W", &obj1, gfx->xref);
  }
  if (!isInt(&obj1))
    goto err2;
  /*
   * Validate the RAW (long) value before it narrows into `width`
   * (word, unsigned 16-bit) -- see project optimization analysis
   * R5. Without this, a negative /Width (e.g. -1) or one exceeding
   * 65535 silently wraps on assignment to the narrower type (a
   * negative value in particular wraps to a huge, wildly wrong
   * positive one), rather than being rejected outright. 0 is also
   * rejected: a zero-width image is degenerate, nothing meaningful
   * to draw.
   */
  rawVal = getInt(&obj1);
  if (rawVal <= 0 || rawVal > 65535)
    goto err2;
  width = (word) rawVal;
  ObjFree(&obj1);
  DictLookup(dict, "Height", &obj1, gfx->xref);
  if (isNull(&obj1)) {
    ObjFree(&obj1);
    DictLookup(dict, "H", &obj1, gfx->xref);
  }
  if (!isInt(&obj1))
    goto err2;
  /* Same validation as /Width just above. */
  rawVal = getInt(&obj1);
  if (rawVal <= 0 || rawVal > 65535)
    goto err2;
  height = (word) rawVal;
  ObjFree(&obj1);

  // image or mask?
  DictLookup(dict, "ImageMask", &obj1, gfx->xref);
  if (isNull(&obj1)) {
    ObjFree(&obj1);
    DictLookup(dict, "IM", &obj1, gfx->xref);
  }
  mask = gFalse;
  if (isBool(&obj1))
    mask = getBool(&obj1);
  else if (!isNull(&obj1))
    goto err2;
  ObjFree(&obj1);

  // bit depth
  DictLookup(dict, "BitsPerComponent", &obj1, gfx->xref);
  if (isNull(&obj1)) {
    ObjFree(&obj1);
    DictLookup(dict, "BPC", &obj1, gfx->xref);
  }
  if (!isInt(&obj1))
    goto err2;
  rawVal = getInt(&obj1);
  /*
   * BitsPerComponent must be one of these five spec-defined values
   * (PDF 32000-1:2008, Table 89) -- see project optimization
   * analysis R5. The mask path below additionally requires exactly
   * 1 (masks are 1-bit by definition), checked separately; this
   * covers both paths against any other value, which would
   * otherwise flow straight into the color-map/bit-unpacking logic
   * with no basis for assuming it can handle it.
   */
  if (rawVal != 1 && rawVal != 2 && rawVal != 4 && rawVal != 8 && rawVal != 16)
    goto err2;
  bits = (short) rawVal;
  ObjFree(&obj1);

  // display a mask
  if (mask) {

    // check for inverted mask
    if (bits != 1)
      goto err1;
    invert = gFalse;
    DictLookup(dict, "Decode", &obj1, gfx->xref);
    if (isNull(&obj1)) {
      ObjFree(&obj1);
      DictLookup(dict, "D", &obj1, gfx->xref);
    }
    if (isArray(&obj1)) {
      ObjArrayGet(&obj1, 0, &obj2, gfx->xref);
      if (isInt(&obj2) && getInt(&obj2) == 1)
	invert = gTrue;
      ObjFree(&obj2);
    } else if (!isNull(&obj1)) {
      goto err2;
    }
    ObjFree(&obj1);

    // draw it
//    out->drawImageMask(state, str, width, height, invert, inlineImg);
    GfxDrawImageMask(gfx, str, width, height, invert, inlineImg);

  } else {

    // get color space and color map
    DictLookup(dict, "ColorSpace", &obj1, gfx->xref);
    if (isNull(&obj1)) {
      ObjFree(&obj1);
      DictLookup(dict, "CS", &obj1, gfx->xref);
    }
    if (isName(&obj1)) {
      GfxLookupColorSpace(gfx, getName(&obj1), &obj2);
      if (!isNull(&obj2)) {
	ObjFree(&obj1);
	ObjMove(&obj1, &obj2);
      } else {
	ObjFree(&obj2);
      }
    }
    GfxColorSpaceInit(&colorSpace, &obj1, gfx->xref);
    ObjFree(&obj1);
    if (!colorSpace.ok) {
      GfxColorSpaceFree(&colorSpace);
      goto err1;
    }
    DictLookup(dict, "Decode", &obj1, gfx->xref);
    if (isNull(&obj1)) {
      ObjFree(&obj1);
      DictLookup(dict, "D", &obj1, gfx->xref);
    }
    GfxImageColorMapInit(&colorMap, bits, &obj1, &colorSpace, gfx->xref);
    ObjFree(&obj1);
    if (!colorMap.ok) {
      GfxImageColorMapFree(&colorMap);
      goto err1;
    }

    /*
     * /SMask: a separate, always-DeviceGray image XObject carrying
     * per-pixel opacity (0 = fully transparent, 255 = fully opaque).
     * PDF never folds this into the base image's own samples, unlike
     * PNG's colorType 4/6 -- has to be fetched and read as an
     * entirely separate image stream, in lockstep with the base
     * image's own scanline loop (see GfxDrawImage). Not composited
     * against the real page background (we don't have arbitrary
     * read-back into whatever's already drawn); blended against
     * white instead, matching the platform's own official PNG
     * import driver's PNG_AT_BLEND convention for exactly this case.
     */
    smaskStr = NULL;
    smaskWidth = smaskHeight = 0;
    smaskBits = 8;
    initNull(&smaskObj);
    DictLookupNF(dict, "SMask", &smaskRef);
    if (isRef(&smaskRef)) {
      ObjFetch(&smaskObj, &smaskRef, gfx->xref);
      if (isStream(&smaskObj)) {
	smaskDict = ObjStreamGetDict(&smaskObj);
	DictLookup(smaskDict, "Width", &obj1, gfx->xref);
	/*
	 * Same raw-value-before-narrowing validation as /Width above
	 * (project optimization analysis R5) -- the smaskWidth > 0
	 * check further down runs AFTER assignment into the word
	 * variable, too late to catch a negative raw value that's
	 * already wrapped into a large, wrongly-valid-looking
	 * positive one.
	 */
	if (isInt(&obj1)) {
	  rawVal = getInt(&obj1);
	  if (rawVal > 0 && rawVal <= 65535) {
	    smaskWidth = (word) rawVal;
	  }
	}
	ObjFree(&obj1);
	DictLookup(smaskDict, "Height", &obj1, gfx->xref);
	if (isInt(&obj1)) {
	  rawVal = getInt(&obj1);
	  if (rawVal > 0 && rawVal <= 65535) {
	    smaskHeight = (word) rawVal;
	  }
	}
	ObjFree(&obj1);
	DictLookup(smaskDict, "BitsPerComponent", &obj1, gfx->xref);
	if (isInt(&obj1)) {
	  rawVal = getInt(&obj1);
	  if (rawVal == 1 || rawVal == 2 || rawVal == 4 || rawVal == 8 || rawVal == 16) {
	    smaskBits = (short) rawVal;
	  }
	}
	ObjFree(&obj1);
	if (smaskWidth > 0 && smaskHeight > 0) {
	  smaskStr = getStream(&smaskObj);
	  if (!StreamResetImage(smaskStr, smaskWidth, 1, smaskBits))
	    smaskStr = NULL;
	} else {
	  smaskStr = NULL;
	}
      }
    }
    ObjFree(&smaskRef);

    // draw it
//    out->drawImage(state, str, width, height, colorMap, inlineImg);
    GfxDrawImage(gfx, str, width, height, &colorMap, inlineImg,
		 smaskStr, smaskWidth, smaskHeight, smaskBits);
    ObjFree(&smaskObj);
    GfxImageColorMapFree(&colorMap);
  }

  return;

 err2:
  ObjFree(&obj1);
 err1:
  EC_WARNING(-1);
//  error(getPos(), "Bad image parameters");
#endif
}

static void GfxDoForm(Gfx *gfx, Obj *str) {
  (void) gfx;
  (void) str;
#if 0
  Parser *oldParser;
  GfxResources *resPtr;
  Dict *dict;
  Dict *resDict;
  Object matrixObj, bboxObj;
  double m[6];
  Object obj1, obj2;
  int i;

  // get stream dict
  dict = str->streamGetDict();

  // check form type
  dict->lookup("FormType", &obj1);
  if (!(obj1.isInt() && obj1.getInt() == 1)) {
    obj1.free();
    error(getPos(), "Unknown form type");
    return;
  }
  obj1.free();

  // get matrix and bounding box
  dict->lookup("Matrix", &matrixObj);
  if (!matrixObj.isArray()) {
    matrixObj.free();
    error(getPos(), "Bad form matrix");
    return;
  }
  dict->lookup("BBox", &bboxObj);
  if (!bboxObj.isArray()) {
    matrixObj.free();
    bboxObj.free();
    error(getPos(), "Bad form bounding box");
    return;
  }

  // push new resources on stack
  dict->lookup("Resources", &obj1);
  if (obj1.isDict()) {
    resDict = obj1.getDict();
    res = new GfxResources(res);
    res->fonts = NULL;
    resDict->lookup("Font", &obj2);
    if (obj2.isDict())
      res->fonts = new GfxFontDict(obj2.getDict());
    obj2.free();
    resDict->lookup("XObject", &res->xObjDict);
    resDict->lookup("ColorSpace", &res->colorSpaceDict);
    obj1.free();
  }

  // save current graphics state
  out->saveState(state);
  state = state->save();

  // save current parser
  oldParser = parser;

  // set form transformation matrix
  for (i = 0; i < 6; ++i) {
    matrixObj.arrayGet(i, &obj1);
    m[i] = obj1.getNum();
    obj1.free();
  }
  state->concatCTM(m[0], m[1], m[2], m[3], m[4], m[5]);
  out->updateCTM(state, m[0], m[1], m[2], m[3], m[4], m[5]);

  // set form bounding box
  for (i = 0; i < 4; ++i) {
    bboxObj.arrayGet(i, &obj1);
    m[i] = obj1.getNum();
    obj1.free();
  }
  state->moveTo(m[0], m[1]);
  state->lineTo(m[0]+m[2], m[1]);
  state->lineTo(m[0]+m[2], m[1]+m[3]);
  state->lineTo(m[0], m[1]+m[3]);
  state->closePath();
  out->clip(state);
  state->clearPath();

  // draw the form
  display(str);

  // free matrix and bounding box
  matrixObj.free();
  bboxObj.free();

  // restore parser
  parser = oldParser;

  // restore graphics state
  state = state->restore();
  out->restoreState(state);

  // pop resource stack
  resPtr = res->next;
  delete res;
  res = resPtr;

  return;
#endif
}

//------------------------------------------------------------------------
// Annotation appearance streams
//------------------------------------------------------------------------

/***********************************************************************
 *		GfxApplyMatrix6
 ***********************************************************************
 * SYNOPSIS:	    Concatenate an arbitrary 6-value PDF matrix
 *		    [a b c d e f] onto the current CTM -- same GEOS
 *		    primitive (GrApplyTransform + TransMatrix) opConcat
 *		    already uses for the `cm` operator, factored out
 *		    here so annotation rendering (and, incidentally,
 *		    any future GfxDoForm work) can reuse it.
 ***********************************************************************/
static void
GfxApplyMatrix6(Handle gstring, gdouble m0, gdouble m1, gdouble m2,
		 gdouble m3, gdouble m4, gdouble m5)
{
    TransMatrix tm;
    sdword tmp;

    tmp = GdoubleToWWFixed(m0);
    tm.TM_e11.WWF_int = IntegerOf(tmp);
    tm.TM_e11.WWF_frac = FractionOf(tmp);
    tmp = m1;
    tm.TM_e12.WWF_int = IntegerOf(tmp);
    tm.TM_e12.WWF_frac = FractionOf(tmp);
    tmp = m2;
    tm.TM_e21.WWF_int = IntegerOf(tmp);
    tm.TM_e21.WWF_frac = FractionOf(tmp);
    tmp = m3;
    tm.TM_e22.WWF_int = IntegerOf(tmp);
    tm.TM_e22.WWF_frac = FractionOf(tmp);
    tmp = m4;
    tm.TM_e31.DWF_int = (sword)IntegerOf(tmp);
    tm.TM_e31.DWF_frac = FractionOf(tmp);
    tmp = m5;
    tm.TM_e32.DWF_int = (sword)IntegerOf(tmp);
    tm.TM_e32.DWF_frac = FractionOf(tmp);

    GrApplyTransform(gstring, &tm);
}

static void
GfxReadNumArray(Obj *arrObj, gdouble *out, short n, XRef *xref)
{
    short i;
    Obj elem;

    for (i = 0; i < n; ++i) {
	ObjArrayGet(arrObj, i, &elem, xref);
	out[i] = isNum(&elem) ? getNum(&elem) : IntToGdouble(0);
	ObjFree(&elem);
    }
}

/***********************************************************************
 *		GfxDrawOneAnnotation
 ***********************************************************************
 * SYNOPSIS:	    Draw a single annotation's Normal appearance stream
 *		    (/AP /N), mapped from its own /BBox (through its own
 *		    /Matrix) onto the annotation's /Rect on the page --
 *		    PDF spec 12.5.5's "Appearance Streams" algorithm.
 *		    Skips cleanly (no drawing, no warning -- this is
 *		    routine, not an error) for anything that isn't a
 *		    straightforward paintable appearance: Hidden/NoView
 *		    flags, no /AP at all (Links and unstyled Popups
 *		    normally have none), an /AS-keyed state dict with no
 *		    matching or default entry, a degenerate /BBox.
 *
 * STRATEGY:	    Mostly mirrors the never-enabled GfxDoForm just above
 *		    (same underlying mechanism: a Form XObject-shaped
 *		    stream, drawn via its own Matrix/BBox/Resources) with
 *		    one extra step Form XObjects don't need: the
 *		    Matrix-transformed BBox has to additionally be mapped
 *		    onto Rect, since an annotation's appearance is meant
 *		    to fit within a page position, not just draw wherever
 *		    its own coordinate system happens to land. Clipping
 *		    to the transformed BBox uses GrSetClipRect, i.e. only
 *		    the axis-aligned case (no rotation/shear in /Matrix)
 *		    -- by far the common case in practice, and simple
 *		    rectangle clipping is all this port's GEOS clip
 *		    primitives offer without building general path-based
 *		    clipping (itself dead code here, see GfxSubpath/
 *		    GfxPath's #if 0 block).
 *
 ***********************************************************************/
static void
GfxDrawOneAnnotation(Gfx *gfx, Obj *annotObj)
{
    Dict *annotDict, *apDict, *formDict, *resDict;
    Obj rectObj, apObj, nObj, asObj, flagsObj;
    Obj bboxObj, matrixObj, resObj;
    long flags;
    gdouble rect[4], bbox[4], matrix[6];
    gdouble tx0, ty0, tx1, ty1, nx, ny;
    gdouble sx, sy, a[6], combined[6];
    gdouble tmp;
    GfxResources newRes;
    Handle gstring = gfx->state->gstring;

    if (!isDict(annotObj)) {
	return;
    }
    annotDict = getDict(annotObj);

    /* Hidden (bit 2, value 2) / NoView (bit 6, value 32) -- an
     * annotation with either set is never meant to be painted on
     * screen at all. */
    DictLookup(annotDict, "F", &flagsObj, gfx->xref);
    flags = isInt(&flagsObj) ? getInt(&flagsObj) : 0;
    ObjFree(&flagsObj);
    if ((flags & 0x02) || (flags & 0x20)) {
	return;
    }

    DictLookup(annotDict, "Rect", &rectObj, gfx->xref);
    if (!isArray(&rectObj) || ObjArrayGetLength(&rectObj) < 4) {
	ObjFree(&rectObj);
	return;
    }
    GfxReadNumArray(&rectObj, rect, 4, gfx->xref);
    ObjFree(&rectObj);
    /* /Rect's corners aren't guaranteed to already be in
     * (llx,lly,urx,ury) order -- normalize */
    if (rect[0] > rect[2]) { tmp = rect[0]; rect[0] = rect[2]; rect[2] = tmp; }
    if (rect[1] > rect[3]) { tmp = rect[1]; rect[1] = rect[3]; rect[3] = tmp; }

    DictLookup(annotDict, "AP", &apObj, gfx->xref);
    if (!isDict(&apObj)) {
	ObjFree(&apObj);
	return;			/* no appearance dict -- routine (Links,
				 * unstyled Popups), not an error */
    }
    apDict = getDict(&apObj);
    DictLookup(apDict, "N", &nObj, gfx->xref);
    ObjFree(&apObj);

    if (isDict(&nObj) && !isStream(&nObj)) {
	/* Multiple appearance states (checkboxes, radio buttons: on/
	 * off, etc.) -- /AS on the annotation itself names which one
	 * is current. No usable fallback if /AS is absent or doesn't
	 * match any state; skip cleanly rather than guess. */
	Dict *statesDict = getDict(&nObj);
	Obj pickedObj;

	DictLookupNF(annotDict, "AS", &asObj);
	if (isName(&asObj)) {
	    DictLookup(statesDict, getName(&asObj), &pickedObj, gfx->xref);
	    ObjFree(&nObj);
	    nObj = pickedObj;
	} else {
	    ObjFree(&nObj);
	    initNull(&nObj);
	}
	ObjFree(&asObj);
    }

    if (!isStream(&nObj)) {
	ObjFree(&nObj);
	return;
    }

    formDict = ObjStreamGetDict(&nObj);

    DictLookup(formDict, "BBox", &bboxObj, gfx->xref);
    if (!isArray(&bboxObj) || ObjArrayGetLength(&bboxObj) < 4) {
	ObjFree(&bboxObj);
	ObjFree(&nObj);
	return;
    }
    GfxReadNumArray(&bboxObj, bbox, 4, gfx->xref);
    ObjFree(&bboxObj);

    DictLookup(formDict, "Matrix", &matrixObj, gfx->xref);
    if (isArray(&matrixObj) && ObjArrayGetLength(&matrixObj) >= 6) {
	GfxReadNumArray(&matrixObj, matrix, 6, gfx->xref);
    } else {
	matrix[0] = IntToGdouble(1); matrix[1] = 0;
	matrix[2] = 0;               matrix[3] = IntToGdouble(1);
	matrix[4] = 0;               matrix[5] = 0;
    }
    ObjFree(&matrixObj);

    /* Transform BBox's 4 corners through Matrix; the axis-aligned
     * bounding box of the results is the "transformed appearance
     * box" (spec 12.5.5) -- correct even when Matrix rotates/skews,
     * though the GrSetClipRect step further down only clips correctly
     * for the (overwhelmingly common) non-rotated case.
     *
     * Unrolled instead of looping over cornerX[4]/cornerY[4] arrays
     * (see project optimization analysis S7): each corner is a
     * fixed, direct function of bbox[]'s 4 values, used exactly
     * once, so there's nothing left for an array to hold that a
     * local scalar can't -- saves 32 bytes of stack (two 4-element
     * gdouble arrays) with identical min/max-tracking behavior
     * (corner 0 unconditionally seeds tx0/ty0/tx1/ty1, matching the
     * original loop's "i == 0 ||" special case; corners 1-3 use the
     * same comparison-based update as before).
     */
    nx = GrMulWWFixed(bbox[0], matrix[0]) + GrMulWWFixed(bbox[1], matrix[2]) + matrix[4];
    ny = GrMulWWFixed(bbox[0], matrix[1]) + GrMulWWFixed(bbox[1], matrix[3]) + matrix[5];
    tx0 = tx1 = nx;
    ty0 = ty1 = ny;

    nx = GrMulWWFixed(bbox[2], matrix[0]) + GrMulWWFixed(bbox[1], matrix[2]) + matrix[4];
    ny = GrMulWWFixed(bbox[2], matrix[1]) + GrMulWWFixed(bbox[1], matrix[3]) + matrix[5];
    if (nx < tx0) tx0 = nx;
    if (nx > tx1) tx1 = nx;
    if (ny < ty0) ty0 = ny;
    if (ny > ty1) ty1 = ny;

    nx = GrMulWWFixed(bbox[2], matrix[0]) + GrMulWWFixed(bbox[3], matrix[2]) + matrix[4];
    ny = GrMulWWFixed(bbox[2], matrix[1]) + GrMulWWFixed(bbox[3], matrix[3]) + matrix[5];
    if (nx < tx0) tx0 = nx;
    if (nx > tx1) tx1 = nx;
    if (ny < ty0) ty0 = ny;
    if (ny > ty1) ty1 = ny;

    nx = GrMulWWFixed(bbox[0], matrix[0]) + GrMulWWFixed(bbox[3], matrix[2]) + matrix[4];
    ny = GrMulWWFixed(bbox[0], matrix[1]) + GrMulWWFixed(bbox[3], matrix[3]) + matrix[5];
    if (nx < tx0) tx0 = nx;
    if (nx > tx1) tx1 = nx;
    if (ny < ty0) ty0 = ny;
    if (ny > ty1) ty1 = ny;

    if (tx1 == tx0 || ty1 == ty0) {
	ObjFree(&nObj);
	return;			/* degenerate BBox */
    }

    /* A: maps the transformed appearance box onto Rect */
    sx = GrUDivWWFixed(rect[2] - rect[0], tx1 - tx0);
    sy = GrUDivWWFixed(rect[3] - rect[1], ty1 - ty0);
    a[0] = sx; a[1] = 0;  a[2] = 0;  a[3] = sy;
    a[4] = rect[0] - GrMulWWFixed(tx0, sx);
    a[5] = rect[1] - GrMulWWFixed(ty0, sy);

    /* combined = Matrix followed by A */
    combined[0] = GrMulWWFixed(matrix[0], a[0]) + GrMulWWFixed(matrix[1], a[2]);
    combined[1] = GrMulWWFixed(matrix[0], a[1]) + GrMulWWFixed(matrix[1], a[3]);
    combined[2] = GrMulWWFixed(matrix[2], a[0]) + GrMulWWFixed(matrix[3], a[2]);
    combined[3] = GrMulWWFixed(matrix[2], a[1]) + GrMulWWFixed(matrix[3], a[3]);
    combined[4] = GrMulWWFixed(matrix[4], a[0]) + GrMulWWFixed(matrix[5], a[2]) + a[4];
    combined[5] = GrMulWWFixed(matrix[4], a[1]) + GrMulWWFixed(matrix[5], a[3]) + a[5];

    /* --- push a resource layer for the appearance stream's own
     * /Resources, same construction GfxInit uses for the page's top-
     * level resources -- falls back to the page's own resources
     * (gfx->res, linked via ->next) for anything not locally defined,
     * per spec. --- */
    DictLookup(formDict, "Resources", &resObj, gfx->xref);
    GfxResourcesInit(&newRes, gfx->res);
    if (isDict(&resObj)) {
	Obj fontObj;
	resDict = getDict(&resObj);
	DictLookup(resDict, "Font", &fontObj, gfx->xref);
	if (isDict(&fontObj)) {
	    newRes.fonts = gmalloc( sizeof(GfxFontDict) );
	    if (newRes.fonts)
	      GfxFontDictInit(newRes.fonts, getDict(&fontObj), gfx->xref);
	}
	ObjFree(&fontObj);
	DictLookup(resDict, "XObject", &newRes.xObjDict, gfx->xref);
	DictLookup(resDict, "ColorSpace", &newRes.colorSpaceDict, gfx->xref);
	DictLookup(resDict, "ExtGState", &newRes.extGStateDict, gfx->xref);
    }
    ObjFree(&resObj);
    gfx->res = &newRes;

    GfxStateSave(gfx->state);
    GrSaveState(gstring);

    GfxApplyMatrix6(gstring, combined[0], combined[1], combined[2],
		     combined[3], combined[4], combined[5]);

    /* clip to BBox in its own (now current) coordinate system --
     * axis-aligned only, see STRATEGY above */
    GrSetClipRect(gstring, PCT_INTERSECTION,
		  GdoubleToWord(bbox[0]), GdoubleToWord(bbox[1]),
		  GdoubleToWord(bbox[2]), GdoubleToWord(bbox[3]));

    GfxDisplay(gfx, &nObj);

    GfxStateRestore(gfx->state);
    GrRestoreState(gstring);

    gfx->res = newRes.next;
    GfxResourcesFree(&newRes);

    ObjFree(&nObj);
}

/***********************************************************************
 *		GfxDrawAnnotations
 ***********************************************************************
 * SYNOPSIS:	    Draw every annotation's Normal appearance in a page's
 *		    /Annots array, in array order (same back-to-front
 *		    order the spec requires). Called once after the main
 *		    page content stream finishes -- see
 *		    PdfDecodePageContent in main/pdfEngine.goc.
 ***********************************************************************/
void
GfxDrawAnnotations(Gfx *gfx, Obj *annotsObj)
{
    word i, n;
    Obj annotObj;

    if (!isArray(annotsObj)) {
	return;
    }
    n = ObjArrayGetLength(annotsObj);
    for (i = 0; i < n; ++i) {
	ObjArrayGet(annotsObj, i, &annotObj, gfx->xref);
	GfxDrawOneAnnotation(gfx, &annotObj);
	ObjFree(&annotObj);
    }
}

//------------------------------------------------------------------------

static void opBeginImage(Gfx *gfx, Obj args[], int numArgs) {
#if 1
  Stream *str;
  long c1, c2;

/*
 * This can't be allocated "Stream str" on the stack, because StreamFree
 * might try to free it (if there are chained streams).
 */
  str = gmalloc(sizeof(Stream));
  if (!str)
    return;

  // build dict/stream
  buildImageStream(gfx, &str);

  // display the image
  if (str->kind != strEOF) {
    GfxDoImage(gfx, str, gTrue);
  
    // skip 'EI' tag
    c1 = StreamGetChar(str);
    c2 = StreamGetChar(str);
    while (!(c1 == 'E' && c2 == 'I') && c2 != EOF) {
      c1 = c2;
      c2 = StreamGetChar(str);
    }
    if (c2 == EOF)
	EC_WARNING(-1);		/* no EI tag */

    StreamFree(str);
    gfree(str);
  }
#endif
  (void) args;
  (void) numArgs;
}

static void buildImageStream(Gfx *gfx, Stream **str) {
#if 1
  Obj dict;
  Obj obj;
  char *key;

  // build dictionary
  initDict(&dict);
  if (GMemHadError()) {
    EOFStreamInit(*str, NULL);
    return;
  }
  ParserGetObj(gfx->parser, &obj);
  while (!isCmdSame(&obj, "ID") && !isEOF(&obj)) {
    if (!isName(&obj)) {
	EC_WARNING(-1);
//      error(getPos(), "Inline image dictionary key must be a name object");
      ObjFree(&obj);
      ParserGetObj(gfx->parser, &obj);
    } else {
      key = copyString(getName(&obj));
      ObjFree(&obj);
      if (!key) {
        ObjFree(&dict);
        EOFStreamInit(*str, NULL);
        return;
      }
      ParserGetObj(gfx->parser, &obj);
      if (isEOF(&obj) || isError(&obj))
	break;
      ObjDictAdd(&dict, key, &obj);
    }
    ParserGetObj(gfx->parser, &obj);
  }
  if (isEOF(&obj))
      EC_WARNING(-1);
//    error(getPos(), "End of file in inline image");
  ObjFree(&obj);

  // make stream
  SubStreamInit(*str, LexerGetStream(gfx->parser->lexer), &dict);
  *str = StreamAddFilters(*str, &dict, gfx->xref);
  ObjFree(&dict);

  return;
#endif
}


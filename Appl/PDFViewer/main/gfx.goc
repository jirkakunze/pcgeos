    r = g = b = GdoubleToWord(getNum(&args[0]) * 255);
    GfxBlendAlpha(&r, &g, &b, gfx->state->strokeAlpha);

    GrSetLineColor(gfx->state->gstring, CF_RGB, r, g, b);
    (void)numArgs;
}

/***********************************************************************
 *      opSetFillCMYKColor
 ***********************************************************************
 * SYNOPSIS:        Set fill cmykcolor.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opSetFillCMYKColor(Gfx *gfx, Obj args[], int numArgs)
{
    word c, m, y, k;
    sword r, g, b;

    c = GdoubleToWord(255 * getNum(&args[0]));
    m = GdoubleToWord(255 * getNum(&args[1]));
    y = GdoubleToWord(255 * getNum(&args[2]));
    k = GdoubleToWord(255 * getNum(&args[3]));

    if ((r = 255 - (c + k)) < 0)
    {
        r = 0;
    }
    if ((g = 255 - (m + k)) < 0)
    {
        g = 0;
    }
    if ((b = 255 - (y + k)) < 0)
    {
        b = 0;
    }

    GfxBlendAlpha(&r, &g, &b, gfx->state->fillAlpha);
    gfx->state->fillColor.r = r;
    gfx->state->fillColor.g = g;
    gfx->state->fillColor.b = b;

    GrSetAreaColor(gfx->state->gstring, CF_RGB, r, g, b);

    GrSetTextColor(gfx->state->gstring, CF_RGB, r, g, b);
    (void)numArgs;
}

/***********************************************************************
 *      opSetStrokeCMYKColor
 ***********************************************************************
 * SYNOPSIS:        Set stroke cmykcolor.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opSetStrokeCMYKColor(Gfx *gfx, Obj args[], int numArgs)
{
    word c, m, y, k;
    sword r, g, b;

    c = GdoubleToWord(255 * getNum(&args[0]));
    m = GdoubleToWord(255 * getNum(&args[1]));
    y = GdoubleToWord(255 * getNum(&args[2]));
    k = GdoubleToWord(255 * getNum(&args[3]));

    if ((r = 255 - (c + k)) < 0)
    {
        r = 0;
    }
    if ((g = 255 - (m + k)) < 0)
    {
        g = 0;
    }
    if ((b = 255 - (y + k)) < 0)
    {
        b = 0;
    }

    GfxBlendAlpha(&r, &g, &b, gfx->state->strokeAlpha);

    GrSetLineColor(gfx->state->gstring, CF_RGB, r, g, b);
    (void)numArgs;
}

/***********************************************************************
 *      opSetFillRGBColor
 ***********************************************************************
 * SYNOPSIS:        Set fill rgbcolor.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opSetFillRGBColor(Gfx *gfx, Obj args[], int numArgs)
{
    sword r, g, b;

    r = GdoubleToWord(getNum(&args[0]) * 255);
    g = GdoubleToWord(getNum(&args[1]) * 255);
    b = GdoubleToWord(getNum(&args[2]) * 255);
    //GfxBlendAlpha(&r, &g, &b, gfx->state->fillAlpha);
    gfx->state->fillColor.r = r;
    gfx->state->fillColor.g = g;
    gfx->state->fillColor.b = b;

    GrSetAreaColor(gfx->state->gstring, CF_RGB, r, g, b);
    GrSetTextColor(gfx->state->gstring, CF_RGB, r, g, b);
    (void)numArgs;
}

/***********************************************************************
 *      opSetStrokeRGBColor
 ***********************************************************************
 * SYNOPSIS:        Set stroke rgbcolor.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opSetStrokeRGBColor(Gfx *gfx, Obj args[], int numArgs)
{
    sword r, g, b;

    r = GdoubleToWord(getNum(&args[0]) * 255);
    g = GdoubleToWord(getNum(&args[1]) * 255);
    b = GdoubleToWord(getNum(&args[2]) * 255);
    GfxBlendAlpha(&r, &g, &b, gfx->state->strokeAlpha);

    GrSetLineColor(gfx->state->gstring, CF_RGB, r, g, b);
    (void)numArgs;
}

/***********************************************************************
 *      GfxApplyColorArray
 ***********************************************************************
 * SYNOPSIS:        Apply color array.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  GfxColorSpace *cs    cs
 *                  short x[4]    x
 *                  GBool stroke    stroke
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/
static void
GfxApplyColorArray(Gfx *gfx, GfxColorSpace *cs, short x[4], GBool stroke)
{
    GfxColor color;
    sword r, g, b;

    GfxColorSpaceGetColor(cs, x, &color);
    r = color.r; g = color.g; b = color.b;
    GfxBlendAlpha(&r, &g, &b, stroke ? gfx->state->strokeAlpha
        : gfx->state->fillAlpha);

    if (stroke)
    {
        GrSetLineColor(gfx->state->gstring, CF_RGB, r, g, b);
    }
    else
    {
        gfx->state->fillColor.r = r;
        gfx->state->fillColor.g = g;
        gfx->state->fillColor.b = b;
        GrSetAreaColor(gfx->state->gstring, CF_RGB, r, g, b);
        GrSetTextColor(gfx->state->gstring, CF_RGB, r, g, b);
    }
}

/***********************************************************************
 *      GfxApplyColorN
 ***********************************************************************
 * SYNOPSIS:        Apply color n.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  GfxColorSpace *cs    cs
 *                  Obj args[]    args
 *                  int numArgs    num args
 *                  GBool stroke    stroke
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/
static void
GfxApplyColorN(Gfx *gfx, GfxColorSpace *cs, Obj args[], int numArgs, GBool stroke)
{
    short x[4];
    short i;

    if (numArgs < 1 || numArgs > 4)
    {
        EC_WARNING(-1);
        return;
    }
    x[0] = x[1] = x[2] = x[3] = 0;
    for (i = 0; i < numArgs; ++i)
    {
        if (!isNum(&args[i]))
        {
            EC_WARNING(-1);
            return;
        }
        x[i] = GdoubleToWord(255 * getNum(&args[i]));
    }

    GfxApplyColorArray(gfx, cs, x, stroke);
}

/***********************************************************************
 *      opSetFillColorSpace
 ***********************************************************************
 * SYNOPSIS:        Set fill color space.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opSetFillColorSpace(Gfx *gfx, Obj args[], int numArgs)
{
    Obj obj, resolved;
    GfxColorSpace cs;
    short zero[4];

    GfxLookupColorSpace(gfx, getName(&args[0]), &resolved);
    if (!isNull(&resolved))
    {
        ObjMove(&obj, &resolved);
    }
    else
    {
        GfxObjFree(&resolved);
        ObjMove(&obj, &args[0]);
    }

    GfxColorSpaceInit(&cs, &obj, gfx->xref);
    GfxObjFree(&obj);

    if (cs.ok && !cs.indexed)
    {
        /*
         * Rare in practice for plain fills , so this is a deliberate, narrow
         * gap, not a bug.
         */
        gfx->state->fillColorSpace = cs;

        /* spec default: color 0 in the new colorspace */
        zero[0] = zero[1] = zero[2] = zero[3] = 0;
        GfxApplyColorArray(gfx, &gfx->state->fillColorSpace, zero, gFalse);
    }
    else
    {
        EC_WARNING(-1);
    }
    (void)numArgs;
}

/***********************************************************************
 *      opSetStrokeColorSpace
 ***********************************************************************
 * SYNOPSIS:        Set stroke color space.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opSetStrokeColorSpace(Gfx *gfx, Obj args[], int numArgs)
{
    Obj obj, resolved;
    GfxColorSpace cs;
    short zero[4];

    GfxLookupColorSpace(gfx, getName(&args[0]), &resolved);
    if (!isNull(&resolved))
    {
        ObjMove(&obj, &resolved);
    }
    else
    {
        GfxObjFree(&resolved);
        ObjMove(&obj, &args[0]);
    }

    GfxColorSpaceInit(&cs, &obj, gfx->xref);
    GfxObjFree(&obj);

    if (cs.ok && !cs.indexed)
    {
        gfx->state->strokeColorSpace = cs;
        zero[0] = zero[1] = zero[2] = zero[3] = 0;
        GfxApplyColorArray(gfx, &gfx->state->strokeColorSpace, zero, gTrue);
    }
    else
    {
        EC_WARNING(-1);
    }
    (void)numArgs;
}

/***********************************************************************
 *      opSetFillColor
 ***********************************************************************
 * SYNOPSIS:        Set fill color.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opSetFillColor(Gfx *gfx, Obj args[], int numArgs)
{

    if (numArgs == gfx->state->fillColorSpace.numComps)
    {
        GfxApplyColorN(gfx, &gfx->state->fillColorSpace, args, numArgs, gFalse);
        return;
    }

    /* numArgs doesn't match the colorspace cs/CS actually set . */
    if (numArgs == 1)
    {
        opSetFillGray(gfx, args, numArgs);

    }
    else if (numArgs == 3)
    {
        opSetFillRGBColor(gfx, args, numArgs);

    }
    else if (numArgs == 4)
    {
        opSetFillCMYKColor(gfx, args, numArgs);

    }
    else
    {
        EC_WARNING(-1);
    }
}

/***********************************************************************
 *      opSetStrokeColor
 ***********************************************************************
 * SYNOPSIS:        Set stroke color.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opSetStrokeColor(Gfx *gfx, Obj args[], int numArgs)
{

    if (numArgs == gfx->state->strokeColorSpace.numComps)
    {
        GfxApplyColorN(gfx, &gfx->state->strokeColorSpace, args, numArgs,
            gTrue);
        return;
    }

    if (numArgs == 1)
    {
        opSetStrokeGray(gfx, args, numArgs);

    }
    else if (numArgs == 3)
    {
        opSetStrokeRGBColor(gfx, args, numArgs);

    }
    else if (numArgs == 4)
    {
        opSetStrokeCMYKColor(gfx, args, numArgs);

    }
    else
    {
        EC_WARNING(-1);
    }
}

/***********************************************************************
 *      opSetFillColorN
 ***********************************************************************
 * SYNOPSIS:        Set fill color n.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opSetFillColorN(Gfx *gfx, Obj args[], int numArgs)
{
    if (numArgs > 0 && isName(&args[numArgs - 1]))
    {
        /* Pattern colorspace fill -- not supported. */
        EC_WARNING(-1);
        return;
    }
    GfxApplyColorN(gfx, &gfx->state->fillColorSpace, args, numArgs, gFalse);
}

/***********************************************************************
 *      opSetStrokeColorN
 ***********************************************************************
 * SYNOPSIS:        Set stroke color n.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opSetStrokeColorN(Gfx *gfx, Obj args[], int numArgs)
{
    if (numArgs > 0 && isName(&args[numArgs - 1]))
    {
        EC_WARNING(-1);
        return;
    }
    GfxApplyColorN(gfx, &gfx->state->strokeColorSpace, args, numArgs, gTrue);
}


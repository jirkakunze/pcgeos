/***********************************************************************
 *		GfxDrawImageMask
 ***********************************************************************
 *
 * SYNOPSIS:	Draw mask encoded in Stream str as a bitmap at 0,0.
 * CALLED BY:	GfxDoImage
 * RETURN:	nothing
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *
 * DrawImageMask is another output-device method handled by me in Gfx instead.
 *
 *
 * Problems: 
 *
 * The mask is supposed to be drawn in the current color, which I don't do.
 * Perhaps the bitmap could be given a palette, with its one color the current
 * color?
 *
 * On my first try, the mask was drawn inverted, so I simply reversed the sense
 * of the "invert" test.  I'm not sure if the correct thing was this, or changing
 * the MixMode, but:
 *
 * I'm not sure the MixMode is really ANDing the bitmap onto the page (and thus
 * letting the src show through).  I changed the MixMode to MM_OR once, but I 
 * got the same result on the page!  That doesn't sound right.
 *
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mevissen	5/21/99   	Initial Revision
 *
 ***********************************************************************/
void GfxDrawImageMask(Gfx *gfx, Stream *str, word width, word height, 
		      GBool invert, GBool inlineImage) {

  Guchar pixBuf[4];
  word i, j;

    VMBlockHandle bitmap;
    GStateHandle bmState;
    byte *line;
    dword nElements;
    dword bitmapBytes;
    word size;
    Handle gstring = gfx->state->gstring;
    Guchar fillR, fillG, fillB;
    GBool paint;
    word xSamp, ySamp, xMod, yCount;
    word sampledWidth, sampledHeight, arrayInd;
    GBool useLine;
/*
 * reverse the sense of the 'invert' test
*/
    invert = !invert;

    fillR = (Guchar) gfx->state->fillColor.r;
    fillG = (Guchar) gfx->state->fillColor.g;
    fillB = (Guchar) gfx->state->fillColor.b;

  // initialize the image stream
  if (!StreamResetImage(str, width, 1, 1))
    return;

/*
 * reset cancel flag
 */
  if (gfx->cancelFlag) *gfx->cancelFlag = gFalse;
/*
 * Put up the image-progress dialog
 */
  if (!inlineImage && gfx->progressCallback) {
      ProcCallFixedOrMovable_cdecl(gfx->progressCallback,
				   PDF_PROGRESS_IMAGE_BEGIN, 0, height,
				   gfx->progressUserData);
  }

/*
 * Same "some PDFs have full-page-sized images" concern GfxDrawImage
 * already handles (see that function's own comment) applies here
 * too -- arguably more so, since a full-page ImageMask (the common
 * case for a scanned/faxed page) is one of the most likely places to
 * actually hit a very large width/height. Cut down with the same
 * simple every-Nth-pixel sampling, same 1500 threshold, so the two
 * functions stay consistent with each other.
 */
    xSamp = width/1500 + 1;
    ySamp = height/1500 + 1;

    /*
     * Ceiling division, not floor: the column/row loop below writes
     * a sample whenever its running mod-counter hits 0, starting at
     * index 0 -- for a dimension that isn't an exact multiple of
     * its sample step, that's ceil(width/xSamp) samples, not
     * floor(width/xSamp). Using floor here (the original code)
     * under-sized the destination bitmap by exactly one pixel
     * whenever width % xSamp != 0, and the loop would then write
     * one sample past the end of the last row's allocated bitmap
     * memory -- a real, confirmed buffer overflow (see project
     * roadmap R1), not just a cosmetic one-pixel cropping issue.
     */
    sampledWidth = (word)(((dword)width + xSamp - 1) / xSamp);
    sampledHeight = (word)(((dword)height + ySamp - 1) / ySamp);

/*
 * We have to adjust the scaling according to the image size; the transform matrix
 * is set in the pdf file to scale an image assuming it fits in a 1 unit x 1 unit square.
 * An n x m image is thus n x m too big.
 */
  GrSaveTransform(gstring);
  GrApplyScale(gstring, 
	       (1L<<16)/sampledWidth,
	       (1L<<16)/sampledHeight);
/*
 * Create a bitmap in the scratch VM file.
 * (XXX: I never delete the bitmap; I assume that's okay, as the vm
 * file is deleted when the pdf file is closed.)
 *
 * ImageMask pixels must carry the current PDF fill color. Do not use an
 * 8-bit palette bitmap here: the palette created on bmState is not retained
 * with the HugeBitmap for the later GrDrawHugeBitmap(), so indices 0/1 are
 * interpreted through the system palette (black/blue instead of white/fill).
 * Store the already-resolved stencil colors directly as 24-bit RGB.
 */

    bitmapBytes = (dword) sampledWidth * (dword) sampledHeight * 3UL;
    if (!GfxCheckPageResourceBudget(gfx, bitmapBytes)) {
	GrRestoreTransform(gstring);
	if (!inlineImage && gfx->progressCallback) {
	    ProcCallFixedOrMovable_cdecl(gfx->progressCallback,
				 PDF_PROGRESS_IMAGE_END, height, height,
				 gfx->progressUserData);
	}
	return;
    }

    bitmap = GrCreateBitmap(BMF_24BIT | BMT_COMPLEX,
			    sampledWidth,
			    sampledHeight,
			    gfx->vmFile,
			    0,
			    &bmState);

    if (!bitmap) {
	gfx->resourceLimitExceeded = gTrue;
	GrRestoreTransform(gstring);
	if (!inlineImage && gfx->progressCallback) {
	    ProcCallFixedOrMovable_cdecl(gfx->progressCallback,
				 PDF_PROGRESS_IMAGE_END, height, height,
				 gfx->progressUserData);
	}
	return;
    }

    GrDestroyBitmap(bmState, BMD_LEAVE_DATA);

    /* OPT-10/19: bind this HugeBitmap to the page cache and account
     * its 24-bit RGB pixel payload. */
    if (bitmap) {
	if (gfx->pageResourceList != NullHandle) {
	    HugeArrayAppend(gfx->vmFile, gfx->pageResourceList, 1, &bitmap);
	    ++gfx->pageResourceCount;
	}
	gfx->pageResourceBytes += bitmapBytes;
    }
/*
 * Fill the bitmap w/pixel data.
 * I read the data even if the bitmap was not created, so the stream ptr for
 * inline images is updated correctly.
 *
 * XXX: opBeginImage looks for an 'EI' tag after an inline image, so I think
 * we can bail on error any time we want.
 */

    if (bitmap) {
	// read image
	arrayInd = sampledHeight;
	yCount = 0;
	for (i = 0; i < height; ++i) {
	/*
	 * Get the ptr for the line in the bitmap.
	 * As usual, the pdf object has to be flipped in the y direction because
	 * pdf coords are defined with +y going up the page.
	 */
	    useLine = (yCount == 0);
	    if (++yCount == ySamp) {
		yCount = 0;
	    }
	    if (useLine) {
		arrayInd--;
		nElements = HugeArrayLock(gfx->vmFile,
					  bitmap,
					  arrayInd,  /* already counts down from
						      * sampledHeight, so this is
						      * the flipped row directly --
						      * no separate height-1-i math
						      * needed like the original
						      * unsampled version used */
					  (void**) &line,
					  &size);
	    } else {
		nElements = 0;
	    }

	    // for each column (line)...
	    xMod = 0;
	    for (j = 0; j < width; ++j) {

		/*
		 * Check 'cancel' flag periodically within the row too,
		 * not just once per row after this loop finishes (see
		 * project optimization analysis U5) -- for a very wide
		 * image, waiting for the whole row to finish before
		 * noticing a cancel request makes cancellation feel
		 * unresponsive. Breaking out of just this inner loop is
		 * enough: the existing per-row check right after it
		 * (same gfx->cancelFlag) sees the same flag immediately
		 * afterward and stops the outer row loop too, so nothing
		 * else needs to change. Every 256 columns is frequent
		 * enough to feel responsive without adding meaningful
		 * per-pixel overhead.
		 */
		if ((j & 0xff) == 0 && gfx->cancelFlag && *gfx->cancelFlag) {
		    break;
		}

		// get image pixel
		StreamGetImagePixel(str, pixBuf);

		if (nElements & 0xffff0000 && xMod == 0) {

		    /* same source-bit/invert relationship the old
		     * packed-mono-byte code had (bit XOR invert),
		     * just resolved one pixel at a time instead of
		     * eight at a go */
		    paint = invert ? !(pixBuf[0] & 1) : (pixBuf[0] & 1);

		    if (paint) {
			*line++ = fillR;
			*line++ = fillG;
			*line++ = fillB;
		    } else {
			*line++ = 255;
			*line++ = 255;
			*line++ = 255;
		    }
		}
		if (++xMod == xSamp) xMod = 0;
	    }

	    if (nElements & 0xffff0000) {
/*
 * dirty/unlock the bitmap line data.
 */
		HugeArrayDirty(line);
		HugeArrayUnlock(line);
	    }
/*
 * Update the image-progress dialog every so often (every 32 lines)
 */
	    if (!(i & 0x1f)) {
		if (gfx->progressCallback) {
		    ProcCallFixedOrMovable_cdecl(gfx->progressCallback,
						   PDF_PROGRESS_IMAGE_UPDATE, i, height,
						   gfx->progressUserData);
		}
	    }
/*
 * Check 'cancel' flag
 */
	    if (gfx->cancelFlag && *gfx->cancelFlag) break;
	}
    }
/*
 * Draw the bitmap into our gstring at coords (0,0). Already painted
 * in the correct color per-pixel above, so a plain draw -- no
 * MM_AND/mix-mode trickery needed here anymore.
 */
    if (bitmap && !(gfx->cancelFlag && *gfx->cancelFlag)) {
	GrDrawHugeBitmap(gstring,
			 0, 0,
			 gfx->vmFile,
			 bitmap);
    }
/*
 * Restore the transformation matrix
 */
    GrRestoreTransform(gstring);
/*
 * Take down the image-decode progress dialog
 */
    if (!inlineImage && gfx->progressCallback) {
	ProcCallFixedOrMovable_cdecl(gfx->progressCallback,
				     PDF_PROGRESS_IMAGE_END, height, height,
				     gfx->progressUserData);
    }
}


/***********************************************************************
 *		GfxDrawImage
 ***********************************************************************
 *
 * SYNOPSIS:	Pass a stream; it copies the image data to a bitmap and
 *		draws the bitmap to the page's gstring.
 * CALLED BY:	GfxDoImage
 * RETURN:	nothing
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *
 * DrawImage is another output-device method handled by me in Gfx.
 *
 * To do:
 *	For efficiency, indexed images should be handled as bitmaps with 
 *	a palette.  (I assume that's more efficient; as it is, the index
 *	values are decoded to their rgb values and stored.)
 *
 *	For efficency, I assume grayscale images should be 8- or 4- bit
 *	bitmaps.  However, my first stab at it didn't work and I gave up.
 *	(The 8-bit bitmaps created by the commented-out code below are
 *	colored really funky.)
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mevissen	5/17/99   	Initial Revision
 *
 ***********************************************************************/
void GfxDrawImage(Gfx *gfx, Stream *str, word width, word height, 
		  GfxImageColorMap *colorMap, GBool inlineImage,
		  Stream *smaskStr, word smaskWidth, word smaskHeight,
		  short smaskBits) {

  Guchar pixBuf[4];
  Guchar smaskPixBuf[4];
  Guchar *smaskRowBuf;
  long smaskRowLoaded;
  long smaskTargetRow, smaskCol;
  long smaskAccum;
  word alpha;
  short nComps, nBits;
  GfxColor color;
  word i, j;
  word sampledWidth, sampledHeight, arrayInd;
    VMBlockHandle bitmap;
    GStateHandle bmState;
    byte *line;
    dword nElements;
    dword bitmapBytes;
    word size;
    Handle gstring = gfx->state->gstring;
    word xSamp, ySamp, xMod, yCount;
    GBool useLine;
/*
 * Some pdf files have pages that are one big image.  (A really bad idea.)
 * Anyway, we can't handle images that are too big, so we cut them down
 * to size with simple (every Nth pixel) sampling.
 */
    xSamp = width/1500 + 1;
    ySamp = height/1500 + 1;

    /* Ceiling division -- see the matching fix (and full
     * explanation) in GfxDrawImage above; same overflow risk
     * applies here identically. */
    sampledWidth = (word)(((dword)width + xSamp - 1) / xSamp);
    sampledHeight = (word)(((dword)height + ySamp - 1) / ySamp);

  // set up
  nComps = GfxImageColorMapGetNumPixelComps(colorMap);
  nBits = GfxImageColorMapGetBits(colorMap);

  /*
   * SMask row buffer: exactly one decoded row (smaskWidth bytes, 1
   * component/pixel since /SMask is always DeviceGray) at a time,
   * never the whole mask image -- deliberately, see the 64-KB-per-
   * segment discussion that flagged xref->entries for the same
   * class of bug. smaskRowLoaded tracks which target row (by
   * nearest-neighbor mapping onto the base image's height) is
   * currently buffered; -1 means "none yet".
   */
  smaskRowBuf = NULL;
  smaskRowLoaded = -1;
  smaskAccum = 0;
  smaskTargetRow = 0;
  if (smaskStr) {
    smaskRowBuf = gmalloc(smaskWidth);
    if (!smaskRowBuf)
      return;
  }

  // initialize the image stream
  if (!StreamResetImage(str, width, nComps, nBits)) {
    gfree(smaskRowBuf);
    return;
  }
/*
 * reset cancel flag
 */
  if (gfx->cancelFlag) *gfx->cancelFlag = gFalse;
/*
 * Put up the image-progress dialog
 */
  if (!inlineImage && gfx->progressCallback) {
      ProcCallFixedOrMovable_cdecl(gfx->progressCallback,
					   PDF_PROGRESS_IMAGE_BEGIN, 0, height,
					   gfx->progressUserData);
  }

/*
 * We have to adjust the scaling according to the image size; the transform matrix
 * is set in the pdf file to scale an image assuming it fits in a 1 unit x 1 unit square.
 * An n x m image is thus n x m too big.
 */
  GrSaveTransform(gstring);
  GrApplyScale(gstring, 
	       (1L<<16)/sampledWidth,
	       (1L<<16)/sampledHeight);
/*
 * Create a bitmap in the scratch VM file.
 * (XXX: I never delete the bitmap; I assume that's okay, as the vm
 * file is deleted when the pdf file is closed.)
 */

    bitmapBytes = (dword) sampledWidth * (dword) sampledHeight * 3UL;

    if (!GfxCheckPageResourceBudget(gfx, bitmapBytes)) {
	GrRestoreTransform(gstring);
	if (!inlineImage && gfx->progressCallback) {
	    ProcCallFixedOrMovable_cdecl(gfx->progressCallback,
				 PDF_PROGRESS_IMAGE_END, height, height,
				 gfx->progressUserData);
	}
	if (smaskRowBuf)
	    gfree(smaskRowBuf);
	return;
    }

    bitmap = GrCreateBitmap(BMF_24BIT | BMT_COMPLEX,
			    sampledWidth,
			    sampledHeight,
			    gfx->vmFile,
			    0,
			    &bmState);

    if (!bitmap) {
	gfx->resourceLimitExceeded = gTrue;
	GrRestoreTransform(gstring);
	if (!inlineImage && gfx->progressCallback) {
	    ProcCallFixedOrMovable_cdecl(gfx->progressCallback,
				 PDF_PROGRESS_IMAGE_END, height, height,
				 gfx->progressUserData);
	}
	if (smaskRowBuf)
	    gfree(smaskRowBuf);
	return;
    }

    GrDestroyBitmap(bmState, BMD_LEAVE_DATA);

    /* OPT-10/19: bind this HugeBitmap to the page cache and
     * account its storage for byte-budget eviction. */
    if (bitmap) {
	if (gfx->pageResourceList != NullHandle) {
	    HugeArrayAppend(gfx->vmFile, gfx->pageResourceList, 1, &bitmap);
	    ++gfx->pageResourceCount;
	}
	gfx->pageResourceBytes += bitmapBytes;
    }
/*
 * Fill the bitmap w/pixel data.
 * I read the data even if the bitmap was not created, so the stream ptr for
 * inline images is updated correctly.
 *
 * XXX: opBeginImage looks for an 'EI' tag after an inline image, so I think
 * we can bail on error any time we want.
 */

  // read image
    if (bitmap) {
	arrayInd = sampledHeight;
	yCount = 0;
	for (i = 0; i < height; ++i) {
	/*
	 * Get the ptr for the line in the bitmap.
	 * As usual, the pdf object has to be flipped in the y direction because
	 * pdf coords are defined with +y going up the page.
	 */
	    useLine = (yCount == 0);
	    if (++yCount == ySamp) {
		yCount = 0;
	    }
	    if (useLine) {
		arrayInd--;
	    }

	    /*
	     * Advance the SMask stream forward (never backward -- it's
	     * a Stream, sequential read only, same as the base image)
	     * to whichever of its own rows corresponds to base-image
	     * row i, by nearest-neighbor mapping. Almost always
	     * smaskHeight == height, in which case this is just "read
	     * the next row"; the general case (spec-legal, rare in
	     * practice) still works, just re-reading rows only when
	     * the target actually changes.
	     */
	    if (smaskStr) {
		/*
		 * Consume rows up through the CURRENT smaskTargetRow
		 * first (its value carried over from the end of the
		 * previous iteration, or the initial 0 for row i==0),
		 * then advance smaskTargetRow for the next iteration
		 * below -- must stay in this order, not the reverse,
		 * or every row would consume next row's target instead
		 * of its own.
		 */
		while (smaskRowLoaded < smaskTargetRow) {
		    for (smaskCol = 0; smaskCol < smaskWidth; ++smaskCol) {
			StreamGetImagePixel(smaskStr, smaskPixBuf);
			/* StreamGetImagePixel hands back the raw
			 * nBits-wide sample, not a 0-255 value -- the
			 * normal upscale to 0-255 happens later, via
			 * GfxImageColorMapGetColor's decode-curve
			 * lookup table, which we're deliberately not
			 * using here (SMask is just a bare alpha byte,
			 * no colorspace/Decode-array machinery to
			 * speak of). 8-bit is by far the common case
			 * for a *soft* (gradient) mask; scale the
			 * rarer sub-8-bit cases up by simple bit
			 * replication so partial transparency isn't
			 * silently wrong for them either. */
			switch (smaskBits) {
			case 1:
			    smaskRowBuf[smaskCol] = smaskPixBuf[0] ? 255 : 0;
			    break;
			case 2:
			    smaskRowBuf[smaskCol] = (Guchar) (smaskPixBuf[0] * 85);
			    break;
			case 4:
			    smaskRowBuf[smaskCol] = (Guchar) (smaskPixBuf[0] * 17);
			    break;
			default:	/* 8 (common) or 16 (rare; StreamGetImagePixel
					 * truncates to 8 bits already, close enough) */
			    smaskRowBuf[smaskCol] = smaskPixBuf[0];
			    break;
			}
		    }
		    ++smaskRowLoaded;
		}
		/*
		 * Advance smaskTargetRow for the NEXT row (i+1), via a
		 * Bresenham-style accumulator instead of a fresh
		 * (long)(i+1)*smaskHeight/height multiply+divide (see
		 * project optimization analysis P4): smaskAccum tracks
		 * the fractional position (scaled by `height`) toward
		 * the next target row; adding smaskHeight and carrying
		 * into smaskTargetRow whenever the accumulator reaches
		 * `height` produces the identical sequence of
		 * floor(i*smaskHeight/height) values as the exact
		 * formula (verified exhaustively, including
		 * smaskHeight > height and very unequal ratios), using
		 * only addition/subtraction/comparison per row instead
		 * of a multiply and a divide.
		 */
		smaskAccum += smaskHeight;
		while (smaskAccum >= (long) height) {
		    smaskAccum -= height;
		    ++smaskTargetRow;
		}
	    }
	    if (useLine) {
		nElements = HugeArrayLock(gfx->vmFile,
					  bitmap,
					  arrayInd,
					  (void**) &line,
					  &size);
	    } else {
		nElements = 0;
	    }

	    xMod = 0;
	    // for each column (line)...
	    for (j = 0; j < width; ++j) {

		/*
		 * Same periodic cancel check as GfxDrawImageMask above
		 * -- see its comment (project optimization analysis
		 * U5). Every 256 columns, not just once per row.
		 */
		if ((j & 0xff) == 0 && gfx->cancelFlag && *gfx->cancelFlag) {
		    break;
		}

		// get image pixel
		StreamGetImagePixel(str, pixBuf);
		/*
		 * If we got the bitmap line locked down,
		 * and sampling is correct, transfer the pixel
		 */
		if (nElements & 0xffff0000 &&
		    (xMod == 0)) {

		// draw image pixel
		    GfxImageColorMapGetColor(colorMap, pixBuf, &color);
		    if (smaskStr) {
			smaskCol = (long) j * smaskWidth / width;
			alpha = smaskRowBuf[smaskCol];
			/* blend against white -- see the STRATEGY note
			 * on GfxDoImage's /SMask handling: we can't
			 * read back whatever's already drawn on the
			 * page, so this matches the platform's own
			 * PNG import driver's PNG_AT_BLEND-against-
			 * white convention for the same situation. */
			color.r = (short) (((word) color.r * alpha + 255 * (255 - alpha)) / 255);
			color.g = (short) (((word) color.g * alpha + 255 * (255 - alpha)) / 255);
			color.b = (short) (((word) color.b * alpha + 255 * (255 - alpha)) / 255);
		    }
		    *line++ = (byte) color.r;
		    *line++ = (byte) color.g;
		    *line++ = (byte) color.b;
		}
		if (++xMod == xSamp) xMod = 0;
	    }
/*
 * dirty/unlock the bitmap line data.
 */
	    if (nElements & 0xffff0000) {
		HugeArrayDirty(line);
		HugeArrayUnlock(line);
	    }
/*
 * Update the image-progress dialog every so often (every 32 lines)
 */
	    if (!(i & 0x1f)) {
		if (gfx->progressCallback) {
		    ProcCallFixedOrMovable_cdecl(gfx->progressCallback,
						   PDF_PROGRESS_IMAGE_UPDATE, i, height,
						   gfx->progressUserData);
		}
	    }
/*
 * Check 'cancel' flag
 */
	    if (gfx->cancelFlag && *gfx->cancelFlag) break;
	}
    }
/*
 * Draw the bitmap into our gstring at coords (0,0) 
 */
    if (bitmap && !(gfx->cancelFlag && *gfx->cancelFlag)) 
	GrDrawHugeBitmap(gstring,
			 0, 0,
			 gfx->vmFile,
			 bitmap);
/*
 * Restore the transformation matrix
 */
    GrRestoreTransform(gstring);
/*
 * Take down the image-decode progress dialog
 */
    if (!inlineImage && gfx->progressCallback) {
	ProcCallFixedOrMovable_cdecl(gfx->progressCallback,
				     PDF_PROGRESS_IMAGE_END, height, height,
				     gfx->progressUserData);
    }
    if (smaskRowBuf) {
	gfree(smaskRowBuf);
    }
}


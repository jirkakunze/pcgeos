/********************************************************************
 *                      opTextMove
 ********************************************************************
 * SYNOPSIS:      Operator Td: move to the start of the next line.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opTextMove(Gfx *gfx, Obj args[], int numArgs)
{
    gdouble tx, ty;

    tx = gfx->state->lineX + getNum(&args[0]);
    ty = gfx->state->lineY + getNum(&args[1]);
    GfxStateTextMoveTo(gfx->state, tx, ty);

    (void)numArgs;
}

/********************************************************************
 *                      opTextMoveSet
 ********************************************************************
 * SYNOPSIS:      Operator TD: move to the next line and set the leading.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opTextMoveSet(Gfx *gfx, Obj args[], int numArgs)
{
    gdouble tx, ty;
    GfxState *state = gfx->state;

    tx = state->lineX + getNum(&args[0]);
    ty = getNum(&args[1]);
    GfxStateSetLeading(state, -ty);
    ty += state->lineY;
    GfxStateTextMoveTo(state, tx, ty);

    (void)numArgs;
}

/********************************************************************
 *                      opSetTextMatrix
 ********************************************************************
 * SYNOPSIS:      Operator Tm: set the text matrix.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opSetTextMatrix(Gfx *gfx, Obj args[], int numArgs)
{
    GfxState *state = gfx->state;

    GfxStateSetTextMat(state, getNum(&args[0]), getNum(&args[1]),
        getNum(&args[2]), getNum(&args[3]),
        getNum(&args[4]), getNum(&args[5]));

    GfxStateTextMoveTo(state, IntToGdouble(0), IntToGdouble(0));

    gfx->fontChanged = gTrue;
    (void)numArgs;
}

/********************************************************************
 *                      opTextNextLine
 ********************************************************************
 * SYNOPSIS:      Operator T*: move to the next line.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Not used.
 *                numArgs               Not used.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opTextNextLine(Gfx *gfx, Obj args[], int numArgs)
{
    gdouble tx, ty;
    GfxState *state = gfx->state;

    tx = state->lineX;
    ty = state->lineY - GfxStateGetLeading(state);
    GfxStateTextMoveTo(state, tx, ty);

    (void)args;
    (void)numArgs;
}

/********************************************************************
 *                      opShowText
 ********************************************************************
 * SYNOPSIS:      Operator Tj: show a string.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opShowText(Gfx *gfx, Obj args[], int numArgs)
{
    if (!GfxStateGetFont(gfx->state))
    {
        EC_WARNING(-1);

        return;
    }
    setTextTransform(gfx);
    doShowText(gfx, getString(&args[0]));
    resetTextTransform(gfx);
    (void)numArgs;
}

/********************************************************************
 *                      opMoveShowText
 ********************************************************************
 * SYNOPSIS:      Operator ': move to the next line and show a string.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opMoveShowText(Gfx *gfx, Obj args[], int numArgs)
{
    gdouble tx, ty;
    GfxState *state = gfx->state;

    if (!GfxStateGetFont(state))
    {
        EC_WARNING(-1);

        return;
    }
    tx = state->lineX;
    ty = state->lineY - GfxStateGetLeading(gfx->state);
    GfxStateTextMoveTo(state, tx, ty);

    setTextTransform(gfx);
    doShowText(gfx, getString(&args[0]));
    resetTextTransform(gfx);
    (void)numArgs;
}

/********************************************************************
 *                      opMoveSetShowText
 ********************************************************************
 * SYNOPSIS:      Operator ": set word and character spacing, move to the next
 *                line and show a string.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opMoveSetShowText(Gfx *gfx, Obj args[], int numArgs)
{
    gdouble tx, ty;
    GfxState *state = gfx->state;

    if (!GfxStateGetFont(state))
    {
        EC_WARNING(-1);

        return;
    }
    GfxStateSetWordSpace(state, getNum(&args[0]));
    GfxStateSetCharSpace(state, getNum(&args[1]));
    tx = state->lineX;
    ty = state->lineY - GfxStateGetLeading(state);
    GfxStateTextMoveTo(state, tx, ty);

    setTextTransform(gfx);
    doShowText(gfx, getString(&args[2]));
    resetTextTransform(gfx);
    (void)numArgs;
}

/********************************************************************
 *                      opShowSpaceText
 ********************************************************************
 * SYNOPSIS:      Operator TJ: show strings with position adjustments.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Numbers move the text position left by 1/1000 of the font
 *                size.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opShowSpaceText(Gfx *gfx, Obj args[], int numArgs)
{
    Array *a;
    Obj obj;
    Obj *elem;
    GBool fetched;
    word i;
    GfxState *state = gfx->state;

    if (!GfxStateGetFont(state))
    {
        EC_WARNING(-1);

        return;
    }
    a = getArray(&args[0]);
    setTextTransform(gfx);
    for (i = 0; i < ArrayGetLength(a); ++i)
    {
        /*
         * Direct elements (numbers and strings) are read in the array: no
         * copy of each string. Only an indirect reference is fetched.
         */
        elem = ArrayElemPtr(a, i);
        fetched = isRef(elem);
        if (fetched)
        {
            ArrayGet(a, i, &obj, gfx->xref);
            elem = &obj;
        }
        if (isNum(elem))
        {
            GfxStateTextShift(state,
                -(getNum(elem) / 1000) *
                GdoubleToWord(GfxStateGetFontSize(state)));

        }
        else if (isString(elem))
        {
            doShowText(gfx, getString(elem));
        }
        else
        {
            EC_WARNING(-1);
        }
        if (fetched)
        {
            GfxObjFree(&obj);
        }
    }
    resetTextTransform(gfx);
    (void)numArgs;
}

/*
 * Text helpers in their own segment (GFXCore size). They
 * are called directly, never through opTab, and call no _near function.
 */
#pragma code_seg("GFXText")

/********************************************************************
 *                      setTextTransform
 ********************************************************************
 * SYNOPSIS:      Set the GEOS font width and the transform for drawing a
 *                string.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *
 * RETURNS:       void
 *
 * STRATEGY:      After a font change the GEOS font is scaled to the PDF width
 *                of "m" (never wider, at most 3 times narrower). The text rise
 *                and the font scaling factor go into a saved transform.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void setTextTransform(Gfx *gfx)
{
    GfxFont *font;
    Handle gstring = gfx->state->gstring;
    char ch;
    WWFixedAsDWord geosWidthM, pdfWidthM;
    WWFixedAsDWord scaledWidthFactor;

    if (gfx->fontChanged)
    {

        GfxUpdateFont(gfx);
        gfx->fontChanged = gFalse;
        font = GfxStateGetFont(gfx->state);

        if (!font->fontWidthFactor)
        {

            if ((ch = GfxFontFindChar(font, 'm')) == 0)
            {
                pdfWidthM = 0;
            }
            else
            {
                pdfWidthM = MakeWWFixed(font->widths[(unsigned char)ch]) / 1000;
            }

            if (pdfWidthM)
            {
                geosWidthM = GrTextWidthWWFixed(gstring, "m", 1) >> 5;

                if (geosWidthM)
                {
                    font->fontWidthFactor =
                        GrUDivWWFixed(
                        GrMulWWFixed(
                        GdoubleToWWFixed(GfxStateGetFontSize(gfx->state)),
                        pdfWidthM),
                        geosWidthM);
                }
                else
                {
                    font->fontWidthFactor = 1L << 16;
                }

            }
            else
            {
                /* No pdf width */
                font->fontWidthFactor = 1L << 16;
            }
            /* Not wider, and at most 3 times narrower */
            if (font->fontWidthFactor > (1L << 16))
            {
                font->fontWidthFactor = 1L << 16;
            }
            else
            if (font->fontWidthFactor < 0x5555)
            {
                font->fontWidthFactor = 1L << 16;
            }
        }
        /* Horizontal scaling into a local value, not into the font */
        scaledWidthFactor = GrMulWWFixed(font->fontWidthFactor,
            GfxStateGetHorizScaling(gfx->state));

        GrSetFontWidth(gstring, IntegerOf(scaledWidthFactor * 100));

    } /* if fontChanged */

    GrSaveTransform(gstring);

    /* Apply text rise (super/sub scripting) */
    GrApplyTranslation(gstring,
        0,
        GfxStateGetRise(gfx->state));

    GrApplyScale(gstring, MakeWWFixed(1) / FONT_SCALING_FACTOR,
        (-1L << 16) / FONT_SCALING_FACTOR);
}

static void resetTextTransform(Gfx *gfx)
{
    GrRestoreTransform(gfx->state->gstring);
}

/********************************************************************
 *                      GfxDrawMappedChar
 ********************************************************************
 * SYNOPSIS:      Draw a GEOS char; ligature codes as their letters.
 *
 * PARAMETERS:    gstring               Handle of the GString.
 *                ch                    GEOS char.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxDrawMappedChar(Handle gstring, byte ch)
{
    switch (ch)
    {
        case C_FI_LIGATURE:
            GrDrawTextAtCP(gstring, "fi", 2);
            break;
        case C_FL_LIGATURE:
            GrDrawTextAtCP(gstring, "fl", 2);
            break;
        case C_FF_LIGATURE:
            GrDrawTextAtCP(gstring, "ff", 2);
            break;
        case C_FFI_LIGATURE:
            GrDrawTextAtCP(gstring, "ffi", 3);
            break;
        case C_FFL_LIGATURE:
            GrDrawTextAtCP(gstring, "ffl", 3);
            break;
        default:
            GrDrawCharAtCP(gstring, ch);
            break;
    }
}

/********************************************************************
 *                      doShowText
 ********************************************************************
 * SYNOPSIS:      Draw a string with the current font and text state.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *s                    Ptr to the string (PDF codes).
 *
 * RETURNS:       void
 *
 * STRATEGY:      Each char is placed with its PDF width, char and word spacing.
 *                Up to two passes: paint (fill as text, stroke through a kernel
 *                path) and clip (glyphs into the kernel path for opEndText).
 *                Type0 fonts read 2-byte CIDs. Symbolic fonts with an embedded
 *                charset are not drawn.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void doShowText(Gfx *gfx, GooString *s)
{
    GfxFont *font;

    GfxState *state = gfx->state;
    WWFixedAsDWord width, fWidth;
    WWFixedAsDWord widthScale, charSpace, wordSpace;
    Handle gstring = state->gstring;

    word len;
    word render, paint, passes, pass;
    WWFixedAsDWord startX, drawY;
    GBool draw, usePath;
    short i;
    char *cp;

    font = GfxStateGetFont(state);
    /* Symbolic font with /CharSet: glyphs only in the font file */
    if (font->hasCharSet && (font->flags & fontSymbolic))
    {
        return;
    }

    /* Tr: 0 fill, 1 stroke, 2 both, 3 none; 4-7 also clip */
    render = GfxStateGetRender(state) & 7;
    paint = render & 3;
    passes = (paint != 3 ? 1 : 0) | (render >= 4 ? 2 : 0);
    if (passes == 0)
    {
        passes = 4;
    }
    startX = state->curTextX;

    /* Font size, scaling and spacing do not change during one call */
    widthScale = GrMulWWFixed(GdoubleToWWFixed(GfxStateGetFontSize(state)),
        GfxStateGetHorizScaling(state));
    /* Fold PDF's 1/1000 glyph scale into the per-call width factor. */
    widthScale = widthScale / 1000;
    charSpace = GdoubleToWWFixed(GfxStateGetCharSpace(state));
    wordSpace = GdoubleToWWFixed(GfxStateGetWordSpace(state));

    for (pass = 1; pass <= 4; pass <<= 1)
    {
    if (!(passes & pass))
    {
        continue;
    }
    state->curTextX = startX;
    draw = (pass != 4);
    usePath = (pass == 2 || (pass == 1 && paint != 0));
    if (usePath)
    {
        /* A stroke pass replaces the kernel path; clip passes unite */
        GrBeginPath(gstring, (pass == 2 && gfx->textClip) ?
            PCT_UNION : PCT_REPLACE);
    }

    /* 16-bit font */
    if (GfxFontIs16Bit(font))
    {
        /* Type0, Identity-H: 2 bytes per CID; Tw is not used (no code 32) */
        GfxCidLock cidLock;
        word cid, cidWidth;
        byte ch;
        Guchar *bp;

        len = GStrGetLength(s);
        bp = (Guchar *)GStrGetCString(s);
        GfxCidFontLock(font, &cidLock);
        for (i = 0; i + 1 < (short)len; i += 2)
        {
            cid = ((word)bp[i] << 8) | bp[i + 1];
            GfxCidFontLookup(&cidLock, cid, &cidWidth, &ch);
            if (draw && ch != 0 && ch != C_SPACE)
            {
                if (i > 0 || usePath || pass != 1)
                {
                    GrMoveToWWFixed(gstring,
                        ((sdword)((dword)state->curTextX << 5)),
                        ((sdword)((dword)(-state->lineY) << 5)));
                }
                GfxDrawMappedChar(gstring, ch);
            }
            fWidth = MakeWWFixed(cidWidth);
            width = GrMulWWFixed(widthScale, fWidth) + charSpace;
            state->curTextX += width;
        }
        GfxCidFontUnlock(font);

        /* 8-bit font */
    }
    else
    {

        len = GStrGetLength(s);
        /* baseline, moved by the font's glyph offset (CMEX) */
        drawY = -state->lineY;
        if (font->charRise != 0)
        {
            /* signed: GrMulWWFixed returns an unsigned WWFixedAsDWord */
            drawY -= (sdword)GrMulWWFixed(
                GdoubleToWWFixed(GfxStateGetFontSize(state)),
                MakeWWFixed(font->charRise)) / 1000;
        }
        if (len != 0)
        {

            cp = GStrGetCString(s);
            for (i = 0; i < len; i++, cp++)
            {
                char c = GfxFontMapChar(font, *cp, ' ');

                if (draw && c != C_SPACE)
                {
                    /* Move to the char position (not for the first char) */
                    if (i > 0 || usePath || pass != 1 ||
                        font->charRise != 0)
                    {
                        GrMoveToWWFixed(gstring,
                            ((sdword)((dword)state->curTextX << 5)),
                            ((sdword)((dword)drawY << 5)));
                    }

                    if (GfxFontIsSymbolChar(font, (byte)*cp))
                    {
                        /* Greek letter: GEOS Symbol font for one char */
                        WWFixedAsDWord ptSize;
                        FontID oldID = GrGetFont(gstring, &ptSize);

                        GrSetFont(gstring, FID_DTC_URW_SYMBOLPS, ptSize);
                        GrDrawCharAtCP(gstring, (byte)c);
                        GrSetFont(gstring, oldID, ptSize);
                    }
                    else
                    {
                        GfxDrawMappedChar(gstring, (byte)c);
                    }
                }

                fWidth = MakeWWFixed(font->widths[(unsigned char)* cp]);
                width = GrMulWWFixed(widthScale, fWidth) + charSpace;
                if (*cp == ' ')
                {
                    width += wordSpace;
                }
                state->curTextX += width;
            }
        }
    }

    if (usePath)
    {
        GrEndPath(gstring);
        if (pass == 1)
        {
            if (paint == 2)
            {
                GrFillPath(gstring, ODD_EVEN);
            }
            GrDrawPath(gstring);    /* text outline: kernel path only */
        }
        else
        {
            gfx->textClip = gTrue;
        }
    }
    }

    /* Pen position for the next string */
    GrMoveToWWFixed(gstring,
        ((sdword)((dword)gfx->state->curTextX << 5)),
        ((sdword)((dword)(-gfx->state->lineY) << 5)));
}


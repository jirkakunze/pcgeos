/********************************************************************
 *                      GfxUpdatePathBounds
 ********************************************************************
 * SYNOPSIS:      Add a point to the raw bounds of the path.
 *
 * PARAMETERS:    *state                Ptr to the graphics state.
 *                x                     x in user space.
 *                y                     y in user space.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void
GfxUpdatePathBounds(GfxState *state, gdouble x, gdouble y)
{
    if (!state->pathRawBoundsValid)
    {
        state->pathRawMinX = state->pathRawMaxX = x;
        state->pathRawMinY = state->pathRawMaxY = y;
        state->pathRawBoundsValid = gTrue;
    }
    else
    {
        if (x < state->pathRawMinX)
        {
            state->pathRawMinX = x;
        }
        if (x > state->pathRawMaxX)
        {
            state->pathRawMaxX = x;
        }
        if (y < state->pathRawMinY)
        {
            state->pathRawMinY = y;
        }
        if (y > state->pathRawMaxY)
        {
            state->pathRawMaxY = y;
        }
    }
}

/********************************************************************
 *                      GfxClipBoxToPath
 ********************************************************************
 * SYNOPSIS:      Shrink the page space clip box to the bounds of the path.
 *
 * PARAMETERS:    *state                Ptr to the graphics state.
 *
 * RETURNS:       void
 *
 * STRATEGY:      The clip box bounds the replacement fills of shadings.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxClipBoxToPath(GfxState *state)
{
    gdouble raw[4], box[4];

    if (!state->pathRawBoundsValid)
    {
        return;
    }
    raw[0] = state->pathRawMinX;
    raw[1] = state->pathRawMinY;
    raw[2] = state->pathRawMaxX;
    raw[3] = state->pathRawMaxY;
    GfxMatApplyBox(state->ctm, raw, box);
    if (box[0] > state->clipBox[0]) state->clipBox[0] = box[0];
    if (box[1] > state->clipBox[1]) state->clipBox[1] = box[1];
    if (box[2] < state->clipBox[2]) state->clipBox[2] = box[2];
    if (box[3] < state->clipBox[3]) state->clipBox[3] = box[3];
}

/********************************************************************
 *                      doEndPath
 ********************************************************************
 * SYNOPSIS:      End the current path and apply a pending clip.
 *
 * PARAMETERS:    *state                Ptr to the graphics state.
 *
 * RETURNS:       GBool                 gTrue if there was a path (to paint).
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static GBool doEndPath(GfxState *state)
{
    Handle gstring = state->gstring;

    GrEndPath(gstring);
    state->pathSubpathStartValid = gFalse;

    if (state->pathType == PATH_NORMAL)
    {
        state->pathType = PATH_NONE;
        return gTrue;
    }

    if (state->pathType == PATH_CLIP)
    {
        GfxClipBoxToPath(state);
        GrSetClipPath(gstring, PCT_INTERSECTION, WINDING);
        state->pathType = PATH_NONE;
        return gTrue;
    }

    if (state->pathType == PATH_CLIP_EO)
    {
        GfxClipBoxToPath(state);
        GrSetClipPath(gstring, PCT_INTERSECTION, ODD_EVEN);
        state->pathType = PATH_NONE;
        return gTrue;
    }

    state->pathType = PATH_NONE;
    return gFalse;
}

/********************************************************************
 *                      opClip
 ********************************************************************
 * SYNOPSIS:      Operator W: clip with the path at its end (nonzero).
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Not used.
 *                numArgs               Not used.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opClip(Gfx *gfx, Obj args[], int numArgs)
{
    gfx->state->pathType = PATH_CLIP;
    (void)args;
    (void)numArgs;
}


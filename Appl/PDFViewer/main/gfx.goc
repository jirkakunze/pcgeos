/********************************************************************
 *                      GfxObjFree
 ********************************************************************
 * SYNOPSIS:      Free an object of the content stream.
 *
 * PARAMETERS:    *obj                  Ptr to the object.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Simple types are only marked objNone (no call into obj_TEXT).
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near GfxObjFree(Obj *obj)
{
#ifdef DEBUG_MEM
    ObjFree(obj);
#else
    switch (obj->type)
    {
        case objBool:
        case objInt:
        case objReal:
        case objNull:
        case objRef:
        case objError:
        case objEOF:
        case objNone:
            obj->type = objNone;
            break;
        default:
            ObjFree(obj);
            break;
    }
#endif
}

/********************************************************************
 *                      GfxInit
 ********************************************************************
 * SYNOPSIS:      Initialize the graphics context for one page or form.
 *
 * PARAMETERS:    *this                 Ptr to the graphics context.
 *                gstring               Handle of the GString to draw into.
 *                *resDict              Ptr to the resource dictionary or NULL.
 *                *xref                 Ptr to the cross-reference table.
 *                vmFile1               Scratch VM file for image bitmaps.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Read the font, XObject, color space, ExtGState, pattern and
 *                shading resources and make the graphics state. On error
 *                GMemHadError() is set.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
void GfxInit(Gfx *this, Handle gstring, Dict *resDict, XRef *xref,
    VMFileHandle vmFile1)
{

    Obj obj1;

    this->res = NULL;
    this->state = NULL;
    this->parser = 0;
    this->res = gmalloc(sizeof(GfxResources));
    if (!this->res)
    {
        return;
    }
    GfxResourcesInit(this->res, NULL);

    this->res->fonts = NULL;
    if (resDict)
    {
        DictLookup(resDict, "Font", &obj1, xref);
        if (isDict(&obj1))
        {
            this->res->fonts = gmalloc(sizeof(GfxFontDict));
            if (this->res->fonts)
            {
                GfxFontDictInit(this->res->fonts, getDict(&obj1), xref);
            }
        }
        GfxObjFree(&obj1);
    }

    if (resDict)
    {
        DictLookup(resDict, "XObject", &this->res->xObjDict, xref);
    }
    else
    {
        initNull(&this->res->xObjDict);
    }

    if (resDict)
    {
        DictLookup(resDict, "ColorSpace", &this->res->colorSpaceDict, xref);
    }
    else
    {
        initNull(&this->res->colorSpaceDict);
    }

    if (resDict)
    {
        DictLookup(resDict, "ExtGState", &this->res->extGStateDict, xref);
        DictLookup(resDict, "Pattern", &this->res->patternDict, xref);
        DictLookup(resDict, "Shading", &this->res->shadingDict, xref);
    }
    else
    {
        initNull(&this->res->extGStateDict);
        initNull(&this->res->patternDict);
        initNull(&this->res->shadingDict);
    }

    this->state = gmalloc(sizeof(GfxState));
    if (!this->state)
    {
        return;
    }
    GfxStateInit(this->state, gstring);

    this->fontChanged = gFalse;

    this->ignoreUndef = 0;

    this->parser = 0;
    this->xref = xref;
    this->vmFile = vmFile1;
    this->nImages = 0;
    this->resourceLimitExceeded = gFalse;
    this->pageResourceBytes = 0;

    this->progressCallback = NULL;
    this->progressUserData = NULL;
    this->cancelFlag = NULL;
    this->formDepth = 0;
    this->pathBuf = NULL;
    this->textClip = gFalse;
    this->saveDepth = 0;
    this->skippedSaves = 0;

}

/********************************************************************
 *                      GfxFree
 ********************************************************************
 * SYNOPSIS:      Free the graphics context.
 *
 * PARAMETERS:    *this                 Ptr to the graphics context.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
void GfxFree(Gfx *this)
{
    GfxResources *resPtr;

    while (this->res)
    {
        resPtr = this->res->next;
        GfxResourcesFree(this->res);
        gfree(this->res);
        this->res = resPtr;
    }
    if (this->state)
    {
        GfxStateFree(this->state);
        gfree(this->state);
    }
    gfree(this->pathBuf);
    this->pathBuf = NULL;
    this->textClip = gFalse;
    this->saveDepth = 0;
    this->skippedSaves = 0;
    /* An active parser here is an internal lifetime error. */
    EC_ERROR_IF(this->parser != NULL, -1);
}

/********************************************************************
 *                      GfxResourcesInit
 ********************************************************************
 * SYNOPSIS:      Initialize one level of the resource stack.
 *
 * PARAMETERS:    *this                 Ptr to the resources.
 *                *next1                Ptr to the outer level or NULL.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxResourcesInit(GfxResources *this, GfxResources *next1)
{
    this->next = next1;
    this->fonts = NULL;
    initNull(&this->xObjDict);
    initNull(&this->colorSpaceDict);
    initNull(&this->extGStateDict);
    initNull(&this->patternDict);
    initNull(&this->shadingDict);
}

/********************************************************************
 *                      GfxResourcesFree
 ********************************************************************
 * SYNOPSIS:      Free one level of the resource stack.
 *
 * PARAMETERS:    *this                 Ptr to the resources.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxResourcesFree(GfxResources *this)
{
    if (this->fonts)
    {
        GfxFontDictFree(this->fonts);
        gfree(this->fonts);
    }
    GfxObjFree(&this->xObjDict);
    GfxObjFree(&this->colorSpaceDict);
    GfxObjFree(&this->extGStateDict);
    GfxObjFree(&this->patternDict);
    GfxObjFree(&this->shadingDict);
}

/********************************************************************
 *                      GfxDisplay
 ********************************************************************
 * SYNOPSIS:      Draw a content stream or an array of content streams.
 *
 * PARAMETERS:    *this                 Ptr to the graphics context.
 *                *obj                  Ptr to the stream or array object.
 *
 * RETURNS:       GBool                 gFalse on error, cancel or a resource
 *                                      limit.
 *
 * STRATEGY:      Parser and lexer are on the heap. Form XObjects re-enter this
 *                function; the outer parser is restored at the end.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
GBool GfxDisplay(Gfx *this, Obj *obj)
{
    Obj obj2;
    word i;
    Parser *parser;
    Parser *oldParser;
    Lexer *lexer;
    XRef *xref = this->xref;
    GBool goRetval;

    if (isArray(obj))
    {
        for (i = 0; i < ObjArrayGetLength(obj); ++i)
        {
            ObjArrayGet(obj, i, &obj2, xref);
            if (!isStream(&obj2))
            {
                EC_WARNING(-1);

                GfxObjFree(&obj2);
                return gFalse;
            }
            GfxObjFree(&obj2);
        }
    }
    else if (!isStream(obj))
    {
        EC_WARNING(-1);

        return gFalse;
    }

    lexer = gmalloc(sizeof(Lexer)); /* ParserFree frees this */
    if (!lexer)
    {
        return gFalse;
    }
    LexerInitFromObj(lexer, obj, xref);
    if (GMemHadError())
    {
        LexerFree(lexer);
        gfree(lexer);
        return gFalse;
    }
    /* heap, not stack: re-entered once per Form XObject level */
    parser = gmalloc(sizeof(Parser));
    if (!parser)
    {
        LexerFree(lexer);
        gfree(lexer);
        return gFalse;
    }
    ParserInit(parser, lexer);

    /* Forms re-enter GfxDisplay: restore the outer parser afterwards */
    oldParser = this->parser;
    this->parser = parser;
    goRetval = GfxGo(this, parser);
    ParserFree(parser);
    gfree(parser);
    this->parser = oldParser;

    return goRetval;
}

/********************************************************************
 *                      GfxGo
 ********************************************************************
 * SYNOPSIS:      Read and execute the operators of a content stream.
 *
 * PARAMETERS:    *this                 Ptr to the graphics context.
 *                *parser               Ptr to the parser of the stream.
 *
 * RETURNS:       GBool                 gFalse if the page was cancelled or a
 *                                      resource limit was hit.
 *
 * STRATEGY:      Collect operands until an operator comes, then execute it.
 *                Report progress every 200 operators and check the cancel flag
 *                after each operator.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static GBool GfxGo(Gfx *this, Parser *parser)
{
    Obj obj;
    Obj *args;
    Operator *pOpTab;
    long streamStart;
    long streamLen;
    int numCmds, numArgs;
    short i;
    GBool retval;

    /* Operands on the heap: GfxGo recurses once per form level */
    args = gmalloc(maxArgs * sizeof(Obj));
    if (!args)
    {
        return gFalse;
    }

    numCmds = 0;
    numArgs = 0;
    streamStart = ParserGetPos(parser);
    streamLen = ParserGetLength(parser);
    MemLock(OptrToHandle(@opTab));
    pOpTab = LMemDeref(@opTab);
    ParserGetObj(parser, &obj);
    while (!isEOF(&obj))
    {

        if (isCmd(&obj))
        {
            GfxExecOp(this, &obj, args, numArgs, pOpTab);
            GfxObjFree(&obj);
            for (i = 0; i < numArgs; ++i)
            {
                GfxObjFree(&args[i]);
            }
            numArgs = 0;

            /* A resource limit in an image operator ends the page */
            if (this->resourceLimitExceeded)
            {
                break;
            }

            /* Progress every 200 operators */
            if (++numCmds > 200)
            {
                numCmds = 0;
                if (this->progressCallback)
                {
                    GfxReportProgress(this, PDF_PROGRESS_PAGE, ParserGetPos(parser) - streamStart, streamLen);
                }
            }
            /* Stop after each operator once Stop was pressed */
            if (this->cancelFlag && *this->cancelFlag)
            {
                break;
            }

        }
        else if (numArgs < maxArgs)
        {
            ObjMove(&args[numArgs++], &obj);

            /* Too many operands: drop them */
        }
        else
        {
            EC_WARNING(-1);

            GfxObjFree(&obj);
        }

        ParserGetObj(parser, &obj);
    }
    GfxObjFree(&obj);
    MemUnlock(OptrToHandle(@opTab));

    /* Operands without an operator at the end */
    if (numArgs > 0)
    {
        EC_WARNING(-1);

        for (i = 0; i < numArgs; ++i)
        {
            GfxObjFree(&args[i]);
        }
    }

    gfree(args);

    /* gFalse reports cancellation, not a rendering error. */
    retval = !this->resourceLimitExceeded &&
        !(this->cancelFlag && *this->cancelFlag);
    return retval;
}

/********************************************************************
 *                      GfxExecOp
 ********************************************************************
 * SYNOPSIS:      Check the operands of an operator and execute it.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *cmd                  Ptr to the operator (command object).
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *                *pOpTab               Ptr to the locked operator table.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Unknown operators and wrong operands are ignored (EC_WARNING).
 *                The functions in the table are _near functions of GFXCore.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxExecOp(Gfx *gfx, Obj *cmd, Obj args[], int numArgs, Operator *pOpTab)
{
    Operator *op;
    char *name;
    int i;

    EC(ECCheckBounds(gfx));
    EC(ECCheckBounds(cmd));
    EC(ECCheckBounds(args));
    EC(ECCheckBounds(pOpTab));

    name = getCmd(cmd);
    if (!(op = GfxFindOp(name, pOpTab)))
    {

        return;
    }

    /* Check the operand count and types */
    if (op->numArgs >= 0)
    {
        if (numArgs != op->numArgs)
        {
            EC_WARNING(-1);

            return;
        }
    }
    else
    {
        if (numArgs > -op->numArgs)
        {
            EC_WARNING(-1);

            return;
        }
    }
    for (i = 0; i < numArgs; ++i)
    {
        if (!GfxCheckArg(&args[i], op->tchk[i]))
        {
            EC_WARNING(-1);

            return;
        }
    }

    (op->func)(gfx, args, numArgs);
}

static void _near opBeginImageDispatch(Gfx *gfx, Obj args[], int numArgs)
{
    opBeginImage(gfx, args, numArgs);
}

static void _near opXObjectDispatch(Gfx *gfx, Obj args[], int numArgs)
{
    opXObject(gfx, args, numArgs);
}

/********************************************************************
 *                      GfxFindOp
 ********************************************************************
 * SYNOPSIS:      Find an operator in the sorted operator table.
 *
 * PARAMETERS:    *name                 Ptr to the operator name.
 *                *opTab                Ptr to the locked operator table.
 *
 * RETURNS:       Operator *            Ptr to the table entry, NULL if not
 *                                      found.
 *
 * STRATEGY:      Binary search.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static Operator *GfxFindOp(char *name, Operator *opTab)
{
    short a, b, m, cmp;

    a = -1;
    b = numOps;
    /* invariant: opTab[a] < name < opTab[b] */
    while (b - a > 1)
    {
        m = (a + b) >> 1;
        cmp = strcmp(opTab[m].name, name);
        if (cmp < 0)
        {
            a = m;
        }
        else if (cmp > 0)
        {
            b = m;
        }
        else
        {
            a = b = m;
        }
    }
    if (cmp != 0)
    {
        return NULL;
    }
    return & opTab[a];
}

/********************************************************************
 *                      GfxCheckArg
 ********************************************************************
 * SYNOPSIS:      Check the type of one operand.
 *
 * PARAMETERS:    *arg                  Ptr to the operand.
 *                type                  Expected type.
 *
 * RETURNS:       GBool                 gTrue if the type is correct.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static GBool GfxCheckArg(Obj *arg, TchkType type)
{
    switch (type)
    {
        case tchkBool: return isBool(arg);
        case tchkInt: return isInt(arg);
        case tchkNum: return isNum(arg);
        case tchkString: return isString(arg);
        case tchkName: return isName(arg);
        case tchkArray: return isArray(arg);
        case tchkProps: return isDict(arg) || isName(arg);
        case tchkSCN: return isNum(arg) || isName(arg);
        case tchkNone: return gFalse;
    }
    return gFalse;
}

/********************************************************************
 *                      GfxLookupFont
 ********************************************************************
 * SYNOPSIS:      Find a font in the resource stack.
 *
 * PARAMETERS:    *this                 Ptr to the graphics context.
 *                *name                 Ptr to the resource name.
 *
 * RETURNS:       GfxFont *             Ptr to the font, NULL if not found.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static GfxFont *GfxLookupFont(Gfx *this, char *name)
{
    GfxFont *font;
    GfxResources *resPtr;

    for (resPtr = this->res; resPtr; resPtr = resPtr->next)
    {
        if (resPtr->fonts)
        {
            if ((font = GfxFontDictLookup(resPtr->fonts, name)))
            {
                return font;
            }
        }
    }

    EC_WARNING(-1);
    return NULL;
}

/********************************************************************
 *                      GfxLookupXObject
 ********************************************************************
 * SYNOPSIS:      Find an XObject in the resource stack.
 *
 * PARAMETERS:    *this                 Ptr to the graphics context.
 *                *name                 Ptr to the resource name.
 *                *obj                  Ptr to the object (out).
 *
 * RETURNS:       GBool                 gFalse if not found.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static GBool GfxLookupXObject(Gfx *this, char *name, Obj *obj)
{
    GfxResources *resPtr;

    for (resPtr = this->res; resPtr; resPtr = resPtr->next)
    {
        if (isDict(&resPtr->xObjDict))
        {
            ObjDictLookup(&resPtr->xObjDict, name, obj, this->xref);
            if (!isNull(obj))
            {
                return gTrue;
            }
            GfxObjFree(obj);
        }
    }
    EC_WARNING(-1);

    return gFalse;
}

/********************************************************************
 *                      GfxLookupColorSpace
 ********************************************************************
 * SYNOPSIS:      Find a color space in the resource stack.
 *
 * PARAMETERS:    *this                 Ptr to the graphics context.
 *                *name                 Ptr to the resource name.
 *                *obj                  Ptr to the object (out); null if not
 *                                      found.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxLookupColorSpace(Gfx *this, char *name, Obj *obj)
{
    GfxResources *resPtr;

    for (resPtr = this->res; resPtr; resPtr = resPtr->next)
    {
        if (isDict(&resPtr->colorSpaceDict))
        {
            ObjDictLookup(&resPtr->colorSpaceDict, name, obj, this->xref);
            if (!isNull(obj))
            {
                return;
            }
            GfxObjFree(obj);
        }
    }
    initNull(obj);
}

/********************************************************************
 *                      GfxLookupExtGState
 ********************************************************************
 * SYNOPSIS:      Find an ExtGState in the resource stack.
 *
 * PARAMETERS:    *this                 Ptr to the graphics context.
 *                *name                 Ptr to the resource name.
 *                *obj                  Ptr to the object (out); null if not
 *                                      found.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxLookupExtGState(Gfx *this, char *name, Obj *obj)
{
    GfxResources *resPtr;

    for (resPtr = this->res; resPtr; resPtr = resPtr->next)
    {
        if (isDict(&resPtr->extGStateDict))
        {
            ObjDictLookup(&resPtr->extGStateDict, name, obj, this->xref);
            if (!isNull(obj))
            {
                return;
            }
            GfxObjFree(obj);
        }
    }
    initNull(obj);
}

/********************************************************************
 *                      GfxLookupResource
 ********************************************************************
 * SYNOPSIS:      Find a pattern or a shading in the resource stack.
 *
 * PARAMETERS:    *this                 Ptr to the graphics context.
 *                which                 0 = /Pattern, 1 = /Shading.
 *                *name                 Ptr to the resource name.
 *                *obj                  Ptr to the object (out); null if not
 *                                      found.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxLookupResource(Gfx *this, word which, char *name, Obj *obj)
{
    GfxResources *resPtr;
    Obj *dict;

    for (resPtr = this->res; resPtr; resPtr = resPtr->next)
    {
        dict = which ? &resPtr->shadingDict : &resPtr->patternDict;
        if (isDict(dict))
        {
            ObjDictLookup(dict, name, obj, this->xref);
            if (!isNull(obj))
            {
                return;
            }
            GfxObjFree(obj);
        }
    }
    initNull(obj);
}

/********************************************************************
 *                      GfxSetPageBox
 ********************************************************************
 * SYNOPSIS:      Set the clip box of the page in user space.
 *
 * PARAMETERS:    *this                 Ptr to the graphics context.
 *                x0                    Left.
 *                y0                    Bottom.
 *                x1                    Right.
 *                y1                    Top.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
void GfxSetPageBox(Gfx *this, gdouble x0, gdouble y0, gdouble x1,
    gdouble y1)
{
    if (this->state)
    {
        this->state->clipBox[0] = x0;
        this->state->clipBox[1] = y0;
        this->state->clipBox[2] = x1;
        this->state->clipBox[3] = y1;
    }
}

/********************************************************************
 *                      GfxConcatCtm
 ********************************************************************
 * SYNOPSIS:      Concatenate a matrix with the CTM.
 *
 * PARAMETERS:    *state                Ptr to the graphics state.
 *                *m                    Ptr to the matrix.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxConcatCtm(GfxState *state, const gdouble *m)
{
    gdouble tmp[6];

    GfxMatMul(m, state->ctm, tmp);
    memcpy(state->ctm, tmp, sizeof(tmp));

    /* The scale of the CTM changed: set the GEOS line width again */
    GfxApplyLineWidth(state);
}

/********************************************************************
 *                      GfxApplyLineWidth
 ********************************************************************
 * SYNOPSIS:      Set the GEOS line width from the PDF line width and the
 *                scale of the CTM.
 *
 * PARAMETERS:    *state                Ptr to the graphics state.
 *
 * RETURNS:       void
 *
 * STRATEGY:      The kernel (ScaleScalar) scales the line width only with
 *                the window matrix, not with the GState matrix. The CTM is
 *                in the GState matrix, thus we must apply its scale here.
 *                The scale is the average length of the transformed unit
 *                vectors, with the same length approximation as the
 *                kernel: (|dx| + |dy| + max(|dx|, |dy|)) / 2. This is
 *                exact for a CTM without rotation.
 *
 * KNOWN BUGS/SIDE EFFECTS/CAVEATS/IDEAS:
 *                ATTENTION: The text matrix and the font scale are also in
 *                the GState matrix while text is drawn. Stroked text
 *                (Tr 1, 2) thus does not get the correct width. Upgrade
 *                path: apply the inverse text scale in doShowText.
 *                ATTENTION: The scale of the print fit (PdfFitPrintPage)
 *                is in the GState matrix of the target and is not applied
 *                to the line width. Upgrade path: also apply it when the
 *                GString is played to the printer.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      11/28/26  Claude/jkunze  Initial version
 *******************************************************************/
static void GfxApplyLineWidth(GfxState *state)
{
    WWFixedAsDWord scale, width;

    EC(ECCheckBounds((void *)state));

    scale = (GfxApproxLength(state->ctm[0], state->ctm[1]) >> 1) +
        (GfxApproxLength(state->ctm[2], state->ctm[3]) >> 1);

    /* A negative width is not valid: use the thinnest line */
    if (state->lineWidth <= 0 || scale == 0)
    {
        width = 0;
    }
    else if (scale >= MakeWWFixed(1) &&
        (WWFixedAsDWord)GdoubleToWWFixed(state->lineWidth) >=
        GrUDivWWFixed(MakeWWFixed(GFX_MAX_LINE_WIDTH), scale))
    {
        /* Prevent an overflow of the multiplication */
        width = MakeWWFixed(GFX_MAX_LINE_WIDTH);
    }
    else
    {
        width = GrMulWWFixed(GdoubleToWWFixed(state->lineWidth), scale);
    }

    /* The kernel accepts widths up to GFX_MAX_LINE_WIDTH only */
    if (width > MakeWWFixed(GFX_MAX_LINE_WIDTH))
    {
        width = MakeWWFixed(GFX_MAX_LINE_WIDTH);
    }

    /* Same width as in the GString: no new element (each cm calls this) */
    if (width == state->geosLineWidth)
    {
        return;
    }
    GrSetLineWidth(state->gstring, width);
    state->geosLineWidth = width;
}

/********************************************************************
 *                      GfxApproxLength
 ********************************************************************
 * SYNOPSIS:      Return the approximate length of a vector.
 *
 * PARAMETERS:    dx                    x of the vector (16.16 fixed).
 *                dy                    y of the vector (16.16 fixed).
 *
 * RETURNS:       WWFixedAsDWord        Length (16.16 fixed).
 *
 * STRATEGY:      Same approximation as the kernel (DistanceApprox):
 *                (|dx| + |dy| + max(|dx|, |dy|)) / 2. Each term is halved
 *                first, thus the sum cannot overflow.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      11/28/26  Claude/jkunze  Initial version
 *******************************************************************/
static WWFixedAsDWord GfxApproxLength(sdword dx, sdword dy)
{
    if (dx < 0)
    {
        dx = -dx;
    }
    if (dy < 0)
    {
        dy = -dy;
    }
    return (WWFixedAsDWord)((dx >> 1) + (dy >> 1) +
        ((dx > dy ? dx : dy) >> 1));
}

/********************************************************************
 *                      opSave
 ********************************************************************
 * SYNOPSIS:      Operator q: save the graphics state.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Not used.
 *                numArgs               Not used.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Levels deeper than GFX_MAX_SAVE_DEPTH are counted, not saved.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opSave(Gfx *gfx, Obj args[], int numArgs)
{
    if (gfx->saveDepth >= GFX_MAX_SAVE_DEPTH)
    {
        gfx->skippedSaves++;
        return;
    }
    gfx->saveDepth++;
    GfxStateSave(gfx->state);
    GrSaveState(gfx->state->gstring);
    (void)args;
    (void)numArgs;
}

/********************************************************************
 *                      GfxDisplayNested
 ********************************************************************
 * SYNOPSIS:      Draw a nested content stream (form, annotation).
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *obj                  Ptr to the content stream.
 *
 * RETURNS:       void
 *
 * STRATEGY:      The nested stream counts its own q levels and closes them at
 *                the end, so that a Q of the form does not close a q of the
 *                page.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void GfxDisplayNested(Gfx *gfx, Obj *obj)
{
    word outerDepth = gfx->saveDepth;
    word outerSkipped = gfx->skippedSaves;

    gfx->saveDepth = 0;
    gfx->skippedSaves = 0;
    GfxDisplay(gfx, obj);
    while (gfx->saveDepth > 0)
    {
        gfx->saveDepth--;
        GfxStateRestore(gfx->state);
        GrRestoreState(gfx->state->gstring);
    }
    gfx->saveDepth = outerDepth;
    gfx->skippedSaves = outerSkipped;
}

/********************************************************************
 *                      opRestore
 ********************************************************************
 * SYNOPSIS:      Operator Q: restore the graphics state.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Not used.
 *                numArgs               Not used.
 *
 * RETURNS:       void
 *
 * STRATEGY:      A Q for a skipped q or without q is ignored.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opRestore(Gfx *gfx, Obj args[], int numArgs)
{
    if (gfx->skippedSaves > 0)
    {
        gfx->skippedSaves--;
        return;
    }
    if (gfx->saveDepth == 0)
    {
        return;     /* Q without q: keep the state of the caller */
    }
    gfx->saveDepth--;
    GfxStateRestore(gfx->state);
    GrRestoreState(gfx->state->gstring);
    (void)args;
    (void)numArgs;
}

/********************************************************************
 *                      opConcat
 ********************************************************************
 * SYNOPSIS:      Operator cm: concatenate a matrix with the CTM.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:      The matrix goes to the GString and to the CTM copy (used for
 *                clip boxes and shadings).
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opConcat(Gfx *gfx, Obj args[], int numArgs)
{
    TransMatrix tm;
    sdword tmp;

    tmp = GdoubleToWWFixed(getNum(&args[0]));

    tm.TM_e11.WWF_int = IntegerOf(tmp);
    tm.TM_e11.WWF_frac = FractionOf(tmp);
    tmp = getNum(&args[1]);
    tm.TM_e12.WWF_int = IntegerOf(tmp);
    tm.TM_e12.WWF_frac = FractionOf(tmp);
    tmp = getNum(&args[2]);
    tm.TM_e21.WWF_int = IntegerOf(tmp);
    tm.TM_e21.WWF_frac = FractionOf(tmp);
    tmp = getNum(&args[3]);
    tm.TM_e22.WWF_int = IntegerOf(tmp);
    tm.TM_e22.WWF_frac = FractionOf(tmp);
    tmp = getNum(&args[4]);
    tm.TM_e31.DWF_int = (sword)IntegerOf(tmp);
    tm.TM_e31.DWF_frac = FractionOf(tmp);
    tmp = getNum(&args[5]);
    tm.TM_e32.DWF_int = (sword)IntegerOf(tmp);
    tm.TM_e32.DWF_frac = FractionOf(tmp);

    GrApplyTransform(gfx->state->gstring, &tm);
    {
        gdouble m[6];
        word i;

        for (i = 0; i < 6; ++i)
        {
            m[i] = getNum(&args[i]);
        }
        GfxConcatCtm(gfx->state, m);
    }
    (void)numArgs;
}

/********************************************************************
 *                      opSetDash
 ********************************************************************
 * SYNOPSIS:      Operator d: set the dash pattern.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:      GEOS dash lengths are in line widths: the PDF lengths are
 *                divided by the line width. A single value means "on" and "off"
 *                of the same length.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opSetDash(Gfx *gfx, Obj args[], int numArgs)
{
    Array *a;
    word length;
    Obj obj;

    word            i;
    byte            dash[MAX_DASH_ARRAY_PAIRS * 2];
    Handle          gstring = gfx->state->gstring;
    WWFixedAsDWord  lineWidth;

    a = getArray(&args[0]);
    length = ArrayGetLength(a);
    if (length == 0)
    {
        GrSetLineStyle(gstring, LS_SOLID, 0, 0, 0);
    }
    else
    {
        /*
         * The PDF width, not the GEOS width: dash lengths and the PDF
         * width are both in user space, the CTM scale cancels out.
         */
        lineWidth = gfx->state->lineWidth;

        /* GEOS dash lengths are in line widths */
        for (i = 0; i < length && i < MAX_DASH_ARRAY_PAIRS * 2; ++i)
        {
            ArrayGet(a, i, &obj, gfx->xref);
#ifdef USE_NATIVE_FLOAT_TYPE
            if ((sdword)lineWidth > 0)
            {
                dash[i] = (byte)((0x8000 + GrUDivWWFixed(getNum(&obj), lineWidth)) >> 16);
            }
            else
            {
                dash[i] = (byte)((0x8000 + getNum(&obj)) >> 16);
            }
#else
            dash[i] = (byte)(0.5 + getNum(&obj));
#endif
            if (i & 1)
            {
                ++dash[i];
            }

            if (!dash[i])
            {
                dash[i] = 1;
            }
            GfxObjFree(&obj);
        }

        if (length == 1) { /* single # implies two...*/
            dash[1] = dash[0];
            length = 2;
        }
        GrSetLineStyle(gstring, LS_CUSTOM, GdoubleToWord(getNum(&args[1])),
            (word *)dash, length >> 1);
    }

    (void)numArgs;
}


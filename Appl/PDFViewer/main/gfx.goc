/***********************************************************************
 *		opSetExtGState  ("gs" operator)
 ***********************************************************************
 * SYNOPSIS:	    Reads /ca (fill) and /CA (stroke) -- constant alpha
 *		    only; blend modes, soft masks, and transparency
 *		    groups (also settable via an ExtGState) aren't
 *		    supported and are silently ignored, same
 *		    "approximate, don't fail" spirit as the rest of the
 *		    colorspace/transparency work in this port. The
 *		    actual blending happens later, in GfxBlendAlpha, at
 *		    the point a color is set -- this operator just
 *		    records the current alpha values.
 ***********************************************************************/
static void _near opSetExtGState(Gfx *gfx, Obj args[], int numArgs) {
    Obj gsObj, fieldObj;

    if (numArgs < 1 || !isName(&args[0])) {
	return;
    }
    GfxLookupExtGState(gfx, getName(&args[0]), &gsObj);
    if (!isDict(&gsObj)) {
	GfxObjFree(&gsObj);
	return;
    }

    DictLookup(getDict(&gsObj), "ca", &fieldObj, gfx->xref);
    if (isNum(&fieldObj)) {
	gfx->state->fillAlpha = getNum(&fieldObj);
    }
    GfxObjFree(&fieldObj);

    DictLookup(getDict(&gsObj), "CA", &fieldObj, gfx->xref);
    if (isNum(&fieldObj)) {
	gfx->state->strokeAlpha = getNum(&fieldObj);
    }
    GfxObjFree(&fieldObj);

    GfxObjFree(&gsObj);
}

//------------------------------------------------------------------------
// color operators
//------------------------------------------------------------------------
/*
 * Note:  Text is normally drawn in "fill" mode; for efficiency, in that 
 * mode I draw the text directly (instead of describing the path then 
 * filling it).  So, we have to set the text color when we set the area 
 * color so text has the correct color.
 */

/***********************************************************************
 *		GfxBlendAlpha
 ***********************************************************************
 * SYNOPSIS:	    Blend an RGB color against white by the given
 *		    constant alpha (0.0-1.0, an ExtGState's /ca or /CA
 *		    -- see opSetExtGState). No-op for alpha==1.0 (PDF's
 *		    own default, and the overwhelming majority of
 *		    content that never sets an ExtGState at all), so
 *		    this costs nothing for the common case.
 *
 *		    Per channel: result = (fg*alpha + 255*(255-alpha))
 *		    / 255 = fg*alpha/255 + (255-alpha) -- the "/255"
 *		    is computed via (x + (x>>8) + 1) >> 8 instead of a
 *		    real division (see project optimization analysis
 *		    P5). This isn't an approximation for this specific
 *		    range: verified exhaustively (all 256*256 fg/alpha
 *		    combinations) to match plain integer division
 *		    exactly whenever the numerator is in 0..65025,
 *		    which fg*alpha always is here (both factors 0..255).
 ***********************************************************************/
static void
GfxBlendAlpha(sword *r, sword *g, sword *b, gdouble alpha)
{
    word alphaByte;
    word t;

    alphaByte = GdoubleToWord(GrMulWWFixed(alpha, IntToGdouble(255)));
    if (alphaByte >= 255) {
	return;
    }
    t = (word) *r * alphaByte;
    *r = (sword) (((t + (t >> 8) + 1) >> 8) + 255 - alphaByte);
    t = (word) *g * alphaByte;
    *g = (sword) (((t + (t >> 8) + 1) >> 8) + 255 - alphaByte);
    t = (word) *b * alphaByte;
    *b = (sword) (((t + (t >> 8) + 1) >> 8) + 255 - alphaByte);
}

static void _near opSetFillGray(Gfx *gfx, Obj args[], int numArgs) {
//  state->setFillColorSpace(new GfxColorSpace(colorGray));
//  state->setFillGray(args[0].getNum());
//  out->updateFillColor(state);

    sword r, g, b;

    r = g = b = GdoubleToWord(getNum(&args[0]) * 255);
    GfxBlendAlpha(&r, &g, &b, gfx->state->fillAlpha);
    gfx->state->fillColor.r = r;
    gfx->state->fillColor.g = g;
    gfx->state->fillColor.b = b;

    GrSetAreaColor(gfx->state->gstring, CF_RGB, r, g, b);
    GrSetTextColor(gfx->state->gstring, CF_RGB, r, g, b);
  (void) numArgs;
}

static void _near opSetStrokeGray(Gfx *gfx, Obj args[], int numArgs) {
//  state->setStrokeColorSpace(new GfxColorSpace(colorGray));
//  state->setStrokeGray(args[0].getNum());
//  out->updateStrokeColor(state);

    sword r, g, b;

    r = g = b = GdoubleToWord(getNum(&args[0]) * 255);
    GfxBlendAlpha(&r, &g, &b, gfx->state->strokeAlpha);

    GrSetLineColor(gfx->state->gstring, CF_RGB, r, g, b);
  (void) numArgs;
}

static void _near opSetFillCMYKColor(Gfx *gfx, Obj args[], int numArgs) {
//  state->setFillColorSpace(new GfxColorSpace(colorCMYK));
//  state->setFillCMYK(args[0].getNum(), args[1].getNum(),
//		     args[2].getNum(), args[3].getNum());
//  out->updateFillColor(state);

    word c, m, y, k;
    sword r, g, b;

    c = GdoubleToWord(255 * getNum(&args[0]));
    m = GdoubleToWord(255 * getNum(&args[1]));
    y = GdoubleToWord(255 * getNum(&args[2]));
    k = GdoubleToWord(255 * getNum(&args[3]));

    if ((r = 255 - (c + k)) < 0)
	r = 0;
    if ((g = 255 - (m + k)) < 0)
	g = 0;
    if ((b = 255 - (y + k)) < 0)
	b = 0;

    GfxBlendAlpha(&r, &g, &b, gfx->state->fillAlpha);
    gfx->state->fillColor.r = r;
    gfx->state->fillColor.g = g;
    gfx->state->fillColor.b = b;

    GrSetAreaColor(gfx->state->gstring, CF_RGB, r, g, b);

    GrSetTextColor(gfx->state->gstring, CF_RGB, r, g, b);
  (void) numArgs;
}


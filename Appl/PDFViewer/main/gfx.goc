 *******************************************************************/
static void _near opSetCharSpacing(Gfx *gfx, Obj args[], int numArgs)
{
    GfxStateSetCharSpace(gfx->state, getNum(&args[0]));

    (void)numArgs;
}

/********************************************************************
 *                      opSetFont
 ********************************************************************
 * SYNOPSIS:      Operator Tf: set the font and the font size.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.

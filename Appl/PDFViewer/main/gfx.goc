/********************************************************************
 *                      opSetFillCMYKColor
 ********************************************************************
 * SYNOPSIS:      Operator k: set a CMYK fill color.
 *
 * PARAMETERS:    *gfx                  Ptr to the graphics context.
 *                *args                 Ptr to the operands.
 *                numArgs               Number of operands.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Simple conversion: r = 255 - (c + k) and so on.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      08/22/26  JK        Initial Revision
 *******************************************************************/
static void _near opSetFillCMYKColor(Gfx *gfx, Obj args[], int numArgs)
{
    word c, m, y, k;
    sword r, g, b;

    c = GdoubleToWord(255 * getNum(&args[0]));
    m = GdoubleToWord(255 * getNum(&args[1]));
    y = GdoubleToWord(255 * getNum(&args[2]));
    k = GdoubleToWord(255 * getNum(&args[3]));

    if ((r = 255 - (c + k)) < 0)
    {
        r = 0;
    }
    if ((g = 255 - (m + k)) < 0)
    {
        g = 0;
    }
    if ((b = 255 - (y + k)) < 0)
    {
        b = 0;
    }

    GfxSetFillRGB(gfx, r, g, b);
    (void)numArgs;
}


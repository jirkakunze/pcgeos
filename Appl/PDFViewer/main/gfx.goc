/***********************************************************************
 *      opSetExtGState
 ***********************************************************************
 * SYNOPSIS:        Set ext gstate.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/
static void _near opSetExtGState(Gfx *gfx, Obj args[], int numArgs)
{
    Obj gsObj, fieldObj;

    if (numArgs < 1 || !isName(&args[0]))
    {
        return;
    }
    GfxLookupExtGState(gfx, getName(&args[0]), &gsObj);
    if (!isDict(&gsObj))
    {
        GfxObjFree(&gsObj);
        return;
    }

    DictLookup(getDict(&gsObj), "ca", &fieldObj, gfx->xref);
    if (isNum(&fieldObj))
    {
        gfx->state->fillAlpha = getNum(&fieldObj);
    }
    GfxObjFree(&fieldObj);

    DictLookup(getDict(&gsObj), "CA", &fieldObj, gfx->xref);
    if (isNum(&fieldObj))
    {
        gfx->state->strokeAlpha = getNum(&fieldObj);
    }
    GfxObjFree(&fieldObj);

    GfxObjFree(&gsObj);
}

/* color operators */

/***********************************************************************
 *      GfxBlendAlpha
 ***********************************************************************
 * SYNOPSIS:        Process gfx blend alpha.
 * PARAMETERS:      sword *r    r
 *                  sword *g    g
 *                  sword *b    b
 *                  gdouble alpha    alpha
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/
static void GfxBlendAlpha(sword *r, sword *g, sword *b, gdouble alpha)
{
    word alphaByte;
    word t;

    alphaByte = GdoubleToWord(GrMulWWFixed(alpha, IntToGdouble(255)));
    if (alphaByte >= 255)
    {
        return;
    }
    t = (word)* r *alphaByte;
    *r = (sword)(((t + (t >> 8) + 1) >> 8) + 255 - alphaByte);
    t = (word)* g *alphaByte;
    *g = (sword)(((t + (t >> 8) + 1) >> 8) + 255 - alphaByte);
    t = (word)* b *alphaByte;
    *b = (sword)(((t + (t >> 8) + 1) >> 8) + 255 - alphaByte);
}

/***********************************************************************
 *      opSetFillGray
 ***********************************************************************
 * SYNOPSIS:        Set fill gray.
 * PARAMETERS:      Gfx *gfx    graphics context
 *                  Obj args[]    args
 *                  int numArgs    num args
 *
 * RETURNS:         void
 *
 * CONTEXT:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *  Name    Date        Description
 *  ----    ----        -----------
 *  JK      08/22/26    Style cleanup
 *
 ***********************************************************************/

static void _near opSetFillGray(Gfx *gfx, Obj args[], int numArgs)
{
    sword r, g, b;

    r = g = b = GdoubleToWord(getNum(&args[0]) * 255);
    GfxBlendAlpha(&r, &g, &b, gfx->state->fillAlpha);
    gfx->state->fillColor.r = r;
    gfx->state->fillColor.g = g;
    gfx->state->fillColor.b = b;

    GrSetAreaColor(gfx->state->gstring, CF_RGB, r, g, b);
    GrSetTextColor(gfx->state->gstring, CF_RGB, r, g, b);
    (void)numArgs;
}

/***********************************************************************
 *      opSetStrokeGray
 ***********************************************************************
 * SYNOPSIS:        Set stroke gray.
 * PARAMETERS:      Gfx *gfx    graphics context

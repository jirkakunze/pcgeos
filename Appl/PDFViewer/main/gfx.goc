/*
 * Phase 4: progress reporting and cancellation used to go through
 * PDFUpdateProgress/PDFPutUpImageProgress/PDFUpdateImageProgress/
 * PDFTakeDownImageProgress (all in ui/pdfvu.goc, called directly from
 * here) and a global GBool (stopLoadingImage). Both are gone now --
 * see the progressCallback/progressUserData/cancelFlag fields the PDF
 * engine sets on Gfx (main/pdfEngine.goc, right after GfxInit).
 */

/*
 * Forward decls
 */

static GBool GfxGo(Gfx *this, Parser *parser);
static void GfxExecOp(Gfx *gfx, Obj *cmd, Obj args[], int numArgs, Operator *pOpTab);
static Operator *GfxFindOp(char *name, Operator *opTab);
static GBool GfxCheckArg(Obj *arg, TchkType type);
void setTextTransform(Gfx *gfx);
void resetTextTransform(Gfx *gfx);
static void doShowText(Gfx *gfx, GooString *s);
static void GfxUpdateFont(Gfx *gfx);
static void GfxDoImage(Gfx *gfx, Stream *str, GBool inlineImg);

/* OPT-24: page-owned bitmap resources are governed primarily by a
 * byte budget instead of the historical hard 100-image cutoff.  The
 * high object-count ceiling is only a last-resort guard against PDFs
 * containing thousands of tiny image objects. */
#define PDF_PAGE_RESOURCE_VM_BUDGET       0x00800000UL
#define PDF_PAGE_RESOURCE_OBJECT_LIMIT    2048

static GBool GfxCheckPageResourceBudget(Gfx *gfx, dword bytes);
static void GfxDoForm(Gfx *gfx, Obj *str);
static void buildImageStream(Gfx *gfx, Stream **str);
static GBool GfxLookupXObject(Gfx *this, char *name, Obj *obj);

void GfxDrawImageMask(Gfx *gfx, Stream *str, word width, word height, 
		      GBool invert, GBool inlineImage);
void GfxDrawImage(Gfx *gfx, Stream *str, word width, word height, 
		  GfxImageColorMap *colorMap, GBool inlineImage,
		  Stream *smaskStr, word smaskWidth, word smaskHeight,
		  short smaskBits);



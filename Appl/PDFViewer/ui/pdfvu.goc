}


/***********************************************************************
 *		PDFPasswordTextClass
 ***********************************************************************
 * SYNOPSIS:	Text field that shows '*' for every typed character.
 * STRATEGY:	Printable keys go into PDFPTI_password, Backspace removes
 *		the last one; after each change the visible text is
 *		replaced by as many '*' (so cursor or selection changes
 *		can never get the display out of step). Enter, Tab and
 *		Escape go to the superclass (default action, navigation,
 *		cancel); all other editing keys are ignored.
 ***********************************************************************/
static void
PDFPasswordTextShow(optr oself, word len)
{
    char stars[PDF_PASSWORD_BUF_SIZE];

    memset(stars, '*', len);
    stars[len] = 0;
    @call oself::MSG_VIS_TEXT_REPLACE_ALL_PTR(stars, len);
}

@method PDFPasswordTextClass, MSG_META_KBD_CHAR
{
    if (flags & CF_RELEASE) {
	@callsuper();
	return;
    }
    if ((character >> 8) == CS_BSW &&
	!(flags & ((SS_LCTRL | SS_RCTRL | SS_LALT | SS_RALT) << 8))) {
	if ((character & 0xff) >= ' ' &&
	    pself->PDFPTI_length < PDF_PASSWORD_BUF_SIZE - 1) {
	    pself->PDFPTI_password[pself->PDFPTI_length++] =
		(char)(character & 0xff);
	    PDFPasswordTextShow(oself, pself->PDFPTI_length);
	}
	return;
    }
    switch (character) {
    case ((CS_CONTROL << 8) | VC_BACKSPACE):
	if (pself->PDFPTI_length) {
	    pself->PDFPTI_password[--pself->PDFPTI_length] = 0;
	    PDFPasswordTextShow(oself, pself->PDFPTI_length);
	}
	break;
    case ((CS_CONTROL << 8) | VC_ENTER):
    case ((CS_CONTROL << 8) | VC_TAB):
    case ((CS_CONTROL << 8) | VC_ESCAPE):
	@callsuper();
	break;
    default:
	if ((character >> 8) != CS_BSW) {
	    /* function keys, shortcuts etc. -- but no text editing */
	    switch (character & 0xff) {
	    case VC_DEL:
		break;
	    default:
		@callsuper();
		break;
	    }
	}
	break;
    }
}

@method PDFPasswordTextClass, MSG_VIS_TEXT_DELETE_ALL
{
    memset(pself->PDFPTI_password, 0, sizeof(pself->PDFPTI_password));
    pself->PDFPTI_length = 0;
    @callsuper();
}

@method PDFPasswordTextClass, MSG_PDF_PASSWORD_TEXT_GET
{
    memcpy(buf, pself->PDFPTI_password, pself->PDFPTI_length);
    buf[pself->PDFPTI_length] = 0;
    return pself->PDFPTI_length;
}

/* no clipboard or quick copy/paste of the password field */
@method PDFPasswordTextClass, MSG_META_CLIPBOARD_CUT,
			      MSG_META_CLIPBOARD_COPY,
			      MSG_META_CLIPBOARD_PASTE
{
}

@method PDFPasswordTextClass, MSG_META_START_MOVE_COPY
{
    /* consume quick copy; tell the UI the event was handled */
    retVal->flags = MRF_PROCESSED;
}

/***********************************************************************
 *		PDFAskPassword
 ***********************************************************************
 * SYNOPSIS:	Ask for the password of an encrypted PDF.
 * PARAMETERS:	char *password	buffer, PDF_PASSWORD_BUF_SIZE bytes
 *		Boolean retry	TRUE: the last password was wrong
 * RETURNS:	TRUE with the password in Latin-1 (the encoding of PDF
 *		passwords), FALSE if the user cancelled
 * STRATEGY:	Runs on the process thread from PHYSICAL_OPEN (not inside
 *		a draw), so a modal UserDoDialog is fine here. The text
 *		is cleared again right away, so the password does not
 *		stay in the UI.
 ***********************************************************************/
static Boolean
PDFAskPassword(char *password, Boolean retry)
{
    word len;

    if (retry) {
	@call PDFPasswordWrongGlyph::MSG_GEN_SET_USABLE(VUM_NOW);
    } else {
	@call PDFPasswordWrongGlyph::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
    }
    @call PDFPasswordText::MSG_VIS_TEXT_DELETE_ALL();

    if (UserDoDialog(@PDFPasswordDB) != IC_OK) {
	@call PDFPasswordText::MSG_VIS_TEXT_DELETE_ALL();
	return FALSE;
    }

    len = @call PDFPasswordText::MSG_PDF_PASSWORD_TEXT_GET(password);
    @call PDFPasswordText::MSG_VIS_TEXT_DELETE_ALL();
    if (len) {
	LocalGeosToCodePage(password, len, CODE_PAGE_LATIN_1, '?');
    }
    return TRUE;
}

/***********************************************************************
 *		MSG_GEN_DOCUMENT_PHYSICAL_OPEN for PDFDocumentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:		word *fileOrError = multipleax,
 *		        DocumentCommonParams *params = ss:bp)
 *
 * RETURNS:		Boolean (true if error)
 * SIDE EFFECTS:    
 *
 * NOTES:
 *	We intercept this message, because it's a handy place to return
 *	an error if the file isn't really a pdf file -- GEOS document
 *	control will realize the file isn't open and continue appropriately.
 *
 *	The code is ported from the PDFDoc constructor.
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mevissen	3/30/99   	Initial Revision
 *
 ***********************************************************************/
@method PDFDocumentClass, MSG_GEN_DOCUMENT_PHYSICAL_OPEN
{
    Boolean status;
    PdfError err;
    PdfDocHandle engine = PDF_NULL_DOC;
    char password[PDF_PASSWORD_BUF_SIZE];
    Boolean retry;
    Boolean cancelled = FALSE;

  /* setup */
    pself->PDFDoc_engine = PDF_NULL_DOC;
    pself->PDFDoc_sourceFile = 0;


/* use superclass to open file; return if error */

    status = @callsuper();
    if (status) return(status);

    pself = ObjDerefGen(oself);

    if (!*fileOrError) return (TRUE);

    pself->PDFDoc_sourceFile = *fileOrError;

/* hand the already-open file to the PDF engine -- it parses the xref
 * table, the page catalog, and opens its own scratch VM file for
 * decoded pages. See pdfEngine.h for what PdfOpen does and doesn't do
 * (in particular: it never closes `file` itself, on success or
 * failure -- that stays our job below). */

    /*
     * Encrypted file: try without a password first (most encrypted PDFs
     * only restrict printing/copying and open with the empty user
     * password), then ask until the password fits or the user cancels.
     */
    password[0] = 0;
    retry = FALSE;
    for (;;) {
	err = PdfOpen(*fileOrError, password, &engine);
	if (err != PDF_ERR_PASSWORD) {
	    break;
	}
	if (!PDFAskPassword(password, retry)) {
	    cancelled = TRUE;
	    break;
	}
	retry = TRUE;
    }
    memset(password, 0, sizeof(password));
    pself = ObjDerefGen(oself);
    pself->PDFDoc_engine = engine;
    if (err != PDF_OK) {
	goto errorClose;
    }

  // done

  /*
   * Set current page, tell controller # of pages -- XXX: how is this
	* done when switching between multiple docs?  jfh - tell the control
	* in MSG_GEN_DOCUMENT_CONTROL_FILE_CHANGED
   */
	 pself->PDFDoc_pageNum = 1;

    /* Phase 4: route this document's page/image progress through
     * PDFDocProgressCallback instead of the four separate functions
     * gfx.goc used to call by name. */
    PdfSetProgressCallback(pself->PDFDoc_engine, PDFDocProgressCallback, NULL);

    PDFUpdatePageControl(PdfGetPageCount(pself->PDFDoc_engine), 1);

    /* opened okay -- return carry clear. */

  return FALSE;


errorClose:

    pself = ObjDerefGen(oself);
/*
 * Free anything the engine allocated
 */
    PdfClose(pself->PDFDoc_engine);
    pself->PDFDoc_engine = PDF_NULL_DOC;

/* 
 * Close the doc file by hand -- the system opened it fine, but we don't think
 * it looks like a PDF file.
 */

    FileClose(*fileOrError, FALSE);
    *fileOrError = 0;
    pself->PDFDoc_sourceFile = 0;

/*
 * Display an error message. Encrypted files get their own, specific
 * message -- PdfOpen already distinguishes PDF_ERR_ENCRYPTED from a
 * genuinely corrupt file (PDF_ERR_BAD_XREF etc.), no reason to make
 * the user read "may be corrupt" for a file that isn't.
 */

    if (cancelled) {
	/* password dialog cancelled: nothing to report */
    } else if (err == PDF_ERR_ENCRYPTED) {
	PDFShowError(@PDFOpenEncryptedError);
    } else if (err == PDF_ERR_OUT_OF_MEMORY) {
	PDFShowError(@PDFOutOfMemoryError);
    } else {
	PDFShowError(@PDFOpenError);
    }

    return TRUE;

}	/* End of MSG_GEN_DOCUMENT_PHYSICAL_OPEN.	*/


/***********************************************************************
 *	MSG_GEN_DOCUMENT_ATTACH_UI_TO_DOCUMENT for PDFDocumentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Adjust the UI for this document
 * PARAMETERS:	    
 * SIDE EFFECTS:    Changes view object in duplicated document resource
 *
 * STRATEGY:	Change the view color to the gray level specified in
 *		INI if both of the following conditions are met:
 *
 *		1. The user is running on the TV
 *		2. The file is located outside of the GEOS tree.
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	dhunter		3/21/2000	Initial version
 *
 ***********************************************************************/
@method PDFDocumentClass, MSG_GEN_DOCUMENT_ATTACH_UI_TO_DOCUMENT
{
    GenFilePath *ppath = ObjVarFindData(oself, ATTR_GEN_PATH_DATA);
    word gray;

    if (onTV && ppath != NULL && FileComparePaths(NULL, SP_TOP, 
	ppath->GFP_path, ppath->GFP_disk) > PCT_SUBDIR)
    {
	if (!InitFileReadInteger(INIT_FILE_CATEGORY, INIT_FILE_KEY_VIEW_COLOR, &gray))
	{
	    optr view = @call @genParent::MSG_GEN_DOCUMENT_GROUP_GET_VIEW();
	    view = ConstructOptr(pself->GDI_display, 
		OptrToChunk(view));
	    @call view::MSG_GEN_VIEW_SET_COLOR(gray, CF_RGB, (gray << 8) | gray);
	}
    }

    @callsuper();
}


/***********************************************************************
 *		MSG_GEN_DOCUMENT_CLOSE for PDFDocumentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    Release the memory we allocated
 * PARAMETERS:	    word (IACPConnection connection = bp) = cx;
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mevissen	4/07/99   	Initial Revision
 *
 ***********************************************************************/
@method PDFDocumentClass, MSG_GEN_DOCUMENT_CLOSE
{
    /*
     * The Stop trigger (UI thread) cancels whatever currentlyDecodingDoc
     * names; never leave it pointing at a handle PdfClose is about to free.
     */
    if (currentlyDecodingDoc == pself->PDFDoc_engine) {
	currentlyDecodingDoc = PDF_NULL_DOC;
    }
    PdfClose(pself->PDFDoc_engine);
    pself->PDFDoc_engine = PDF_NULL_DOC;
    pself->PDFDoc_sourceFile = 0;

    /* callsuper */

    return (@callsuper());

}	/* End of MSG_GEN_DOCUMENT_CLOSE.	*/


/***********************************************************************
 *		MSG_VIS_DRAW for PDFDocumentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    void (DrawFlags drawFlags, GStateHandle gstate)
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mevissen	4/06/99   	Initial Revision
 *
 ***********************************************************************/
@method PDFDocumentClass, MSG_VIS_DRAW
{
    word pagenum = pself->PDFDoc_pageNum;
    Point pageSize;
    PdfError err;

    GrSaveState(gstate);


/* do we need callsuper? nope - none available jfh */

//    @callsuper();

/* Decode (or fetch from cache) this page */

    if (pagenum == pself->PDFDoc_cancelledPage) {
	GrRestoreState(gstate);
	return;
    }

    currentlyDecodingDoc = pself->PDFDoc_engine;
    err = PdfDecodePage(pself->PDFDoc_engine, pagenum);
    currentlyDecodingDoc = PDF_NULL_DOC;
    pself = ObjDerefGen(oself);
    if (err != PDF_OK) {
	PDFDismissProgress();
	if (err == PDF_ERR_CANCELLED) {
	    pself->PDFDoc_cancelledPage = pagenum;
	}
    }

/*
 * Draw the page
 */
    if (err == PDF_OK) {

/* Render it, and pick up the page size while we're at it -- this
 * used to be set inside PDFSetupGState (which wrote PDFDoc_bounds and
 * sent MSG_GEN_VIEW_SET_DOC_BOUNDS itself); that's UI-object messaging
 * and now happens here instead, using what PdfDrawPage reports. */

	err = PdfDrawPage(pself->PDFDoc_engine, pagenum, gstate, FALSE, &pageSize);
	/* only tell the view about a new size -- setting the bounds on
	 * every draw makes the view redraw/rescroll for nothing */
	if (err == PDF_OK && (pageSize.P_x != pself->PDFDoc_bounds.P_x ||
			      pageSize.P_y != pself->PDFDoc_bounds.P_y)) {
	    pself->PDFDoc_bounds = pageSize;
	    @call pself->GCI_genView::MSG_GEN_VIEW_SET_DOC_BOUNDS(
		pageSize.P_y, pageSize.P_x, 0, 0);
	}

    }

/* Report a failure once per page. The dialog is queued instead of shown
 * here: a modal dialog inside MSG_VIS_DRAW would trigger the next
 * redraw (and the next dialog) when it closes. A cancelled decode is
 * the user's own doing and needs no message. */

    if (err == PDF_OK) {
	pself->PDFDoc_errorPage = 0;
    } else if (err != PDF_ERR_CANCELLED && pself->PDFDoc_errorPage != pagenum) {
	pself->PDFDoc_errorPage = pagenum;
	@send, forceQueue oself::MSG_PDF_DOCUMENT_REPORT_ERROR(err);
    }

    GrRestoreState(gstate);

}	/* End of MSG_VIS_DRAW.	*/

/*
 * PDFSetupGState and PDFGetPageGString used to be defined here.
 * Both moved into the PDF engine (main/pdfEngine.goc) as part of
 * PdfDrawPage and PdfDecodePage respectively -- see pdfEngine.h.
 * The busy-cursor and page-decode progress dialog bracket around the
 * whole PdfDecodePage call is still ours to do (there's none of that
 * here in MSG_VIS_DRAW since it doesn't matter for a cache hit); the
 * per-image progress dialog that gfx.goc puts up mid-decode now goes
 * through PDFDocProgressCallback below, registered once in
 * MSG_GEN_DOCUMENT_PHYSICAL_OPEN.
 */


/***********************************************************************
 *		PDFDocProgressCallback
 ***********************************************************************
 *
 * SYNOPSIS:	PdfProgressCallback registered with the engine (Phase 4)
 *		for the current document; replaces the four separate
 *		functions gfx.goc used to call directly
 *		(PDFUpdateProgress, PDFPutUpImageProgress,
 *		PDFUpdateImageProgress, PDFTakeDownImageProgress).
 * CALLED BY:	the PDF engine, from inside PdfDecodePage
 * PARAMETERS:	see PdfProgressCallback in pdfEngine.h
 * RETURN:	nothing
 * SIDE EFFECTS:
 *
 * STRATEGY:	Dispatch on `kind`. ppValue/ipValue/PDFImageProgressDialog
 *		are the same singleton UI objects the four original
 *		functions sent to; only the entry point changed.
 *
 *		The decode runs on the process thread; the dialogs live
 *		in the Interface resource (ui-object), i.e. on the UI
 *		thread. INITIATE and IC_DISMISS are @call so the dialog
 *		is really up/down when the engine continues; the value
 *		updates are @send so the decode never waits for them.
 *		MSG_GEN_VALUE_SET_VALUE's second parameter is the
 *		`indeterminate' flag (not a VisUpdateMode): passing
 *		VUM_NOW (1) marked the value as unknown and the bar
 *		stayed empty.
 *
 *		The engine calls this through ProcCallFixedOrMovable_cdecl,
 *		which has no parameter prototype; GfxReportProgress in
 *		gfx.goc makes sure all arguments arrive as dwords.
 *
 ***********************************************************************/
/*
 * PDFProgressFraction: current/total as a WWFixed in the range 0..1 (the
 * range of ppValue/ipValue). The old MakeWWFixed(current)/total shifted
 * `current` left by 16 bits and overflowed for current >= 32768, and
 * divided by zero for total == 0.
 */
static dword
PDFProgressFraction(dword current, dword total)
{
    if (total == 0) {
	return 0;
    }
    if (current >= total) {
	return MakeWWFixed(1);
    }
    while (current >= 0x8000L) {
	current >>= 1;
	total >>= 1;
    }
    if (total == 0) {
	return MakeWWFixed(1);
    }
    return MakeWWFixed(current)/total;
}

/*
 * PDFDismissProgress: safety net, called after a decode returns. Makes
 * sure the image progress dialog is closed on every path, e.g. when an
 * error ended the decode before PDF_PROGRESS_IMAGE_END was sent.
 */
void
PDFDismissProgress(void)
{
    @call PDFImageProgressDialog::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
}

/***********************************************************************
 *		PDFShowError
 ***********************************************************************
 * SYNOPSIS:	Show an error notification with a string from
 *		StringResource.
 ***********************************************************************/
void
PDFShowError(optr msg)
{
    UserStandardDialogOptr(NULL, NULL, NullOptr, NullOptr, msg,
	(CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
	(GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET));
}

/***********************************************************************
 *		MSG_PDF_DOCUMENT_REPORT_ERROR for PDFDocumentClass
 ***********************************************************************
 * SYNOPSIS:	Tell the user that a page couldn't be decoded/drawn.
 * PARAMETERS:	word err (a PdfError)
 * STRATEGY:	Queued by MSG_VIS_DRAW, printing and clipboard copy so
 *		the modal dialog runs outside of those handlers.
 ***********************************************************************/
@method PDFDocumentClass, MSG_PDF_DOCUMENT_REPORT_ERROR
{
    if (err == PDF_ERR_OUT_OF_MEMORY) {
	PDFShowError(@PDFOutOfMemoryError);
    } else {
	PDFShowError(@PDFPageError);
    }
}

void
PDFDocProgressCallback(dword kind, dword current, dword total, void *userData)
{
    switch (kind) {
    case PDF_PROGRESS_PAGE:
	@send ppValue::MSG_GEN_VALUE_SET_VALUE(
	    PDFProgressFraction(current, total), FALSE);
	break;

    case PDF_PROGRESS_IMAGE_BEGIN:
	@send ipValue::MSG_GEN_VALUE_SET_VALUE(0, FALSE);
	@call PDFImageProgressDialog::MSG_GEN_INTERACTION_INITIATE();
	break;

    case PDF_PROGRESS_IMAGE_UPDATE:
	@send ipValue::MSG_GEN_VALUE_SET_VALUE(
	    PDFProgressFraction(current, total), FALSE);
	break;

    case PDF_PROGRESS_IMAGE_END:
	@call PDFImageProgressDialog::
	    MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
	break;
    }
}	/* End of PDFDocProgressCallback.	*/


/***********************************************************************
 *		MSG_META_KBD_CHAR for PDFDocumentClass
 ***********************************************************************
 *
 * SYNOPSIS:	Some obvious keyboard shortcuts.
 *    
 * PARAMETERS:	word character = cx, word flags = dx, word state = bp);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mevissen	4/20/99   	Initial Revision
 *
 ***********************************************************************/
@method PDFDocumentClass, MSG_META_KBD_CHAR
{
    EventHandle event;

    if (flags & CF_FIRST_PRESS) {
	if (character == ((((word)CS_CONTROL)<<8) | VC_NEXT)) {
	    event = @record PDFDocumentClass::MSG_META_PAGED_OBJECT_NEXT_PAGE();
	    @send self::MSG_META_SEND_CLASSED_EVENT(event, TO_APP_TARGET);

	} else 	if (character == ((((word)CS_CONTROL)<<8) | VC_PREVIOUS)) {
	    event = @record PDFDocumentClass::MSG_META_PAGED_OBJECT_PREVIOUS_PAGE();
	    @send self::MSG_META_SEND_CLASSED_EVENT(event, TO_APP_TARGET);

	} else if (character == ((((word)CS_CONTROL)<<8) | VC_DOWN)) {
	    event = @record GenViewClass::MSG_GEN_VIEW_SCROLL_DOWN();
	    @send self::MSG_META_SEND_CLASSED_EVENT(event, TO_APP_TARGET);

	} else 	if (character == ((((word)CS_CONTROL)<<8) | VC_UP)) {
	    event = @record GenViewClass::MSG_GEN_VIEW_SCROLL_UP();
	    @send self::MSG_META_SEND_CLASSED_EVENT(event, TO_APP_TARGET);

	} else if (character == ((((word)CS_CONTROL)<<8) | VC_RIGHT)) {
	    event = @record GenViewClass::MSG_GEN_VIEW_SCROLL_RIGHT();
	    @send self::MSG_META_SEND_CLASSED_EVENT(event, TO_APP_TARGET);

	} else 	if (character == ((((word)CS_CONTROL)<<8) | VC_LEFT)) {
	    event = @record GenViewClass::MSG_GEN_VIEW_SCROLL_LEFT();
	    @send self::MSG_META_SEND_CLASSED_EVENT(event, TO_APP_TARGET);

	} else if (character == ((((word)CS_CONTROL)<<8) | VC_HOME)) {
	    event = @record PDFDocumentClass::MSG_META_PAGED_OBJECT_GOTO_PAGE(1);
	    @send self::MSG_META_SEND_CLASSED_EVENT(event, TO_APP_TARGET);

	} else 	if (character == ((((word)CS_CONTROL)<<8) | VC_END)) {
	    event = @record PDFDocumentClass::MSG_META_PAGED_OBJECT_GOTO_PAGE(32000);
	    @send self::MSG_META_SEND_CLASSED_EVENT(event, TO_APP_TARGET);

	} else {
	    @callsuper();
	}
    } else {
	@callsuper();
    }
}	/* End of MSG_META_KBD_CHAR.	*/


/***********************************************************************
 *		MSG_META_PAGED_OBJECT_NEXT_PAGE for PDFDocumentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mevissen	4/20/99   	Initial Revision
 *
 ***********************************************************************/
@method PDFDocumentClass, MSG_META_PAGED_OBJECT_NEXT_PAGE
{
    optr view;
    word numPages = PdfGetPageCount(pself->PDFDoc_engine);

/* If on last page, don't advance */

    if (pself->PDFDoc_pageNum >= numPages) {
	return;
    }

/* else, advance */

    ++pself->PDFDoc_pageNum;
    pself->PDFDoc_cancelledPage = 0;
    view = @call PDFDocumentGroup::MSG_GEN_DOCUMENT_GROUP_GET_VIEW();
    if (pself->GDI_display & 0xff00) {
	view = (view & 0xffff) | ((long)pself->GDI_display << 16);
    }

    @call view::MSG_GEN_VIEW_SUSPEND_UPDATE();
    @call view::MSG_GEN_VIEW_SCROLL_TOP();
    @call view::MSG_GEN_VIEW_REDRAW_CONTENT();
    @call view::MSG_GEN_VIEW_UNSUSPEND_UPDATE();

/* update the page controller */

    pself = ObjDerefGen(oself);
    PDFUpdatePageControl(numPages,
			 pself->PDFDoc_pageNum);

}	/* End of MSG_META_PAGED_OBJECT_NEXT_PAGE.	*/


/***********************************************************************
 *		MSG_META_PAGED_OBJECT_PREVIOUS_PAGE for PDFDocumentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mevissen	4/20/99   	Initial Revision
 *
 ***********************************************************************/
@method PDFDocumentClass, MSG_META_PAGED_OBJECT_PREVIOUS_PAGE
{
    optr view;

/* If on first page, don't retreat */

    if (pself->PDFDoc_pageNum == 1) {
	return;
    }

/* else, retreat */

    --pself->PDFDoc_pageNum;
    pself->PDFDoc_cancelledPage = 0;
    view = @call PDFDocumentGroup::MSG_GEN_DOCUMENT_GROUP_GET_VIEW();
    if (pself->GDI_display & 0xff00) {
	view = (view & 0xffff) | ((long)pself->GDI_display << 16);
    }

    @call view::MSG_GEN_VIEW_SUSPEND_UPDATE();
    @call view::MSG_GEN_VIEW_SCROLL_TOP();
    @call view::MSG_GEN_VIEW_REDRAW_CONTENT();
    @call view::MSG_GEN_VIEW_UNSUSPEND_UPDATE();

/* update the page controller */

    pself = ObjDerefGen(oself);
	 PDFUpdatePageControl(PdfGetPageCount(pself->PDFDoc_engine),
			 pself->PDFDoc_pageNum);

}	/* End of MSG_META_PAGED_OBJECT_PREVIOUS_PAGE.	*/

/***********************************************************************
 *		MSG_PDF_DOCUMENT_UPDATE_PAGE_CONTROL for PDFDocumentClass
 ***********************************************************************
 *
 * SYNOPSIS:	update the page control.
 * PARAMETERS:	void (void)
 * SIDE EFFECTS:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	jfh		11/14/02  Initial Revision
 *
 ***********************************************************************/
@method PDFDocumentClass, MSG_PDF_DOCUMENT_UPDATE_PAGE_CONTROL
{

	 PDFUpdatePageControl(PdfGetPageCount(pself->PDFDoc_engine),
			 pself->PDFDoc_pageNum);


}


/***********************************************************************
 *		MSG_META_PAGED_OBJECT_GOTO_PAGE for PDFDocumentClass
 ***********************************************************************
 *
 * SYNOPSIS:	    
 * PARAMETERS:	    word page = cx
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mevissen	4/20/99   	Initial Revision
 *
 ***********************************************************************/
@method PDFDocumentClass, MSG_META_PAGED_OBJECT_GOTO_PAGE
{
    optr view;
    word numPages = PdfGetPageCount(pself->PDFDoc_engine);

/* verify page is in range */

    if (page < 1) page = 1;
    if (page > numPages) page = numPages;

/* update page number */

    pself->PDFDoc_pageNum = page;
    pself->PDFDoc_cancelledPage = 0;

/* redraw view */

    view = @call PDFDocumentGroup::MSG_GEN_DOCUMENT_GROUP_GET_VIEW();
    if (pself->GDI_display & 0xff00) {
	view = (view & 0xffff) | ((long)pself->GDI_display << 16);
    }

    @call view::MSG_GEN_VIEW_SUSPEND_UPDATE();
    @call view::MSG_GEN_VIEW_SCROLL_TOP();
    @call view::MSG_GEN_VIEW_REDRAW_CONTENT();
    @call view::MSG_GEN_VIEW_UNSUSPEND_UPDATE();

    PDFUpdatePageControl(numPages, page);

}	/* End of MSG_META_PAGED_OBJECT_GOTO_PAGE.	*/


/***********************************************************************
 *		PDFUpdatePageControl
 ***********************************************************************
 *
 * SYNOPSIS:	Tell the page control what page we're on, so it can
 *		disable next/prev appropriately.
 * CALLED BY:	
 * PARAMS:	word totalPages	= total # pages in doc
 *		word curPage	= the current page
 *
 * RETURN:	nothing
 * SIDE EFFECTS:
 *	
 * STRATEGY:
 *	
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mevissen	4/21/99   	Initial Revision
 *
 ***********************************************************************/
void
PDFUpdatePageControl (word totalPages, word curPage)
{
    MemHandle mh;
    NotifyPageStateChange *pageState;
    EventHandle pageNotify;


    mh = MemAlloc(sizeof(NotifyPageStateChange),
		  HF_SHARABLE | HF_SWAPABLE,
		  HAF_NO_ERR);
    pageState = MemLock(mh);

    pageState->NPSC_firstPage = 1;
    pageState->NPSC_lastPage = totalPages;
    pageState->NPSC_currentPage = curPage;

    MemUnlock(mh);
    MemInitRefCount(mh, 1);

    pageNotify = @record (optr)NullClass::MSG_META_NOTIFY_WITH_DATA_BLOCK(
	MANUFACTURER_ID_GEOWORKS,
	GWNT_PAGE_STATE_CHANGE,
	mh);

    @call process::MSG_GEN_PROCESS_SEND_TO_APP_GCN_LIST(
	GCNLSF_SET_STATUS,
	pageNotify,
	mh,
	GAGCNLT_APP_TARGET_NOTIFY_PAGE_STATE_CHANGE,
	MANUFACTURER_ID_GEOWORKS);

}	/* End of PDFUpdatePageControl.	*/


/***********************************************************************
 *		MSG_PRINT_START_PRINTING for PDFDocumentClass
 ***********************************************************************
 *
 * SYNOPSIS:	Start printing this document.
 * PARAMETERS:	void   (optr 		printCtrlOD = cx:dx,
 *			GStateHandle 	gstate = bp );
 *
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mevissen	4/23/99   	Initial Revision
 *
 ***********************************************************************/
@method PDFDocumentClass, MSG_PRINT_START_PRINTING
{
	 PdfError	err = PDF_ERR_INVALID_PAGE;
    word pagenum;
    PCPageRange		pageRange;
    PageSizeReport	sPageSize;
    Boolean		bContinue;

    /* Print UI is disabled when /P forbids printing; guard anyway */
    if (!PdfOkToPrint(pself->PDFDoc_engine)) {
	@send printCtrlOD::MSG_PRINT_CONTROL_PRINTING_CANCELLED();
	return;
    }

	 /*
     * Set page size 
     */
/*
    @call printCtrlOD::MSG_PRINT_CONTROL_GET_PAPER_SIZE_INFO(
        &sPageSize );
    @call printCtrlOD::MSG_PRINT_CONTROL_SET_DOC_MARGINS(&sPageSize.PSR_margins);
    @call printCtrlOD::MSG_PRINT_CONTROL_SET_DOC_SIZE(
        sPageSize.PSR_width - sPageSize.PSR_margins.PCMP_left
	 - sPageSize.PSR_margins.PCMP_right,
	sPageSize.PSR_height - sPageSize.PSR_margins.PCMP_top
	 - sPageSize.PSR_margins.PCMP_bottom );
*/
    /*
     * Let the print control set the document margins and dimensions to
     * yield the largest possible print area.
     */
    @call printCtrlOD::MSG_PRINT_CONTROL_CALC_DOC_DIMENSIONS(&sPageSize);

    /*
     * Get the page range to print
     */
    pageRange = @call printCtrlOD::
	MSG_PRINT_CONTROL_GET_SELECTED_PAGE_RANGE();

    /*
     * Loop through the pages to be printed
     */
    for (pagenum = pageRange.PCPR_firstPage; 
	 pagenum <= pageRange.PCPR_lastPage; ++pagenum) {

	/*
	 * Report progress, check for cancel
	 */

	bContinue = @call printCtrlOD::
	    MSG_PRINT_CONTROL_REPORT_PROGRESS( PCPT_PAGE, pagenum );
	if ( FALSE == bContinue ) {
	    break;
	}


    /* Decode (or fetch from cache) this page, then render it straight
     * into the printing gstate. printing == TRUE picks the same
     * GrCopyGString path PDFSetupGState used here before. */

	currentlyDecodingDoc = pself->PDFDoc_engine;
	err = PdfDecodePage(pself->PDFDoc_engine, pagenum);
	currentlyDecodingDoc = PDF_NULL_DOC;
	if (err != PDF_OK) {
	    PDFDismissProgress();
	}

	if (err == PDF_OK) {
	    err = PdfDrawPage(pself->PDFDoc_engine, pagenum, gstate, TRUE, NULL);
	}

	/* stop at the first failing page -- otherwise the next page's
	 * result would hide the error and the job would count as done */
	if (err != PDF_OK) {
	    if (err != PDF_ERR_CANCELLED) {
		@send, forceQueue oself::MSG_PDF_DOCUMENT_REPORT_ERROR(err);
	    }
	    break;
	}

	/* emit page-finished command */
	GrNewPage(gstate, PEC_FORM_FEED);
    }
    /*
     * Send 'finished' message, which depends on whether we were canceled
     * (or other error occurred).
     */
    if (TRUE == bContinue && err == PDF_OK) {
	@send printCtrlOD::MSG_PRINT_CONTROL_PRINTING_COMPLETED();
    } else {
	@send printCtrlOD::MSG_PRINT_CONTROL_PRINTING_CANCELLED();
    }
}	/* End of MSG_PRINT_START_PRINTING.	*/


/***********************************************************************
 *		MSG_PRINT_GET_DOC_NAME for PDFDocumentClass
 ***********************************************************************
 *
 * SYNOPSIS:	Tell the printer the current document name.
 * PARAMETERS:	void  (optr printCtrlOD = cx:dx);
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mevissen	4/23/99   	Initial Revision
 *
 ***********************************************************************/
@method PDFDocumentClass, MSG_PRINT_GET_DOC_NAME
{

    @call printCtrlOD::
	MSG_PRINT_CONTROL_SET_DOC_NAME(pself->GDI_fileName);

}	/* End of MSG_PRINT_GET_DOC_NAME.	*/


/***********************************************************************
 *		MSG_PDF_DOCUMENT_TELL_PRINT_CONTROL_NUM_PAGES for PDFDocumentClass
 ***********************************************************************
 *
 * SYNOPSIS:	Tell the print control how many pages in this document.
 * PARAMETERS:	void (void)
 * SIDE EFFECTS:
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mevissen	4/26/99   	Initial Revision
 *
 ***********************************************************************/
@method PDFDocumentClass, MSG_PDF_DOCUMENT_TELL_PRINT_CONTROL_NUM_PAGES
{
	 @call PDFPrintControl::
	MSG_PRINT_CONTROL_SET_TOTAL_PAGE_RANGE(1,
			PdfGetPageCount(pself->PDFDoc_engine));

    /* /P of an encrypted file may forbid printing */
    if (PdfOkToPrint(pself->PDFDoc_engine)) {
	@send PDFPrintControl::MSG_GEN_SET_ENABLED(VUM_NOW);
    } else {
	@send PDFPrintControl::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
    }

}	/* End of MSG_PDF_DOCUMENT_TELL_PRINT_CONTROL_NUM_PAGES.	*/


/*
 * PDFPutUpImageProgress, PDFUpdateImageProgress, and
 * PDFTakeDownImageProgress used to be defined here. All three moved
 * into PDFDocProgressCallback (see above, near MSG_VIS_DRAW) as the
 * PDF_PROGRESS_IMAGE_BEGIN/_UPDATE/_END cases -- gfx.goc reaches them
 * through the engine's callback now, not by name.
 */


/***********************************************************************
 *		MSG_GEN_GUP_INTERACTION_COMMAND for PDFImageInteractionClass
 ***********************************************************************
 *
 * SYNOPSIS:	    See whether image-display is being canceled.
 * PARAMETERS:	    Boolean (InteractionCommand command = cx);
 *
 * SIDE EFFECTS:    
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *	Name		Date		Description
 *	----		----		-----------
 *	mevissen	6/02/99   	Initial Revision
 *
 ***********************************************************************/
@method PDFImageInteractionClass, MSG_GEN_GUP_INTERACTION_COMMAND
{
    if (command == IC_STOP) {
	/*
	 * user-canceled; tell the engine to stop the current decode
	 */
	PdfCancelDecode(currentlyDecodingDoc);
    }
    return (@callsuper());
}	/* End of MSG_GEN_GUP_INTERACTION_COMMAND.	*/


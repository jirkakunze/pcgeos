 */
void PDFDocProgressCallback(dword kind, dword current, dword total, void *userData);
void PDFDismissProgress(void);
void PDFShowError(optr msg);
void PDFUpdateSaveDirText(void);

/*
 * PDFSetupGState and PDFGetPageGString used to be declared here and
 * defined further down in this file. Both moved into the PDF engine

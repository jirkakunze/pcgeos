*/
}

@object GenInteractionClass PDFOptionsMenu = {
	GI_visMoniker = 'O', "Options";
	GI_comp = @PDFToolsToggle;
	GII_visibility = GIV_POPUP;
}

@visMoniker PDFHideToolsMoniker = "Hide Tool Bar";
@visMoniker PDFShowToolsMoniker = "Show Tool Bar";

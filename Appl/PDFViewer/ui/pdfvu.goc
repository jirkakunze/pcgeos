/********************************************************************
 *                      PDFPasswordTextShow
 ********************************************************************
 * SYNOPSIS:      Show one "*" for each typed password char.
 *
 * PARAMETERS:    oself                 Password text object.
 *                len                   Number of chars.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      04/20/99  mevissen  Initial Revision
 *******************************************************************/
static void
PDFPasswordTextShow(optr oself, word len)
{
    char stars[PDF_PASSWORD_BUF_SIZE];

    memset(stars, '*', len);
    stars[len] = 0;
    @call oself::MSG_VIS_TEXT_REPLACE_ALL_PTR(stars, len);
}

/********************************************************************
 *                      MSG_META_KBD_CHAR for PDFPasswordTextClass
 ********************************************************************
 * SYNOPSIS:      Collect password chars; the text shows only "*".
 *
 * PARAMETERS:    character             Char.
 *                flags                 Char flags.
 *                state                 Shift state.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Printable keys go into PDFPTI_password, Backspace removes the
 *                last one. Other keys (function keys, shortcuts) go to the
 *                superclass; text editing keys are ignored.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      04/20/99  mevissen  Initial Revision
 *******************************************************************/
@method PDFPasswordTextClass, MSG_META_KBD_CHAR
{
    if (flags & CF_RELEASE) {
	@callsuper();
	return;
    }
    if ((character >> 8) == CS_BSW &&
	!(flags & ((SS_LCTRL | SS_RCTRL | SS_LALT | SS_RALT) << 8))) {
	if ((character & 0xff) >= ' ' &&
	    pself->PDFPTI_length < PDF_PASSWORD_BUF_SIZE - 1) {
	    pself->PDFPTI_password[pself->PDFPTI_length++] =
		(char)(character & 0xff);
	    PDFPasswordTextShow(oself, pself->PDFPTI_length);
	}
	return;
    }
    switch (character) {
    case ((CS_CONTROL << 8) | VC_BACKSPACE):
	if (pself->PDFPTI_length) {
	    pself->PDFPTI_password[--pself->PDFPTI_length] = 0;
	    PDFPasswordTextShow(oself, pself->PDFPTI_length);
	}
	break;
    case ((CS_CONTROL << 8) | VC_ENTER):
    case ((CS_CONTROL << 8) | VC_TAB):
    case ((CS_CONTROL << 8) | VC_ESCAPE):
	@callsuper();
	break;
    default:
	if ((character >> 8) != CS_BSW) {
	    /* function keys, shortcuts etc. -- but no text editing */
	    switch (character & 0xff) {
	    case VC_DEL:
		break;
	    default:
		@callsuper();
		break;
	    }
	}
	break;
    }
}

/********************************************************************
 *                      MSG_VIS_TEXT_DELETE_ALL for PDFPasswordTextClass
 ********************************************************************
 * SYNOPSIS:      Clear the password and the text.
 *
 * PARAMETERS:    none
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      04/20/99  mevissen  Initial Revision
 *******************************************************************/
@method PDFPasswordTextClass, MSG_VIS_TEXT_DELETE_ALL
{
    memset(pself->PDFPTI_password, 0, sizeof(pself->PDFPTI_password));
    pself->PDFPTI_length = 0;
    @callsuper();
}

/********************************************************************
 *                      MSG_PDF_PASSWORD_TEXT_GET for PDFPasswordTextClass
 ********************************************************************
 * SYNOPSIS:      Return the typed password.
 *
 * PARAMETERS:    buf                   Ptr to the buffer (PDF_PASSWORD_BUF_SIZE
 *                                      bytes).
 *
 * RETURNS:       word                  Length of the password.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      04/20/99  mevissen  Initial Revision
 *******************************************************************/
@method PDFPasswordTextClass, MSG_PDF_PASSWORD_TEXT_GET
{
    memcpy(buf, pself->PDFPTI_password, pself->PDFPTI_length);
    buf[pself->PDFPTI_length] = 0;
    return pself->PDFPTI_length;
}

/********************************************************************
 *      MSG_META_CLIPBOARD_CUT/COPY/PASTE for PDFPasswordTextClass
 ********************************************************************
 * SYNOPSIS:      Do not cut, copy or paste the password (ignored).
 *
 * PARAMETERS:    none
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      04/20/99  mevissen  Initial Revision
 *******************************************************************/
@method PDFPasswordTextClass, MSG_META_CLIPBOARD_CUT,
			      MSG_META_CLIPBOARD_COPY,
			      MSG_META_CLIPBOARD_PASTE
{
}

/********************************************************************
 *                      MSG_META_START_MOVE_COPY for PDFPasswordTextClass
 ********************************************************************
 * SYNOPSIS:      Ignore quick copy of the password.
 *
 * PARAMETERS:    retVal                Ptr to the mouse return data.
 *                xPosition             Not used.
 *                yPosition             Not used.
 *                inputState            Not used.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      04/20/99  mevissen  Initial Revision
 *******************************************************************/
@method PDFPasswordTextClass, MSG_META_START_MOVE_COPY
{
    /* consume quick copy; tell the UI the event was handled */
    retVal->flags = MRF_PROCESSED;
}

/********************************************************************
 *                      PDFAskPassword
 ********************************************************************
 * SYNOPSIS:      Ask for the password of an encrypted PDF.
 *
 * PARAMETERS:    *password             Ptr to the password buffer (out).
 *                retry                 TRUE after a wrong password (shows a
 *                                      hint).
 *
 * RETURNS:       Boolean               TRUE with the password, FALSE if the
 *                                      user cancelled.
 *
 * STRATEGY:      Runs in PHYSICAL_OPEN (not inside a draw): a modal
 *                UserDoDialog is safe. The text is cleared at once, so the
 *                password does not stay in the UI.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      04/20/99  mevissen  Initial Revision
 *******************************************************************/
static Boolean
PDFAskPassword(char *password, Boolean retry)
{
    word len;

    if (retry) {
	@call PDFPasswordWrongGlyph::MSG_GEN_SET_USABLE(VUM_NOW);
    } else {
	@call PDFPasswordWrongGlyph::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
    }
    @call PDFPasswordText::MSG_VIS_TEXT_DELETE_ALL();

    if (UserDoDialog(@PDFPasswordDB) != IC_OK) {
	@call PDFPasswordText::MSG_VIS_TEXT_DELETE_ALL();
	return FALSE;
    }

    len = @call PDFPasswordText::MSG_PDF_PASSWORD_TEXT_GET(password);
    @call PDFPasswordText::MSG_VIS_TEXT_DELETE_ALL();
    if (len) {
	LocalGeosToCodePage(password, len, CODE_PAGE_LATIN_1, '?');
    }
    return TRUE;
}

/********************************************************************
 *                      MSG_GEN_DOCUMENT_PHYSICAL_OPEN for PDFDocumentClass
 ********************************************************************
 * SYNOPSIS:      Open the PDF file with the engine.
 *
 * PARAMETERS:    fileOrError           Ptr to the file handle or error (out).
 *                params                Ptr to the document parameters.
 *
 * RETURNS:       Boolean               TRUE on error.
 *
 * STRATEGY:      The superclass opens the file, then PdfOpen reads it.
 *                Encrypted files try the empty password first, then ask. Files
 *                that are not PDF are closed again with an error message.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      3/30/99   mevissen  Initial Revision
 *******************************************************************/
@method PDFDocumentClass, MSG_GEN_DOCUMENT_PHYSICAL_OPEN
{
    Boolean status;
    PdfError err;
    PdfDocHandle engine = PDF_NULL_DOC;
    char password[PDF_PASSWORD_BUF_SIZE];
    Boolean retry;
    Boolean cancelled = FALSE;

    pself->PDFDoc_engine = PDF_NULL_DOC;
    pself->PDFDoc_sourceFile = 0;

    status = @callsuper();
    if (status) return(status);

    pself = ObjDerefGen(oself);

    if (!*fileOrError) return (TRUE);

    pself->PDFDoc_sourceFile = *fileOrError;

/* PdfOpen reads the xref table and the catalog of the open file */

    /* Encrypted: try the empty password first, then ask */
    password[0] = 0;
    retry = FALSE;
    for (;;) {
	err = PdfOpen(*fileOrError, password, &engine);
	if (err != PDF_ERR_PASSWORD) {
	    break;
	}
	if (!PDFAskPassword(password, retry)) {
	    cancelled = TRUE;
	    break;
	}
	retry = TRUE;
    }
    memset(password, 0, sizeof(password));
    pself = ObjDerefGen(oself);
    pself->PDFDoc_engine = engine;
    if (err != PDF_OK) {
	goto errorClose;
    }

	 pself->PDFDoc_pageNum = 1;

    /* Page and image progress through PDFDocProgressCallback */
    PdfSetProgressCallback(pself->PDFDoc_engine, PDFDocProgressCallback, NULL);

    PDFUpdatePageControl(PdfGetPageCount(pself->PDFDoc_engine), 1);

  return FALSE;

errorClose:

    pself = ObjDerefGen(oself);
    PdfClose(pself->PDFDoc_engine);
    pself->PDFDoc_engine = PDF_NULL_DOC;

/* Not a PDF: close the file again */

    FileClose(*fileOrError, FALSE);
    *fileOrError = 0;
    pself->PDFDoc_sourceFile = 0;

/* Encrypted files get their own message */

    if (cancelled) {
	/* password dialog cancelled: nothing to report */
    } else if (err == PDF_ERR_ENCRYPTED) {
	PDFShowError(@PDFOpenEncryptedError);
    } else if (err == PDF_ERR_OUT_OF_MEMORY) {
	PDFShowError(@PDFOutOfMemoryError);
    } else {
	PDFShowError(@PDFOpenError);
    }

    return TRUE;

}


/********************************************************************
 *      MSG_GEN_DOCUMENT_ATTACH_UI_TO_DOCUMENT for PDFDocumentClass
 ********************************************************************
 * SYNOPSIS:      Set the view color for files outside the GEOS tree on a TV.
 *
 * PARAMETERS:    none
 *
 * RETURNS:       void
 *
 * STRATEGY:      The gray level comes from the INI file.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      3/21/2000  dhunter   Initial version
 *******************************************************************/
@method PDFDocumentClass, MSG_GEN_DOCUMENT_ATTACH_UI_TO_DOCUMENT
{
    GenFilePath *ppath = ObjVarFindData(oself, ATTR_GEN_PATH_DATA);
    word gray;

    if (onTV && ppath != NULL && FileComparePaths(NULL, SP_TOP, 
	ppath->GFP_path, ppath->GFP_disk) > PCT_SUBDIR)
    {
	if (!InitFileReadInteger(INIT_FILE_CATEGORY, INIT_FILE_KEY_VIEW_COLOR, &gray))
	{
	    optr view = @call @genParent::MSG_GEN_DOCUMENT_GROUP_GET_VIEW();
	    view = ConstructOptr(pself->GDI_display, 
		OptrToChunk(view));
	    @call view::MSG_GEN_VIEW_SET_COLOR(gray, CF_RGB, (gray << 8) | gray);
	}
    }

    @callsuper();
}


/********************************************************************
 *                      MSG_GEN_DOCUMENT_CLOSE for PDFDocumentClass
 ********************************************************************
 * SYNOPSIS:      Close the PDF engine document.
 *
 * PARAMETERS:    connection            IACP connection.
 *
 * RETURNS:       word                  Result of the superclass.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      4/07/99   mevissen  Initial Revision
 *******************************************************************/
@method PDFDocumentClass, MSG_GEN_DOCUMENT_CLOSE
{
    /* Stop cancels currentlyDecodingDoc: do not leave a freed handle */
    if (currentlyDecodingDoc == pself->PDFDoc_engine) {
	currentlyDecodingDoc = PDF_NULL_DOC;
    }
    PdfClose(pself->PDFDoc_engine);
    pself->PDFDoc_engine = PDF_NULL_DOC;
    pself->PDFDoc_sourceFile = 0;

    return (@callsuper());

}


/********************************************************************
 *                      MSG_VIS_DRAW for PDFDocumentClass
 ********************************************************************
 * SYNOPSIS:      Decode and draw the current page.
 *
 * PARAMETERS:    drawFlags             Not used.
 *                gstate                GState to draw into.
 *
 * RETURNS:       void
 *
 * STRATEGY:      The page comes from the page cache or is decoded. A new page
 *                size goes to the view. An error is reported once per page
 *                through a queued message (no modal dialog inside a draw).
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      4/06/99   mevissen  Initial Revision
 *******************************************************************/
@method PDFDocumentClass, MSG_VIS_DRAW
{
    word pagenum = pself->PDFDoc_pageNum;
    Point pageSize;
    PdfError err;

    GrSaveState(gstate);

/* Page from the cache or decoded */

    if (pagenum == pself->PDFDoc_cancelledPage) {
	GrRestoreState(gstate);
	return;
    }

    currentlyDecodingDoc = pself->PDFDoc_engine;
    err = PdfDecodePage(pself->PDFDoc_engine, pagenum);
    currentlyDecodingDoc = PDF_NULL_DOC;
    pself = ObjDerefGen(oself);
    if (err != PDF_OK) {
	PDFDismissProgress();
	if (err == PDF_ERR_CANCELLED) {
	    pself->PDFDoc_cancelledPage = pagenum;
	}
    }

    if (err == PDF_OK) {

/* Draw the page and get its size */

	err = PdfDrawPage(pself->PDFDoc_engine, pagenum, gstate, FALSE, NULL,
			  &pageSize);
	/* Send only a new size: setting it on each draw redraws the view */
	if (err == PDF_OK && (pageSize.P_x != pself->PDFDoc_bounds.P_x ||
			      pageSize.P_y != pself->PDFDoc_bounds.P_y)) {
	    pself->PDFDoc_bounds = pageSize;
	    @call pself->GCI_genView::MSG_GEN_VIEW_SET_DOC_BOUNDS(
		pageSize.P_y, pageSize.P_x, 0, 0);
	}

    }

/* Report once per page, queued: a dialog here would redraw */

    if (err == PDF_OK) {
	pself->PDFDoc_errorPage = 0;
    } else if (err != PDF_ERR_CANCELLED && pself->PDFDoc_errorPage != pagenum) {
	pself->PDFDoc_errorPage = pagenum;
	@send, forceQueue oself::MSG_PDF_DOCUMENT_REPORT_ERROR(err);
    }

    GrRestoreState(gstate);

}

/*
 * PDFSetupGState and PDFGetPageGString used to be defined here.
 * Both moved into the PDF engine (main/pdfEngine.goc) as part of
 * PdfDrawPage and PdfDecodePage respectively -- see pdfEngine.h.
 * The busy-cursor and page-decode progress dialog bracket around the
 * whole PdfDecodePage call is still ours to do (there's none of that
 * here in MSG_VIS_DRAW since it doesn't matter for a cache hit); the
 * per-image progress dialog that gfx.goc puts up mid-decode now goes
 * through PDFDocProgressCallback below, registered once in
 * MSG_GEN_DOCUMENT_PHYSICAL_OPEN.
 */


/********************************************************************
 *                      PDFProgressFraction
 ********************************************************************
 * SYNOPSIS:      Return current / total as a WWFixed fraction.
 *
 * PARAMETERS:    current               Progress so far.
 *                total                 Total amount.
 *
 * RETURNS:       dword                 Fraction 0-1 (WWFixed).
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      04/20/99  mevissen  Initial Revision
 *******************************************************************/
static dword
PDFProgressFraction(dword current, dword total)
{
    if (total == 0) {
	return 0;
    }
    if (current >= total) {
	return MakeWWFixed(1);
    }
    while (current >= 0x8000L) {
	current >>= 1;
	total >>= 1;
    }
    if (total == 0) {
	return MakeWWFixed(1);
    }
    return MakeWWFixed(current)/total;
}

void
PDFDismissProgress(void)
{
    @call PDFImageProgressDialog::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
}

void
PDFShowError(optr msg)
{
    UserStandardDialogOptr(NULL, NULL, NullOptr, NullOptr, msg,
	(CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
	(GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET));
}

/********************************************************************
 *                      MSG_PDF_DOCUMENT_REPORT_ERROR for PDFDocumentClass
 ********************************************************************
 * SYNOPSIS:      Show the error dialog for a page that could not be decoded.
 *
 * PARAMETERS:    err                   PdfError.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Queued by MSG_VIS_DRAW, printing and Copy: the modal dialog
 *                runs outside of those handlers.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      04/20/99  mevissen  Initial Revision
 *******************************************************************/
@method PDFDocumentClass, MSG_PDF_DOCUMENT_REPORT_ERROR
{
    if (err == PDF_ERR_OUT_OF_MEMORY) {
	PDFShowError(@PDFOutOfMemoryError);
    } else {
	PDFShowError(@PDFPageError);
    }
}

/********************************************************************
 *                      PDFDocProgressCallback
 ********************************************************************
 * SYNOPSIS:      Progress callback of the engine.
 *
 * PARAMETERS:    kind                  PDF_PROGRESS_* value.
 *                current               Progress so far.
 *                total                 Total amount.
 *                *userData             Not used.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Updates the page and image progress dialogs. Called on the
 *                process thread during the decode; the dialogs run on the UI
 *                thread.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      04/20/99  mevissen  Initial Revision
 *******************************************************************/
void
PDFDocProgressCallback(dword kind, dword current, dword total, void *userData)
{
    switch (kind) {
    case PDF_PROGRESS_PAGE:
	@send ppValue::MSG_GEN_VALUE_SET_VALUE(
	    PDFProgressFraction(current, total), FALSE);
	break;

    case PDF_PROGRESS_IMAGE_BEGIN:
	@send ipValue::MSG_GEN_VALUE_SET_VALUE(0, FALSE);
	@call PDFImageProgressDialog::MSG_GEN_INTERACTION_INITIATE();
	break;

    case PDF_PROGRESS_IMAGE_UPDATE:
	@send ipValue::MSG_GEN_VALUE_SET_VALUE(
	    PDFProgressFraction(current, total), FALSE);
	break;

    case PDF_PROGRESS_IMAGE_END:
	@call PDFImageProgressDialog::
	    MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
	break;
    }
}


/********************************************************************
 *                      MSG_META_KBD_CHAR for PDFDocumentClass
 ********************************************************************
 * SYNOPSIS:      Keyboard shortcuts for page navigation.
 *
 * PARAMETERS:    character             Char.
 *                flags                 Char flags.
 *                state                 Shift state.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      4/20/99   mevissen  Initial Revision
 *******************************************************************/
@method PDFDocumentClass, MSG_META_KBD_CHAR
{
    EventHandle event;

    if (flags & CF_FIRST_PRESS) {
	if (character == ((((word)CS_CONTROL)<<8) | VC_NEXT)) {
	    event = @record PDFDocumentClass::MSG_META_PAGED_OBJECT_NEXT_PAGE();
	    @send self::MSG_META_SEND_CLASSED_EVENT(event, TO_APP_TARGET);

	} else 	if (character == ((((word)CS_CONTROL)<<8) | VC_PREVIOUS)) {
	    event = @record PDFDocumentClass::MSG_META_PAGED_OBJECT_PREVIOUS_PAGE();
	    @send self::MSG_META_SEND_CLASSED_EVENT(event, TO_APP_TARGET);

	} else if (character == ((((word)CS_CONTROL)<<8) | VC_DOWN)) {
	    event = @record GenViewClass::MSG_GEN_VIEW_SCROLL_DOWN();
	    @send self::MSG_META_SEND_CLASSED_EVENT(event, TO_APP_TARGET);

	} else 	if (character == ((((word)CS_CONTROL)<<8) | VC_UP)) {
	    event = @record GenViewClass::MSG_GEN_VIEW_SCROLL_UP();
	    @send self::MSG_META_SEND_CLASSED_EVENT(event, TO_APP_TARGET);

	} else if (character == ((((word)CS_CONTROL)<<8) | VC_RIGHT)) {
	    event = @record GenViewClass::MSG_GEN_VIEW_SCROLL_RIGHT();
	    @send self::MSG_META_SEND_CLASSED_EVENT(event, TO_APP_TARGET);

	} else 	if (character == ((((word)CS_CONTROL)<<8) | VC_LEFT)) {
	    event = @record GenViewClass::MSG_GEN_VIEW_SCROLL_LEFT();
	    @send self::MSG_META_SEND_CLASSED_EVENT(event, TO_APP_TARGET);

	} else if (character == ((((word)CS_CONTROL)<<8) | VC_HOME)) {
	    event = @record PDFDocumentClass::MSG_META_PAGED_OBJECT_GOTO_PAGE(1);
	    @send self::MSG_META_SEND_CLASSED_EVENT(event, TO_APP_TARGET);

	} else 	if (character == ((((word)CS_CONTROL)<<8) | VC_END)) {
	    event = @record PDFDocumentClass::MSG_META_PAGED_OBJECT_GOTO_PAGE(32000);
	    @send self::MSG_META_SEND_CLASSED_EVENT(event, TO_APP_TARGET);

	} else {
	    @callsuper();
	}
    } else {
	@callsuper();
    }
}


/********************************************************************
 *                      MSG_META_PAGED_OBJECT_NEXT_PAGE for PDFDocumentClass
 ********************************************************************
 * SYNOPSIS:      Show the next page.
 *
 * PARAMETERS:    none
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      4/20/99   mevissen  Initial Revision
 *******************************************************************/
@method PDFDocumentClass, MSG_META_PAGED_OBJECT_NEXT_PAGE
{
    optr view;
    word numPages = PdfGetPageCount(pself->PDFDoc_engine);

    if (pself->PDFDoc_pageNum >= numPages) {
	return;
    }

    ++pself->PDFDoc_pageNum;
    pself->PDFDoc_cancelledPage = 0;
    view = @call PDFDocumentGroup::MSG_GEN_DOCUMENT_GROUP_GET_VIEW();
    pself = ObjDerefGen(oself);	/* the call may move our block */
    if (pself->GDI_display & 0xff00) {
	view = (view & 0xffff) | ((long)pself->GDI_display << 16);
    }

    @call view::MSG_GEN_VIEW_SUSPEND_UPDATE();
    @call view::MSG_GEN_VIEW_SCROLL_TOP();
    @call view::MSG_GEN_VIEW_REDRAW_CONTENT();
    @call view::MSG_GEN_VIEW_UNSUSPEND_UPDATE();

    pself = ObjDerefGen(oself);
    PDFUpdatePageControl(numPages,
			 pself->PDFDoc_pageNum);

}


/********************************************************************
 *                      MSG_META_PAGED_OBJECT_PREVIOUS_PAGE for PDFDocumentClass
 ********************************************************************
 * SYNOPSIS:      Show the previous page.
 *
 * PARAMETERS:    none
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      4/20/99   mevissen  Initial Revision
 *******************************************************************/
@method PDFDocumentClass, MSG_META_PAGED_OBJECT_PREVIOUS_PAGE
{
    optr view;

    if (pself->PDFDoc_pageNum == 1) {
	return;
    }

    --pself->PDFDoc_pageNum;
    pself->PDFDoc_cancelledPage = 0;
    view = @call PDFDocumentGroup::MSG_GEN_DOCUMENT_GROUP_GET_VIEW();
    pself = ObjDerefGen(oself);	/* the call may move our block */
    if (pself->GDI_display & 0xff00) {
	view = (view & 0xffff) | ((long)pself->GDI_display << 16);
    }

    @call view::MSG_GEN_VIEW_SUSPEND_UPDATE();
    @call view::MSG_GEN_VIEW_SCROLL_TOP();
    @call view::MSG_GEN_VIEW_REDRAW_CONTENT();
    @call view::MSG_GEN_VIEW_UNSUSPEND_UPDATE();

    pself = ObjDerefGen(oself);
	 PDFUpdatePageControl(PdfGetPageCount(pself->PDFDoc_engine),
			 pself->PDFDoc_pageNum);

}

/********************************************************************
 *      MSG_PDF_DOCUMENT_UPDATE_PAGE_CONTROL for PDFDocumentClass
 ********************************************************************
 * SYNOPSIS:      Tell the page control the current page.
 *
 * PARAMETERS:    none
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      11/14/02  jfh       Initial Revision
 *******************************************************************/
@method PDFDocumentClass, MSG_PDF_DOCUMENT_UPDATE_PAGE_CONTROL
{

	 PDFUpdatePageControl(PdfGetPageCount(pself->PDFDoc_engine),
			 pself->PDFDoc_pageNum);

}


/********************************************************************
 *                      MSG_META_START_SELECT for PDFDocumentClass
 ********************************************************************
 * SYNOPSIS:      Follow a link under a mouse click.
 *
 * PARAMETERS:    retVal                Ptr to the mouse return data.
 *                xPosition             x in document coordinates.
 *                yPosition             y in document coordinates.
 *                inputState            Not used.
 *
 * RETURNS:       void
 *
 * STRATEGY:      The engine reads the /Annots of the page once per click;
 *                nothing is kept in memory.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      4/20/99   mevissen  Initial Revision
 *******************************************************************/
@method PDFDocumentClass, MSG_META_START_SELECT
{
    word destPage;
    sdword destY;

    @callsuper();
    retVal->flags |= MRF_PROCESSED;

    /* Link under the click? (reads /Annots once) */
    if (pself->PDFDoc_engine != PDF_NULL_DOC &&
	PdfFindLink(pself->PDFDoc_engine, pself->PDFDoc_pageNum,
		    xPosition, yPosition, &destPage, &destY))
    {
	@send oself::MSG_PDF_DOCUMENT_GOTO_DEST(destPage, destY);
    }
}

/********************************************************************
 *                      MSG_PDF_DOCUMENT_GOTO_DEST for PDFDocumentClass
 ********************************************************************
 * SYNOPSIS:      Show a link destination.
 *
 * PARAMETERS:    page                  Page number (1-based).
 *                docY                  Target y in document coordinates, < 0
 *                                      for the top of the page.
 *
 * RETURNS:       void
 *
 * STRATEGY:      The view gets the new page size first, else the new origin is
 *                clipped to the old page. The x origin stays.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      04/20/99  mevissen  Initial Revision
 *******************************************************************/
@method PDFDocumentClass, MSG_PDF_DOCUMENT_GOTO_DEST
{
    optr view;
    PointDWord origin;
    Point size;
    word numPages = PdfGetPageCount(pself->PDFDoc_engine);

    if (page < 1 || page > numPages) {
	return;
    }
    if (docY < 0) {
	@call oself::MSG_META_PAGED_OBJECT_GOTO_PAGE(page);
	return;
    }

    view = @call PDFDocumentGroup::MSG_GEN_DOCUMENT_GROUP_GET_VIEW();
    pself = ObjDerefGen(oself);
    if (pself->GDI_display & 0xff00) {
	view = (view & 0xffff) | ((long)pself->GDI_display << 16);
    }

    @call view::MSG_GEN_VIEW_SUSPEND_UPDATE();
    pself = ObjDerefGen(oself);
    if (page != pself->PDFDoc_pageNum) {
	pself->PDFDoc_pageNum = page;
	pself->PDFDoc_cancelledPage = 0;
	if (PdfGetPageSize(pself->PDFDoc_engine, page, &size) == PDF_OK &&
	    (size.P_x != pself->PDFDoc_bounds.P_x ||
	     size.P_y != pself->PDFDoc_bounds.P_y)) {
	    pself->PDFDoc_bounds = size;
	    @call view::MSG_GEN_VIEW_SET_DOC_BOUNDS(size.P_y, size.P_x, 0, 0);
	}
	@call view::MSG_GEN_VIEW_REDRAW_CONTENT();
	PDFUpdatePageControl(numPages, page);
    }
    @call view::MSG_GEN_VIEW_GET_ORIGIN(&origin);
    @call view::MSG_GEN_VIEW_SET_ORIGIN(docY, origin.PD_x);
    @call view::MSG_GEN_VIEW_UNSUSPEND_UPDATE();
}

/********************************************************************
 *                      MSG_META_PAGED_OBJECT_GOTO_PAGE for PDFDocumentClass
 ********************************************************************
 * SYNOPSIS:      Show a page.
 *
 * PARAMETERS:    page                  Page number (1-based), limited to the
 *                                      page count.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      04/20/99  mevissen  Initial Revision
 *******************************************************************/
@method PDFDocumentClass, MSG_META_PAGED_OBJECT_GOTO_PAGE
{
    optr view;
    word numPages = PdfGetPageCount(pself->PDFDoc_engine);

    if (numPages == 0) {
	return;		/* no document: nothing to show */
    }
    if (page < 1) page = 1;
    if (page > numPages) page = numPages;

    pself->PDFDoc_pageNum = page;
    pself->PDFDoc_cancelledPage = 0;

    view = @call PDFDocumentGroup::MSG_GEN_DOCUMENT_GROUP_GET_VIEW();
    pself = ObjDerefGen(oself);	/* the call may move our block */
    if (pself->GDI_display & 0xff00) {
	view = (view & 0xffff) | ((long)pself->GDI_display << 16);
    }

    @call view::MSG_GEN_VIEW_SUSPEND_UPDATE();
    @call view::MSG_GEN_VIEW_SCROLL_TOP();
    @call view::MSG_GEN_VIEW_REDRAW_CONTENT();
    @call view::MSG_GEN_VIEW_UNSUSPEND_UPDATE();

    PDFUpdatePageControl(numPages, page);

}


/********************************************************************
 *                      PDFUpdatePageControl
 ********************************************************************
 * SYNOPSIS:      Tell the page and print controls the current page.
 *
 * PARAMETERS:    totalPages            Number of pages; 0 does nothing.
 *                curPage               Current page.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      4/21/99   mevissen  Initial Revision
 *******************************************************************/
void
PDFUpdatePageControl (word totalPages, word curPage)
{
    MemHandle mh;
    NotifyPageStateChange *pageState;
    EventHandle pageNotify;

    /* no pages (document closed or failed): a range 1..0 is invalid */
    if (totalPages == 0) {
	return;
    }

    /* The print dialog offers the page on display */
    @send PDFPrintControl::MSG_PRINT_CONTROL_SET_SELECTED_PAGE_RANGE(
	curPage, curPage);

    mh = MemAlloc(sizeof(NotifyPageStateChange),
		  HF_SHARABLE | HF_SWAPABLE,
		  HAF_NO_ERR);
    pageState = MemLock(mh);

    pageState->NPSC_firstPage = 1;
    pageState->NPSC_lastPage = totalPages;
    pageState->NPSC_currentPage = curPage;

    MemUnlock(mh);
    MemInitRefCount(mh, 1);

    pageNotify = @record (optr)NullClass::MSG_META_NOTIFY_WITH_DATA_BLOCK(
	MANUFACTURER_ID_GEOWORKS,
	GWNT_PAGE_STATE_CHANGE,
	mh);

    @call process::MSG_GEN_PROCESS_SEND_TO_APP_GCN_LIST(
	GCNLSF_SET_STATUS,
	pageNotify,
	mh,
	GAGCNLT_APP_TARGET_NOTIFY_PAGE_STATE_CHANGE,
	MANUFACTURER_ID_GEOWORKS);

}


/********************************************************************
 *                      MSG_PRINT_START_PRINTING for PDFDocumentClass
 ********************************************************************
 * SYNOPSIS:      Print the selected pages.
 *
 * PARAMETERS:    printCtrlOD           Print control.
 *                gstate                GState of the print job.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Each page is fitted into the printable area (PdfDrawPage).
 *                Stop at the first page that fails; /P can forbid printing.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      4/23/99   mevissen  Initial Revision
 *******************************************************************/
@method PDFDocumentClass, MSG_PRINT_START_PRINTING
{
	 PdfError	err = PDF_ERR_INVALID_PAGE;
    word pagenum;
    PCPageRange		pageRange;
    PageSizeReport	sPageSize;
    Boolean		bContinue = TRUE;
    Point		printArea;

    /* Print UI is disabled when /P forbids printing; guard anyway */
    if (!PdfOkToPrint(pself->PDFDoc_engine)) {
	@send printCtrlOD::MSG_PRINT_CONTROL_PRINTING_CANCELLED();
	return;
    }

    /* The print control sets margins for the largest print area */
    @call printCtrlOD::MSG_PRINT_CONTROL_CALC_DOC_DIMENSIONS(&sPageSize);

    /* Each page is fitted into this area (margins already removed) */
    printArea.P_x = (sPageSize.PSR_width > 0x7fffL) ? 0x7fff :
	(sword)sPageSize.PSR_width;
    printArea.P_y = (sPageSize.PSR_height > 0x7fffL) ? 0x7fff :
	(sword)sPageSize.PSR_height;

    pageRange = @call printCtrlOD::
	MSG_PRINT_CONTROL_GET_SELECTED_PAGE_RANGE();

    for (pagenum = pageRange.PCPR_firstPage; 
	 pagenum <= pageRange.PCPR_lastPage; ++pagenum) {

	bContinue = @call printCtrlOD::
	    MSG_PRINT_CONTROL_REPORT_PROGRESS( PCPT_PAGE, pagenum );
	if ( FALSE == bContinue ) {
	    break;
	}

    /* Page from the cache or decoded, drawn into the print GState */

	currentlyDecodingDoc = pself->PDFDoc_engine;
	err = PdfDecodePage(pself->PDFDoc_engine, pagenum);
	currentlyDecodingDoc = PDF_NULL_DOC;
	if (err != PDF_OK) {
	    PDFDismissProgress();
	}

	if (err == PDF_OK) {
	    err = PdfDrawPage(pself->PDFDoc_engine, pagenum, gstate, TRUE,
			      &printArea, NULL);
	}

	/* Stop at the first failing page, else the job counts as done */
	if (err != PDF_OK) {
	    if (err != PDF_ERR_CANCELLED) {
		@send, forceQueue oself::MSG_PDF_DOCUMENT_REPORT_ERROR(err);
	    }
	    break;
	}

	GrNewPage(gstate, PEC_FORM_FEED);
    }
    /* Send "finished" or "cancelled" */
    if (TRUE == bContinue && err == PDF_OK) {
	@send printCtrlOD::MSG_PRINT_CONTROL_PRINTING_COMPLETED();
    } else {
	@send printCtrlOD::MSG_PRINT_CONTROL_PRINTING_CANCELLED();
    }
}


/********************************************************************
 *                      MSG_PRINT_GET_DOC_NAME for PDFDocumentClass
 ********************************************************************
 * SYNOPSIS:      Tell the print control the document name.
 *
 * PARAMETERS:    printCtrlOD           Print control.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      4/23/99   mevissen  Initial Revision
 *******************************************************************/
@method PDFDocumentClass, MSG_PRINT_GET_DOC_NAME
{

    @call printCtrlOD::
	MSG_PRINT_CONTROL_SET_DOC_NAME(pself->GDI_fileName);

}


/********************************************************************
 *      MSG_PDF_DOCUMENT_TELL_PRINT_CONTROL_NUM_PAGES for PDFDocumentClass
 ********************************************************************
 * SYNOPSIS:      Tell the print control the page range and if printing is
 *                allowed.
 *
 * PARAMETERS:    none
 *
 * RETURNS:       void
 *
 * STRATEGY:      Can come after MSG_GEN_DOCUMENT_CLOSE (0 pages): a range 1..0
 *                is not sent.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      4/26/99   mevissen  Initial Revision
 *******************************************************************/
@method PDFDocumentClass, MSG_PDF_DOCUMENT_TELL_PRINT_CONTROL_NUM_PAGES
{
    word numPages = PdfGetPageCount(pself->PDFDoc_engine);

    /* Can come after MSG_GEN_DOCUMENT_CLOSE: no range 1..0 */
    if (numPages == 0) {
	return;
    }
	 @call PDFPrintControl::
	MSG_PRINT_CONTROL_SET_TOTAL_PAGE_RANGE(1, numPages);

    /* /P of an encrypted file may forbid printing */
    if (PdfOkToPrint(pself->PDFDoc_engine)) {
	@send PDFPrintControl::MSG_GEN_SET_ENABLED(VUM_NOW);
    } else {
	@send PDFPrintControl::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
    }

}


/*
 * PDFPutUpImageProgress, PDFUpdateImageProgress, and
 * PDFTakeDownImageProgress used to be defined here. All three moved
 * into PDFDocProgressCallback (see above, near MSG_VIS_DRAW) as the
 * PDF_PROGRESS_IMAGE_BEGIN/_UPDATE/_END cases -- gfx.goc reaches them
 * through the engine's callback now, not by name.
 */


/********************************************************************
 *      MSG_GEN_GUP_INTERACTION_COMMAND for PDFImageInteractionClass
 ********************************************************************
 * SYNOPSIS:      Stop the decode when the user clicks Stop in a progress
 *                dialog.
 *
 * PARAMETERS:    command               Interaction command.
 *
 * RETURNS:       Boolean               Result of the superclass.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      6/02/99   mevissen  Initial Revision
 *******************************************************************/
@method PDFImageInteractionClass, MSG_GEN_GUP_INTERACTION_COMMAND
{
    if (command == IC_STOP) {
	/* Stop: cancel the current decode */
	PdfCancelDecode(currentlyDecodingDoc);
    }
    return (@callsuper());
}

/********************************************************************
 *                      MSG_PDF_DOCUMENT_SAVE for PDFDocumentClass
 ********************************************************************
 * SYNOPSIS:      Open the Save Copy As dialog.
 *
 * PARAMETERS:    none
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      4/26/2000  dhunter   Initial revision
 *******************************************************************/
@method PDFDocumentClass, MSG_PDF_DOCUMENT_SAVE
{
	 @call PDFFileName::MSG_VIS_TEXT_REPLACE_ALL_PTR(
														pself->GDI_fileName, 0);
	 PDFUpdateSaveDirText();
	 @send PDFSaveDB::MSG_GEN_INTERACTION_INITIATE();
    return;
}

#define PDF_INFO_BUF_SIZE 256

/********************************************************************
 *                      PDFSetInfoText
 ********************************************************************
 * SYNOPSIS:      Put one /Info entry into a text object.
 *
 * PARAMETERS:    text                  Text object.
 *                engine                Engine document.
 *                *key                  Ptr to the /Info key.
 *                *buf                  Ptr to a work buffer of
 *                                      PDF_INFO_BUF_SIZE bytes.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      04/20/99  mevissen  Initial Revision
 *******************************************************************/
static void
PDFSetInfoText(optr text, PdfDocHandle engine, const char *key, char *buf)
{
    PdfGetInfoField(engine, key, buf, PDF_INFO_BUF_SIZE);
    @call text::MSG_VIS_TEXT_REPLACE_ALL_PTR(buf, 0);
}

/********************************************************************
 *                      MSG_PDF_DOCUMENT_SHOW_INFO for PDFDocumentClass
 ********************************************************************
 * SYNOPSIS:      Fill the Document Info dialog and show it.
 *
 * PARAMETERS:    none
 *
 * RETURNS:       void
 *
 * STRATEGY:      The work buffer is a heap block (small process stack).
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      11/23/26  JK        Initial revision
 *******************************************************************/
@method PDFDocumentClass, MSG_PDF_DOCUMENT_SHOW_INFO
{
    MemHandle mh;
    char *buf;
    PdfDocHandle engine = pself->PDFDoc_engine;

    mh = MemAlloc(PDF_INFO_BUF_SIZE, HF_SWAPABLE, HAF_LOCK);
    if (!mh) {
	return;
    }
    buf = MemDeref(mh);
    PDFSetInfoText(@PDFInfoTitle, engine, "Title", buf);
    PDFSetInfoText(@PDFInfoAuthor, engine, "Author", buf);
    PDFSetInfoText(@PDFInfoSubject, engine, "Subject", buf);
    PDFSetInfoText(@PDFInfoKeywords, engine, "Keywords", buf);
    PDFSetInfoText(@PDFInfoCreator, engine, "Creator", buf);
    PDFSetInfoText(@PDFInfoProducer, engine, "Producer", buf);
    PDFSetInfoText(@PDFInfoCreated, engine, "CreationDate", buf);
    PDFSetInfoText(@PDFInfoModified, engine, "ModDate", buf);
    UtilHex32ToAscii(buf, PdfGetPageCount(engine), UHTAF_NULL_TERMINATE);
    @call PDFInfoPages::MSG_VIS_TEXT_REPLACE_ALL_PTR(buf, 0);
    MemFree(mh);

    @send PDFInfoDB::MSG_GEN_INTERACTION_INITIATE();
}

/********************************************************************
 *                      PDFUpdateSaveDirText
 ********************************************************************
 * SYNOPSIS:      Show the current folder of the Save Copy As file selector
 *                ("Saving to Folder: NAME").
 *
 * PARAMETERS:    none
 *
 * RETURNS:       void
 *
 * STRATEGY:      The path buffers come from the heap: PATH_BUFFER_SIZE is too
 *                large for the process stack.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      04/20/99  mevissen  Initial Revision
 *******************************************************************/
void
PDFUpdateSaveDirText(void)
{
    MemHandle mh;
    TCHAR *fsPath, *fullPath, *end, *name;
    DiskHandle disk;

    @call PDFSaveDirText::MSG_VIS_TEXT_REPLACE_ALL_OPTR(@PDFSaveToDirStr, 0);

    mh = MemAlloc(2 * PATH_BUFFER_SIZE, HF_SWAPABLE, HAF_LOCK);
    if (!mh) {
	return;
    }
    fsPath = MemDeref(mh);
    fullPath = fsPath + PATH_BUFFER_SIZE / sizeof(TCHAR);

    @call PDFSaveFileSel::MSG_GEN_PATH_GET(fsPath, PATH_BUFFER_SIZE);
    disk = @call PDFSaveFileSel::MSG_GEN_PATH_GET_DISK_HANDLE();

    end = fullPath;
    *end = 0;
    FileConstructFullPath(&end, PATH_BUFFER_SIZE, disk, fsPath, TRUE);

    /* only the last folder name, unless that is the root ("C:\") */
    name = fullPath;
    while (end > fullPath && end[-1] == '\\' && end - 1 > fullPath &&
	   end[-2] != ':') {
	*--end = 0;
    }
    {
	TCHAR *p;
	for (p = fullPath; p < end; ++p) {
	    if (*p == '\\' && p + 1 < end) {
		name = p + 1;
	    }
	}
    }

    @call PDFSaveDirText::MSG_VIS_TEXT_APPEND_PTR(name, 0);
    MemFree(mh);
}

/********************************************************************
 *                      MSG_PDF_SAVE_DIR_SELECTED for PDFProcessClass
 ********************************************************************
 * SYNOPSIS:      Update the folder line when the Save Copy As file selector
 *                changes.
 *
 * PARAMETERS:    entryNum              Not used.
 *                entryFlags            File selector entry flags.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      04/20/99  mevissen  Initial Revision
 *******************************************************************/
@method PDFProcessClass, MSG_PDF_SAVE_DIR_SELECTED
{
    if (!(entryFlags & (GFSEF_ERROR | GFSEF_NO_ENTRIES))) {
	PDFUpdateSaveDirText();
    }
}

#define PDF_SAVE_BUF_SIZE 4096

/********************************************************************
 *                      PDFCopyOpenFile
 ********************************************************************
 * SYNOPSIS:      Copy the open document file to a new file.
 *
 * PARAMETERS:    src                   Handle of the open PDF file.
 *                *destName             Ptr to the name of the new file in the
 *                                      current folder.
 *
 * RETURNS:       word                  0 on success, non-zero on error.
 *
 * STRATEGY:      Read through the own file handle (the open document may not be
 *                shareable). The engine sets the file position before every
 *                read, so moving it here is safe.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      04/20/99  mevissen  Initial Revision
 *******************************************************************/
static word
PDFCopyOpenFile(FileHandle src, const char *destName)
{
    FileHandle dst;
    MemHandle mh;
    byte *buf;
    dword remaining;
    word chunk;
    word result = 0;

    mh = MemAlloc(PDF_SAVE_BUF_SIZE, HF_SWAPABLE, HAF_LOCK);
    if (!mh) {
	return 1;
    }
    buf = MemDeref(mh);

    dst = FileCreate(destName,
	FILE_CREATE_ONLY | FCF_NATIVE | FILE_ACCESS_W | FILE_DENY_RW, 0);
    if (!dst) {
	MemFree(mh);
	return 1;
    }

    remaining = FileSize(src);
    FilePos(src, 0, FILE_POS_START);
    while (remaining > 0) {
	chunk = (remaining > PDF_SAVE_BUF_SIZE) ?
	    PDF_SAVE_BUF_SIZE : (word)remaining;
	if (FileRead(src, buf, chunk, FALSE) != chunk ||
	    FileWrite(dst, buf, chunk, FALSE) != chunk) {
	    result = 1;
	    break;
	}
	remaining -= chunk;
    }

    FileClose(dst, FALSE);
    if (result) {
	FileDelete(destName);
    }
    MemFree(mh);
    return result;
}

/********************************************************************
 *                      MSG_PDF_DOCUMENT_SAVE_FILE_NOW for PDFDocumentClass
 ********************************************************************
 * SYNOPSIS:      Save a copy of the document under the name of the Save Copy As
 *                dialog.
 *
 * PARAMETERS:    none
 *
 * RETURNS:       void
 *
 * STRATEGY:      An existing file is not overwritten; the application is busy
 *                during the copy.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      04/20/99  mevissen  Initial Revision
 *******************************************************************/
@method PDFDocumentClass, MSG_PDF_DOCUMENT_SAVE_FILE_NOW
{
 word		retval;
 char		destFile[13];
 char			PDFPath[PATH_BUFFER_SIZE];
 DiskHandle		PDFDiskhandle;

	@call PDFFileName::MSG_VIS_TEXT_GET_ALL_PTR(destFile);
	@call PDFSaveFileSel::MSG_GEN_PATH_GET(PDFPath, sizeof(PDFPath));
	PDFDiskhandle = @call PDFSaveFileSel::MSG_GEN_PATH_GET_DISK_HANDLE();

	/* Set the folder: the file selector does not */
	FilePushDir();
	FileSetCurrentPath(PDFDiskhandle, PDFPath);

	/* Does the file exist? */
	FileGetAttributes(destFile);
	if (ThreadGetError() != ERROR_FILE_NOT_FOUND) {
		UserStandardDialogOptr(
			(char *)NULL, (void *)NULL, NullOptr, NullOptr,
			@SaveFileExistsStr,
			((CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
			(GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET)));
		}
	else {
		@send PDFSaveTrigger::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
		@call application::MSG_GEN_APPLICATION_MARK_APP_COMPLETELY_BUSY();

		retval = PDFCopyOpenFile(pself->PDFDoc_sourceFile, destFile);

		@send PDFSaveTrigger::MSG_GEN_SET_ENABLED(VUM_NOW);
		@call application::MSG_GEN_APPLICATION_MARK_APP_NOT_COMPLETELY_BUSY();

		if (!retval)
			@send PDFSaveDB::MSG_GEN_INTERACTION_ACTIVATE_COMMAND(IC_DISMISS);
		else {
			UserStandardDialogOptr(
				(char *)NULL, (void *)NULL, NullOptr, NullOptr,
				@SaveFileErrorStr,
				((CDT_ERROR << CDBF_DIALOG_TYPE_OFFSET) |
				(GIT_NOTIFICATION << CDBF_INTERACTION_TYPE_OFFSET)));
			}
		}
	FilePopDir();
	return;
}

@ifdef COPY_PAGE
/********************************************************************
 *                      SendSelectNotify
 ********************************************************************
 * SYNOPSIS:      Tell the edit control if the page can be copied.
 *
 * PARAMETERS:    canCopy               FALSE if /P forbids copying.
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      7/29/92   ardeb     Initial Revision
 *******************************************************************/
static void
SendSelectNotify(Boolean canCopy)
{
    MemHandle	data;
    NotifySelectStateChange *nsscPtr;
    EventHandle	notifyEvent;

    /* Sharable: the edit control locks it in another thread */
    data = MemAlloc(sizeof(NotifySelectStateChange), HF_DYNAMIC|HF_SHARABLE,
		    HAF_STANDARD_NO_ERR);
EC( ECCheckMemHandle( data ); )
    nsscPtr = (NotifySelectStateChange *)MemLock(data);
EC( ECCheckBounds( nsscPtr ); )

    /* The selection is graphics */
    nsscPtr->NSSC_selectionType = SDT_GRAPHICS;

    /* The page can be copied unless /P forbids it */
    nsscPtr->NSSC_clipboardableSelection = canCopy;

    MemUnlock(data);
    MemInitRefCount(data, 1);

    notifyEvent =
	@record null::MSG_META_NOTIFY_WITH_DATA_BLOCK(MANUFACTURER_ID_GEOWORKS,
						      GWNT_SELECT_STATE_CHANGE,
						      data);
EC( ECCheckEventHandle( notifyEvent ); )

    @call application::MSG_META_GCN_LIST_SEND
	(GCNLSF_SET_STATUS,
	 notifyEvent,
	 data,
	 GAGCNLT_APP_TARGET_NOTIFY_SELECT_STATE_CHANGE,
	 MANUFACTURER_ID_GEOWORKS);

}

/********************************************************************
 *                      MSG_META_GAINED_TARGET_EXCL for PDFDocumentClass
 ********************************************************************
 * SYNOPSIS:      Enable the document commands and the edit control when the
 *                document becomes the target.
 *
 * PARAMETERS:    none
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      7/31/92   ardeb     Initial Revision
 *******************************************************************/
@method PDFDocumentClass, MSG_META_GAINED_TARGET_EXCL
{
    ClipboardAddToNotificationList(oself);

    /* "Save Copy As..." needs a document to copy */
    @send PDFDocumentSave::MSG_GEN_SET_ENABLED(VUM_NOW);
    @send PDFDocumentInfo::MSG_GEN_SET_ENABLED(VUM_NOW);

    @callsuper();
	SendSelectNotify(PdfOkToCopy(pself->PDFDoc_engine));
}

/********************************************************************
 *                      MSG_META_LOST_TARGET_EXCL for PDFDocumentClass
 ********************************************************************
 * SYNOPSIS:      Disable the document commands when the document is no longer
 *                the target.
 *
 * PARAMETERS:    none
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      7/31/92   ardeb     Initial Revision
 *******************************************************************/
@method PDFDocumentClass, MSG_META_LOST_TARGET_EXCL
{
    ClipboardRemoveFromNotificationList(oself);
    @send PDFDocumentSave::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
    @send PDFDocumentInfo::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
    @callsuper();
}

/********************************************************************
 *                      MSG_META_CLIPBOARD_COPY for PDFDocumentClass
 ********************************************************************
 * SYNOPSIS:      Copy the current page as a graphics string to the clipboard.
 *
 * PARAMETERS:    none
 *
 * RETURNS:       void
 *
 * STRATEGY:      The page is drawn into a GString in the transfer VM file with
 *                its real page size. /P can forbid copying.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      1/24/2000  dhunter   Initial Revision
 *******************************************************************/
@method PDFDocumentClass, MSG_META_CLIPBOARD_COPY
{
    VMFileHandle      transferVMFile;
	 VMBlockHandle     headerVMBlock;
	 VMBlockHandle     dataVMBlock;
    ClipboardItemHeader *headerMem;
	 MemHandle         headerMemHandle;
	 PdfError          err;
	 GStateHandle        gstate;
	 Point             pageSize;

	/* Edit menu is disabled when /P forbids copying; guard anyway */
	 if (!PdfOkToCopy(pself->PDFDoc_engine)) {
	     return;
	 }

	/* Decode (or fetch from cache) the current page */
	 currentlyDecodingDoc = pself->PDFDoc_engine;
	 err = PdfDecodePage(pself->PDFDoc_engine, pself->PDFDoc_pageNum);
	 currentlyDecodingDoc = PDF_NULL_DOC;
	 if (err != PDF_OK) {
	     PDFDismissProgress();
	     if (err != PDF_ERR_CANCELLED) {
		 @send, forceQueue oself::MSG_PDF_DOCUMENT_REPORT_ERROR(err);
	     }
	     return;
	 }

    transferVMFile = ClipboardGetClipboardFile();

/* Draw the page again (a VM chain copy comes out flipped) */
	gstate = GrCreateGString(transferVMFile, GST_VMEM, &dataVMBlock);

	err = PdfDrawPage(pself->PDFDoc_engine, pself->PDFDoc_pageNum, gstate,
			  TRUE, NULL, &pageSize);

	if (err != PDF_OK) {
	    GrDestroyGString(gstate, NULL, GSKT_KILL_DATA);
	    @send, forceQueue oself::MSG_PDF_DOCUMENT_REPORT_ERROR(err);
	    return;
	}

	/* End the GString; its data stays in the clipboard file */
	GrEndGString(gstate);
	GrDestroyGString(gstate, NULL, GSKT_LEAVE_DATA);

    headerVMBlock = VMAlloc(transferVMFile, sizeof(ClipboardItemHeader), 1111);
    headerMem = (ClipboardItemHeader *)VMLock(transferVMFile, headerVMBlock,
							&headerMemHandle);
    headerMem->CIH_owner = (optr) (((dword)GeodeGetProcessHandle()<<16) | 0);
    headerMem->CIH_flags = 0;
    MemLock(OptrToHandle(@PDFClipboardItemName));
    strncpy(headerMem->CIH_name, LMemDeref(@PDFClipboardItemName),
        CLIPBOARD_ITEM_NAME_LENGTH);
    headerMem->CIH_name[CLIPBOARD_ITEM_NAME_LENGTH] = 0;
    MemUnlock(OptrToHandle(@PDFClipboardItemName));
    headerMem->CIH_sourceID = 0;

    headerMem->CIH_formatCount = 1;

    headerMem->CIH_formats[0].CIFI_format =
      FormatIDFromManufacturerAndType(MANUFACTURER_ID_GEOWORKS,
        CIF_GRAPHICS_STRING);
    headerMem->CIH_formats[0].CIFI_vmChain =
        (VMChain)(((dword)(dataVMBlock))<<16L) ;

	 /* Real page size from the engine */
	 headerMem->CIH_formats[0].CIFI_extra1 =
      (sword)(pageSize.P_x);
	 headerMem->CIH_formats[0].CIFI_extra2 =
      (sword)(pageSize.P_y);
    VMUnlock(headerMemHandle);

    /* Register the transfer item with the clipboard */

    ClipboardRegisterItem(BlockIDFromFileAndBlock(
                            transferVMFile, headerVMBlock),
                          TIF_NORMAL);
}

@endif /* COPY_PAGE */

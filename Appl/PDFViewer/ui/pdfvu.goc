 * Sent to app model when the Save dialog is acknowledged.
 */


/* data from the 'pdf doc' object in xpdf */


/*
 * All PDF-internal state (XRef, Catalog, decoded-page cache, scratch
 * VM file) now lives behind this one opaque handle in the PDF engine
 * (see pdfEngine.h). PDFDoc_xref/PDFDoc_catalog/PDFDoc_gstringFile/
 * PDFDoc_pageData/PDFDoc_ok used to be separate instance vars here;
 * they're gone, PdfIsValid(PDFDoc_engine) replaces PDFDoc_ok.
 */
@instance  PdfDocHandle	PDFDoc_engine = PDF_NULL_DOC;

/*
 * The file the engine was opened from. Ownership of this FileHandle
 * stays with the UI (see PdfOpen's contract in pdfEngine.h) -- we
 * used to reach into PDFDoc_xref.fHan for this (MSG_PDF_DOCUMENT_
 * SAVE_FILE_NOW), which isn't possible any more now that XRef is an
 * engine-internal detail.
 */
@instance  FileHandle	PDFDoc_sourceFile = 0;

@instance  word		PDFDoc_pageNum = 1;  /* current page num on display */

@instance  Point    PDFDoc_bounds = {0, 0};  /* view bounds of current page */

/* User can 'save' this document to SP_DOCUMENT if this value is TRUE. */
@instance  Boolean	PDFDoc_saveable = FALSE;

@endc

/* PDFDOC_PAGE_COUNT_LIMIT used to be defined here (30); the page-cache
 * eviction it controlled now lives entirely in the engine as
 * PDF_MAX_CACHED_PAGES (main/pdfEngine.goc) -- the UI doesn't manage
 * the cache any more. */


@class  PDFDocumentControlClass, GenDocumentControlClass ;
@endc


@class PDFImageInteractionClass, GenInteractionClass ;
@endc


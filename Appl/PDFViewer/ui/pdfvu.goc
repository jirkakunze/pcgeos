}


/*
 * Save Copy As dialog -- laid out like the document control's own
 * "Save As" dialog (CommonUI cmainUIDocumentControl.ui, FileSaveAsSummons)
 * so it looks the same as in other GEOS applications.
 */
@object GenInteractionClass PDFSaveDB =
{
    GI_visMoniker = "Save Copy As";
    GI_comp = @PDFSaveGlyph,
	      @PDFSaveFileSel,
	      @PDFSaveDirText,
	      @PDFFileName,
	      @PDFSaveTrigger,
	      @PDFCancelTrigger;
    GII_type = GIT_COMMAND;
    GII_visibility = GIV_DIALOG;
    GII_attrs = @default | GIA_NOT_USER_INITIATABLE | GIA_MODAL;
    ATTR_GEN_HELP_CONTEXT = "SaveDB";
}


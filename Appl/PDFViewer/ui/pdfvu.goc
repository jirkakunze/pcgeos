/*
 * Document Info dialog: entries of the /Info dictionary (filled by
 * MSG_PDF_DOCUMENT_SHOW_INFO).
 */
@object GenInteractionClass PDFInfoDB = {
    GI_visMoniker = "Document Info";
    GI_comp = @PDFInfoTitle,
	      @PDFInfoAuthor,
	      @PDFInfoSubject,
	      @PDFInfoKeywords,
	      @PDFInfoCreator,
	      @PDFInfoProducer,
	      @PDFInfoCreated,
	      @PDFInfoModified,
	      @PDFInfoPages;
    GII_type = GIT_NOTIFICATION;
    GII_visibility = GIV_DIALOG;
    GII_attrs = @default | GIA_NOT_USER_INITIATABLE;
    HINT_CENTER_CHILDREN_ON_MONIKERS;
}


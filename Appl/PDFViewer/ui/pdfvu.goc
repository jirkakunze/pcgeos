@chunk char PDFOpenError[] = "PDF Viewer encountered an error while trying to "
                        "open the file.  The file may be corrupt or may not "
                        "be a PDF file.";

@chunk char PDFOpenEncryptedError[] = "This PDF file is encrypted with a method "
                        "PDF Viewer does not support (for example AES). "

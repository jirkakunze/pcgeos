/*
 * Set for the duration of a PdfDecodePage call so
 * PDFImageInteractionClass's cancel button
 * (MSG_GEN_GUP_INTERACTION_COMMAND) knows which document's decode to
 * cancel. PDFImageProgressDialog/PDFImageInteractionClass are
 * singleton UI objects with no direct link back to whichever
 * PDFDocumentClass instance is currently decoding, so this tracks it
 * explicitly -- same single-active-decode assumption the old global
 * stopLoadingImage flag already made (only one decode happens at a
 * time), just routed through the engine's per-document cancel flag
 * instead of a raw bool.
 */
PdfDocHandle currentlyDecodingDoc = PDF_NULL_DOC;

Boolean onTV, g_showTools;


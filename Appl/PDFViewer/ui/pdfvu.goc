@chunk TCHAR PDFSaveToDirStr[] = "Saving to Folder: ";

@chunk TCHAR SaveFileExistsStr[] = "The file already exists - please choose another name.";

@chunk TCHAR SaveFileErrorStr[] = "Unknown error in saving file - try again possibly with a different file name.";

/* Name of the clipboard item made by Copy (max. CLIPBOARD_ITEM_NAME_LENGTH) */
@chunk TCHAR PDFClipboardItemName[] = "PDFViewer Page";

@end StringResource;


/********************************************************************
 *                      MSG_GEN_PROCESS_OPEN_APPLICATION for PDFProcessClass
 ********************************************************************
 * SYNOPSIS:      Set up the UI when the application starts.
 *
 * PARAMETERS:    attachFlags           Attach flags.
 *                launchBlock           Launch block.
 *                extraState            Extra state block.
 *
 * RETURNS:       void
 *
 * STRATEGY:      Hide our Open trigger if the user configured the standard one;
 *                show or hide the tool bar as set in the INI file.
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      3/21/2000  dhunter   Initial version
 *******************************************************************/
@method PDFProcessClass, MSG_GEN_PROCESS_OPEN_APPLICATION
{
 word		optionsSet;
 Boolean	initError;

	/* Hide our Open trigger if the standard one is configured */
	InitFileReadInteger("uiFeatures", "docControlOptions", &optionsSet);
	if (optionsSet & 8192)
		@send PDFDocumentOpenTrigger::MSG_GEN_SET_NOT_USABLE(
																 VUM_DELAYED_VIA_APP_QUEUE);

	/* Show the tool bar or not */
	initError = InitFileReadBoolean("pdfvu", "tools", &g_showTools);
	if (initError) g_showTools = TRUE;
	if (g_showTools) {
		@send PDFToolsToggle::MSG_GEN_USE_VIS_MONIKER(
							OptrToChunk(@PDFHideToolsMoniker),
							VUM_DELAYED_VIA_APP_QUEUE);
		@send Toolbar::MSG_GEN_SET_USABLE(VUM_DELAYED_VIA_APP_QUEUE);
		}
	else {
		@send PDFToolsToggle::MSG_GEN_USE_VIS_MONIKER(
							OptrToChunk(@PDFShowToolsMoniker),
							VUM_DELAYED_VIA_APP_QUEUE);
		@send Toolbar::MSG_GEN_SET_NOT_USABLE(VUM_DELAYED_VIA_APP_QUEUE);
		}

	 @callsuper();

		  onTV = FALSE;

}


/********************************************************************
 *      MSG_GEN_PROCESS_CREATE_NEW_STATE_FILE for PDFProcessClass
 ********************************************************************
 * SYNOPSIS:      Do not create a state file.
 *
 * PARAMETERS:    appInstanceReference  Not used.
 *
 * RETURNS:       VMFileHandle          NullHandle.
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      5/9/2000  dhunter   Initial version
 *******************************************************************/
@method PDFProcessClass, MSG_GEN_PROCESS_CREATE_NEW_STATE_FILE
{
    return( NullHandle );
}

/********************************************************************
 *                      MSG_PDF_TOGGLE_OPTIONS for PDFProcessClass
 ********************************************************************
 * SYNOPSIS:      Show or hide the tool bar and save the setting in the INI
 *                file.
 *
 * PARAMETERS:    none
 *
 * RETURNS:       void
 *
 * STRATEGY:
 *
 * REVISION HISTORY:
 *      Date      Name      Description
 *      ----      ----      -----------
 *      11/15/02  jfh       Initial version
 *******************************************************************/
@method PDFProcessClass, MSG_PDF_TOGGLE_OPTIONS
{

	if (g_showTools) {
		g_showTools = FALSE;
		@send PDFToolsToggle::MSG_GEN_USE_VIS_MONIKER(
							OptrToChunk(@PDFShowToolsMoniker),
							VUM_DELAYED_VIA_APP_QUEUE);
		@send Toolbar::MSG_GEN_SET_NOT_USABLE(VUM_DELAYED_VIA_APP_QUEUE);
		}
	else {
		g_showTools = TRUE;
		@send PDFToolsToggle::MSG_GEN_USE_VIS_MONIKER(
							OptrToChunk(@PDFHideToolsMoniker),
							VUM_DELAYED_VIA_APP_QUEUE);
		@send Toolbar::MSG_GEN_SET_USABLE(VUM_DELAYED_VIA_APP_QUEUE);
		}

	/* Save the setting */
	InitFileWriteBoolean("pdfvu", "tools", g_showTools);
   InitFileSave();

}


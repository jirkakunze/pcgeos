/*
 * Define the extent of the coordinate space on our document: 8.5x11
 */
#define DOCUMENT_WIDTH		(8.5*72)
#define DOCUMENT_HEIGHT		(11*72)

#define INIT_FILE_CATEGORY		"pdfvu"
#define INIT_FILE_KEY_VIEW_COLOR	"viewColor"

/*
 ***************************************************************************
 *		Global variables
 ***************************************************************************
 */

/*
 * Set for the duration of a PdfDecodePage call so
 * PDFImageInteractionClass's cancel button
 * (MSG_GEN_GUP_INTERACTION_COMMAND) knows which document's decode to
 * cancel. PDFImageProgressDialog/PDFImageInteractionClass are
 * singleton UI objects with no direct link back to whichever
 * PDFDocumentClass instance is currently decoding, so this tracks it
 * explicitly -- same single-active-decode assumption the old global
 * stopLoadingImage flag already made (only one decode happens at a
 * time), just routed through the engine's per-document cancel flag
 * instead of a raw bool.
 */
PdfDocHandle currentlyDecodingDoc = PDF_NULL_DOC;

Boolean onTV, g_showTools;

/*
 ***************************************************************************
 *		Class & Message Definitions
 ***************************************************************************
 */

@class	PDFProcessClass, GenProcessClass ;
	@message void MSG_PDF_TOGGLE_OPTIONS();
	/* Save Copy As file selector changed folder */
	@message (GEN_FILE_SELECTOR_NOTIFICATION_MSG) MSG_PDF_SAVE_DIR_SELECTED;
@endc   /* end of class definition */


/*
 * PDFDocument class is our subclass of GenDocument that we use to add
 * behavior to the GenDocument
 */

@class	PDFDocumentClass, GenDocumentClass ;

@message void MSG_PDF_DOCUMENT_TELL_PRINT_CONTROL_NUM_PAGES();
/*
 * Sent to app target when multi-view document switches;
 * we update the print control with the document's # pages.
 */
@message void MSG_PDF_DOCUMENT_UPDATE_PAGE_CONTROL();

@message void MSG_PDF_DOCUMENT_SAVE();
/*
 * Sent to app model when our special Save trigger is pressed.
 */

@message void MSG_PDF_DOCUMENT_SAVE_FILE_NOW();
/*
 * Sent to app model when the Save dialog is acknowledged.
 */

@message void MSG_PDF_DOCUMENT_REPORT_ERROR(word err);
/*
 * Queued to ourselves when decoding/drawing a page failed; shows the
 * error dialog outside of MSG_VIS_DRAW/printing.
 */

@message void MSG_PDF_DOCUMENT_SHOW_INFO();
/*
 * Sent to app model by File > Document Info: fills and opens PDFInfoDB.
 */

@message void MSG_PDF_DOCUMENT_GOTO_DEST(word page, sdword docY);
/*
 * Go to a link target: page (1-based) and y in document coordinates of
 * that page, -1 = top of the page (F4).
 */

/* data from the 'pdf doc' object in xpdf */

/*
 * All PDF-internal state (XRef, Catalog, decoded-page cache, scratch
 * VM file) now lives behind this one opaque handle in the PDF engine
 * (see pdfEngine.h). PDFDoc_xref/PDFDoc_catalog/PDFDoc_gstringFile/
 * PDFDoc_pageData/PDFDoc_ok used to be separate instance vars here;
 * they're gone, PDFDoc_engine replaces them.
 */
@instance  PdfDocHandle	PDFDoc_engine = PDF_NULL_DOC;

/*
 * The file the engine was opened from. Ownership of this FileHandle
 * stays with the UI (see PdfOpen's contract in pdfEngine.h) -- we
 * used to reach into PDFDoc_xref.fHan for this (MSG_PDF_DOCUMENT_
 * SAVE_FILE_NOW), which isn't possible any more now that XRef is an
 * engine-internal detail.
 */
@instance  FileHandle	PDFDoc_sourceFile = 0;

@instance  word		PDFDoc_pageNum = 1;  /* current page num on display */

@instance  Point    PDFDoc_bounds = {0, 0};  /* view bounds of current page */

/* Page whose decode error was already reported (0 = none), so every
 * redraw of a broken page doesn't pop up the dialog again. */
@instance  word		PDFDoc_errorPage = 0;

/* Page whose decode the user stopped (0 = none). MSG_VIS_DRAW leaves it
 * blank instead of decoding again -- closing the progress dialog causes
 * a redraw, which would otherwise restart the decode right away.
 * Cleared when the user navigates (also to the same page again). */
@instance  word		PDFDoc_cancelledPage = 0;

@endc

/* PDFDOC_PAGE_COUNT_LIMIT used to be defined here (30); the page-cache
 * eviction it controlled now lives entirely in the engine as
 * PDF_MAX_CACHED_PAGES (main/pdfEngine.goc) -- the UI doesn't manage
 * the cache any more. */

@class  PDFDocumentControlClass, GenDocumentControlClass ;
@endc

@class PDFImageInteractionClass, GenInteractionClass ;
@endc

/*  The page control is overridden on the GPC as a CUI bug workaround.  
    See the method below. */
@class PDFPageControlClass, GenPageControlClass;
@endc

/*
 * Password entry field: GEOS text objects have no hidden mode (the
 * VTES_HIDDEN text style is not implemented by the text library), so the
 * typed characters are kept in instance data and only '*' are shown.
 * Editing is limited to typing and Backspace; clipboard and quick
 * copy are blocked.
 */
@class PDFPasswordTextClass, GenTextClass;
	/* copy the password (without '*') into buf, returns its length */
	@message word MSG_PDF_PASSWORD_TEXT_GET(char *buf);
	@instance char PDFPTI_password[PDF_PASSWORD_BUF_SIZE] = "";
	@instance word PDFPTI_length = 0;
@endc

@classdecl	PDFDocumentControlClass ;
@classdecl	PDFImageInteractionClass ;

@classdecl	PDFProcessClass, neverSaved ;
@classdecl	PDFDocumentClass ;

@classdecl  PDFPageControlClass;
@classdecl  PDFPasswordTextClass;


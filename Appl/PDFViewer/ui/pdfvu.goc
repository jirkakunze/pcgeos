@object GenTriggerClass PDFDocumentSave = {
	 GI_visMoniker = 'C', "Save Copy As...";
	 GI_states = @default & ~GS_ENABLED;
	 GTI_destination = (TO_APP_MODEL);
	 GTI_actionMsg = MSG_PDF_DOCUMENT_SAVE;
